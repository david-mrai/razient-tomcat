# Razient Production Deployment Environment Variables
# Copy this to .env and fill in your production values

# Database Configuration (REQUIRED)
RAZIENT_DB_URL=jdbc:mariadb://10.0.0.34:3306/razient
RAZIENT_DB_USERNAME=razient
RAZIENT_DB_PASSWORD=<your-database-password>
RAZIENT_DB_DRIVER=org.mariadb.jdbc.Driver

# Razient Application Settings
RAZIENT_PUBLIC_BASE_URL=https://rz.digicrew.com
RAZIENT_DATA_DIR=/data
RAZIENT_LOG_LEVEL=INFO

# Database Schema (KEEP AS 'none' FOR PRODUCTION)
# Do NOT use 'update' or 'create' against production databases
RAZIENT_DB_SCHEMA_ACTION=none

# Mail Configuration (Optional)
# RAZIENT_SMTP_HOST=smtp.example.com
# RAZIENT_SMTP_PORT=587
# RAZIENT_SMTP_USERNAME=
# RAZIENT_SMTP_PASSWORD=
# RAZIENT_SMTP_AUTH=true
# RAZIENT_MAIL_FROM=noreply@rz.digicrew.com

# External API Keys (Optional)
# RAZIENT_GOOGLE_MAPS_KEY=
# RAZIENT_OPENWEATHERMAP_APPID=

# Scheduled Jobs (Optional - set to true to enable)
# RAZIENT_ALERTS_DAILY_JOB=true
# RAZIENT_ALERTS_WEEKLY_JOB=false
# RAZIENT_TICKETS_DAILY_JOB=false
# RAZIENT_SURVEYS_JOB=false
# RAZIENT_EARTHQUAKES_DAILY_JOB=false
# RAZIENT_WEATHER_DAILY_JOB=false
# RAZIENT_INCIDENTS_JOB=false

# Connection Pool Size (Optional)
# RAZIENT_DB_POOL_SIZE=20

# Upload Configuration (Optional)
# RAZIENT_PUBLIC_UPLOAD_URL=/Razient/upload/
