<?xml version="1.0" encoding="UTF-8"?>
<!--
  Razient Tomcat 11 server configuration.

  - One HTTP connector on 8080, meant to sit behind the TLS front proxy (no AJP, no TLS here).
  - No shutdown port, no UserDatabase/manager apps, no auto-deploy at runtime.
  - Error pages never show stack traces or the server version.
  - webapps-javaee holds the JEvolution report apps (Java EE / javax.*); Tomcat converts them to
    Jakarta EE into webapps at startup.
-->
<Server port="-1" shutdown="SHUTDOWN">
  <Listener className="org.apache.catalina.startup.VersionLoggerListener" logArgs="false" />
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
  <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />

  <Service name="Catalina">
    <Connector port="8080" protocol="HTTP/1.1"
               connectionTimeout="20000"
               maxParameterCount="1000"
               xpoweredBy="false"
               allowTrace="false" />

    <Engine name="Catalina" defaultHost="localhost">
      <Host name="localhost"
            appBase="webapps"
            legacyAppBase="webapps-javaee"
            unpackWARs="true"
            autoDeploy="false"
            deployOnStartup="true">

        <!-- Trust X-Forwarded-For/-Proto from the proxy on the private network, so request.isSecure()
             (HSTS, secure cookies) and client addresses are right behind it. -->
        <Valve className="org.apache.catalina.valves.RemoteIpValve"
               remoteIpHeader="X-Forwarded-For"
               protocolHeader="X-Forwarded-Proto" />

        <Valve className="org.apache.catalina.valves.AccessLogValve" directory="logs"
               prefix="localhost_access_log" suffix=".txt"
               pattern="%a %l %u %t &quot;%r&quot; %s %b %D" />

        <Valve className="org.apache.catalina.valves.ErrorReportValve"
               showReport="false" showServerInfo="false" />
      </Host>
    </Engine>
  </Service>
</Server>
