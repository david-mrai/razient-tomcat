<Data>
  <Name>610SQL49</Name>
  <Sentence>
  SELECT vw_cussur_secque.idcustomerSurveys,vw_cussur_secque.customer_idCustomer,
  vw_cussur_secque.surveyname,vw_cussur_secque.sectionname,
  vw_cussur_secque.question,supplier.idSupplier,supplier.name,
  CASE WHEN (`suppliersurveyresponseanswers`.answer IS NULL ) THEN 'Not Answered' ELSE `suppliersurveyresponseanswers`.answer END AS answer,
  CASE WHEN (`suppliersurveyresponseanswers`.levelMarginal IS NULL) THEN 0 ELSE `suppliersurveyresponseanswers`.levelMarginal END AS levelMarginal 
  FROM `vw_cussur_secque` `vw_cussur_secque` 
  INNER JOIN `customersurveyasignsupp` `customersurveyasignsupp` ON ( (`vw_cussur_secque`.`customer_idCustomer` = `customersurveyasignsupp`.`idCustomer`) 
	AND (`vw_cussur_secque`.`idcustomerSurveys` = `customersurveyasignsupp`.`idSurvey`) )
  INNER JOIN `supplier` `supplier` ON (`customersurveyasignsupp`.`idSupplier` = `supplier`.`idSupplier`)
  LEFT JOIN `suppliersurveyresponseanswers` `suppliersurveyresponseanswers` ON ((`supplier`.`idSupplier` = `suppliersurveyresponseanswers`.`supplier_idSupplier`) 
	AND (`suppliersurveyresponseanswers`.`customerQuestionsSurveys_idcustomerQuestionSurveys` = `vw_cussur_secque`.`idcustomerQuestionSurveys` ))
  WHERE (vw_cussur_secque.idcustomerSurveys=@idSurvey)
  AND (vw_cussur_secque.customer_idCustomer=@cxRaz__razient__customersurveys__idcustomerSurveys )
  </Sentence>
