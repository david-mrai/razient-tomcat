        <Data>
            <Name>110SQL25</Name>
            <Sentence>SELECT reportnewsglobalincident.idrazienGlobalIncident,&apos;_&apos;,reportnewsglobalincident.datePosted,reportnewsglobalincident.title,reportnewsglobalincident.city,reportnewsglobalincident.state,reportnewsglobalincident.country FROM razient.reportnewsglobalincident AS reportnewsglobalincident WHERE (reportnewsglobalincident.datePosted&gt;=@fromdate) AND (reportnewsglobalincident.datePosted&lt;=@todate) ORDER BY reportnewsglobalincident.datePosted ASC</Sentence>
