<?xml version="1.0" encoding="ISO-8859-1" ?>
<jsp:root version="1.2"
   xmlns:jsp="http://java.sun.com/JSP/Page"
   xmlns:f="http://java.sun.com/jsf/core"
   xmlns:h="http://java.sun.com/jsf/html"
   xmlns:ice="http://www.icesoft.com/icefaces/component">
   <jsp:directive.page contentType="text/html;charset=ISO-8859-1" pageEncoding="ISO-8859-1" />
   <f:view>
   		<ice:outputDeclaration 
            doctypeRoot="html" 
            doctypePublic="-//W3C//DTD HTML 4.01 Transitional//EN" 
            doctypeSystem="http://www.w3.org/TR/html4/loose.dtd" /> 
    <html>
       <head>
         <title>(Razient) Header Top Login</title>
       </head>
       <body>      
        <div>
   			<div class="header_form_container">
   				<div class="header_form_content">
	   				<div class="flag_content">
	   						<ice:form>
	   						<ice:commandLink action="#{languageBean.toLanguage_English}" >
								<ice:graphicImage url="./css/images/login/flag_USA_up.png"
										onmouseout	="this.src='./css/images/login/flag_USA_up.png'"
										onmouseover	="this.src='./css/images/login/flag_USA_over.png'"
										onmouseup	="this.src='./css/images/login/flag_USA_up.png'"
										onmousedown	="this.src='./css/images/login/flag_USA_down.png'">
								</ice:graphicImage>
							</ice:commandLink>
								
							<ice:graphicImage url="./css/images/risk_black_low.png">
							</ice:graphicImage>
							
							<ice:commandLink action="#{languageBean.toLanguage_Spanish}" >
								<ice:graphicImage url="./css/images/login/flag_Sp_up.png"
										onmouseout	="this.src='./css/images/login/flag_Sp_up.png'"
										onmouseover	="this.src='./css/images/login/flag_Sp_over.png'"
										onmouseup	="this.src='./css/images/login/flag_Sp_up.png'"
										onmousedown	="this.src='./css/images/login/flag_Sp_down.png'">
								</ice:graphicImage>
							</ice:commandLink>
							</ice:form>
					</div>
      			</div>
    		</div>
		</div>

       </body>
    </html>
   </f:view>
</jsp:root>
