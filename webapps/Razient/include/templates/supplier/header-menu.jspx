<?xml version="1.0" encoding="ISO-8859-1" ?>
<jsp:root version="1.2"
   xmlns:jsp="http://java.sun.com/JSP/Page"
   xmlns:f="http://java.sun.com/jsf/core"
   xmlns:h="http://java.sun.com/jsf/html"
   xmlns:ice="http://www.icesoft.com/icefaces/component">
   <jsp:directive.page contentType="text/html;charset=ISO-8859-1" pageEncoding="ISO-8859-1" />
   <f:view>
   		<ice:outputDeclaration 
            doctypeRoot="html" 
            doctypePublic="-//W3C//DTD HTML 4.01 Transitional//EN" 
            doctypeSystem="http://www.w3.org/TR/html4/loose.dtd" /> 
    <html>
       <head>
         <title>(Razient) Header</title>
       </head>
       <body>   
       <br/><br/>   
        <div>
   			<div class="header_tab_container">
   				<div class="header_tab_content">
        		<div>
               	<ice:form>
		               		<!-- main menu declaration  -->
						<ice:panelGroup styleClass="componentBoxHeader menuBarContainer">

						<div >
						<table cellspacing="0" cellpadding="0">
							<tr>
								<td><ice:graphicImage style="border:none;"  styleClass="noborder"
										url		="./css/images/menu/risk_dash_1.png" 
									onmouseout	="this.src='./css/images/menu/risk_dash_1.png'"
									onmouseover	="this.src='./css/images/menu/risk_dash_2.png'"
									onmouseup	="this.src='./css/images/menu/risk_dash_1.png'"
									onmousedown	="this.src='./css/images/menu/risk_dash_2.png'" />
								</td>
								<td><ice:graphicImage style="border:none;"  styleClass="noborder"
										url		="./css/images/risk_black_low.png"/> 
								</td>
								<td><ice:graphicImage style="border:none;"  styleClass="noborder"
										url		="./css/images/menu/risk_survey_1.png" 
									onmouseout	="this.src='./css/images/menu/risk_survey_1.png'"
									onmouseover	="this.src='./css/images/menu/risk_survey_2.png'"
									onmouseup	="this.src='./css/images/menu/risk_survey_1.png'"
									onmousedown	="this.src='./css/images/menu/risk_survey_2.png'" />
								</td>
								<td><ice:graphicImage style="border:none;"  styleClass="noborder"
										url		="./css/images/risk_black_low.png"/>
								</td>
								<td><ice:graphicImage style="border:none;"  styleClass="noborder"
										url		="./css/images/menu/risk_global_1.png" 
									onmouseout	="this.src='./css/images/menu/risk_global_1.png'"
									onmouseover	="this.src='./css/images/menu/risk_global_2.png'"
									onmouseup	="this.src='./css/images/menu/risk_global_1.png'"
									onmousedown	="this.src='./css/images/menu/risk_global_2.png'" />
								</td>
								<td><ice:graphicImage style="border:none;"  styleClass="noborder"
										url		="./css/images/risk_black_low.png"/>
								</td>
								<td>
								<ice:graphicImage style="border:none;"  styleClass="noborder"
										url		="./css/images/menu/risk_request_1.png" 
									onmouseout	="this.src='./css/images/menu/risk_request_1.png'"
									onmouseover	="this.src='./css/images/menu/risk_request_2.png'"
									onmouseup	="this.src='./css/images/menu/risk_request_1.png'"
									onmousedown	="this.src='./css/images/menu/risk_request_2.png'" />
								</td>
								<td>
								<ice:graphicImage style="border:none;"  styleClass="noborder"
										url		="./css/images/risk_black_low.png"/>
								</td>
								<td>
								<ice:graphicImage style="border:none;"  styleClass="noborder"
										url		="./css/images/menu/risk_asses_1.png" 
									onmouseout	="this.src='./css/images/menu/risk_asses_1.png'"
									onmouseover	="this.src='./css/images/menu/risk_asses_2.png'"
									onmouseup	="this.src='./css/images/menu/risk_asses_1.png'"
									onmousedown	="this.src='./css/images/menu/risk_asses_2.png'" />
								</td>
								<td>
								<ice:graphicImage style="border:none;"  styleClass="noborder"
										url		="./css/images/risk_black_low.png"/>
								</td>
								<td>
								<ice:graphicImage style="border:none;"  styleClass="noborder"
										url		="./css/images/menu/risk_rep_1.png" 
									onmouseout	="this.src='./css/images/menu/risk_rep_1.png'"
									onmouseover	="this.src='./css/images/menu/risk_rep_2.png'"
									onmouseup	="this.src='./css/images/menu/risk_rep_1.png'"
									onmousedown	="this.src='./css/images/menu/risk_rep_2.png'" />
								</td>
							</tr>
						</table>											
						</div>
						 
						
						<!-- INIT : Title -->
						</ice:panelGroup>
		
			
				</ice:form>
               		</div>
      			</div>
    		</div>
		</div>

       </body>
    </html>
   </f:view>
</jsp:root>
