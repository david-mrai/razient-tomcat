								<br/><br/><br/><br/><br/><br/><br/>		
						</c:if>
						<c:if test="${builtquestions.razientQuestionTypeIdrazientQuestionType == 10}">
									
								<ice:panelGroup styleClass="paneBuiltQuestionBox">	
									<ice:selectInputDate id="q_date_#{builtquestions.id}e" renderMonthAsDropdown="true" renderYearAsDropdown="true" required="false"  
												value="#{builtquestions.answerDate}" title="answerDate"
												renderAsPopup="true" styleClass="fieldsimpledates">
											<f:convertDateTime pattern="#{bundle['rz_calendar.format.a']}" timeZone="default"/>
											</ice:selectInputDate>
								</ice:panelGroup>	
								<br/><br/><br/>							
						</c:if>
						<c:if test="${builtquestions.razientQuestionTypeIdrazientQuestionType == 11}">
