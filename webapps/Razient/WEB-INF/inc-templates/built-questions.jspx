															rowClasses="rowOn,rowOff" cellpadding="0"
															>
			
															
															<ice:column>
																	<ice:outputText value="">>></ice:outputText>
															</ice:column>
															<ice:column style="background-color:#F7F4F5;">
																<f:facet name="header">
																	<ice:outputText value="">#{bundle['rz_document']}&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</ice:outputText>
																</f:facet>
																<ice:outputText  id="fu_path_#{builtquestions.id}" value="#{fupBean.path}" />
															</ice:column>
															
															<ice:column style="background-color:#F7F4F5;">
																<f:facet name="header">
																			<ice:outputText value=""></ice:outputText>
																</f:facet>
																<ice:commandLink action="#{builtquestions.deleteFileAdditional}" actionListener="#{builtquestions.actionFuploadlistener}" onclick="javascript:if(!confirm('#{bundle['rz_areyousure']} #{bundle['rz_delete_document']}?')) return false;rld();">
																						<ice:graphicImage style="border:none;"  styleClass="noborder"
																							url		="./css/images/#{folderBean.folder_menu}/icons/menu_up_deletelow.png" 
																							onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_deletelow.png'"
																							onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_deletelow.png'"
																							onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_deletelow.png'"
																							onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_deletelow.png'"/>
																						<f:attribute name="optionFuId" value="#{fupBean.id}" />		
																						<f:attribute name="optionQuestionId" value="#{builtquestions.id}" />
																						<f:attribute name="optionSupplierId" value="#{builtquestions.idSupplier}" />																		
																</ice:commandLink>
															</ice:column>
															
														</ice:dataTable>
														<ice:panelGroup styleClass="clearer" />
														
								    
								</ice:panelGroup>
								<br/><br/><br/><br/><br/><br/><br/>								
						</c:if>
						<c:if test="${builtquestions.razientQuestionTypeIdrazientQuestionType == 9}">
								<ice:panelGroup styleClass="paneBuiltQuestionBox">
									<ice:selectManyCheckbox id="q_cb_#{builtquestions.id}"
															value="#{builtquestions.cb_response}"
															styleClass="selectedOneRadioMultiplekey"
															valueChangeListener="#{builtquestions.processValueChange}"
