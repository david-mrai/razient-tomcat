																<ice:commandLink action="#{builtquestions.deleteFileAdditional}" actionListener="#{builtquestions.actionFuploadlistener}" onclick="javascript:if(!confirm('#{bundle['rz_areyousure']} #{bundle['rz_delete_document']}?')) return false;rld();">
																						<ice:graphicImage style="border:none;"  styleClass="noborder"
																							url		="./css/images/#{folderBean.folder_menu}/icons/menu_up_deletelow.png" 
																							onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_deletelow.png'"
																							onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_deletelow.png'"
																							onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_deletelow.png'"
																							onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_deletelow.png'"/>
																						<f:attribute name="optionFuId" value="#{fupBean.id}" />		
																						<f:attribute name="optionQuestionId" value="#{builtquestions.id}" />
																						<f:attribute name="optionSupplierId" value="#{builtquestions.idSupplier}" />																		
																</ice:commandLink>
															</ice:column>
															
														</ice:dataTable>
														<ice:panelGroup styleClass="clearer" />
								</ice:panelGroup>
								<br/><br/><br/><br/><br/><br/><br/>		
						</c:if>
						
						<!-- COMMENTS -->
						<c:if test="${builtquestions.isRequiredComment != 'F'}">
							<table>
									<c:if test="${builtquestions.isRequiredFollowup == 'F'}">
										<tr>
											<td>
													<div style="float: left; margin-top: 2px; font-size:10px;color:#545138">#{bundle['rz_buildsurvey.addinfo']} :</div>
											</td>
											<td>
													<ice:panelGroup styleClass="paneBuiltQuestionCommentBox">	
														<ice:inputTextarea id="q_comment_#{builtquestions.id}"
																   cols="86" rows="5"
										                           maxlength="480"
										                           value="#{builtquestions.comment}"
										                           partialSubmit="true"
										                           styleClass="fieldtextareacommentbuilt">
									   					 </ice:inputTextarea>
													</ice:panelGroup>	
											</td>
										</tr>
									</c:if>
									<c:if test="${builtquestions.isRequiredFollowup != 'F'}">
										<tr>
											<td>
													<div style="float: left; margin-top: 2px; font-size:10px;color:#545138">#{bundle['rz_buildsurvey.comment']} :</div>
											</td>
											<td>
													<ice:panelGroup styleClass="paneBuiltQuestionCommentBox">	
														<ice:inputTextarea id="q_comment_#{builtquestions.id}"
																   cols="92" rows="5"
										                           maxlength="480"
										                           value="#{builtquestions.comment}"
										                           partialSubmit="true"
										                           styleClass="fieldtextareacommentbuilt">
									   					 </ice:inputTextarea>
													</ice:panelGroup>	
											</td>
										</tr>
										<tr>
											<td>
													<div style="float: left; margin-top: 2px; font-size:10px;color:#545138">#{bundle['rz_buildsurvey.commentresponse']} :</div>
											</td>
											<td>
													<ice:panelGroup styleClass="paneBuiltQuestionCommentBox">	
														<ice:inputTextarea id="q_commentrp_#{builtquestions.id}"
																	cols="92" rows="5"
														            maxlength="480"
														            value="#{builtquestions.commentResponse}"
														            partialSubmit="true"
														            readonly="true"
														            styleClass="fieldtextareacommentresponsebuilt">
													    </ice:inputTextarea>
													</ice:panelGroup>	
											</td>
										</tr>
									</c:if>
									
							</table>
						</c:if>
						
						
					</td>
				</tr>
				<tr><td><br/></td></tr>
			</c:if>
		</c:if>
		

	</table>
	
	
	<br/><br/>
</span>
	
