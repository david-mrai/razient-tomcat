<span xmlns:ice="http://www.icesoft.com/icefaces/component" xmlns:h="http://java.sun.com/jsf/html" xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jstl/core" xmlns:ft="http://www.mcmsoftware.com">
	
	<param name="builtquestionsview" value="#{value}"/>
	
	<table class="tablebuiltquestions" width="100%" border="0">
		<tr>
			<td align="left" width="210" valign="top">
				<c:if test="${builtquestionsview.isQuestion != 'F'}">
					
					<c:if test="${builtquestionsview.isRateable != 'T'}">
						<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/icons/menu_up_rating_0.png"/>
						<h:outputLabel>
							<h:outputText styleClass="titlebuiltquestionsname" value="#{builtquestionsview.name}"></h:outputText>
						</h:outputLabel>
						<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/icons/menu_up_question.png"/>
					</c:if>
					<c:if test="${builtquestionsview.isRateable == 'T'}">
						<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/icons/menu_up_rating_#{builtquestionsview.icon}.png"/>
						<h:outputLabel>
							<h:outputText styleClass="titlebuiltquestionsname" value="#{builtquestionsview.name}"></h:outputText>
						</h:outputLabel>
						<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/icons/menu_up_question.png"/>
					</c:if>
				</c:if>
				<c:if test="${builtquestionsview.isQuestion == 'F'}">
					<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/icons/menu_up_point.png"/>
					<h:outputLabel>
						<h:outputText styleClass="titlebuiltquestionsname" style="font-size:14px;font-weight: bold;" value="#{builtquestionsview.name}"></h:outputText>
					</h:outputLabel>
				</c:if>
			</td>
			<td align="left">
				<c:if test="${builtquestionsview.isQuestion != 'F'}">
					<h:outputLabel>
						<h:outputText styleClass="titlebuiltquestionslabel" value="#{builtquestionsview.label}"></h:outputText>
					</h:outputLabel>
					<c:if test="${builtquestionsview.supportingInformation != null}">
						<c:if test="${builtquestionsview.supportingInformation != ''}">
							<br/><br/>
							<div style="float: left; margin-top: 0px; font-size:10px;color:#491011;">
								&lt;&lt; ${builtquestionsview.supportingInformation} &gt;&gt;
							</div>				
							<br/>
							<br/>
						</c:if>
					</c:if>
					
				</c:if>
				<c:if test="${builtquestionsview.isQuestion == 'F'}">
					<h:outputLabel>
						<h:outputText styleClass="titlebuiltquestionslabel"  style="font-size:14px;font-weight: bold;font-variant: small-caps;" value="#{builtquestionsview.label}"></h:outputText>
					</h:outputLabel>
				</c:if>
			</td>
		</tr>
		<c:if test="${builtquestionsview.isQuestion != null}">
			<c:if test="${builtquestionsview.isQuestion != 'F'}">
				<tr >
					<td align="left" width="210" valign="top">
					</td>
					<td align="left">
					
						<c:if test="${builtquestionsview.razientQuestionTypeIdrazientQuestionType == 2}">
								<ice:panelGroup styleClass="paneCheckQuestionBox">	
									<ice:inputText id="q_rb_#{builtquestionsview.id}" 
															   value="#{builtquestionsview.response}"
															   size="85"
									                           readonly="true"
									                           styleClass="fieldtextareacheck">
								    </ice:inputText>
								</ice:panelGroup>		
								<br/><br/><br/>
						</c:if>
						<c:if test="${builtquestionsview.razientQuestionTypeIdrazientQuestionType == 3}">
								<ice:panelGroup styleClass="paneCheckQuestionBox">	
									<ice:inputTextarea id="q_txt_#{builtquestionsview.id}"
															   cols="85" rows="5"
									                           maxlength="480"
									                           value="#{builtquestionsview.response}"
									                           readonly="true"
									                           styleClass="fieldtextareacheck">
								    </ice:inputTextarea>
								</ice:panelGroup>								
						</c:if>
						<c:if test="${builtquestionsview.razientQuestionTypeIdrazientQuestionType == 4}">
								
								<table>
									<tr>
										<td>
											<div style="float: left; margin-top: 2px; font-size:10px;color:#545138">#{bundle['rz_checksurvey.download']} :</div>
										</td>
										<td>
											<div style="float: left; margin-top: 2px; font-size:10px;">&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</div>
										</td>
										<td>
										</td>
									</tr>
									
									<tr>
										<td colspan="3"><br/>
													<ice:panelGroup styleClass="paneBuiltQuestionBox">
													<ice:dataTable resizable="false" border="1" id="tableticketsteps_#{builtquestionsview.id}"
															value="#{builtquestionsview.allCrudBeans}"
															var="fupBean"
															width="98%"
															style="float:center;font-color: #FFFFFF;"
															columnWidths="1%,70%,29%"
															columnClasses="columnCenter,columnLeft,columnLeft"
															rowClasses="rowOn,rowOff" cellpadding="0"
															>
			
															
															<ice:column> 
																	<ice:outputText value="">>></ice:outputText>
															</ice:column>
															<ice:column style="background-color:#F7F4F5;">
																<f:facet name="header">
																	<ice:outputText value="">#{bundle['rz_document']}&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</ice:outputText>
																</f:facet>
																<ice:outputText  id="fu_path_#{builtquestionsview.id}" value="#{fupBean.path}" />
															</ice:column>
															
															<ice:column style="background-color:#F7F4F5;">
																<f:facet name="header">
																			<ice:outputText value=""></ice:outputText>
																</f:facet>
																<ice:commandLink   action="#{builtQuestionsViewManager.selectedFileDocumentView}" 
																	actionListener="#{builtQuestionsViewManager.selectionListener}"
																	>													
																	<ice:graphicImage style="border:none;" styleClass="noborder" 
