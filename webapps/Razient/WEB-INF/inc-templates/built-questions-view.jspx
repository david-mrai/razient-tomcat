									                           styleClass="fieldtextareacheck">
								    </ice:inputTextarea>
								</ice:panelGroup>	
								<br/><br/><br/>
						</c:if>

						
						
						<c:if test="${builtquestionsview.razientQuestionTypeIdrazientQuestionType == 7}">
