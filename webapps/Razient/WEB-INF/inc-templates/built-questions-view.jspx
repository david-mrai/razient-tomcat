																		<f:attribute name="mimetype" value="#{fupBean.mimetype}" />
																		<f:attribute name="pathfolder" value="#{builtquestionsview.pathfolder}" />
																		<f:attribute name="pathname" value="#{fupBean.path}" />
																		<f:attribute name="imagetype" value="#{fupBean.imagetype}" />
																</ice:commandLink>
															</ice:column>
															
														</ice:dataTable>
														<ice:panelGroup styleClass="clearer" /><br/>
													</ice:panelGroup>
												</td>
									</tr>
									
								</table>

								<br/>				
						</c:if>
						<c:if test="${builtquestionsview.razientQuestionTypeIdrazientQuestionType == 5}">
								<ice:panelGroup styleClass="paneCheckQuestionBox">	
									<ice:inputTextarea id="q_cb_#{builtquestionsview.id}"
															   cols="85" rows="5"
									                           maxlength="480"
