						<!-- COMMENTS -->
						<c:if test="${builtquestionsview.isRequiredComment != 'F'}">
							<table>
									<c:if test="${builtquestionsview.isRequiredFollowup == 'F'}">
										<tr>
											<td>
													<div style="float: left; margin-top: 2px; font-size:10px;color:#545138">#{bundle['rz_buildsurvey.addinfo']} :</div>
											</td>
											<td>
													<ice:panelGroup styleClass="paneCheckAQuestionCommentBox">	
														<ice:inputTextarea id="q_comment_#{builtquestionsview.id}"
																   cols="86" rows="5"
										                           maxlength="480"
										                           value="#{builtquestionsview.comment}"
