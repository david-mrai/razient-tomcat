<span xmlns:ice="http://www.icesoft.com/icefaces/component" xmlns:h="http://java.sun.com/jsf/html" xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jstl/core" xmlns:ft="http://www.mcmsoftware.com">
	
	<param name="section" value="#{value}"/>
	
	<ice:panelCollapsible  actionListener="#{componentRzSurveyManager.actionlistenerSection}" id="c_#{section.id}">
		<f:facet name="header">
			<ice:outputText value="#{section.name} : #{section.title}"></ice:outputText>
		</f:facet>
		
		<ice:outputText value="#{section.description}"></ice:outputText>
		
		<ice:panelGroup styleClass="pnlClpsblWrapper panelSurveyCollapsible">
			<div >
			
				<c:if test="${section.count_questions != '0'}">
					<table class="tableformsbuildsurvey" width="95%" style="margin-top: 0px;" cellspacing="0" cellpadding="0">

							<tr class="trHeaderSurvey">
												<td>&amp;nbsp</td>
												<td width="100px" align="center">
													<h:outputLabel style="font-size:11px;">
														<h:outputText value="#{bundle['rz_admin_surveymanager.questions.name']}"></h:outputText>
													</h:outputLabel>&amp;nbsp&amp;nbsp
												</td>
												<td style="border-left: white 1px solid;">&amp;nbsp</td>
												<td align="center">
													&amp;nbsp&amp;nbsp<h:outputLabel style="font-size:11px;">
														<h:outputText value="#{bundle['rz_admin_surveymanager.questions.information']}"></h:outputText>
													</h:outputLabel>&amp;nbsp&amp;nbsp
												</td>
												<td style="border-left: white 1px solid;">&amp;nbsp</td>
												<td width="100px" align="center">
													&amp;nbsp&amp;nbsp<h:outputLabel style="font-size:11px;">
														<h:outputText style="align:center;"
															value="#{bundle['rz_admin_surveymanager.questions.type']}"></h:outputText>
													</h:outputLabel>&amp;nbsp&amp;nbsp
												</td>
												<td style="border-right: white 1px solid;">&amp;nbsp</td>
												<td width="100px" align="center">
													&amp;nbsp&amp;nbsp<h:outputLabel style="font-size:11px;">
														<h:outputText
															value="#{bundle['rz_admin_surveymanager.questions.answerLabels']}"></h:outputText>
													</h:outputLabel>
												</td>
												<td>&amp;nbsp</td>
							</tr>
							
							
							 <c:forEach var="question" items="#{section.list_questions}" varStatus="rowCounter">
							 		
							 	 
		             			 	<ft:question value="#{question}"/>
		             			 
		         			 </c:forEach>

	         		</table>
	         	 </c:if>
			</div> 
		</ice:panelGroup>
		
	</ice:panelCollapsible>

</span>
	
