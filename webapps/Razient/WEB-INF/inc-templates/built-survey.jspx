<span xmlns:ice="http://www.icesoft.com/icefaces/component" xmlns:h="http://java.sun.com/jsf/html" xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jstl/core" xmlns:ft="http://www.mcmsoftware.com">
	
	<param name="builtsurvey" value="#{value}"/>

	<table class="tablebuiltsurvey" width="100%" border="0">
		<tr>
			<td align="right" colspan="2"><h:outputLabel>
					<h:outputText styleClass="titlebuiltsurveys" value="#{builtsurvey.name}"></h:outputText>
				</h:outputLabel>
			</td>
		</tr>
		<c:if test="${builtsurvey.title != null}">
			<c:if test="${builtsurvey.title != ''}">
				<tr >
					<td align="right" colspan="2"><h:outputLabel>
							<h:outputText styleClass="titlebuiltsurveystitle" value="#{builtsurvey.title}"></h:outputText>
						</h:outputLabel>
					</td>
				</tr>
			</c:if>
		</c:if>
		<tr>
			<td width="40%"></td>
			<td width="60%" align="justify" ><h:outputLabel>
					<h:outputText styleClass="titlebuiltsurveysdescription" value="#{builtsurvey.description}"></h:outputText>
				</h:outputLabel>
			</td>
		</tr>
		<tr>
			<td  align="right" colspan="2">
				<ice:graphicImage url		="./css/images/icons/menu_survey_line.png" width="800px" height="4px"/>
			</td>
		</tr>
	</table>
	<br/><br/>
	
		<ice:panelGroup >
				<div xmlns:ft="http://www.mcmsoftware.com">
						<c:forEach var="builtsection" items="#{builtSectionManager.list_sections}">
				             		<ft:builtsection value="#{builtsection}"/>
				         </c:forEach>
				</div> 
		</ice:panelGroup>	
	
	<br/><br/>
	<table class="tablebuiltsurvey" width="100%" border="0">
		<tr>
			<td  align="left" colspan="2" >
				<ice:graphicImage url		="./css/images/icons/menu_survey_line.png" width="800px" height="4px"/>
			</td>
		</tr>
	</table>
</span>
	
