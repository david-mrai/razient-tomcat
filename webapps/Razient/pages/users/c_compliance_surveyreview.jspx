																					value="#{c_ReviewSuppliersSurveysGridBean.itemSelected}" multiple="false"
																					 />               
																                   	<ice:graphicImage visible="true" style="border:none;"
																						styleClass="noborder" height="25"
																						url="./css/images/#{folderBean.folder_menu}/icons/menu_up_checkratings_#{adminReviewSvSpBean.iconRating}.png"/>	
																			</ice:column>
																			<ice:column  style="background-color:#F7EAEA;">
																				<f:facet name="header" >
																					<ice:commandLink action="#{c_ReviewSuppliersSurveysGridBean.selectedSurveysAction}"  onclick="rld();">
																						<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																								url="./css/images/#{folderBean.folder_menu}/icons/menu_up_checkboxselected.png"
																								onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_checkboxselected.png'"
																								onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_checkboxselected.png'"
																						/>
																					</ice:commandLink>
																				</f:facet>
																				<ice:selectBooleanCheckbox value="#{adminReviewSvSpBean.isClosed}" partialSubmit="true" immediate="true" />	
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:commandSortHeader id="namesortsvsp" columnName="name">
																						<ice:outputText value="#{bundle['c_compliance_surveyview.survey.name']}"></ice:outputText>
																					</ice:commandSortHeader>
																				</f:facet>
																				<ice:outputText id="idnamesvsp"
																					value="#{adminReviewSvSpBean.name}" />
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:commandSortHeader id="creationdatesortsvsp" columnName="creationDate">
																						<ice:outputText value="#{bundle['c_compliance_surveyview.creationdate']}"></ice:outputText>
																					</ice:commandSortHeader>
																				</f:facet>
																				<ice:outputText id="creationdatesvsp"
																					value="#{adminReviewSvSpBean.creationDate}" />
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:commandSortHeader id="distributiondatesortsvsp" columnName="distributionDate">
																						<ice:outputText value="#{bundle['c_compliance_surveyview.distributiondate']}"></ice:outputText>
																					</ice:commandSortHeader>
																				</f:facet>
																				<ice:outputText id="distributiondatesvsp"
																					value="#{adminReviewSvSpBean.distributionDate}" />
																			</ice:column>
																			
																			<ice:column>
																				<f:facet name="header">
																					<ice:commandSortHeader id="closedatesortsvsp" columnName="closeDate">
																						<ice:outputText value="#{bundle['c_compliance_surveyreview.expirationdate']}"></ice:outputText>
																					</ice:commandSortHeader>
																				</f:facet>
																				<ice:outputText id="closedatesvsp"
																					value="#{adminReviewSvSpBean.closeDate}" />
																			</ice:column>
																			<ice:column style="background-color:#5A7985;">	
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_compliance_surveyview.nroquestions']}"></ice:outputText>
																				</f:facet>
																				<ice:outputText style="text-align:center;font-weight:bold;" id="numberofquestions"
																					value="#{adminReviewSvSpBean.nroQuestions}" />
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_compliance_surveyview.nroanswered']}"></ice:outputText>
																				</f:facet>
																				<ice:outputText style="text-align:center;font-weight:bold;" id="numberofquestions"
																					value="#{adminReviewSvSpBean.nroComplete}" />
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_compliance_surveyview.nrounanswered']}"></ice:outputText>
																				</f:facet>
																				<ice:outputText style="text-align:center;font-weight:bold;" id="numberofquestions"
																					value="#{adminReviewSvSpBean.nroIncomplete}" />
																			</ice:column>
																			<ice:column style="background-color:white;">
																				<f:facet name="header" >
																				</f:facet>
																				<ice:commandLink action="#{c_ReviewSuppliersSurveysGridBean.toCheckSurveyAction}" actionListener="#{c_ReviewSuppliersSurveysGridBean.selectionListener}" onclick="window.location.reload();">
																					<ice:graphicImage style="border:none;" styleClass="noborder"
																						url="./css/images/#{folderBean.folder_menu}/icons/menu_down_review.png"
																						onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_review.png'"
																						onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_review.png'"
																					
																					/>
																					<f:attribute name="idSelected" value="#{adminReviewSvSpBean.idcustomerSurveys}" />																						
																				</ice:commandLink>
																			</ice:column>
																		</ice:dataTable>
																		<ice:panelGroup styleClass="clearer" />
							
							
																		<!-- PAGINATOR-->
																		<ice:panelGroup style="float:left;width:420px;">
																			<center>
																				<ice:dataPaginator id="dataScroll_sv2"
																					rendered="#{c_ReviewSuppliersSurveysGridBean.selectedDataScrollModes[c_ReviewSuppliersSurveysGridBean.selectedDataScrollMode].pagingEnabled}"
																					for="tablereviewsvspgrid" vertical="false" fastStep="3" paginator="true"
																					paginatorMaxPages="10">
																					<f:facet name="first">
																						<ice:graphicImage id="firstpage_sv2"
																							url="./css/rime/css-images/arrow-first.gif"
																							style="border:none;" title="first" />
																					</f:facet>
																					<f:facet name="last">
																						<ice:graphicImage id="lastpage_sv2"
																							url="./css/rime/css-images/arrow-last.gif"
																							style="border:none;" title="last" />
																					</f:facet>
																					<f:facet name="previous">
																						<ice:graphicImage id="previouspage_sv2"
																							url="./css/rime/css-images/arrow-previous.gif"
																							style="border:none;" title="previous" />
																					</f:facet>
																					<f:facet name="next">
																						<ice:graphicImage id="nextpage_sv2"
																							url="./css/rime/css-images/arrow-next.gif"
																							style="border:none;" title="next" />
																					</f:facet>
																					<f:facet name="fastforward">
																						<ice:graphicImage id="fastforward_sv2"
																							url="./css/rime/css-images/arrow-ff.gif"
																							style="border:none;" title="ff" />
																					</f:facet>
																					<f:facet name="fastrewind">
																						<ice:graphicImage id="fastrewind_sv2"
																							url="./css/rime/css-images/arrow-fr.gif"
																							style="border:none;" title="fr" />
																					</f:facet>
																				</ice:dataPaginator>
																			</center>
																		</ice:panelGroup>
							
																	</ice:panelGroup>
							
																</ice:panelGroup>
							
															<br/><br/><br/>	
														<ice:commandLink action="#{c_ReviewSuppliersSurveysGridBean.closeSurveysAction}" panelConfirmation="confirmclosesurveysupp" onclick="rld();">
																			<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																					url="./css/images/#{folderBean.folder_menu}/icons/menu_up_closesurveysselected.png"
																					onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_closesurveysselected.png'"
																					onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_closesurveysselected.png'"
																			/>
														</ice:commandLink>
													</ice:panelGroup>
												     
													<ice:panelConfirmation id="confirmclosesurveysupp"   styleClass="cnfSurvey" 
															  acceptLabel="#{bundle['ice_confirmation.ok']}"  
															  cancelLabel="#{bundle['ice_confirmation.cancel']}"  
															  message="#{bundle['ice_confirmation.closesurveys.message']}"  
															  title="#{bundle['ice_confirmation.closesurveys.title']}"  
															  draggable="false"  
													 />
														
													</ice:panelTab>
													
													
												</ice:panelTabSet>
											</ice:panelGroup>
										</div>
												
									</ice:panelTab>
									
								</ice:panelTabSet>
							</ice:panelGroup>
							
							
							
						</ice:form>
	
				</ui:define>
				

			</ui:composition>

	

       </body>
    </html>
   </f:view>
</jsp:root>
