			    <ui:define name="hide-show-value">
						<ice:form>
					    	<div style="margin-top:3px;float: left;position: absolute;">
						    	<ice:commandLink action="#{showhideBean.action_showhide}" onclick="rld();">
									<ice:graphicImage style="border:none;" 
										styleClass="noborder" url="./css/images/icons/menu_#{showhideBean.url_icon}.png"/>
								</ice:commandLink>
							</div>
						</ice:form>
				</ui:define>
			    <ui:define name="page-menu-value">
			    	 <ice:form>
			    	 
					 <ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
					 	<ice:graphicImage visible="true"  styleClass="menuPosA"
								url="./css/images/#{folderBean.folder_menu}/risk_menu_up_surveymanager.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_surveymanager.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_surveymanager.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_surveymanager.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_surveymanager.png'" />
									<f:attribute name="optioonselected" value="cp_sm"/>
					</ice:commandLink>
					<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
					 	<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_surveydistribution.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_surveydistribution.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_surveydistribution.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_surveydistribution.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_surveydistribution.png'" />
						<f:attribute name="optioonselected" value="cp_sd"/>
					</ice:commandLink>
					<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
						<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_surveyview.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_surveyview.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_surveyview.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_surveyview.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_surveyview.png'" />  	
					    <f:attribute name="optioonselected" value="cp_sv"/>
					</ice:commandLink>
						
					<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_down_surveyreview.png"/>		
					  	
					 <ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_one.png"/>
									
					 </ice:form> 	
			    </ui:define>
			    
				<ui:define name="page-content-value">
					
						
					<ice:form>
							
					
							<ice:panelGroup id="tabSetTab"	styleClass="tabPanelBox panelTabSetSaleContainer">

								<ice:panelTabSet tabChangeListener="#{c_TabReviewSurveysBean.processTabChange}" selectedIndex="#{c_TabReviewSurveysBean.ITab}">

									<ice:panelTab label="#{bundle['c_compliance_surveyreview.tab1']}">
									
										<div style="height:#{utilServiceLocatorBean.heightPanel}px;">
										
										 <ice:panelGroup id="subTabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer" >
							
											<ice:panelTabSet tabChangeListener="#{c_TabReviewSurveysTabCpBean.processTabChange}" selectedIndex="#{c_TabReviewSurveysTabCpBean.ITab}">
											   

												<ice:panelTab   label="#{bundle['c_compliance_surveyreview.tab11']}">
													<br/>
													<table cellspacing="0" cellpadding="0" style="margin-top: -7px;" width="100%">
																<tr class="menubuttons">
																	<td align="left">
																		&amp;nbsp&amp;nbsp
																		<ice:commandLink action="#{c_ReviewSurveysGridBean.find_All_Action}"  onclick="rld();">
																			<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																					url="./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconAllA}_taballsurveys.png"
																					onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconAllA}_taballsurveys.png'"
																					onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconAllB}_taballsurveys.png'"
																			/>
																		</ice:commandLink>
																	</td>	
																	<td>
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																	</td>
																	
															</tr>
															<tr>
																<td colspan="4" class="menuline">
																</td>
															</tr>
														</table>
													
													<ice:panelGroup styleClass="customerProfileBox"
														style="width:97%;overflow:auto;">
						
															<ice:panelGroup>
																<ice:panelGroup>
																	<ice:dataTable resizable="false" border="1" id="tablereviewgrid"
																		value="#{c_ReviewSurveysGridBean.allCrudBeans}"
																		var="adminReviewBean"
																		width="99%"
																		rows="#{c_ReviewSurveysGridBean.selectedDataScrollModes[c_ReviewSurveysGridBean.selectedDataScrollMode].rows}"
																		scrollable="#{c_ReviewSurveysGridBean.selectedDataScrollModes[c_ReviewSurveysGridBean.selectedDataScrollMode].scrollingEnabled}"
																		scrollHeight="200px"
																		style="float:center;font-color: #FFFFFF;"
																		columnWidths="1%,25%,16%,16%,16%,10px,1%,10%,5%"
																		columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter,columnCenter,columnCenter,columnCenter"
																		rowClasses="rowOn,rowOff" cellpadding="0"
																		sortColumn="#{c_ReviewSurveysGridBean.columnNameOrder}"
																		sortAscending="#{c_ReviewSurveysGridBean.descending}"
																		onclick="window.location.reload()">
						
																		<ice:column style="background-color:white;">
																			<ice:rowSelector id="selected"
																				value="#{c_ReviewSurveysGridBean.itemSelected}" multiple="false"
																				selectionListener="#{c_ReviewSurveysGridBean.rowSelectionListener}"
																				selectionAction="#{c_ReviewSurveysGridBean.rowSelectionAction}" />               
															                    <ice:graphicImage visible="true" style="border:none;"
																						styleClass="noborder" height="25"
																						url="./css/images/#{folderBean.folder_menu}/icons/menu_up_#{adminReviewBean.iconSurvey}surveys.png"/>	
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="namesort" columnName="name">
																					<ice:outputText value="#{bundle['c_compliance_surveyview.survey.name']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="idname"
																				value="#{adminReviewBean.name}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="creationdatesort" columnName="creationDate">
																					<ice:outputText value="#{bundle['c_compliance_surveyview.creationdate']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="creationdate"
																				value="#{adminReviewBean.creationDate}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="distributiondatesort" columnName="distributionDate">
																					<ice:outputText value="#{bundle['c_compliance_surveyview.distributiondate']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="distributiondate"
																				value="#{adminReviewBean.distributionDate}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="closedatesort" columnName="closeDate">
																					<ice:outputText value="#{bundle['c_compliance_surveyreview.expirationdate']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="closedate"
																				value="#{adminReviewBean.closeDate}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:outputText
																					value="#{bundle['c_compliance_surveyview.nroquestions']}"></ice:outputText>
																			</f:facet>
																			<ice:outputText style="text-align:center;font-weight:bold;" id="numberofquestions"
																				value="#{adminReviewBean.nroQuestions}" />
																		</ice:column>
																		<ice:column style="background-color:#5A7985;">	
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:outputText
																					value="##{entityTypeBundle.entity_ofs}"></ice:outputText>
																			</f:facet>
																			<ice:outputText style="text-align:center;font-weight:bold;" id="numberofquestions"
																				value="#{adminReviewBean.nroSuppliers}" />
																		</ice:column>	
																		<ice:column style="background-color:white;">
																			<f:facet name="header" >
																			</f:facet>
																			<ice:graphicImage style="border:none;" styleClass="noborder"
																				url="./css/images/#{folderBean.folder_menu}/icons/menu_down_#{entityTypeBundle.type_Customer}s.png"
																				onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_#{entityTypeBundle.type_Customer}s.png'"
																				onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_#{entityTypeBundle.type_Customer}s.png'"
																			
																			/>
																		</ice:column>
																	</ice:dataTable>
																	<ice:panelGroup styleClass="clearer" />
						
						
																	<!-- PAGINATOR-->
																	<ice:panelGroup style="float:left;width:420px;">
																		<center>
																			<ice:dataPaginator id="dataScroll_sv1"
																				rendered="#{c_ReviewSurveysGridBean.selectedDataScrollModes[c_ReviewSurveysGridBean.selectedDataScrollMode].pagingEnabled}"
																				for="tablereviewgrid" vertical="false" fastStep="3" paginator="true"
																				paginatorMaxPages="10">
																				<f:facet name="first">
																					<ice:graphicImage id="firstpage_sv1"
																						url="./css/rime/css-images/arrow-first.gif"
																						style="border:none;" title="first" />
																				</f:facet>
																				<f:facet name="last">
																					<ice:graphicImage id="lastpage_sv1"
																						url="./css/rime/css-images/arrow-last.gif"
																						style="border:none;" title="last" />
																				</f:facet>
																				<f:facet name="previous">
																					<ice:graphicImage id="previouspage_sv1"
																						url="./css/rime/css-images/arrow-previous.gif"
																						style="border:none;" title="previous" />
																				</f:facet>
																				<f:facet name="next">
																					<ice:graphicImage id="nextpage_sv1"
																						url="./css/rime/css-images/arrow-next.gif"
																						style="border:none;" title="next" />
																				</f:facet>
