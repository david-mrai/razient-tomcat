									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_dataupload.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_dataupload.png'" />
								<f:attribute name="optioonselected" value="ad_du" />
							</ice:commandLink>
							-->
						</ice:form>
					</ui:define>

					<ui:define name="page-content-value">
						<h:form>
						
						<table cellspacing="0" cellpadding="0" style="margin-top: -7px;" width="100%" >
								<tr  class="menubuttons">
									<td align="left">
										&amp;nbsp&amp;nbsp
										<ice:commandLink action="#{rz_EmployeeCrudBean.editableAction}"  onclick="rld();" visible="#{rz_EmployeeCrudBean.bTypeQuery}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_editable.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_editable.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_editable.png'"
												
												/>
										</ice:commandLink>
										&amp;nbsp&amp;nbsp
										<ice:commandLink action="#{rz_EmployeeCrudBean.addAction}"  onclick="rld();" visible="#{rz_EmployeeCrudBean.bTypeCreate}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_save.png'"
												
												/>
										</ice:commandLink>
										<ice:commandLink action="#{rz_EmployeeCrudBean.updateAction}"  onclick="rld();" visible="#{rz_EmployeeCrudBean.bTypeEdit}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_save.png'"
												
												/>
										</ice:commandLink>
										<!--&amp;nbsp&amp;nbsp
										<ice:commandLink action="#{rz_EmployeeCrudBean.clearFormAction}"  onclick="rld();" visible="#{rz_EmployeeCrudBean.bTypeEdit}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_delete.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_delete.png'"
