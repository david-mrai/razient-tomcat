							</tr>
							<tr>
								<td colspan="3" class="menuline"></td>
							</tr>
						</table>
						</h:form>
						<h:form>
							
							<ice:panelGroup id="tabSetTabCustomerProfile" styleClass="tabPanelBox panelTabSetSaleContainer">

								<ice:panelTabSet>

								<ice:panelTab label="#{bundle['rz_admin_customerprofile_employee.title']}">
									<div style="height:100%;">
										<br/>
										<ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;">
											<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
												<tr>
													<td width="20%"  class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['rz_admin_customerprofile.employee.site']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{rz_EmployeeCrudBean.stEdit_Global}" width="30%">
														<ice:selectOneMenu id="selectedSite" visible="#{not rz_EmployeeCrudBean.bEdit_Site}"
																value="#{rz_EmployeeCrudBean.idSiteCustomer}"
																styleClass="selectedOneMenukeyBold"
																valueChangeListener="#{rz_EmployeeCrudBean.processValueChange}"
																partialSubmit="true">
																<f:selectItems value="#{rz_EmployeeCrudBean.list_Site}" />
														</ice:selectOneMenu>
														<ice:inputText id="nameSite" size="30" maxlength="30" visible="#{rz_EmployeeCrudBean.bEdit_Site}"
																value="#{rz_EmployeeCrudBean.nameSite}" partialSubmit="true"
																readonly="true" styleClass="tablefieldedit_disabled">
														</ice:inputText>
													 </td>
												</tr>
			
											</table>
											
										</ice:panelGroup>
										
										<br/><br/>
										<ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;">
											<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
												<tr>
													<td  width="20%" class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['rz_admin_customerprofile.employee.email']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td colspan="3" align="left" class="tablelabelfieldedit_enabled" width="30%">
														<ice:inputText id="email" size="80" maxlength="80" style="font-weight: bold;"
																value="#{rz_EmployeeCrudBean.email}" partialSubmit="true"
																readonly="#{rz_EmployeeCrudBean.bEdit_Email}" styleClass="tablefieldedit_createnotedit_#{rz_EmployeeCrudBean.stEdit_Email}">
														</ice:inputText>
													 </td>
												</tr>
												<tr><td colspan="4" class="menusep_#{rz_EmployeeCrudBean.stEdit_Global}"></td></tr>
												<tr>
													<td width="20%"  class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['rz_admin_customerprofile.employee.firstname']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{rz_EmployeeCrudBean.stEdit_Global}" width="30%">
														<ice:inputText id="firtsname" size="30" maxlength="30"
																value="#{rz_EmployeeCrudBean.firstName}" partialSubmit="true"
																readonly="#{rz_EmployeeCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{rz_EmployeeCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
													 <td  width="20%" class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['rz_admin_customerprofile.employee.lastname']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{rz_EmployeeCrudBean.stEdit_Global}" width="30%">
														<ice:inputText id="lastname" size="30" maxlength="30"
																value="#{rz_EmployeeCrudBean.lastName}" partialSubmit="true"
																readonly="#{rz_EmployeeCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{rz_EmployeeCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
												</tr>
												<tr><td colspan="4" class="menusep_#{rz_EmployeeCrudBean.stEdit_Global}"></td></tr>
												<tr>
													<td width="20%"  class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['rz_admin_customerprofile.employee.phone']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{rz_EmployeeCrudBean.stEdit_Global}" width="30%">
														<ice:inputText id="phone" size="30" maxlength="30"
																value="#{rz_EmployeeCrudBean.phone}" partialSubmit="true"
																readonly="#{rz_EmployeeCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{rz_EmployeeCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
													<td width="20%"  class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['rz_admin_customerprofile.employee.mobile']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{rz_EmployeeCrudBean.stEdit_Global}" width="30%">
														<ice:inputText id="mobile" size="30" maxlength="30"
																value="#{rz_EmployeeCrudBean.mobile}" partialSubmit="true"
																readonly="#{rz_EmployeeCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{rz_EmployeeCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
												</tr>
												<tr><td colspan="4" class="menusep_#{rz_EmployeeCrudBean.stEdit_Global}"></td></tr>
												<tr>
													<td  width="20%" class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['rz_admin_customerprofile.employee.fax']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{rz_EmployeeCrudBean.stEdit_Global}" width="30%">
														<ice:inputText id="fax" size="30" maxlength="30"
																value="#{rz_EmployeeCrudBean.fax}" partialSubmit="true"
																readonly="#{rz_EmployeeCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{rz_EmployeeCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
													<td width="20%"  class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['rz_admin_customerprofile.employee.department']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{rz_EmployeeCrudBean.stEdit_Global}" width="30%">
														<ice:inputText id="department" size="30" maxlength="30"
																value="#{rz_EmployeeCrudBean.department}" partialSubmit="true"
																readonly="#{rz_EmployeeCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{rz_EmployeeCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
												</tr>
												<tr>
													<td width="20%"  class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['rz_admin_customerprofile.employee.title']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{rz_EmployeeCrudBean.stEdit_Global}" width="30%">
														<ice:inputText id="title" size="30" maxlength="30"
																value="#{rz_EmployeeCrudBean.title}" partialSubmit="true"
																readonly="#{rz_EmployeeCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{rz_EmployeeCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
													<td  width="20%" class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['rz_admin_customerprofile.employee.prioritylevel']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{rz_EmployeeCrudBean.stEdit_Global}" width="30%">
														<ice:selectOneMenu id="selectedprioritylevel" visible="#{not rz_EmployeeCrudBean.bEdit_Global}"
																value="#{rz_EmployeeCrudBean.prioritylevel}"
																styleClass="selectedOneMenukeyBold"
																valueChangeListener="#{rz_EmployeeCrudBean.processValueChange}"
																partialSubmit="true">
																<f:selectItems value="#{rz_EmployeeCrudBean.list_PriorityLevel}" />
														</ice:selectOneMenu>
														<ice:inputText id="prioritylevelDesc" size="30" maxlength="30" visible="#{rz_EmployeeCrudBean.bEdit_Global}"
																value="#{rz_EmployeeCrudBean.prioritylevelDesc}" partialSubmit="true"
																readonly="#{rz_EmployeeCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{rz_EmployeeCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
												</tr>
												<tr><td colspan="4" class="menusep_#{rz_EmployeeCrudBean.stEdit_Global}"></td></tr>
												<tr>
													<td width="20%"  class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
													</td>
													<td align="left" class="tablelabelfieldedit_#{rz_EmployeeCrudBean.stEdit_Global}" width="30%">
													 </td>
													<td  width="20%" class="tablelabeledit_#{rz_EmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
