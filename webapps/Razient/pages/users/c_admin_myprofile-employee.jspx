														<ice:selectOneMenu id="selectedStatus" visible="#{not rz_EmployeeCrudBean.bEdit_Global}"
																value="#{rz_EmployeeCrudBean.status}"
																styleClass="selectedOneMenukeyBold"
																valueChangeListener="#{rz_EmployeeCrudBean.processValueChange}"
																partialSubmit="true">
																<f:selectItems value="#{rz_EmployeeCrudBean.list_Status}" />
														</ice:selectOneMenu>
														<ice:inputText id="statusDesc" size="30" maxlength="30" visible="#{rz_EmployeeCrudBean.bEdit_Global}"
																value="#{rz_EmployeeCrudBean.statusDesc}" partialSubmit="true"
																readonly="#{rz_EmployeeCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{rz_EmployeeCrudBean.stEdit_Global}">
