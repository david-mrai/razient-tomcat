<?xml version="1.0" encoding="utf-8" ?>
<jsp:root version="1.2"
   xmlns:jsp="http://java.sun.com/JSP/Page"
   xmlns:f="http://java.sun.com/jsf/core"
   xmlns:h="http://java.sun.com/jsf/html"
   xmlns:ice="http://www.icesoft.com/icefaces/component">
   <jsp:directive.page contentType="text/html;charset=ISO-8859-1" pageEncoding="ISO-8859-1" />
   <f:view>
   		<ice:outputDeclaration 
            doctypeRoot="html" 
            doctypePublic="-//W3C//DTD HTML 4.01 Transitional//EN" 
            doctypeSystem="http://www.w3.org/TR/html4/loose.dtd" /> 
    <html>
       <head>
         <title>Index (Razient)</title>
       </head>
       <body>
       
        	<!-- template="#{templateBean.templateContent}"-->
			<ui:composition
			        template="../../include/templates/pages/modeB_supplier.jspx"
			        xmlns:h="http://java.sun.com/jsf/html"
			        xmlns:f="http://java.sun.com/jsf/core"
			        xmlns:c="http://java.sun.com/jstl/core"
			        xmlns:ice="http://www.icesoft.com/icefaces/component"
			        xmlns:ui="http://java.sun.com/jsf/facelets" >
			
			  <!-- params for page titles-->
			 		 <!--<f:loadBundle basename="truckandi.view.bundle.Message" var="bundle"/>
			        <ui:param name="pageTitle" value="#{bundle['tai_login.title']}" />-->
					<ui:param name="pageTitle" value="#{bundle['s_survey_survey.survey']}" />
				
				<ui:define name="header_menu_value">
						<table cellspacing="0" cellpadding="0">
										<tr>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">		
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_dash_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_2.png'" />
														<f:attribute name="optioonselected" value="dh"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/#{folderBean.folder_menu}/risk_survey_2.png" visible="#{users_MenuBarBean.visible_S_Survey}"/>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_GlobalIncidents}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_global_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_2.png'" />
													<f:attribute name="optioonselected" value="gi_al"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<!--<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_RequestForProposal}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_request_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_2.png'" />
														<f:attribute name="optioonselected" value="rp_op"/>
												</ice:commandLink>
												<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_request_3.png" />
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											-->
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_Reports}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_rep_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_2.png'" />
													<f:attribute name="optioonselected" value="rp_sv"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_Administration}">																								
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_2.png'" />
														<f:attribute name="optioonselected" value="ad_um"/>
												</ice:commandLink>
											</td>
										</tr>
									</table>			
				</ui:define>
			    <ui:define name="hide-show-value">
						<ice:form>
					    	<div style="margin-top:3px;float: left;position: absolute;">
						    	<ice:commandLink action="#{showhideBean.action_showhide}" onclick="rld();">
									<ice:graphicImage style="border:none;" 
										styleClass="noborder" url="./css/images/icons/menu_#{showhideBean.url_icon}.png"/>
								</ice:commandLink>
							</div>
						</ice:form>
				</ui:define>
			    <ui:define name="page-menu-value">
			    	 <ice:form>
					 
					 <ice:graphicImage visible="true"  styleClass="menuPosA"
								url="./css/images/#{folderBean.folder_menu}/risk_menu_down_survey.png" />
					 <!--<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
					 	<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_surveymanager.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_surveymanager.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_surveymanager.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_surveymanager.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_surveymanager.png'" />
						<f:attribute name="optioonselected" value="sv_sm"/>
					</ice:commandLink>-->
					 <ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_one.png"/>
					 </ice:form> 	
			    </ui:define>
			    
				<ui:define name="page-content-value">
					
					    <ice:form>    
							<ice:panelGrid>
												<div class="paneTableBox"  style="height:#{utilServiceLocatorBean.heightAllTable}px;margin-top:1px;overflow:auto;width:#{utilServiceLocatorBean.widthAllTable}px;">
												
												<table class="tableformstot" style="margin-top:0px;" >
														<tr>
															<td>
																<table class="tableformscell" cellspacing="0" cellpadding="0">
																	<tr>
																		<td >
																			&amp;nbsp&amp;nbsp
																		</td>
																		<td>
																			<ice:commandLink action="#{s_SV_SV_ListTableBean.findAllSurveys}" onclick="rld();">
																				<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																					url="./css/images/#{folderBean.folder_menu}/icons/menu_up_all.png"
																					onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_all.png'"
																					onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_all.png'" />
																			</ice:commandLink>
																		</td>
																		<td>
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		</td>
																		<td >
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		</td>
																		<td>
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		</td>
																		<td>
																			&amp;nbsp&amp;nbsp
																		</td>
																		<td>
																			&amp;nbsp&amp;nbsp
																		</td>
																	</tr>
																</table>
															</td>
														</tr>
													</table> 
													
												<table width="97%" style="margin-left:10px;margin-top:3px;border:1px solid #C3DFF4;" cellspacing="0" cellpadding="0" border="0">
													<tr class="trHeader"><td colspan="4" align="center">#{bundle['s_survey_survey.title']}</td></tr>
													<tr >
														<td valign="top" class="tdcolumninfo">
														</td>
														<td>&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</td>
														<td>
															<ice:panelGroup>
															<ice:panelGroup>
																
																<ice:dataTable resizable="false" border="1" id="stable" value="#{s_SV_SV_ListTableBean.SSurveysBean}" var="surveyBean"  
																			width="98%" onclick="window.location.reload();"
																			rows="#{s_SV_SV_ListTableBean.selectedDataScrollModes[s_SV_SV_ListTableBean.selectedDataScrollMode].rows}"
															               	scrollable="#{s_SV_SV_ListTableBean.selectedDataScrollModes[s_SV_SV_ListTableBean.selectedDataScrollMode].scrollingEnabled}"
															               	scrollHeight="200px"
															               	style="float:center;font-color: #FFFFFF;margin-top:2px;"
															               	columnWidths="1%,18%,18%,12%,12%,12%,9%,9%,9%"
															               	columnClasses="columnCenter,columnLeft,columnLeft,columnCenter,columnCenter,columnCenter,columnCenter,columnCenter,columnCenter"
															                rowClasses="rowOn,rowOff"
															               	cellpadding="0"
																			sortColumn="#{s_SV_SV_ListTableBean.columnNameOrder}" sortAscending="#{s_SV_SV_ListTableBean.descending}">
																	
																	<ice:column style="background-color:white;">
																		<ice:rowSelector id="selected"
										                                 value="#{s_SV_SV_ListTableBean.itemSelected}"
										                                 multiple="false"         
										                                 selectionListener="#{s_SV_SV_ListTableBean.rowSelectionListener}"
										                                 selectionAction="#{s_SV_SV_ListTableBean.rowSelectionAction}"/> 
										                                <f:facet name="header">
																			<ice:commandSortHeader id="statussort" columnName="status">
																				<ice:outputText value="#{bundle['s_survey_survey.status']}" ></ice:outputText>
																			</ice:commandSortHeader>
																		</f:facet>
																		<ice:graphicImage style="border:none;" styleClass="noborder" 
																		 		url="./css/images/#{folderBean.folder_menu}/icons/menu_up_surveystatus#{surveyBean.status}.png"
																		 		/>	           
										                             
																	</ice:column>
																		<ice:column style="background-color:white;">
																		<f:facet name="header">
																			<ice:outputText  value="#{bundle['s_survey_survey.name']}"></ice:outputText>
																		</f:facet>
																		<ice:outputText id="idname" value="#{surveyBean.name}"/>
																	</ice:column>
																	<ice:column style="background-color:white;">
																		<f:facet name="header">
																			<ice:outputText value="#{bundle['s_survey_survey.description']}"></ice:outputText>
																		</f:facet>
																		
																		<ice:inputTextarea id="iddescriptions"
																		   cols="40" rows="2" maxlength="450"
												                           value="#{surveyBean.description}"
												                           readonly="false" styleClass="fieldtextareahighreadonly">
												                         </ice:inputTextarea>
																	</ice:column>
																	<ice:column>
																		<f:facet name="header">
																			<ice:outputText value="#{bundle['s_survey_survey.dateasign']}"></ice:outputText>
																		</f:facet>
																		<ice:outputText id="iddateassing" value="#{surveyBean.dateAsign}"/>
																	</ice:column>
																	<ice:column>
																		<f:facet name="header">
																			<ice:outputText value="#{bundle['s_survey_survey.datestarted']}"></ice:outputText>
																		</f:facet>
																		<ice:outputText id="iddatestart" value="#{surveyBean.dateStarted}"/>
																	</ice:column>
																	<ice:column>
																		<f:facet name="header">
																			<ice:outputText value="#{bundle['s_survey_survey.expirationdate']}"></ice:outputText>
																		</f:facet>
																		<ice:outputText id="iddateclose" value="#{surveyBean.dateClosed}"/>
																	</ice:column>
																	<ice:column>
																		<f:facet name="header">
																			<ice:outputText value="#{bundle['s_survey_survey.numberofquestion']}"></ice:outputText>
																		</f:facet>
																		<ice:outputText id="idnoquestion" style = "color:#1A2055;font-weight:bold" value="#{surveyBean.numberOfQuestions}"/>
																	</ice:column>
																	<ice:column>
																		<f:facet name="header">
																			<ice:outputText value="#{bundle['s_survey_survey.numberofresponse']}"></ice:outputText>
																		</f:facet>
																		<ice:outputText id="idcloseDate" style = "color:#812E30;font-weight:bold" value="#{surveyBean.numberOfResponse}"/>
																	</ice:column>
																	<ice:column style="background-color:white;">
																		<f:facet name="header"></f:facet>
																		 <ice:graphicImage style="border:none;" styleClass="noborder" 
																		 		url="./css/images/#{folderBean.folder_menu}/icons/menu_up_surveyreview.png"
																		 		onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_surveyreview.png'"
																				onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_surveyreview.png'"
																				/>	
																	</ice:column>
																	</ice:dataTable>
													
																	<ice:panelGroup styleClass="clearer"/>
																	  
											        				
																	<!-- Set up the buttons and links for browsing through the table
															             fastStep means No. of pages to fast forward or rewind: 3
															             paginatorMaxPages means No. of direct links to pages: 4 -->
															        <ice:panelGroup style="float:left;width:420px;">
														            <center>
														            <ice:dataPaginator id="dataScroll_x"
														                   rendered="#{s_SV_SV_ListTableBean.selectedDataScrollModes[s_SV_SV_ListTableBean.selectedDataScrollMode].pagingEnabled}"
														                   for="stable"
														                   vertical="false" fastStep="3" paginator="true" paginatorMaxPages="4">
														                <f:facet name="first">
														                    <ice:graphicImage id="firstpage_1" url="./css/rime/css-images/arrow-first.gif" style="border:none;" title="first"/>
														                </f:facet>
														                <f:facet name="last">
														                    <ice:graphicImage id="lastpage_1" url="./css/rime/css-images/arrow-last.gif" style="border:none;" title="last"/>
														                </f:facet>
														                <f:facet name="previous">
														                    <ice:graphicImage id="previouspage_1" url="./css/rime/css-images/arrow-previous.gif" style="border:none;" title="previous"/>
														                </f:facet>
														                <f:facet name="next">
														                    <ice:graphicImage id="nextpage_1" url="./css/rime/css-images/arrow-next.gif" style="border:none;" title="next"/>
														                </f:facet>
														                <f:facet name="fastforward">
														                    <ice:graphicImage id="fastforward_1" url="./css/rime/css-images/arrow-ff.gif" style="border:none;" title="ff"/>
														                </f:facet>
														                <f:facet name="fastrewind">
														                    <ice:graphicImage id="fastrewind_1" url="./css/rime/css-images/arrow-fr.gif" style="border:none;" title="fr"/>
														                </f:facet>
														            </ice:dataPaginator>
														            </center>
														        </ice:panelGroup>
																
																
															</ice:panelGroup>
															
														</ice:panelGroup>
														</td>
														<td>&amp;nbsp
														</td>
													</tr>
													<tr>
														<td colspan="4">
															&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp<ice:graphicImage style="border:none;" styleClass="noborder" 
																		 		url="./css/images/#{folderBean.folder_menu}/icons/menu_legend_surveystatus.png"
															/>
														</td>
													</tr>
												</table>
												
												</div>
												
									</ice:panelGrid>
						</ice:form>
					
				</ui:define>
				

			</ui:composition>

	

       </body>
    </html>
   </f:view>
</jsp:root>
