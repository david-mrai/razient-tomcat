									<ice:form>
							
										<ice:panelPopup  autoPosition="200,100" autoCentre="true" modal="true" visible="#{viewIncidentTypePopUpBean.visible}" style="width:700px;" styleClass="icePanelPopupBody icePanelPopup">
							                <f:facet name="header">
							                   <ice:panelGrid width="100%" cellpadding="0" cellspacing="0" columns="2" styleClass="trHeader" >
							                        <ice:outputText style="color: white;" value="#{bundle['c_dh.hazardousincidents']}"/>
							                        <ice:commandButton image="./css/images/icons/close.png" action="#{viewIncidentTypePopUpBean.closePopup}" title="Close this draggable popup"/>
							                    </ice:panelGrid>
							                </f:facet>
							                
							                <f:facet name="body">
							                    <ice:panelGrid width="100%" columns="2" cellpadding="0"  style="background-color: #FFFFFF">

							              			<table style='text-align: left;  height: 240px;' width="100%" border='1' border-color='gray' border-style='solid' cellpadding='2' cellspacing='2'>
													<tr style='font-weight: bold;'>
														<td style='height: 78px; width: 184px;' ><span style='font-weight: normal;'> <img src='#{viewIncidentGmapBean.imageUrl}' height="80" width="80"/></span></td>
														<td colspan='3' rowspan='1' style='height: 78px; width: 291px;font-size: 15px;font-variant: small-caps;' >#{bundle['rz_popup.map_incident']}: #{viewIncidentGmapBean.type} <br/><br/>#{bundle['rz_popup.map_locate']}: #{viewIncidentGmapBean.city}</td>
													</tr>
													<tr>
														<td style='height: 0px; width: 184px; text-align: left;' valign='undefined'><span style='font-weight: bold;'>#{bundle['rz_popup.map_incidentsummary']}</span></td>
													<td colspan='3' rowspan='1' style='height: 0px; width: 291px;' >#{viewIncidentGmapBean.title}</td>
													</tr>	
													<tr>	
													<td style='width: 184px; height: 26px; font-weight: bold;' >#{bundle['rz_popup.map_country']}</td>
													<td style='width: 292px; height: 26px;' >#{viewIncidentGmapBean.country}</td>
													<td style='height: 26px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_severity']}</td>
													<td style='height: 26px; width: 291px;' >#{viewIncidentGmapBean.riskLevel}</td>
													</tr>	
													<tr>	
													<td style='width: 184px; height: 30px; font-weight: bold;' >#{bundle['rz_popup.map_state']}</td>
													<td style='width: 292px; height: 30px;' >#{viewIncidentGmapBean.state}</td>
													<td style='height: 30px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_incidenttype']}</td>
													<td style='height: 30px; width: 291px;' >#{viewIncidentGmapBean.type}</td>
													</tr>
													<tr>
													<td style='width: 184px; height: 24px; font-weight: bold;' >#{bundle['rz_popup.map_city']}</td>
													<td style='width: 292px; height: 24px;' >#{viewIncidentGmapBean.city}</td>
													<td style='height: 24px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_date']}</td>
													<td style='height: 24px; width: 291px;' >#{viewIncidentGmapBean.dateNews}</td>
													</tr>
													<tr>
													<td style='width: 184px; height: 26px; font-weight: bold;' >#{bundle['rz_popup.map_deaths']}</td>
													<td style='width: 292px; height: 26px;' >#{viewIncidentGmapBean.deads}</td>
													<td style='height: 26px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_url']}</td>
													<td style='height: 26px; width: 80px; font-weight: bold;' >&amp;nbsp&amp;nbsp<a href="#{viewIncidentGmapBean.url}"  target="_blank" style="color: #8C2635; font-variant: small-caps;font-size: 15px;">#{bundle['rz_popup.map_link']}</a></td>
													</tr>
													<tr>
													<td style='overflow:hidden; width:80px; height: 90px; font-weight: bold;' >#{bundle['rz_popup.map_description']}</td>
													<td colspan='3' rowspan='1' style='height: 90px; width: 291px;' ><TEXTAREA style="border:0; font-weight: normal; background-color: #FBFBFD; font-family:Times New Roman,Helvetica,sans-serif; font-size: 1.25em;" cols="90" rows="4" wrap="true" name="text" value="">#{viewIncidentGmapBean.description}</TEXTAREA></td>
													</tr>
												</table>
							                 	</ice:panelGrid>
							                 	
							                </f:facet>
							                
							            </ice:panelPopup>   
							            
