																	</ice:panelGroup>
						
																</ice:panelGroup>
						
															</ice:panelGroup>
						
														</ice:panelGroup>
													
													</ice:panelTab>
													     
													<ice:panelTab   label="#{bundle['c_compliance_surveyview.tab22']}"  disabled="#{c_TabViewSurveysTabSppBean.disabledSurveys}">
													
														<br/>
												     
													     <ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;">
															<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
																<tr>
																	<td width="20%"  class="tablelabeledit_disabled">&amp;nbsp&amp;nbsp 
																			<h:outputLabel>
																				<h:outputText value="#{bundle['c_compliance_surveyview.namesupplier']}"></h:outputText>
																			</h:outputLabel>
																	</td>
																	<td align="left" class="tablelabelfieldedit_disabled" width="30%">
																	
																		<h:outputLabel>
																				<h:outputText  value="#{c_ViewSuppliersSurveysGridBean.nameSupplier}" styleClass="tabletexttitleinformation"></h:outputText>
																		</h:outputLabel>
																	 </td>
																</tr>
							
															</table>
															
														</ice:panelGroup>
													
														<ice:panelGroup styleClass="customerProfileBox" style="width:97%;overflow:auto;">
							
																<ice:panelGroup>
																	<ice:panelGroup>
																		<ice:dataTable resizable="false" border="1" id="tableviewsvspgrid"
																			value="#{c_ViewSuppliersSurveysGridBean.allCrudBeans}"
																			var="adminViewSvSpBean"
																			width="99%"
																			rows="#{c_ViewSuppliersSurveysGridBean.selectedDataScrollModes[c_ViewSuppliersSurveysGridBean.selectedDataScrollMode].rows}"
																			scrollable="#{c_ViewSuppliersSurveysGridBean.selectedDataScrollModes[c_ViewSuppliersSurveysGridBean.selectedDataScrollMode].scrollingEnabled}"
																			scrollHeight="200px"
																			style="float:center;font-color: #FFFFFF;"
																			columnWidths="1%,28%,10%,10%,10%,1%,10%,10%,10%,10%"
																			columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter,columnCenter,columnCenter"
																			rowClasses="rowOn,rowOff" cellpadding="0"
																			sortColumn="#{c_ViewSuppliersSurveysGridBean.columnNameOrder}"
																			sortAscending="#{c_ViewSuppliersSurveysGridBean.descending}"
																			>
							
																			<ice:column style="background-color:white;">
																				<ice:rowSelector id="selectedsvsp"
																					value="#{c_ViewSuppliersSurveysGridBean.itemSelected}" multiple="false"
																					selectionListener="#{c_ViewSuppliersSurveysGridBean.rowSelectionListener}"
																					selectionAction="#{c_ViewSuppliersSurveysGridBean.rowSelectionAction}" />               
																                    <ice:graphicImage visible="true" style="border:none;"
																							styleClass="noborder" height="25"
																							url="./css/images/#{folderBean.folder_menu}/icons/menu_up_#{adminViewSvSpBean.iconSurvey}surveys.png"/>	
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:commandSortHeader id="namesortsvsp" columnName="name">
																						<ice:outputText value="#{bundle['c_compliance_surveyview.survey.name']}"></ice:outputText>
																					</ice:commandSortHeader>
																				</f:facet>
																				<ice:outputText id="idnamesvsp"
																					value="#{adminViewSvSpBean.name}" />
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:commandSortHeader id="creationdatesortsvsp" columnName="creationDate">
																						<ice:outputText value="#{bundle['c_compliance_surveyview.creationdate']}"></ice:outputText>
																					</ice:commandSortHeader>
																				</f:facet>
																				<ice:outputText id="creationdatesvsp"
																					value="#{adminViewSvSpBean.creationDate}" />
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:commandSortHeader id="distributiondatesortsvsp" columnName="distributionDate">
																						<ice:outputText value="#{bundle['c_compliance_surveyview.distributiondate']}"></ice:outputText>
																					</ice:commandSortHeader>
																				</f:facet>
																				<ice:outputText id="distributiondatesvsp"
																					value="#{adminViewSvSpBean.distributionDate}" />
																			</ice:column>
																			
																			<ice:column>
																				<f:facet name="header">
																					<ice:commandSortHeader id="closedatesortsvsp" columnName="closeDate">
																						<ice:outputText value="#{bundle['c_compliance_surveyview.expirationdate']}"></ice:outputText>
																					</ice:commandSortHeader>
																				</f:facet>
																				<ice:outputText id="closedatesvsp"
																					value="#{adminViewSvSpBean.closeDate}" />
																			</ice:column>
																			<ice:column style="background-color:#5A7985;">	
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_compliance_surveyview.nroquestions']}"></ice:outputText>
																				</f:facet>
																				<ice:outputText style="text-align:center;font-weight:bold;" id="numberofquestions"
																					value="#{adminViewSvSpBean.nroQuestions}" />
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_compliance_surveyview.nroanswered']}"></ice:outputText>
																				</f:facet>
																				<ice:outputText style="text-align:center;font-weight:bold;" id="numberofquestions"
																					value="#{adminViewSvSpBean.nroComplete}" />
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_compliance_surveyview.nrounanswered']}"></ice:outputText>
																				</f:facet>
																				<ice:outputText style="text-align:center;font-weight:bold;" id="numberofquestions"
																					value="#{adminViewSvSpBean.nroIncomplete}" />
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_compliance_surveyview.closedate']}"></ice:outputText>
																				</f:facet>
																				<ice:outputText id="iddtclosed" style="text-align:center;font-weight:bold;"
																					value="#{adminViewSvSpBean.dateClosed}" />
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																						<ice:outputText value="#{bundle['c_compliance_surveyview.status']}"></ice:outputText>
																				</f:facet>
															                   <ice:graphicImage style="border:none;" styleClass="noborder"
																					url="./css/images/#{folderBean.folder_menu}/icons/menu_up_status#{adminViewSvSpBean.statusSurvey}.png"
																				/>	
																			</ice:column>
																			<ice:column style="background-color:white;">
																				<f:facet name="header" >
																				</f:facet>
																				<ice:commandLink action="#{c_ViewSuppliersSurveysGridBean.toCheckSurveyAction}" actionListener="#{c_ViewSuppliersSurveysGridBean.selectionListener}" onclick="window.location.reload();">
																					<ice:graphicImage style="border:none;" styleClass="noborder"
																						url="./css/images/#{folderBean.folder_menu}/icons/menu_down_view.png"
																						onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_view.png'"
																						onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_view.png'"
																					
																					/>
																					<f:attribute name="idSelected" value="#{adminViewSvSpBean.idcustomerSurveys}" />																						
																				</ice:commandLink>
																			</ice:column>
																		</ice:dataTable>
																		<ice:panelGroup styleClass="clearer" />
							
							
																		<!-- PAGINATOR-->
																		<ice:panelGroup style="float:left;width:420px;">
																			<center>
																				<ice:dataPaginator id="dataScroll_sv2"
																					rendered="#{c_ViewSuppliersSurveysGridBean.selectedDataScrollModes[c_ViewSuppliersSurveysGridBean.selectedDataScrollMode].pagingEnabled}"
																					for="tableviewsvspgrid" vertical="false" fastStep="3" paginator="true"
																					paginatorMaxPages="10">
																					<f:facet name="first">
																						<ice:graphicImage id="firstpage_sv2"
																							url="./css/rime/css-images/arrow-first.gif"
																							style="border:none;" title="first" />
																					</f:facet>
																					<f:facet name="last">
																						<ice:graphicImage id="lastpage_sv2"
																							url="./css/rime/css-images/arrow-last.gif"
																							style="border:none;" title="last" />
																					</f:facet>
																					<f:facet name="previous">
																						<ice:graphicImage id="previouspage_sv2"
																							url="./css/rime/css-images/arrow-previous.gif"
																							style="border:none;" title="previous" />
																					</f:facet>
																					<f:facet name="next">
																						<ice:graphicImage id="nextpage_sv2"
																							url="./css/rime/css-images/arrow-next.gif"
																							style="border:none;" title="next" />
																					</f:facet>
																					<f:facet name="fastforward">
																						<ice:graphicImage id="fastforward_sv2"
																							url="./css/rime/css-images/arrow-ff.gif"
																							style="border:none;" title="ff" />
																					</f:facet>
																					<f:facet name="fastrewind">
																						<ice:graphicImage id="fastrewind_sv2"
																							url="./css/rime/css-images/arrow-fr.gif"
																							style="border:none;" title="fr" />
																					</f:facet>
																				</ice:dataPaginator>
																			</center>
																		</ice:panelGroup>
							
																	</ice:panelGroup>
																	<br/><br/><br/><br/>
																	<ice:graphicImage style="border:none;" styleClass="noborder" 
																				 		url="./css/images/#{folderBean.folder_menu}/icons/menu_legend_statussurveys.png"
																	/>
							
																</ice:panelGroup>
							
															</ice:panelGroup>
													
													
													</ice:panelTab>
													
													
												</ice:panelTabSet>
											</ice:panelGroup>
										</div>
												
									</ice:panelTab>
									
								</ice:panelTabSet>
							</ice:panelGroup>
							
							
														
							
						</ice:form>
					<br/>
				</ui:define>
				

			</ui:composition>

	

       </body>
    </html>
   </f:view>
</jsp:root>
