				<ui:define name="page-content-value">

					<ice:form>
							<ice:panelGroup id="tabSetTab"	styleClass="tabPanelBox panelTabSetSaleContainer">

								<ice:panelTabSet tabChangeListener="#{c_TabViewSurveysBean.processTabChange}" selectedIndex="#{c_TabViewSurveysBean.ITab}">

									<ice:panelTab label="#{bundle['c_compliance_surveyview.tab1']}">
									
										<div style="height:#{utilServiceLocatorBean.heightPanel}px;">
										
										
							             <ice:panelGroup id="subTabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer" >
							
											<ice:panelTabSet tabChangeListener="#{c_TabViewSurveysTabCpBean.processTabChange}" selectedIndex="#{c_TabViewSurveysTabCpBean.ITab}">
											   

												<ice:panelTab   label="#{bundle['c_compliance_surveyview.tab11']}">
												     
												     <br/>
												     <table cellspacing="0" cellpadding="0" style="margin-top: -7px;" width="100%">
														<tr class="menubuttons">
															<td align="left">
																&amp;nbsp&amp;nbsp
																<ice:commandLink action="#{c_ViewSurveysGridBean.find_All_Action}"  onclick="rld();">
																		<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																				url="./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconAllA}_taballsurveys.png"
																				onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconAllA}_taballsurveys.png'"
																				onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconAllB}_taballsurveys.png'"
																		/>
																</ice:commandLink>
																&amp;nbsp&amp;nbsp
																<ice:commandLink action="#{c_ViewSurveysGridBean.find_New_Action}" onclick="rld();">
																		<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																				url="./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconNewA}_tabnewsurveys.png"
																				onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconNewA}_tabnewsurveys.png'"
																				onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconNewB}_tabnewsurveys.png'"
																		/>
																		
																</ice:commandLink>
																&amp;nbsp&amp;nbsp
																<ice:commandLink action="#{c_ViewSurveysGridBean.find_Open_Action}"  onclick="rld();">
																		<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																				url="./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconOpenA}_tabopensurveys.png"
																				onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconOpenA}_tabopensurveys.png'"
																				onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconOpenB}_tabopensurveys.png'"
																		/>
																</ice:commandLink>
																&amp;nbsp&amp;nbsp
																	<ice:commandLink action="#{c_ViewSurveysGridBean.find_Close_Action}" onclick="rld();">
																		<ice:graphicImage visible="true" style="border:none;"
																			styleClass="noborder"
																			url="./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconCloseA}_tabclosesurveys.png"
																			onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconCloseA}_tabclosesurveys.png'"
																			onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_#{c_ViewSurveysGridBean.iconCloseB}_tabclosesurveys.png'" />
																	</ice:commandLink>
																</td>
															<td>
																&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
															</td>
													</tr>
													<tr>
														<td colspan="4" class="menuline">
														</td>
													</tr>
												</table>
												     
										
													<ice:panelGroup styleClass="customerProfileBox"
														style="width:97%;overflow:auto;">
						
															<ice:panelGroup>
																<ice:panelGroup>
																	<ice:dataTable resizable="false" border="1" id="tableviewgrid"
																		value="#{c_ViewSurveysGridBean.allCrudBeans}"
																		var="adminViewBean"
																		width="99%"
																		rows="#{c_ViewSurveysGridBean.selectedDataScrollModes[c_ViewSurveysGridBean.selectedDataScrollMode].rows}"
																		scrollable="#{c_ViewSurveysGridBean.selectedDataScrollModes[c_ViewSurveysGridBean.selectedDataScrollMode].scrollingEnabled}"
																		scrollHeight="200px"
																		style="float:center;font-color: #FFFFFF;"
																		columnWidths="1%,24%,14%,14%,14%,9px,1%,9%,9%,5%"
																		columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter,columnCenter,columnCenter,columnCenter,columnCenter"
																		rowClasses="rowOn,rowOff" cellpadding="0"
																		sortColumn="#{c_ViewSurveysGridBean.columnNameOrder}"
																		sortAscending="#{c_ViewSurveysGridBean.descending}"
																		onclick="window.location.reload()">
						
																		<ice:column style="background-color:white;">
																			<ice:rowSelector id="selected"
																				value="#{c_ViewSurveysGridBean.itemSelected}" multiple="false"
																				selectionListener="#{c_ViewSurveysGridBean.rowSelectionListener}"
																				selectionAction="#{c_ViewSurveysGridBean.rowSelectionAction}" />               
															                    <ice:graphicImage visible="true" style="border:none;"
																						styleClass="noborder" height="25"
																						url="./css/images/#{folderBean.folder_menu}/icons/menu_up_#{adminViewBean.iconSurvey}surveys.png"/>	
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="namesort" columnName="name">
																					<ice:outputText value="#{bundle['c_compliance_surveyview.survey.name']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="idname"
																				value="#{adminViewBean.name}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="creationdatesort" columnName="creationDate">
																					<ice:outputText value="#{bundle['c_compliance_surveyview.creationdate']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="creationdate"
																				value="#{adminViewBean.creationDate}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="distributiondatesort" columnName="distributionDate">
																					<ice:outputText value="#{bundle['c_compliance_surveyview.distributiondate']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="distributiondate"
																				value="#{adminViewBean.distributionDate}" />
																		</ice:column>
																		<ice:column> 
																			<f:facet name="header">
																				<ice:commandSortHeader id="closedatesort" columnName="closeDate">
																					<ice:outputText value="#{bundle['c_compliance_surveyview.expirationdate']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="closedate"
																				value="#{adminViewBean.closeDate}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:outputText
																					value="#{bundle['c_compliance_surveyview.nroquestions']}"></ice:outputText>
																			</f:facet>
																			<ice:outputText style="text-align:center;font-weight:bold;" id="numberofquestions"
																				value="#{adminViewBean.nroQuestions}" />
																		</ice:column>
																		<ice:column style="background-color:#5A7985;">	
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:outputText
																					value="##{entityTypeBundle.entity_ofs}"></ice:outputText>
																			</f:facet>
																			<ice:outputText style="text-align:center;font-weight:bold;" id="numberofquestions"
																				value="#{adminViewBean.nroSuppliers}" />
