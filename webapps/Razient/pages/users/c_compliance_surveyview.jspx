						<f:attribute name="optioonselected" value="cp_sd"/>
					</ice:commandLink>
					<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_down_surveyview.png"/>
						
					<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
						<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_surveyreview.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_surveyreview.png'"
