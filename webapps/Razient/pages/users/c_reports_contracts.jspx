																	value="&amp;dataURL=./fusioncharts/customer/#{reportmetricsLevelMarginalChartBean.idCustomer}/dh/levelmarginal_survey#{reportmetricsLevelMarginalChartBean.sValue}.xml&amp;" />
																<param name="quality" value="high" />
																<embed src="./fusioncharts/Column3D.swf"
																	flashVars="&amp;dataURL=./fusioncharts/customer/#{reportmetricsLevelMarginalChartBean.idCustomer}/dh/levelmarginal_survey#{reportmetricsLevelMarginalChartBean.sValue}.xml&amp;"
																	quality="high" width="420" height="320" name="levelmarginal"
																	type="application/x-shockwave-flash"
																	pluginspage="http://www.macromedia.com/go/getflashplayer" />
															</object>
														</ice:panelGrid>
												</ice:panelGroup>
                                        </td>
                                          </tr>
                                        </tbody>
                                      </table>
                                      </td>
                                      <td style="border-right: 1px solid rgb(239, 239, 239);" valign="top">
                                      <table width="100%" border="0" cellpadding="5" cellspacing="0">
                                        <tbody>
                                          <tr>
                                            <td height="41"><strong>#{bundle['c_dh_metrics.survey.title']}</strong></td>
                                          </tr>
                                          <tr>
                                            <td bgcolor="#ffffff">
									
									
								   	<table class="tabularmetricsNewView"  style="border-left: 1px solid rgb(217, 217, 217);" width="100%" cellpadding="0" cellspacing="0">
                                               <tbody>
                                                 <tr >
                                                   <td  align="left" class="odd" width="70%">
                                                   		<ice:selectOneMenu value="#{reportmetricsSurveyChartBean.idsurvey}" 
														id="selectedSurvey" styleClass="selectedOneMasterSurvey"
														partialSubmit="true" >
														<f:selectItem itemLabel="#{bundle['rz_select_survey']}" itemValue="0" />
														<f:selectItems value="#{reportmetricsSurveyChartBean.list_Surveys}" id="survey" />
												</ice:selectOneMenu>
                                                   </td>
                                                   <td  align="center" class="odd"   width="30%">
                                                   		<ice:commandLink action="#{reportmetricsSurveyChartBean.loadSurveys}">
													<ice:graphicImage style="border:none;" styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_graphsurvey.png"
														onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_graphsurvey.png'"
														onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_graphsurvey.png'"
														onmouseup="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_graphsurvey.png'"
														onmousedown="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_graphsurvey.png'"
														 />
										   		</ice:commandLink>
											</td>
                                                 </tr>
                                               </tbody>
                                             </table>
                                             <br/>
								   
                                            	<table class="tabularmetricsNewView"  style="border-left: 1px solid rgb(217, 217, 217);" width="100%" cellpadding="0" cellspacing="0">
                                               <tbody>
                                                 <tr >
                                                 
                                                   <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.survey.name']}" /></td>
                                                   <td  align="center" class="odd"   width="55%">
                                                   		<ice:outputText styleClass="titleLabelDhMetrics"  value="#{reportmetricsSurveyChartBean.nameSurvey}" />
											</td>
                                                 </tr>
                                                 <tr >
                                                   <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.survey.total']}" /></td>
                                                   <td  align="center" class="odd"   width="55%">
                                                   		<ice:outputText styleClass="titleLabelDhMetrics"  value="#{reportmetricsSurveyChartBean.totalQuestion}" />
											</td>
                                                 </tr>
                                                 <tr >
                                                   <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.survey.dtdist']}" /></td>
                                                   <td  align="center" class="odd"   width="55%">
                                                   		<ice:outputText styleClass="titleLabelDhMetrics"  value="#{reportmetricsSurveyChartBean.dtDistribution}" />
											</td>
                                                 </tr>
                                                 <tr >
                                                   <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.survey.dtclose']}" /></td>
                                                   <td  align="center" class="odd"   width="55%">
                                                   		<ice:outputText styleClass="titleLabelDhMetrics"  value="#{reportmetricsSurveyChartBean.dtClose}" />
											</td>
                                                 </tr>
                                               </tbody>
                                             </table><br/>
                                            	<table class="tabularmetricsNewView"  style="border-left: 1px solid rgb(217, 217, 217);" width="100%" cellpadding="0" cellspacing="0">
                                               <tbody>
                                                 <tr >
                                                   <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.survey.nosuppliers']} #{entityTypeBundle.entity_ofs}" /></td>
                                                   <td  align="center" class="odd"   width="55%">
                                                   		<ice:outputText styleClass="titleLabelDhMetrics"  value="#{reportmetricsSurveyChartBean.noofsuppliers}" />
											</td>
                                                 </tr>
                                                 <tr >
                                                   <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.surveynotstarted']}" /></td>
                                                   <td  align="center" class="trrownotstarted"   width="55%">
                                                   		<ice:outputText styleClass="titleLabelDhMetricsvalue"  value="#{reportmetricsSurveyChartBean.nonStarted}" />
											</td>
                                                 </tr>
                                                 <tr >
                                                   <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.surveycomplete']}" /></td>
                                                   <td  align="center" class="trrowcomplete"   width="55%">
                                                   		<ice:outputText styleClass="titleLabelDhMetricsvalue"  value="#{reportmetricsSurveyChartBean.completed}" />
											</td>
                                                 </tr>
                                                 <tr >
                                                   <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.surveyincomplete']}" /></td>
                                                   <td  align="center" class="trrowincomplete"   width="55%">
                                                   		<ice:outputText styleClass="titleLabelDhMetricsvalue"  value="#{reportmetricsSurveyChartBean.incompleted}" />
											</td>
                                                 </tr>
                                               </tbody>
                                             </table>
                                             
                                             <br/>
                                             
                                             <ice:panelGroup >


												 <div id='chartContainer' style="width: 400px; margin: 0 auto" >Charts will load here. Please wait...</div>
												
													<script type="text/javascript">
													FusionCharts.printManager.enabled(true);
												    var myChart = new FusionCharts( "./fusioncharts/Column3D.swf", "myChartId", "400", "280", "0", "1" );
												    myChart.setXMLUrl( "./fusioncharts/customer/#{reportmetricsSurveyChartBean.idCustomer}/dh/only_survey#{reportmetricsSurveyChartBean.sValue}.xml" );
												    myChart.render( "chartContainer" );
												    
												    FusionCharts("myChartId").configureLink (
													  {
													    swfUrl : "./fusioncharts/SSGrid.swf",
													    overlayButton:
													    {    
													      message: "close",
													      fontColor : "880000",
													      bgColor:"FFEEEE",
													      borderColor: "660000"
													    }
													  }, 0 );
													  
													  FusionCharts("myChartId").configureLink (
													  {
													    swfUrl : "./fusioncharts/Line.swf",
													    overlayButton:
													    {    
													      message: "close",
													      fontColor : "880000",
													      bgColor:"FFEEEE",
													      borderColor: "660000"
													    }
													  }, 1 );
													  
	
												  </script>
											   
												</ice:panelGroup>
                                            
                                           </td>
                                          </tr>
                                        </tbody>
                                      </table>
                                      </td>

                                    </tr>
                                  </tbody>
                                </table>
                            </ice:form>
                            
                            </td>
                        </tr>

                       </tbody>
                      </table>
                      <br/>
                      <br/>
                       </td>
                   	</tr>
                   </tbody>
                        </table>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                  		</td>
                      </tr>
					 </tbody>
                  </table>
                  
				</ui:define>
			</ui:composition>

       </body>
    </html>
   </f:view>
</jsp:root>
