				<ui:define name="page-content-value">
				
					<ice:panelGrid visible="#{not viewsurveybuildPopUpBean.visible}" width="100%">
				
						<h:form>
						
							<table cellspacing="0" cellpadding="0" style="margin-top: -7px;" width="100%">
									<tr class="menubuttons">
										<td align="left">
											&amp;nbsp&amp;nbsp
											<ice:commandLink action="#{c_CP_SM_ListTableBean.findAllSurveys}" visible="#{c_CP_SM_ListTableBean.visibleListSurvey}" onclick="rld();">
																							<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																										url="./css/images/#{folderBean.folder_menu}/icons/menu_up_all.png"
																										onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_all.png'"
																										onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_all.png'"
																							/>
											</ice:commandLink>
										</td>
										<td>
											&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
											&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
										</td>
										<td align="right">
											&amp;nbsp&amp;nbsp
											<ice:commandLink  action="#{viewsurveybuildPopUpBean.openPopup}" visible="#{c_CP_SM_ListTableBean.visibleListSurvey}"  onclick="rld();">
																								<ice:graphicImage style="border:none;" styleClass="noborder"
																									url="./css/images/#{folderBean.folder_menu}/icons/menu_up_viewsurveys.png"
																									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_viewsurveys.png'"
																									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_viewsurveys.png'"
																									/>
																								
											</ice:commandLink>
										</td>
										<td>
											&amp;nbsp
										</td>
								</tr>
								<tr>
									<td colspan="4" class="menuline">
									</td>
								</tr>
							</table>
						</h:form>
						<ice:form>    
								
						
								<ice:panelGrid visible="#{c_CP_SM_ListTableBean.visibleListSurvey}">
													<div class="paneTableBox"  style="height:#{utilServiceLocatorBean.heightAllTable}px;margin-top:1px;overflow:auto;width:#{utilServiceLocatorBean.widthAllTable}px;">
													
													<table class="tableformstot" style="margin-top:0px;" >
															<tr>
																<td>
																	<table class="tableformscell" cellspacing="0" cellpadding="0">
																		<tr>
																			<td>
																				&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																			</td>
																			<td class="tableflabelbuttons" width="120"  align="right">
																			<h:outputLabel >
																				<h:outputText value="#{bundle['c_compliance_surveymanager.survey.autofind']} :"></h:outputText>
																				</h:outputLabel>
																			</td>
																			<td>
																				<ice:selectInputText rows="7" width="200" valueChangeListener="#{c_CP_SM_ListTableBean.updateParamsList}">
																                    <f:selectItems value="#{c_CP_SM_ListTableBean.list}" />
																                </ice:selectInputText>
																			</td>
																		</tr>
																	</table>
																</td>
															</tr>
														</table> 
														
													<table width="85%" style="margin-left:10px;margin-top:3px;border:1px solid #C3DFF4;" cellspacing="0" cellpadding="0" border="0">
														<tr class="trHeader"><td colspan="4" align="center">#{bundle['c_compliance_surveymanager.title']}</td></tr>
														<tr >
															<td valign="top" class="tdcolumninfo">
															
															<table border="0" cellspacing="0" cellpadding="0" width="95%" >
																<tr>
																	<td>&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</td>
																	
																</tr>
																<tr>
																	<td align="center">
																		<ice:commandLink action="#{c_CP_SM_ListTableBean.toListNewSurvey}" onclick="rld();">
																								<ice:graphicImage style="border:none;" styleClass="noborder"
																									url="./css/images/icons/menu_up_new.png"
																									onmouseout="this.src='./css/images/icons/menu_up_new.png'"
																									onmouseover="this.src='./css/images/icons/menu_up_new.png'"
																									onmouseup="this.src='./css/images/icons/menu_up_new.png'"
																									onmousedown="this.src='./css/images/icons/menu_up_new.png'"
																									alt="#{bundle['rz_insert']}" />
																								
																						</ice:commandLink>	
																	</td>
																</tr>
																<tr>
																	<td align="center">
																		<ice:outputLabel>
																			<h:outputText styleClass="titleButtonsFixedHigh" value="#{bundle['c_compliance_surveymanager.survey.newsurvey']}"></h:outputText>
																		</ice:outputLabel>
																	</td>
																</tr>
																<tr>
																	<td align="center">
																		<br/>
																	</td>
																</tr>
																<tr>
																	<td align="center">
																		<ice:commandLink  action="#{loadcsurveyPopUpBean.openPopup}" rendered="#{not loadcsurveyPopUpBean.visible}"  onclick="rld();">
																								<ice:graphicImage style="border:none;" styleClass="noborder"
																									url="./css/images/icons/menu_new_load.png"
																									onmouseout="this.src='./css/images/icons/menu_new_load.png'"
																									onmouseover="this.src='./css/images/icons/menu_new_load.png'"
																									onmouseup="this.src='./css/images/icons/menu_new_load.png'"
																									onmousedown="this.src='./css/images/icons/menu_new_load.png'"
																									 />
																								
																		</ice:commandLink>	
																		
																		
																			<ice:panelPopup modal="true" visible="#{loadcsurveyPopUpBean.visible}" style="margin-left:0px;margin-top:-55px;position:absolute; width:550px;" styleClass="icePanelPopupBody" autoCentre="true">
																                <f:facet name="header">
																                    <ice:panelGrid width="550" cellpadding="0" cellspacing="1" columns="2" styleClass="trHeader" >
																                        <ice:outputText style="color: white;" value="#{bundle['c_compliance_surveymanager.duplicate']}"/>
																                        <ice:commandLink  action="#{loadcsurveyPopUpBean.closePopup}" >
																								<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/icons/close.png" />
																								
																						</ice:commandLink>
																                    </ice:panelGrid>
																                </f:facet>
																                
																                <f:facet name="body">
																                    <ice:panelGrid width="100%" columns="1" cellpadding="0"  style="background-color: #F0F7FB">
																	                	
																	                	
																	                	<ice:panelGroup>
																							<ice:panelGroup>
																								<ice:dataTable resizable="false" border="1" id="tablestd" value="#{c_CP_SM_Duplicate_ListRowBean.currentDSurveyBeans}" var="svBean"  
																											width="98%" 
																											rows="#{c_CP_SM_Duplicate_ListRowBean.selectedDataScrollModes[c_CP_SM_Duplicate_ListRowBean.selectedDataScrollMode].rows}"
																						               		scrollable="#{c_CP_SM_Duplicate_ListRowBean.selectedDataScrollModes[c_CP_SM_Duplicate_ListRowBean.selectedDataScrollMode].scrollingEnabled}"
																						               		style="float:left"
																							               	columnWidths="1%,35%,53%,10%"
																							               	columnClasses="columnCenter,columnLeft,columnLeft,columnCenter"
																						                	rowClasses="rowOn,rowOff"
																							               	cellpadding="0"
																							               	binding="#{c_CP_SM_Duplicate_ListRowBean.htmlDataTable}">
																									
																									<ice:column>
																										<f:facet name="header">
																										</f:facet>
																										>>	
																									</ice:column>
																									<ice:column>
																										<f:facet name="header">
																		                        				<ice:outputText value="#{bundle['c_compliance_surveymanager.survey.name']}"></ice:outputText>
																										</f:facet>
																											<ice:outputLabel>
																												<h:outputText styleClass="titleButtonsFixedHigh" value="#{svBean.name}"></h:outputText>
																											</ice:outputLabel>
																									</ice:column>
																									<ice:column>
																										<f:facet name="header">
																											<ice:outputText value="#{bundle['c_compliance_surveymanager.survey.description']}"></ice:outputText>
																										</f:facet>
																										<ice:inputTextarea id="iddescription"
																										   cols="40" rows="2" maxlength="450"
																				                           value="#{svBean.description}"
																				                           readonly="false" styleClass="fieldtextareareadonly">
																				                         </ice:inputTextarea>
																									</ice:column>
																
																									
																									<ice:column>
																										<f:facet name="header">
																		                        			<ice:commandLink action="#{c_CP_SM_Duplicate_ListRowBean.loadRow}"  onclick="if(!confirm('#{bundle['rz_info.surveyofsurvey']}?')) return false;">
																												<ice:graphicImage style="border:none;" url		="./css/images/icons/save.png"/>
																											</ice:commandLink>
																		                        		</f:facet>
