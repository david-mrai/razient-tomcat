				<ui:define name="page-content-value">
					
				
				
					  
						<!-- Static Tab Set -->
					<ice:form>
					<ice:panelGroup id="tabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer">
					
					   <ice:panelTabSet tabChangeListener="#{c_supplierView_suppliers_TabBean.processTabChange}" binding="#{rz_UserManagerBean.tabSet}">
					   
							<ice:panelTab   label="#{bundle['c_supplierview_suppliers.tab1']}" >
					           <div style="height:300px">
								<table>
								<tr>
								 <td width="300">
								 <ice:outputText style="font-weight:bold;font-size:15px;font-family:Times New Roman,Helvetica, sans-serif;">Display All  High Risk Alerts in past 24 hours for specific vendor</ice:outputText>
								 </td>
