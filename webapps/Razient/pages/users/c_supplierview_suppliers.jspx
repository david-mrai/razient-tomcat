										<tr>
											<td bgcolor="#EFF2FF">SynTech Technologies</td>
											<td bgcolor="#EFF2FF">Chemical Spill</td>
											<td bgcolor="#EFF2FF">High</td>
										</tr>
										<tr>
											<td bgcolor="#FFFFFF">China Electric Manufacturing Ltd</td>
											<td bgcolor="#FFFFFF">Power outage</td>
											<td bgcolor="#FFFFFF">High</td>
										</tr>
										</table>
									</td>
								</tr>	
					            </table>  
							   </div>
					        </ice:panelTab>
					        <ice:panelTab   label="#{bundle['c_supplierview_suppliers.tab2']}" >
