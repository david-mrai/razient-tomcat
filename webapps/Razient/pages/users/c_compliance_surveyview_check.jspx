				<ui:define name="page-content-value">
					
						
						<ice:form>
							
								<div class="paneTableBox"
									style="height:100;margin-top:1px;overflow:auto;width:100%;">


									<table  cellspacing="0" cellpadding="0" style="margin-top: 2px;" width="100%" >
										<tr>
											<td>&amp;nbsp</td>
											<td align="left">
												<ice:commandLink
													action="#{c_ViewSurveyTreeSurveyBean.buildSection_responsesaction}">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_findresponses.png"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_findresponses.png'"
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_findresponses.png'"
														/>
												</ice:commandLink>
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												<ice:commandLink
													action="#{c_ViewSurveyTreeSurveyBean.buildSection_ratingaction}">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_findrating.png"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_findrating.png'"
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_findrating.png'"
														/>
												</ice:commandLink>
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												<!--<ice:commandLink action="#{zoomSurveyQuestionsPopUpBean.openPopup}" rendered="#{not zoomSurveyQuestionsPopUpBean.visible}">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_zoomsurvey.png"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_zoomsurvey.png'"
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_zoomsurvey.png'"
														/>
												</ice:commandLink>-->
											</td>
											<td align="right">
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												<ice:commandLink
													action="#{c_ViewSurveysSuppliersGridBean.toListSurvey}"
													onclick="rld();">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_tolist.png"
														onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_tolist.png'"
														onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_tolist.png'"
														/>
												</ice:commandLink>
											</td>
											<td>
												&amp;nbsp&amp;nbsp&amp;nbsp
											</td>
										</tr>
									</table>
								</div>
								
								<br />
								<!-- <div style="margin-left:-10px;margin-top:-10px;position: fixed;float: none; z-index: 100">
									    	<ice:commandLink action="#{showhidesectionsBean.action_showhide}" onclick="rld();">
												<ice:graphicImage style="border:none;" 
													styleClass="noborder" url="./css/images/#{folderBean.folder_menu}/icons/menu_#{showhidesectionsBean.url_icon}.png"/>
											</ice:commandLink>
								</div> -->
								
								<ice:panelGroup>
									<div class="paneTableSectionBox"
											style="z-index: 10;margin-left:2px;margin-top:-9px;width:#{utilServiceLocatorBean.widthAllTree-6}px;float: left;position: absolute; ">
											
											<div class="pageHeading">#{bundle['s_survey_survey.question.sections.title']}</div>
											
											<br/>
											<!-- first column, for tree navigation -->
									    	
											
										<ice:panelGroup style="border: 0px solid gray; height: #{utilServiceLocatorBean.heightAllTree-76}px;">
											
											<ice:tree id="tree" value="#{c_ViewSurveyTreeSurveyBean.model}"
												var="item" hideRootNode="false" hideNavigation="false"
												imageDir="./css/images/tree/" >
												<ice:treeNode >
													<f:facet name="icon">
														<ice:panelGroup style="display: inline;font-size:11px;">
															<h:graphicImage value="#{item.userObject.icon}" />
														</ice:panelGroup>
													</f:facet>
													<f:facet name="content" >
														<ice:panelGroup style="display: inline;font-size:10px;color:red;">
															<ice:commandLink target="_top"
																actionListener="#{c_ViewSurveyTreeSurveyBean.actionlistener}"
																value="#{item.userObject.text}" onclick="javascript:window.location.reload();">
																<f:attribute name="sectionsId"
																	value="#{item.userObject.section.idcustomerSectionSurveys}" />
															</ice:commandLink>
														</ice:panelGroup>
													</f:facet>
												</ice:treeNode>
											</ice:tree>
										</ice:panelGroup>

								</div>
							</ice:panelGroup>
								
								
							<ice:panelGrid columns="2" style="margin-top:-12px;margin-left:-4px;">
								
								<div class="paneTableBox" style="height:100%;margin-top:0px;overflow:auto;width:#{utilServiceLocatorBean.widthAllTree}px;">

								</div>
								<div class="paneBuiltSurveyBox"  style="margin-top:0px;width:100%;">

									  <table class="tablebuiltsurvey" width="120" border="0">
										<tr>
											<td>&amp;nbsp
												<h:outputLabel>
													<h:outputText styleClass="titlebuiltquestionsname" style="font-size:12px;font-weight: bold;" value="#{bundle['c_compliance_surveyreview_rate.rating']} :"></h:outputText>
												</h:outputLabel>
											</td>
											<td>&amp;nbsp
												<ice:graphicImage url="./css/images/icons/menu_sep.png"
													style="border:none;" />&amp;nbsp&amp;nbsp
											</td>
											<td align="left">
												<ice:inputText maxlength="9" size="9"
													value="#{statusSectionBean.irating_level} #{bundle['c_compliance_surveyreview_rate.points']}"
													styleClass="fieldmenuindexcheck" readonly="true"></ice:inputText>
											</td>
											<td align="left">
												<ice:graphicImage url="./css/images/icons/menu_up_of.png"
													style="border:none;" />
											</td>
											<td align="left">
												<ice:inputText maxlength="9" size="9"
													value="#{statusSectionBean.irating_total} #{bundle['c_compliance_surveyreview_rate.points']}"
													styleClass="fieldmenuamountcheck" readonly="true"></ice:inputText>
											</td>
											<td  align="right">
												<ice:graphicImage url="./css/images/icons/menu_sep.png"
													style="border:none;" />

											</td>
										</tr>
										<tr>
											<td align="left" colspan="6">
												<ice:graphicImage height="1px" width="300"
													url="./css/images/icons/menu_menu_line.png" />
											</td>
										</tr>
									</table>
									
									
									
									<div style="margin-top:0px;overflow:auto;width:100%;">
									 
									<ice:panelGroup >
										<div xmlns:ft="http://www.mcmsoftware.com">
											<c:forEach var="builtsurveyview"
												items="#{builtSurveyViewManager.list_surveys}">
												<ft:builtsurveyview value="#{builtsurveyview}" />
											</c:forEach>
										</div>
									</ice:panelGroup> 
									</div>
								</div>
								
							</ice:panelGrid>
								
								
							<div class="paneTableBox"
									style="height:100%;margin-top:1px;overflow:auto;width:100%;">


									<table  cellspacing="0" cellpadding="0" style="margin-top: 2px;" width="100%" >
										<tr>
											<td>&amp;nbsp</td>

											<td>
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
											</td>
											<td align="right">
												&amp;nbsp
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												<ice:commandLink
													action="#{c_ViewSurveysSuppliersGridBean.toListSurvey}"
													onclick="rld();">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_tolist.png"
														onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_tolist.png'"
														onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_tolist.png'"
														/>
												</ice:commandLink>
											</td>
											<td>
												&amp;nbsp
											</td>
										</tr>
									</table>
								</div>
								
								<ice:panelConfirmation id="confirmsend"  
									  acceptLabel="#{bundle['ice_confirmation.ok']}"  
									  cancelLabel="#{bundle['ice_confirmation.cancel']}"  
									  message="#{bundle['ice_confirmation.sendsupplier.message']}"  
									  title="#{bundle['ice_confirmation.sendsurvey.title']}"  
									  draggable="false"  
								/>
								<ice:panelConfirmation id="confirmclose"  
									  acceptLabel="#{bundle['ice_confirmation.ok']}"  
									  cancelLabel="#{bundle['ice_confirmation.cancel']}"  
									  message="#{bundle['ice_confirmation.sendclose.message']}"  
									  title="#{bundle['ice_confirmation.sendsurvey.title']}"  
									  draggable="false"  
								/>
								<!--  
								
								<ice:panelPopup modal="true"  visible="#{zoomSurveyQuestionsPopUpBean.visible}" style="width:#{utilServiceLocatorBean.widthSurveyBuiltTable+350}px;" styleClass="icePanelPopupBody icePanelPopup" autoCentre="true">
						                <f:facet name="header">
						                   <ice:panelGrid width="#{utilServiceLocatorBean.widthSurveyBuiltTable+350}px;" cellpadding="0" cellspacing="1" columns="4" styleClass="trHeader" >
