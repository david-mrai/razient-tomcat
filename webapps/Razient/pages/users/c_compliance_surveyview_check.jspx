						                <f:facet name="body">
						                
								           <div style="height:#{utilServiceLocatorBean.heightAllTree+150}px;margin-top:0px;overflow:auto;width:#{utilServiceLocatorBean.widthSurveyBuiltTable+330}px;">
												<div style="margin-top:0px;overflow:auto;width:100%;">
												 
												<ice:panelGroup >
