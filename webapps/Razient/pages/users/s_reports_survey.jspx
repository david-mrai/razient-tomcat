				<ui:define name="page-content-value">
					
					<table class="data" width="100%" border="0" cellpadding="1" cellspacing="0" style="margin-left:0px;margin-top:0px;font-family: Arial,Verdana,  Helvetica, sans-serif;">
              <tbody>
                <tr>
                  <td valign="top">
                  <table width="100%" border="0" cellpadding="0" cellspacing="0">
                    <tbody>
					<tr>
                        <td bgcolor="#e1e6e8" valign="top">
                        <table width="100%" border="0" cellpadding="0" cellspacing="0">
                          <tbody>
                            <tr>
                              <td style="padding: 3px 8px 8px;">
                              <table width="100%" align="center" border="0" cellpadding="0" cellspacing="0">
                                <tbody>
                                  <tr>
                                    <td rowspan="2" style="background-repeat: repeat-x;" background="./css/images/general/dashcontent_header.png"  bgcolor="#ffffff"  valign="top">
                                    
                                    
					
								<ice:form>
                                    <table id="tab0" style="display: block" width="100%" border="0" cellpadding="0" cellspacing="0">
                                      <tbody>
                                        <tr>
                                        <td width="11" height="41" valign="top"><img src="./css/images/general/dashcontent_left_top.png" width="11" height="41"/></td>
                                    
                                          <td style="border-right: 1px solid rgb(239, 239, 239);" valign="top">
                                          <table width="100%" border="0" cellpadding="5" cellspacing="0">
                                            <tbody>
                                              <tr>
                                                <td height="41"><strong>#{bundle['c_dh_metrics.allsurveys.title']}</strong></td>
                                              </tr>
                                              <tr>
                                                <td align="center" bgcolor="#ffffff">
                                                
                                                 	<table class="tabularmetricsNewView"  style="border-left: 1px solid rgb(217, 217, 217);" width="100%" cellpadding="0" cellspacing="0">
	                                                  <tbody>
	                                                    <tr >
	                                                      <td  align="left" class="odd" width="70%">
	                                                      		<ice:selectOneMenu value="#{metricsQuestionsSurveyChartBean.idsurvey}" 
																		id="selectedSurvey" styleClass="selectedOneMasterSurvey"
																		partialSubmit="true" >
																		<f:selectItem itemLabel="#{bundle['rz_select_survey']}" itemValue="0" />
																		<f:selectItems value="#{metricsQuestionsSurveyChartBean.list_Surveys}" id="survey" />
																</ice:selectOneMenu>
	                                                      </td>
	                                                      <td  align="center" class="odd"   width="30%">
	                                                      		<ice:commandLink action="#{metricsQuestionsSurveyChartBean.loadSurveys_Supplier}">
																	<ice:graphicImage style="border:none;" styleClass="noborder"
																		url="./css/images/#{folderBean.folder_menu}/icons/menu_up_graphsurvey.png"
																		onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_graphsurvey.png'"
																		onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_graphsurvey.png'"
																		onmouseup="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_graphsurvey.png'"
																		onmousedown="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_graphsurvey.png'"
																		 />
														   		</ice:commandLink>
															</td>
	                                                    </tr>
	                                                  </tbody>
	                                                </table>
	                                                <br/>
                                                
												   
                                                	<table class="tabularmetricsNewView"  style="border-left: 1px solid rgb(217, 217, 217);" width="100%" cellpadding="0" cellspacing="0">
	                                                  <tbody>
	                                                    <tr >
	                                                    
	                                                      <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.survey.name']}" /></td>
	                                                      <td  align="center" class="odd"   width="55%">
	                                                      		<ice:outputText styleClass="titleLabelDhMetrics"  value="#{metricsQuestionsSurveyChartBean.nameSurvey}" />
															</td>
	                                                    </tr>
	                                                    <tr >
	                                                      <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.survey.total']}" /></td>
	                                                      <td  align="center" class="odd"   width="55%">
	                                                      		<ice:outputText styleClass="titleLabelDhMetrics"  value="#{metricsQuestionsSurveyChartBean.totalQuestion}" />
															</td>
	                                                    </tr>
	                                                    <tr >
	                                                      <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.survey.dtdist']}" /></td>
	                                                      <td  align="center" class="odd"   width="55%">
	                                                      		<ice:outputText styleClass="titleLabelDhMetrics"  value="#{metricsQuestionsSurveyChartBean.dtDistribution}" />
															</td>
	                                                    </tr>
	                                                    <tr >
	                                                      <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.survey.dtclose']}" /></td>
	                                                      <td  align="center" class="odd"   width="55%">
	                                                      		<ice:outputText styleClass="titleLabelDhMetrics"  value="#{metricsQuestionsSurveyChartBean.dtClose}" />
															</td>
	                                                    </tr>
	                                                    <tr >
	                                                      <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.survey.status']}" /></td>
	                                                      <td  align="center" class="odd"   width="55%">
	                                                      		<ice:outputText styleClass="titleLabelDhMetrics"  value="#{metricsQuestionsSurveyChartBean.status}" />
															</td>
	                                                    </tr>
	                                                  </tbody>
	                                                </table><br/>
                                                	<table class="tabularmetricsNewView"  style="border-left: 1px solid rgb(217, 217, 217);" width="100%" cellpadding="0" cellspacing="0">
	                                                  <tbody>
	                                                    <tr >
	                                                      <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.questioncomplete']}" /></td>
	                                                      <td  align="center" class="trrowcomplete"   width="55%">
	                                                      		<ice:outputText styleClass="titleLabelDhMetricsvalue"  value="#{metricsQuestionsSurveyChartBean.completed}" />
															</td>
	                                                    </tr>
	                                                    <tr >
	                                                      <td  align="left" class="trrowtitle" width="35%"><ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{bundle['c_dh_metrics.questionincomplete']}" /></td>
	                                                      <td  align="center" class="trrownotstarted"   width="55%">
	                                                      		<ice:outputText styleClass="titleLabelDhMetricsvalue"  value="#{metricsQuestionsSurveyChartBean.incompleted}" />
															</td>
	                                                    </tr>
	                                                  </tbody>
	                                                </table>
	                                                
	                                                <br/>
													
													 <ice:panelGroup >

														 <div id='chartContainer' style="width: 330px; margin: 0 auto" >Charts will load here. Please wait...</div>
														
															<script type="text/javascript">
															FusionCharts.printManager.enabled(true);
														    var myChart = new FusionCharts( "./fusioncharts/Column3D.swf", "myChartId", "330", "280", "0", "1" );
														    myChart.setXMLUrl( "./fusioncharts/supplier/#{metricsQuestionsSurveyChartBean.idSupplier}/dh/only_questionssurvey#{metricsQuestionsSurveyChartBean.sValue}.xml" );
														    myChart.render( "chartContainer" );
														    
														    FusionCharts("myChartId").configureLink (
															  {
															    swfUrl : "./fusioncharts/SSGrid.swf",
															    overlayButton:
															    {    
															      message: "close",
															      fontColor : "880000",
															      bgColor:"FFEEEE",
															      borderColor: "660000"
															    }
															  }, 0 );
															  
															  FusionCharts("myChartId").configureLink (
															  {
															    swfUrl : "./fusioncharts/Line.swf",
															    overlayButton:
															    {    
															      message: "close",
															      fontColor : "880000",
															      bgColor:"FFEEEE",
															      borderColor: "660000"
															    }
															  }, 1 );
															  
			
														  </script>
													   
													</ice:panelGroup>
                                                
                                                
                                                
                                                 </td>
                                              </tr>
                                            </tbody>
                                          </table>
                                          </td>
                                          
                                          
                                          <td style="border-right: 1px solid rgb(239, 239, 239);" align="center"  valign="top">
                                          <table width="100%" border="0" cellpadding="5" cellspacing="0">
                                            <tbody>
                                              <tr>
                                                <td height="41"><strong>Survey Results Summary x Survey</strong></td>
                                              </tr>
                                              <tr>
                                                <td align="center" bgcolor="#ffffff">
                                                
                                                <table class="tabularmetricsNewView"  style="border-left: 1px solid rgb(217, 217, 217);" width="100%" cellpadding="0" cellspacing="0">
                                                  <tbody>
                                                    <tr >
                                                      <td align="left"><ice:outputText styleClass="titleLabelDhMetrics" value="#{bundle['c_dh_metrics.surveynotstarted']}" /></td>
                                                      <td class="trrownotstarted" align="center">
                                                      		<ice:outputText styleClass="titleLabelDhMetricsvalue" value="#{metricsAllSurveysChartBean.nonStarted}" />  
														</td>
                                                    </tr>
                                                    <tr >
                                                      <td  class="odd" align="left"><ice:outputText styleClass="titleLabelDhMetrics" value="#{bundle['c_dh_metrics.surveycomplete']}" /></td>
