                                                      </td>
                                                    </tr>
                                                    <tr >
                                                      <td align="left"><ice:outputText styleClass="titleLabelDhMetrics" value="#{bundle['c_dh_metrics.surveyinadditional']}" /></td>
                                                      <td  class="trrowinadditional" align="center">
                                                      		<ice:outputText styleClass="titleLabelDhMetricsvalue"  value="#{metricsAllSurveysChartBean.inadditional}" />
                                                      </td>
                                                    </tr>
                                                    <tr >
                                                      <td align="left"><ice:outputText styleClass="titleLabelDhMetrics" value="#{bundle['c_dh_metrics.surveyexpired']}" /></td>
                                                      <td  class="trrowexpired" align="center">
