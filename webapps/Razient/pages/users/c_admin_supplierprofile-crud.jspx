								<ice:panelPopup autoPosition="200,100" autoCentre="true" modal="true" visible="#{filedocumentPopUpBean.visible}" style="margin-left:0px;margin-top:-55px;position:absolute; width:300px;" styleClass="icePanelPopupBody">
