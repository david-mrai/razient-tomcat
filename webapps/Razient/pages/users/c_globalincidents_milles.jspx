				<ui:define name="page-content-value">
					<ice:form>

					<ice:panelGrid width="100%" columns="1" cellpadding="0"  style="align:center;background-color: #F0F7FB; border-color: #294D80">
										    
										    	
											
								<span class="smallHeading"  onClick="showTab('mapsgi', this)" style="cursor: pointer;font-size:17px;font-weight:bold;"><img src="./css/images/general/minus-glow.png" align="absmiddle"></img>
									<h:outputLabel>
										<h:outputText styleClass="titleMiles" value="#{bundle['c_globalincidents_alerts.map.title']}"></h:outputText>
										</h:outputLabel>
									</span>
										<table cellpadding="0" cellspacing="0" id="mapsgi"><tr><td>	
											<style type="text/css">
	                                		.dhalGmpMapTd div.gmap {width:  #{utilServiceLocatorBean.widthPanelMapQueryGincidents}px; height: 500px}
											.dhalGmpMapTd {visibility: block}
	                                 	</style>
											<ice:panelGroup >
												        <ice:gMap id="popmap" rendered="true" styleClass="dhalGmpMapTd" latitude="#{c_GI_AlertsGmapBean.latitude}" longitude="#{c_GI_AlertsGmapBean.longitude}" zoomLevel="#{c_GI_AlertsGmapBean.zoom}" >
												        	<ice:gMapGeoXml  url="#{bundle['url_upload']}#{bundle['url_kml']}#{bundle['url_customer']}#{c_GI_AlertsGmapBean.idCustomer}/#{c_GI_AlertsGmapBean.nameKML50Mils}"/>
												        	<ice:gMapControl id="largectrl" name="GLargeMapControl" rendered="#{c_GI_AlertsGmapBean.showControls}"/>
												            <ice:gMapControl id="scalectrl" name="GScaleControl" rendered="#{c_GI_AlertsGmapBean.showControls}"/>
												            <ice:gMapControl id="typectrl" name="GMapTypeControl" rendered="#{c_GI_AlertsGmapBean.showControls}"/>
														 
														  <ice:gMapDirection locateAddress="true"  textualDivId="textDiv"></ice:gMapDirection>
														</ice:gMap>
														<ice:panelGroup id="textDiv">...
														</ice:panelGroup>
											</ice:panelGroup>	
											</td></tr>
										</table>

										</ice:panelGrid>
					
					
					<ice:panelGroup id="icePanelUpLoad" 
								style="height:#{utilServiceLocatorBean.heightPanelTbGincidents}px;width:#{utilServiceLocatorBean.widthPanelTbGincidents}px;overflow:auto;border-color: #294D80;">
								<div>
									<table class="tableformsgincidents" style="margin-top: 0px;" border="1" cellspacing="0" cellpadding="0">
										<tr class="trHeader" align="left">
											<td colspan="4">
												<h:outputLabel>
													<h:outputText value="#{bundle['c_globalincidents_alerts.search.title']}"></h:outputText>
												</h:outputLabel>
											</td>
										</tr>
										<tr class="trrow1">
											<td class="tableflabelmasterbold">
																<h:outputLabel>
																	<h:outputText value="#{bundle['c_globalincidents_alerts.search.scity']}"></h:outputText>
																</h:outputLabel>
											</td>
											<td align="left">
												<ice:selectOneMenu id="selectedCities" partialSubmit="true" immediate="true"
											                                       value="#{c_GI_AlertsGmapBean.selectedCity}"
											                       >
											                       <f:selectItems value="#{c_GI_AlertsGmapBean.list_city}" id="citys" />
											    </ice:selectOneMenu>
											</td>
											<td align="left">
												<ice:commandLink action="#{c_GI_AlertsGmapBean.findAllAction}"  onclick="window.location.reload();">
													<ice:graphicImage style="border:none;" styleClass="noborder"
														url="./css/images/icons/menu_up_find-records.png"
														onmouseout="this.src='./css/images/icons/menu_up_find-records.png'"
														onmouseover="this.src='./css/images/icons/menu_up_find-records.png'"
														onmouseup="this.src='./css/images/icons/menu_up_find-records.png'"
														onmousedown="this.src='./css/images/icons/menu_up_find-records.png'"
													/>
												</ice:commandLink>
											</td>
										</tr>
									</table>
								</div>
							</ice:panelGroup>
					
					
					<span class="smallHeading"  onClick="showTab('milesfive', this)" style="cursor: pointer;font-size:17px;font-weight:bold;"><img src="./css/images/general/minus-glow.png" align="absmiddle"></img>
					<h:outputLabel>
							<h:outputText styleClass="titleMiles" value="#{bundle['c_globalincidents_alerts.data50.title']}"></h:outputText>
					</h:outputLabel>
					
					</span>
						
						<table id="milesfive" style="display:none;">
							<tr>
							<td>
							
							<ice:panelGroup styleClass="customerProfileBox" 
									style="height:#{utilServiceLocatorBean.heightPanelMiles}px;width:#{utilServiceLocatorBean.widthPanelMiles}px;overflow:auto;">
	
									<ice:dataTable resizable="false" border="1" id="tablestdgi5miles"
										value="#{c_GI_Alerts_5MilesBean.list_5miles}"
										var="stdGI5mBean" width="98%"
										rows="#{c_GI_Alerts_5MilesBean.selectedDataScrollModes[c_GI_Alerts_5MilesBean.selectedDataScrollMode].rows}"
										scrollable="#{c_GI_Alerts_5MilesBean.selectedDataScrollModes[c_GI_Alerts_5MilesBean.selectedDataScrollMode].scrollingEnabled}"
										style="float:left;margin-left:2px" columnWidths="1%,35%,35%,29%"
										columnClasses="columnCenter,columnCenter,columnLeft,columnCenter"
										rowClasses="rowOn,rowOff" cellpadding="0"
										sortColumn="#{c_GI_Alerts_5MilesBean.columnNameOrder}" sortAscending="#{c_GI_Alerts_5MilesBean.descending}">
										<ice:column>
											<f:facet name="header">
											</f:facet>>>
										</ice:column>
										<ice:column>
											<f:facet name="header">
												<ice:outputText
													value="#{bundle['c_admin_usermanager.supp.name']}"></ice:outputText>
											</f:facet>
											<ice:outputLabel>
												<h:outputText styleClass="titleTextKml" value="#{stdGI5mBean.name}"></h:outputText>
											</ice:outputLabel>
	
										</ice:column>
										<ice:column>
											<f:facet name="header">
													<ice:outputText value="#{bundle['c_admin_usermanager.supp.address']}"></ice:outputText>
											</f:facet>
											<h:outputText styleClass="titleTextKml" value="#{stdGI5mBean.address}"></h:outputText>
										</ice:column>
										<ice:column>
											<f:facet name="header">
												<ice:outputText
													value="#{bundle['c_globalincidents_alerts.miles']}"></ice:outputText>
											</f:facet>
											<h:outputText styleClass="titleTextKml"
													value="#{stdGI5mBean.miles}"></h:outputText>
										</ice:column>
	
	
									</ice:dataTable>
									<br />
									<br />
									<ice:panelGroup style="float:left;width:420px;">
										<center>
											<ice:dataPaginator id="dataScroll_std5m"
												rendered="#{c_GI_Alerts_5MilesBean.selectedDataScrollModes[c_GI_Alerts_5MilesBean.selectedDataScrollMode].pagingEnabled}"
												for="tablestdgi5miles" vertical="false" fastStep="3" paginator="true"
												paginatorMaxPages="10">
												<f:facet name="first">
													<ice:graphicImage id="firstpage_1"
														url="./css/rime/css-images/arrow-first.gif"
														style="border:none;" title="first" />
												</f:facet>
												<f:facet name="last">
													<ice:graphicImage id="lastpage_1"
														url="./css/rime/css-images/arrow-last.gif"
														style="border:none;" title="last" />
												</f:facet>
												<f:facet name="previous">
													<ice:graphicImage id="previouspage_1"
														url="./css/rime/css-images/arrow-previous.gif"
														style="border:none;" title="previous" />
												</f:facet>
												<f:facet name="next">
													<ice:graphicImage id="nextpage_1"
														url="./css/rime/css-images/arrow-next.gif"
														style="border:none;" title="next" />
												</f:facet>
												<f:facet name="fastforward">
													<ice:graphicImage id="fastforward_1"
														url="./css/rime/css-images/arrow-ff.gif"
														style="border:none;" title="ff" />
												</f:facet>
												<f:facet name="fastrewind">
													<ice:graphicImage id="fastrewind_1"
														url="./css/rime/css-images/arrow-fr.gif"
														style="border:none;" title="fr" />
												</f:facet>
											</ice:dataPaginator>
										</center>
									</ice:panelGroup>
	
								</ice:panelGroup>
								
								</td>
								</tr>
							</table>
					
					
