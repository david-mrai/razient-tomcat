																																onmouseup="this.src='./css/images/icons/menu_up_on.png'"
																																onmousedown="this.src='./css/images/icons/menu_up_on.png'"
																																/>
																								</ice:commandLink>	
																								<br/><br/>
																				            </td>
																				        </tr>
																				        <tr style="vertical-align: top;">
																				            <td>
																				            	<ice:commandLink actionListener="#{c_DistributionAddSupplierGridBean.addOff}">
																															<ice:graphicImage style="border:none;" styleClass="noborder"
																																url="./css/images/icons/menu_up_off.png"
																																onmouseout="this.src='./css/images/icons/menu_up_off.png'"
																																onmouseover="this.src='./css/images/icons/menu_up_off.png'"
																																onmouseup="this.src='./css/images/icons/menu_up_off.png'"
																																onmousedown="this.src='./css/images/icons/menu_up_off.png'"
																																/>
																								</ice:commandLink>	
																				            </td>
																				        </tr>
																				    </table>
																					
																					
																			</ice:panelGrid>		
																	</td>
																</tr>
																<tr>
																	<td align="center">
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		<br/>
																	</td>
																</tr>
															</table>
															
															
															</td>
															<td>&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</td>
															<td valign="top"><br/>
																<ice:panelGroup>
																	
																	<ice:dataTable resizable="false" border="1" id="ctabledistsuppaddsup" value="#{c_DistributionAddSupplierGridBean.CSuppliersBean}" var="suppAddBean"  
																				width="98%" 
																				rows="#{c_DistributionAddSupplierGridBean.selectedDataScrollModes[c_DistributionAddSupplierGridBean.selectedDataScrollMode].rows}"
																               	scrollable="#{c_DistributionAddSupplierGridBean.selectedDataScrollModes[c_DistributionAddSupplierGridBean.selectedDataScrollMode].scrollingEnabled}"
																               	scrollHeight="200px"
																               	style="float:center;font-color: #FFFFFF;margin-top:2px;"
																               	columnWidths="1%,29%,25%,20%,25%"
																               	columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft"
																                rowClasses="rowOn,rowOff"
																               	cellpadding="0"
																				sortColumn="#{c_DistributionAddSupplierGridBean.columnNameOrder}" sortAscending="#{c_DistributionAddSupplierGridBean.descending}">
																		
																		<ice:column style="background-color:white;">
																			<ice:rowSelector id="selectedsuppaddsup"
											                                 value="#{c_DistributionAddSupplierGridBean.itemSelected}"
											                                 multiple="false"         
											                                 selectionListener="#{c_DistributionAddSupplierGridBean.rowSelectionListener}"
											                                 selectionAction="#{c_DistributionAddSupplierGridBean.rowSelectionAction}"/>               
											                                  <ice:graphicImage style="border:none;" styleClass="noborder" height="16"
																						url="./css/images/icons/menu_up_add.png"/>				
																		</ice:column>
																		
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="nameIdsuppaddsup" columnName="name">
											                        				<ice:outputText value="#{entityTypeBundle.entity_of}"/>
											                    				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="idnamesuppaddsup" value="#{suppAddBean.name}"/>
																		</ice:column>
																		<ice:column  groupOn="#{suppAddBean.countryDesc}"  style="background-color:#F7F4F5;">
																			<f:facet name="header">
																				<ice:commandSortHeader id="countryIdsuppaddsup" columnName="countryDesc"  >
											                        				<ice:outputText  value="#{bundle['c_admin_usermanager.supp.country']}"></ice:outputText>
											                    				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="idcountrysuppaddsup" style="font-weight:bold;text-align:center;" value="#{suppAddBean.countryDesc}"/>
																		</ice:column>
																		<ice:column groupOn="#{suppAddBean.stateDesc}" style="background-color:#F3F4F8;">
																			<f:facet name="header">
																				<ice:commandSortHeader id="stateaddsupsort" columnName="stateDesc">
																					<ice:outputText value="#{bundle['rz_admin_usermanager.cust.state']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="statedesc"
																				value="#{suppAddBean.stateDesc}" />
																		</ice:column>
																		<ice:column groupOn="#{suppAddBean.cityDesc}" style="background-color:#F4F7F5;">
																			<f:facet name="header">
																				<ice:commandSortHeader id="citysort" columnName="cityDesc">
																					<ice:outputText value="#{bundle['rz_admin_usermanager.cust.city']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="cityaddsupdesc"
																				value="#{suppAddBean.cityDesc}" />
																		</ice:column>
																		</ice:dataTable>
														
																		<ice:panelGroup styleClass="clearer"/>
																		  
												        				
																		<!-- Set up the buttons and links for browsing through the table
																             fastStep means No. of pages to fast forward or rewind: 3
																             paginatorMaxPages means No. of direct links to pages: 4 -->
																        <ice:panelGroup style="float:left;width:420px;">
															            <center>
															            <ice:dataPaginator id="dataScroll_1_suppaddsup"
															                   rendered="#{c_DistributionAddSupplierGridBean.selectedDataScrollModes[c_DistributionAddSupplierGridBean.selectedDataScrollMode].pagingEnabled}"
															                   for="ctabledistsuppaddsup"
															                   vertical="false" fastStep="3" paginator="true" paginatorMaxPages="4">
															                <f:facet name="first">
															                    <ice:graphicImage id="firstpage_1suppaddsup" url="./css/rime/css-images/arrow-first.gif" style="border:none;" title="first"/>
															                </f:facet>
															                <f:facet name="last">
															                    <ice:graphicImage id="lastpage_1suppaddsup" url="./css/rime/css-images/arrow-last.gif" style="border:none;" title="last"/>
															                </f:facet>
															                <f:facet name="previous">
															                    <ice:graphicImage id="previouspage_1suppaddsup" url="./css/rime/css-images/arrow-previous.gif" style="border:none;" title="previous"/>
															                </f:facet>
															                <f:facet name="next">
															                    <ice:graphicImage id="nextpage_1suppaddsup" url="./css/rime/css-images/arrow-next.gif" style="border:none;" title="next"/>
															                </f:facet>
															                <f:facet name="fastforward">
															                    <ice:graphicImage id="fastforward_1suppaddsup" url="./css/rime/css-images/arrow-ff.gif" style="border:none;" title="ff"/>
															                </f:facet>
															                <f:facet name="fastrewind">
															                    <ice:graphicImage id="fastrewind_1suppaddsup" url="./css/rime/css-images/arrow-fr.gif" style="border:none;" title="fr"/>
															                </f:facet>
															            </ice:dataPaginator>
															            </center>
															        </ice:panelGroup>
																
															</ice:panelGroup>
															</td>
															<td>&amp;nbsp</td>
														</tr>
													</table>
													</div>
										</ice:panelGrid>
	
										<ice:panelGrid>
												<div class="paneTableBox"  style="height:250px;margin-top:1px;overflow:auto;width:#{utilServiceLocatorBean.widthPanelDistribution}px;">
		
													<table width="85%" style="margin-left:10px;margin-top:3px;border:1px solid #C3DFF4;" cellspacing="0" cellpadding="0" border="0">
														<tr class="trHeader">
														<td class="trSubHeaderHigh" align="center">#{bundle['c_compliance_surveydistribution.supplier.titlesubhead']}</td>
														</tr>
														<tr >
															<td valign="top" class="tdcolumninfo">
															
																<br/>
																<table border="0" cellspacing="0" cellpadding="0" width="95%" >
																	<tr>
																		<td>
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		</td>
																		<td>
																		
																			<table cellpadding="0" cellspacing="0">
																						<tr>
																							<td class="tableflabelbuttons" width="160"  align="left">
																								<h:outputLabel >
																									<h:outputText value="#{bundle['c_compliance_surveydistribution.supplier.templatetype']} :"></h:outputText>
																								</h:outputLabel>
																							</td>
																						</tr>
																						<tr>
																							<td>
																								<ice:selectOneMenu id="selectedtemplatesaddsup"
																										value="#{c_DistributionAddSupplierGridBean.template}"
																										styleClass="selectedOneMenukeyBold"
																										valueChangeListener="#{c_DistributionAddSupplierGridBean.processValueChange}"
																										partialSubmit="true">
																										<f:selectItems value="#{c_DistributionAddSupplierGridBean.list_templates}" />
																								</ice:selectOneMenu>
																							</td>
																						</tr>
																			</table>
																		
																		</td>

																		<td>
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		</td>
																		<td>
																		
																			<table cellpadding="0" cellspacing="0" >
																						<tr>
																							<td class="tableflabelbuttons" width="160"   align="center">
																								<ice:outputLabel>
																									<h:outputText styleClass="titleLabelDistribution" value="#{bundle['c_compliance_surveydistribution.supplier.sendsurvey']}"></h:outputText>
																								</ice:outputLabel>
																							</td>
																						</tr>
																						<tr>
																							<td align="center">
																								<ice:commandLink actionListener="#{c_DistributionAddSupplierGridBean.sendmail}"  panelConfirmation="confirmexecute">
																																<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/icons/mail.png"/>
																								</ice:commandLink>
																							</td>
																						</tr>
																			</table>
																		
																		</td>
																	</tr>	
																</table>
																
																<br/>
															</td>
														</tr>
													</table>
													</div>
											</ice:panelGrid>
											
											
											
										</ice:panelTab>	
										
									</ice:panelTabSet>
								</ice:panelGroup>
							</ice:panelTab>
							
						</ice:panelTabSet>
							
					  </ice:panelGroup>
					</ice:form>
					
					<ice:form>    
							
						</ice:form>
					
					
						<ice:form>    
							
									<ice:panelConfirmation id="confirmexecute"   
									  acceptLabel="#{bundle['ice_confirmation.distribution.execute']}"  
									  cancelLabel="#{bundle['ice_confirmation.cancel']}"  
									  message="#{bundle['c_compliance_surveydistribution.supplier.mail.alreadydate']}"  
									  title="#{bundle['ice_confirmation.distribution.title']}"  
									  draggable="false"  
									 />
									
						</ice:form>
						<ice:form>

							<ice:panelPopup  modal="true" visible="#{viewlogsPopUpBean.visible}" style="margin-top:-90px;width:685px;" styleClass="icePanelPopupBody icePanelPopup">
				                <f:facet name="header">
				                   <ice:panelGrid width="685" cellpadding="0" cellspacing="1" columns="2" styleClass="trHeader" >
				                        <ice:outputText style="color: white;" value="#{bundle['rz_log']}"/>
				                        <ice:commandButton image="./css/images/icons/close.png" action="#{viewlogsPopUpBean.closePopup}" title="Close this draggable popup"/>
				                    </ice:panelGrid>
				                </f:facet>
				                <f:facet name="body">
				                	<ice:panelGrid width="100%">
				                		<table style="border:none;margin-top:-10px;float:left;">
				                			<tr>
				                				<td rowspan="2" valign="top"><ice:graphicImage styleClass="noborder" url="./css/images/general/log#{logger.stType}.png"/></td>
				                				<td style="color:#3A4358;font-weight:bold;">&amp;nbsp&amp;nbsp#{bundle['rz_compliance_surveydistribution.info']}</td>
				                			</tr>
				                			<tr>
				                				<td >
					                				 <ice:panelGrid width="100%" columns="1" cellpadding="0" border="1" style="background-color: #F4F4F4;border-color:black;" >
									                	<table align="center">
										                       	<tr>
											                       <td  width="610" colspan="3" class="tableflabelmaster" >
											                       		<div style="height:200px;overflow: auto;" >
											                       			#{logger.stLogger}
											                       		</div>
											                       </td>
											                    </tr>
											             </table>
								                 	</ice:panelGrid>
				                				</td>
				                			</tr>
				                			<tr>
				                				<td colspan="3" align="right">
					                				<ice:commandLink action ="#{viewlogsPopUpBean.closePopup}">
																<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/general/logexit.png"/>
													</ice:commandLink>
												</td>
				                			</tr>
				                		</table>
									</ice:panelGrid>
				                </f:facet>
				            </ice:panelPopup>  
				            </ice:form>
						
					<ice:messages style="margin-top:-5px;color:#1D115E; font-size: 11px;" globalOnly="false" />
				</ui:define>
				

			</ui:composition>

	

       </body>
    </html>
   </f:view>
