														<tr>
															<td bgcolor="#ffffff">
																<ice:panelGroup id="icePanelDGBI"
																	style="height:#{utilServiceLocatorBean.heightPanelTbGincidents+420}px;width:#{utilServiceLocatorBean.widthPanelTbGincidents}px;overflow:auto;border-color: #294D80;">

																	<div>

																		<ice:dataTable resizable="false"
																			border="1" id="tableGirn"
																			value="#{dashboard_GridBean.allCrudBeans}"
																			var="dGirnBean" width="95%"
																			rows="#{dashboard_GridBean.selectedDataScrollModes[dashboard_GridBean.selectedDataScrollMode].rows}"
																			scrollable="#{dashboard_GridBean.selectedDataScrollModes[dashboard_GridBean.selectedDataScrollMode].scrollingEnabled}"
																			style="float:left;margin-left:2px"
																			columnWidths="1%,20%,17%,13%,12%,12%,1%,13%,11%"
																			columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft"
																			rowClasses="rowOn,rowOff"
																			cellpadding="0"
																			sortColumn="#{dashboard_GridBean.columnNameOrder}"
																			sortAscending="#{dashboard_GridBean.descending}">
																			<ice:column>
																			<f:facet name="header">
																				<span
																					style="color: #F9FAF8; font-size: 9px; text-align: center">&amp;nbsp#{bundle['c_dh.map']}
																					</span>
																			</f:facet>
																			<ice:commandLink
																				action="#{dashboard_GridBean.viewIncidentAction}"
																				visible="true" onclick="rld();"
																				actionListener="#{dashboard_GridBean.rowSelectionListener}">
                           														<ice:graphicImage style="border:none;"  styleClass="noborder"
																					url		="./css/images/#{folderBean.folder_menu}/icons/menu_up_site_#{dGirnBean.siteType}.png"
																					onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_site_#{dGirnBean.siteType}.png'"
																					onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_site_#{dGirnBean.siteType}.png'"	
																					/>
																				<f:attribute name="idSelected"
																					value="#{dGirnBean.idrazienGlobalIncident}" />
																			</ice:commandLink>																			
																			</ice:column>
																			<!-- 
																			<ice:column style="text-align:center;">
																				<f:facet name="header">
																					<ice:outputText id="dSupp"
																						value="#{bundle['c_dh.SupplierId']}"></ice:outputText>
																				</f:facet>
																				<ice:outputLabel>
																					<h:outputText
																						styleClass="titleTextFileUpload"
																						value="#{dGirnBean.idSupplier}"></h:outputText>
																				</ice:outputLabel>
																			</ice:column>
																			 -->
																			<ice:column>
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_dh.SupplierName']}"></ice:outputText>
																				</f:facet>
																				<h:outputText id="diName"
																					value="#{dGirnBean.name}"
																					style="color: #808080; font-style: normal"></h:outputText>
																			</ice:column>
																			<ice:column groupOn="#{dGirnBean.city}" style="background-color:#F4F7F5;">
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_dh.SupplierCity']}"></ice:outputText>
																				</f:facet>
																				<h:outputText id="dCity"
																					styleClass="titleTextFileUpload"
																					value="#{dGirnBean.city}"></h:outputText>
																			</ice:column>
																			<ice:column groupOn="#{dGirnBean.state}" style="background-color:#F3F4F8;">
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_dh.SupplierState']}" ></ice:outputText>
																				</f:facet>
																				<h:outputText id="dState"
																					styleClass="titleTextKml"
																					value="#{dGirnBean.state}"></h:outputText>
																			</ice:column>
																			<ice:column groupOn="#{dGirnBean.country}" style="background-color:#F7F4F5;">
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_dh.SupplierCountry']}"></ice:outputText>
																				</f:facet>
																				<h:outputText id="dCountry"
																					styleClass="titleTextKml"
																					value="#{dGirnBean.country}"></h:outputText>
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_dh.GIType']}"></ice:outputText>
																				</f:facet>
																				<h:outputText id="dType"
																					styleClass="titleTextKml"
																					value="#{dGirnBean.type}"></h:outputText>
																			</ice:column>
																			<ice:column>
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_dh.GIImg']}"></ice:outputText>
																				</f:facet>																																								
																				<ice:commandLink action="#{dashboard_GridBean.viewIncidentPopUpAction}" actionListener="#{dashboard_GridBean.rowSelectionListener}">
																					<ice:graphicImage style="border:none;"  styleClass="noborder"
																							url="#{dGirnBean.imagetype}" height="25" width="25"/>
																					<f:attribute name="idSelected"
																					value="#{dGirnBean.idrazienGlobalIncident}" />																						
																				</ice:commandLink>																				
																			</ice:column>
																			<!-- 
																			<ice:column>
																				<f:facet name="header">
																					<ice:outputText
																						value="#{bundle['c_dh.SupplierPartService']}"></ice:outputText>
																				</f:facet>
																				<h:outputText id="dDescription" styleClass="titleTextKml"
																					value="#{dGirnBean.description}"></h:outputText>
																			</ice:column>
																			 -->
																			<ice:column style="text-align:center;">
																				<f:facet name="header">
																					<ice:commandSortHeader id="duSeverity"
																						columnName="riskLevel">
																						<ice:outputText
																							value="#{bundle['c_dh.GISeverity']}"></ice:outputText>
																					</ice:commandSortHeader>
																				</f:facet>
																				<h:outputText id="dSeverity"
																					styleClass="titleTextKml"
																					value="#{dGirnBean.riskLevel}"></h:outputText>
																			</ice:column>
																			<ice:column style="text-align:center;">
																				<f:facet name="header">
																					<ice:commandSortHeader id="duPosted"
																						columnName="posted">
																						<ice:outputText
																							value="#{bundle['c_dh.GIDatePosted']}"></ice:outputText>
																					</ice:commandSortHeader>
																				</f:facet>
																				<h:outputText id="dPosted"
																					styleClass="titleTextKml"
																					value="#{dGirnBean.dateNews}"></h:outputText>
																			</ice:column>
																		</ice:dataTable>
																	</div>
																</ice:panelGroup>
															</td>
														</tr>
														
													</table>
                                                
                                                </td>
                                               </tr>
                                            </tbody>
                                          </table>
                                          </td>
                                    	 
                                        </tr>
                                      </tbody>
