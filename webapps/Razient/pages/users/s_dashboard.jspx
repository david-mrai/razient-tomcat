                              <table width="100%" align="center" border="0" cellpadding="0" cellspacing="0">
                                <tbody>
                                  <tr>
                                    <td rowspan="2" style="background-repeat: repeat-x;" background="./css/images/general/dashcontent_header.png"  bgcolor="#ffffff"  valign="top">
                                    
                                    
       <!-- GLOBAL INCIDENTS TAB0-->   
       								<ice:form>                          
                                    <table id="tab0" style="display: block;" width="700px" border="0" cellpadding="0" cellspacing="0">
                                      <tbody>
                                        <tr>
                                        <td width="11" height="41" valign="top"><img src="./css/images/general/dashcontent_left_top.png" width="11" height="41"/></td>
                                    	 
                                    	 <td style="border-right: 1px solid rgb(239, 239, 239);" valign="top">
                                          <table width="100%" border="0" cellpadding="5" cellspacing="0">
                                            <tbody>
                                              <tr>
                                                <td height="41">
                                                	<h:outputLabel>
														<h:outputText styleClass="titleDashboard" value="#{bundle['c_dh.globalincidents']}"></h:outputText>
													</h:outputLabel>	
                                                </td>
                                              </tr>
                                              <tr>
                                                <td bgcolor="#ffffff">
                                                	<style type="text/css">
                                                		.dhGmpMapTd div.gmap {width: #{utilServiceLocatorBean.widthPanelMapDhGincidents}px; height: 500px}
														.dhGmpMapTd {visibility: block}
                                                	</style>
                                                	<ice:panelGroup >
														        <ice:gMap id="dhgimap"  rendered="true" styleClass="dhGmpMapTd" latitude="#{usersGIGmapBean.latitude}" longitude="#{usersGIGmapBean.longitude}" zoomLevel="#{usersGIGmapBean.zoomlevel}">														        	
														        	<ice:gMapGeoXml  url="#{bundle['url_upload']}#{bundle['url_kml']}#{bundle['url_supplier']}#{usersGIGmapBean.idSupplier}/#{usersGIGmapBean.nameKml}"/>
														        	<ice:gMapControl id="largectrl" name="GLargeMapControl" rendered="#{usersGIGmapBean.showControls}"/>
														            <ice:gMapControl id="scalectrl" name="GScaleControl" rendered="#{usersGIGmapBean.showControls}"/>
														            <ice:gMapControl id="typectrl" name="GMapTypeControl" rendered="#{usersGIGmapBean.showControls}"/>
																</ice:gMap>
													</ice:panelGroup>		
