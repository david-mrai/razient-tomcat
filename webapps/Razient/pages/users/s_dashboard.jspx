                                    <ice:form>
                                    <table id="tab1" style="display: none;" width="100%" border="0" cellpadding="0" cellspacing="0">
                                      <tbody>
                                        <tr>
                                        <td width="11" height="41" valign="top"><img src="./css/images/general/dashcontent_left_top.png" width="11" height="41"/></td>
                                    
                                          <td style="border-right: 1px solid rgb(239, 239, 239);" valign="top">
                                          <table width="100%" border="0" cellpadding="5" cellspacing="0">
                                            <tbody>
                                              <tr>
                                                <td height="41"><strong>#{bundle['c_dh_metrics.allsurveys.title']}</strong></td>
                                              </tr>
                                              <tr>
                                                <td align="center" bgcolor="#ffffff">
                                                
                                                 	<table class="tabularmetricsNewView"  style="border-left: 1px solid rgb(217, 217, 217);" width="100%" cellpadding="0" cellspacing="0">
	                                                  <tbody>
	                                                    <tr >
	                                                      <td  align="left" class="odd" width="70%">
	                                                      		<ice:selectOneMenu value="#{metricsQuestionsSurveyChartBean.idsurvey}" 
																		id="selectedSurvey" styleClass="selectedOneMasterSurvey"
																		partialSubmit="true" >
																		<f:selectItem itemLabel="#{bundle['rz_select_survey']}" itemValue="0" />
																		<f:selectItems value="#{metricsQuestionsSurveyChartBean.list_Surveys}" id="survey" />
																</ice:selectOneMenu>
