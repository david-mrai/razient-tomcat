																	<h:outputText styleClass="titleDashboard"
																		value="#{bundle['c_dh.hazardousincidents']}"></h:outputText>
																</h:outputLabel>

															</td>
														</tr>
														<tr>
															<td>
																<ice:panelGroup
																	style="float:left;width:420px;">
																	<div>
																		<center>
																			<ice:dataPaginator
																				id="dataScroll_tableGirn"
																				rendered="#{dashboard_GridBean.selectedDataScrollModes[dashboard_GridBean.selectedDataScrollMode].pagingEnabled}"
																				for="tableGirn" vertical="false"
																				fastStep="3" paginator="true"
																				paginatorMaxPages="10">
																				<f:facet name="first">
																					<ice:graphicImage id="firstpage_1"
																						url="./css/rime/css-images/arrow-first.gif"
																						style="border:none;" title="first" />
																				</f:facet>
																				<f:facet name="last">
																					<ice:graphicImage id="lastpage_1"
