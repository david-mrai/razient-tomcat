											<td class="tableffield">
						                         <ice:panelGroup styleClass="exampleBox inputRichTextContainer" >

												        <ice:inputRichText id="iceInpRchTxt"
												                           height="340"
												                           width="600"
												                           toolbar="#{c_TPTemplateBean.toolbarMode}"
