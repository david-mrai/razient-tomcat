											<td>
												&amp;nbsp
											</td>
											<td class="tdHeaderEmail">
												<h:outputLabel>
													<h:outputText
														value="#{bundle['c_admin_usermanager.template.subject']}"></h:outputText>
												</h:outputLabel>
											</td>
											<td class="tableffield">
						                          <ice:inputTextarea id="bodyText"
												   cols="115"
												   rows="2"
						                           maxlength="480"
						                           value="#{c_TPTemplateBean.subject}"
						                           partialSubmit="true"
						                           styleClass="fieldsimple">
						                         </ice:inputTextarea>
											</td>
											<td>
												&amp;nbsp
											</td>
											<td>
