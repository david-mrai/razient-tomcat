												</h:outputLabel>
											</td>
											<td align="left">
												<ice:inputText id="key" size="5" maxlength="3"
													value="#{c_TPTemplateBean.keyname}" partialSubmit="true"
													readonly="false" styleClass="fieldkeymaster"
													title="Integer">
												</ice:inputText>
											</td>
											<td>
												&amp;nbsp
											</td>
											<td>
												&amp;nbsp
											</td>
										</tr>
										
										<tr class="trrow2">
											<td >
												&amp;nbsp
											</td>
											<td class="tdHeaderEmail">
												<h:outputLabel>
													<h:outputText
														value="#{bundle['c_admin_usermanager.template.name']}"></h:outputText>
												</h:outputLabel>
											</td>
											<td align="left">
												<ice:inputText id="name" size="45" maxlength="49"
													value="#{c_TPTemplateBean.name}" partialSubmit="true"
													readonly="false" styleClass="fieldkeymasterbg"
												>
												</ice:inputText>
											</td>
											<td>
												&amp;nbsp
											</td>
											<td>
												&amp;nbsp
											</td>
										</tr>
