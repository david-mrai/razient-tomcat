			    <ui:define name="page-menu-value">
			    	 <ice:form>
					 
					<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
					 	<ice:graphicImage visible="true"  styleClass="menuPosA"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_survey.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_survey.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_survey.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_survey.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_survey.png'" />
						<f:attribute name="optioonselected" value="rp_sv"/>			
					</ice:commandLink>		
					<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
					 	<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_proposal.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_proposal.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_proposal.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_proposal.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_proposal.png'" />
						<f:attribute name="optioonselected" value="rp_pp"/>
					</ice:commandLink>	
						<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_down_globalincidents.png"/>
									
					<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_one.png"/>
									
						
					 </ice:form> 	
			    </ui:define>
			    
				<ui:define name="page-content-value">
					<table cellspacing="0" cellpadding="3"  class="dataTable">
                    <tr>
                      <td><strong>Survey Selection</strong></td>
                      <td>PCI v1.2 Compliance Q1 2010</td>
                    </tr>
                    <tr>
                      <td><strong>Category</strong></td>
                      <td>Build and maintain a Secure    Network</td>
                    </tr>
                    <tr>
                      <td><strong>Subcategory</strong></td>
                      <td>Requirement 1:    Install and maintain a firewall configuration to protect cardholder data</td>
                    </tr>
                    </table>
                    <table border="1" cellpadding="5" cellspacing="0" class="tabularView" style="border: 1px #C3DFF4 solid;">
                    <tr >
                      <th bgcolor="#3C7FB1" style="color:#FFFFFF">ID</th>
                      <th style="color:#FFFFFF" bgcolor="#3C7FB1">Standard</th>
                      <th bgcolor="#3C7FB1" style="color:#FFFFFF">Question</th>
                      <th style="color:#FFFFFF" bgcolor="#3C7FB1">Answer</th>
                      <th bgcolor="#3C7FB1" style="color:#FFFFFF">Automated Risk    Rating of Answer</th>
                    </tr>
                    <tr bgcolor="#FFFFFF">
                      <td>PCi111</td>
                      <td>A formal process for approving and testing all external network connections and changes to the firewall configuration</td>
                      <td>Do you have a formal process for approving and testing all external network connections and changes to the firewall configuration ?</td>
                      <td>Yes</td>
                      <td>Acceptable</td>
                    </tr>
                    <tr class="odd" bgcolor="#EFF2FF">
                      <td>PCI112</td>
                      <td>A current network diagram with all connections to cardholder data, including    any wireless networks</td>
                      <td>Do you have a current network diagram with all connections to cardholder data,    including any wireless networks?</td>
                      <td>No</td>
                      <td>Medium</td>
                    </tr>
                  </table>
                   <br/>
                  <table cellpadding="3" cellspacing="0" class="dataTable">
                    <tr>
                      <td><strong>Category</strong></td>
                      <td colspan="4">Protect Cardholder    Data</td>
                    </tr>
                    <tr>
                      <td><strong>Subcategory</strong></td>
                      <td colspan="4">Requirement 3:    Protect stored cardholder data</td>
                    </tr>
                  </table>
                  <table border="1" cellpadding="5" cellspacing="0" class="tabularView" style="border: 1px #C3DFF4 solid;">
                    <tr>
                      <th bgcolor="#3C7FB1" style="color:#FFFFFF">ID</th>
                      <th style="color:#FFFFFF" bgcolor="#3C7FB1">Standard</th>
                      <th bgcolor="#3C7FB1" style="color:#FFFFFF">Question</th>
                      <th style="color:#FFFFFF" bgcolor="#3C7FB1">Answer</th>
                      <th bgcolor="#3C7FB1" style="color:#FFFFFF">Automated Risk    Rating of Answer</th>
                    </tr>
                    <tr bgcolor="#FFFFFF">
                      <td bgcolor="#FFFFFF">PCI31</td>
                      <td>Keep cardholder    data storage to a minimum. Develop a data retention and disposal policy</td>
                      <td>Doyou have a    data retention and disposal policy?</td>
                      <td>No</td>
                      <td>Low</td>
                    </tr>
                    <tr class="odd" bgcolor="#EFF2FF">
                      <td>PCI32</td>
                      <td>Do    not store sensitive authentication data subsequent to authorization (even if    encrypted).</td>
                      <td>Is    sensitive authentication data subsequent to authorization stored?</td>
                      <td>Yes</td>
                      <td>Acceptable</td>
                    </tr>
                    <tr bgcolor="#FFFFFF">
                      <td>PCI33</td>
                      <td>You    must have a proactive monitoring solution</td>
                      <td>How    proactive is your monitoring solution?</td>
                      <td>7    (out of 10)</td>
                      <td>Informational</td>
                    </tr>
                    <tr class="odd" bgcolor="#EFF2FF">
                      <td>PCI34</td>
                      <td>You    should have a process for educating employees on cardholder data security</td>
                      <td>What    is your process for educating employees on cardholder data security?</td>
                      <td>We    have a training session every month.</td>
                      <td>Acceptable</td>
                    </tr>
                  </table>
                  <br/>
                  <table border="1" cellpadding="5" cellspacing="0" class="tabularView" style="border: 1px #C3DFF4 solid;">
                    <tr>
                      <th align="left" bgcolor="#3C7FB1" style="color:#FFFFFF" width="500">Survey:    PCI Compliance Q1 2010</th>
                      <th width="400" align="left" bgcolor="#3C7FB1" style="color:#FFFFFF">Risk Results</th>
                    </tr>
                    <tr bgcolor="#FFFFFF">
                      <td bgcolor="#FFFFFF">High</td>
                      <td align="right">3</td>
                    </tr>
                    <tr class="odd" bgcolor="#EFF2FF">
                      <td>Medium</td>
                      <td align="right">5</td>
                    </tr>
                    <tr bgcolor="#FFFFFF">
                      <td>Low</td>
                      <td align="right">20</td>
                    </tr>
                    <tr class="odd" bgcolor="#EFF2FF">
                      <td>Informational</td>
                      <td align="right">40</td>
                    </tr>
                    <tr bgcolor="#FFFFFF">
                      <td>Acceptable</td>
                      <td align="right">32</td>
                    </tr>
                  </table>
                  <br/>
                  <br/>
                  <table width="100%" border="0" cellspacing="0" cellpadding="5">
                    <tr bgcolor="#FFFFFF">
                      <td bgcolor="#FFFFFF"><div align="center"><img src="./css/images/general/print.png" width="21" height="21"/><font color="#FFFFFF">&amp;&amp;</font><img src="./css/images/general/submit.png" width="71" height="25"/></div></td>
                    </tr>
                  </table>
				</ui:define>
				

			</ui:composition>

	

       </body>
    </html>
