															<ice:column>
																<f:facet name="header">
																	<ice:outputText 
																		value="#{bundle['c_reports_research.graph2.rl']}"></ice:outputText>
																</f:facet>
																<h:outputText id="risklevel"
																	value="#{dRRBean.severityLevel}"
																	style="color: #808080; font-style: normal; font-size: 10px;"></h:outputText>
															</ice:column>
															<ice:column style="text-align:center;">
																<f:facet name="header">
																	<ice:outputText 
																		value="#{entityTypeBundle.entity_ofs} #{bundle['c_reports_research.graph2.supp']}"></ice:outputText>
																</f:facet>
																<h:outputText id="numberimpacted"
																	style="color: #808080; font-style: normal; font-size: 10px;"
																	value="#{dRRBean.numberofincidents}"></h:outputText>
															</ice:column>
														</ice:dataTable>
													</div>
													</ice:panelGroup>
