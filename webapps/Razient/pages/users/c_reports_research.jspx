															var="dRRBean" width="100%"
															rows="#{researchGridBean.selectedDataScrollModes[researchGridBean.selectedDataScrollMode].rows}"
															scrollable="#{researchGridBean.selectedDataScrollModes[researchGridBeanselectedDataScrollMode].scrollingEnabled}"
