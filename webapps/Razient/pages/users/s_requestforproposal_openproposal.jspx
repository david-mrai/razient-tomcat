<?xml version="1.0" encoding="utf-8" ?>
<jsp:root version="1.2"
   xmlns:jsp="http://java.sun.com/JSP/Page"
   xmlns:f="http://java.sun.com/jsf/core"
   xmlns:h="http://java.sun.com/jsf/html"
   xmlns:ice="http://www.icesoft.com/icefaces/component">
   <jsp:directive.page contentType="text/html;charset=ISO-8859-1" pageEncoding="ISO-8859-1" />
   <f:view>
   		<ice:outputDeclaration 
            doctypeRoot="html" 
            doctypePublic="-//W3C//DTD HTML 4.01 Transitional//EN" 
            doctypeSystem="http://www.w3.org/TR/html4/loose.dtd" /> 
    <html>
       <head>
         <title>Index (Razient)</title>
       </head>
       <body>
       
        	<!-- template="#{templateBean.templateContent}"-->
			<ui:composition
			        template="../../include/templates/pages/modeB_supplier.jspx"
			        xmlns:h="http://java.sun.com/jsf/html"
			        xmlns:f="http://java.sun.com/jsf/core"
			        xmlns:c="http://java.sun.com/jstl/core"
			        xmlns:ice="http://www.icesoft.com/icefaces/component"
			        xmlns:ui="http://java.sun.com/jsf/facelets" >
			
			  <!-- params for page titles-->
			 		 <!--<f:loadBundle basename="truckandi.view.bundle.Message" var="bundle"/>
			        <ui:param name="pageTitle" value="#{bundle['tai_login.title']}" />-->
					<ui:param name="pageTitle" value="Request For Proposal" />
				
				<ui:define name="header_menu_value">
						<table cellspacing="0" cellpadding="0">
										<tr>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">		
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_dash_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_2.png'" />
														<f:attribute name="optioonselected" value="dh"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_Survey}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_survey_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_survey_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_survey_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_survey_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_survey_2.png'" />
													<f:attribute name="optioonselected" value="sv_sv"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_GlobalIncidents}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_global_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_2.png'" />
													<f:attribute name="optioonselected" value="gi_al"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>																																				
												<ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/#{folderBean.folder_menu}/risk_request_2.png"  visible="#{users_MenuBarBean.visible_S_RequestForProposal}"/>	
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_Reports}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_rep_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_2.png'" />
													<f:attribute name="optioonselected" value="rp_sv"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_Administration}">																								
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_2.png'" />
														<f:attribute name="optioonselected" value="ad_um"/>
												</ice:commandLink>
											</td>
										</tr>
									</table>			
				</ui:define>
			    
			    <ui:define name="page-menu-value">
			    	 <ice:form>
					 
					 <ice:graphicImage visible="true"  styleClass="menuPosA"
										url		="./css/images/#{folderBean.folder_menu}/risk_menu_down_openproposals.png"/>
					<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
					 	<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_placebids.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_placebids.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_placebids.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_placebids.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_placebids.png'" />
						<f:attribute name="optioonselected" value="rp_pb"/>
					</ice:commandLink>	
					 
					<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_one.png"/>
									
					 </ice:form> 	
			    </ui:define>
			    
				<ui:define name="page-content-value">
					<table cellspacing="0" border="1" cellpadding="5" class="tabularView" style="border: 1px #C3DFF4 solid;">
                  <tr bgcolor="#3C7FB1" style="color:#FFFFFF">
                    <th>Company</th>
                    <th>RFP ID</th>
                    <th>RFP Name</th>
                    <th>RFP Brief    Description</th>
                    <th>Rfp Due Date</th>
                    <th>Review Details</th>
                    <th>Email Customer</th>
                  </tr>
                  <tr bgcolor="#FFFFFF">
                    <td>Cisco</td>
                    <td align="right">112233</td>
                    <td>Build    New Router</td>
                    <td>New    manufacturing company will build new router to specs.</td>
                    <td align="right">7/30/2010</td>
                    <td><img width="27" height="27" src="./css/images/general/select.png" alt="checkbox.jpg" /></td>
                    <td><img src="./css/images/general/mail.png" width="27" height="27"/></td>
                  </tr>
                  <tr class="odd" bgcolor="#EFF2FF">
                    <td>IBM</td>
                    <td align="right">223333</td>
                    <td>Build    a Data center</td>
                    <td>Build    a new data center in Shanghai China</td>
                    <td align="right">8/30/2010</td>
                    <td><img width="27" height="27" src="./css/images/general/select.png" alt="checkbox.jpg" /></td>
                    <td><img src="./css/images/general/mail.png" width="27" height="27"/></td>
                  </tr>
                  <tr bgcolor="#FFFFFF">
                    <td>Nike</td>
                    <td align="right">444444</td>
                    <td>Design    new Shoe</td>
                    <td>Design    a new shoe for LeBron James</td>
                    <td align="right">9/30/2010</td>
                    <td><img width="27" height="27" src="./css/images/general/select.png" alt="checkbox.jpg" /></td>
                    <td><img src="./css/images/general/mail.png" width="27" height="27"/></td>
                  </tr>
                </table>
				</ui:define>
				

			</ui:composition>

	

       </body>
    </html>
   </f:view>
</jsp:root>
