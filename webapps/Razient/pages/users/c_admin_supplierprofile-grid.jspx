							  	 		<table cellpadding="0" cellspacing="0" style="margin-top:0px;">
							  	 			<tr>
							  	 					<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
							  	 					<td class="tableflabelmasterbold">
														<h:outputLabel>
															<h:outputText
																value="#{bundle['rz_admin_usermanager.cust.country']}"></h:outputText>
														</h:outputLabel>&amp;nbsp&amp;nbsp
													</td>
													<td class="tableffieldleft" colspan="3">
														<ice:selectOneMenu value="#{c_SupplierProfileGridBean.country}"
															id="selectedCountry" styleClass="selectedOneMasterCountry"
															valueChangeListener="#{c_SupplierProfileGridBean.processValueChange}"
															partialSubmit="true">
															<f:selectItem itemLabel="#{bundle['rz_select_country']}"
																itemValue="0" />
															<f:selectItems
																value="#{applicationBean.countrySelectedItems}"
																id="country" />
														</ice:selectOneMenu>
													</td>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td class="tableflabelmasterbold">
														<h:outputLabel>
															<h:outputText
																value="#{bundle['rz_admin_usermanager.cust.state']}"></h:outputText>
														</h:outputLabel>&amp;nbsp&amp;nbsp
													</td>
													<td class="tableffieldleft">
														<ice:selectOneMenu value="#{c_SupplierProfileGridBean.state}"
															id="selectedState" styleClass="selectedOneMasterState"
															valueChangeListener="#{c_SupplierProfileGridBean.processValueChange}"
															partialSubmit="true">
															<f:selectItem itemLabel="#{bundle['rz_select_state']}" itemValue="0" />
															<f:selectItems value="#{c_SupplierProfileGridBean.list_State}" id="state" />
														</ice:selectOneMenu>
													</td>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td class="tableflabelmasterbold">
														<h:outputLabel>
															<h:outputText
																value="#{bundle['rz_admin_usermanager.cust.city']}"></h:outputText>
														</h:outputLabel>&amp;nbsp&amp;nbsp
													</td>
													<td class="tableffieldleft">
														<ice:selectOneMenu value="#{c_SupplierProfileGridBean.city}"
															id="selectedCity" styleClass="selectedOneMasterState"
															valueChangeListener="#{c_SupplierProfileGridBean.processValueChange}"
															partialSubmit="true">
															<f:selectItem itemLabel="#{bundle['rz_select_city']}"
																itemValue="0" />
															<f:selectItems value="#{c_SupplierProfileGridBean.list_City}"
																id="city" />
														</ice:selectOneMenu>
													</td>
													<td>
													&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
								  	 				<td>
								  	 					
								  	 					<ice:commandLink action="#{c_SupplierProfileGridBean.find_x_Items_Action}"  onclick="rld();">
															<ice:graphicImage style="border:none;" styleClass="noborder"
																url="./css/images/#{folderBean.folder_menu}/icons/menu_up_search.png"
																onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_search.png'"
																onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_search.png'"
																
																/>
														</ice:commandLink>
													</td>
								  	 				<td>&amp;nbsp</td>
							  	 			</tr>
							  	 			</table>
							  	 			<br/>
							  	 			<table cellpadding="0" cellspacing="0" style="margin-top:0px;">
							  	 			<tr>
							  	 				
							  	 			</tr>						  	 		
							  	 			</table>
						  	 		</div>
						    	</ice:panelTab>
							</ice:panelTabSet>  
						</ice:panelGroup>

						</h:form>
						<h:form>
							<br/><br/><br/><br/><br/><br/><br/><br/>

							<ice:panelGroup styleClass="customerProfileBox"
								style="height:#{utilServiceLocatorBean.heightPanelCustomerProfileGrid}px;width:97%;overflow:auto;">

									<ice:panelGroup>
										<ice:panelGroup>
											<!-- PAGINATOR-->
											<ice:panelGroup style="float:left;width:420px;">
												<center>
													<ice:dataPaginator id="dataScroll_2"
														rendered="#{c_SupplierProfileGridBean.selectedDataScrollModes[c_SupplierProfileGridBean.selectedDataScrollMode].pagingEnabled}"
														for="tablesupgrid" vertical="false" fastStep="3" paginator="true"
														paginatorMaxPages="10">
														<f:facet name="first">
															<ice:graphicImage id="firstpage_2"
																url="./css/rime/css-images/arrow-first.gif"
																style="border:none;" title="first" />
														</f:facet>
														<f:facet name="last">
															<ice:graphicImage id="lastpage_2"
																url="./css/rime/css-images/arrow-last.gif"
																style="border:none;" title="last" />
														</f:facet>
														<f:facet name="previous">
															<ice:graphicImage id="previouspage_2"
																url="./css/rime/css-images/arrow-previous.gif"
																style="border:none;" title="previous" />
														</f:facet>
														<f:facet name="next">
															<ice:graphicImage id="nextpage_2"
																url="./css/rime/css-images/arrow-next.gif"
																style="border:none;" title="next" />
														</f:facet>
														<f:facet name="fastforward">
															<ice:graphicImage id="fastforward_2"
																url="./css/rime/css-images/arrow-ff.gif"
																style="border:none;" title="ff" />
														</f:facet>
														<f:facet name="fastrewind">
															<ice:graphicImage id="fastrewind_2"
																url="./css/rime/css-images/arrow-fr.gif"
																style="border:none;" title="fr" />
														</f:facet>
													</ice:dataPaginator>
												</center>
											</ice:panelGroup>
											
											<ice:dataTable resizable="false" border="1" id="tablesupgrid"
												value="#{c_SupplierProfileGridBean.allCrudBeans}"
												var="adminSupplierBean"
												width="98%"
												rows="#{c_SupplierProfileGridBean.selectedDataScrollModes[c_SupplierProfileGridBean.selectedDataScrollMode].rows}"
												scrollable="#{c_SupplierProfileGridBean.selectedDataScrollModes[c_SupplierProfileGridBean.selectedDataScrollMode].scrollingEnabled}"
												scrollHeight="200px"
												style="float:center;font-color: #FFFFFF;"
												columnWidths="1%,29%,15%,15%,15%,10%,10%,5%"
												columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
												rowClasses="rowOn,rowOff" cellpadding="0"
												sortColumn="#{c_SupplierProfileGridBean.columnNameOrder}"
												sortAscending="#{c_SupplierProfileGridBean.descending}"
												onclick="window.location.reload()">

												<ice:column>
													<ice:rowSelector id="selected"
														value="#{c_SupplierProfileGridBean.itemSelected}" multiple="false"
														selectionListener="#{c_SupplierProfileGridBean.rowSelectionListener}"
														selectionAction="#{c_SupplierProfileGridBean.rowSelectionAction}" />               
									                    <f:facet name="header">
														<ice:commandSortHeader id="typeentsort" columnName="typeEntity">
															<ice:outputText value="#{bundle['rz_typeentity']}"></ice:outputText>
														</ice:commandSortHeader>
													     </f:facet>
														<ice:outputText id="identity" value="#{adminSupplierBean.typeEntityDesc}" />	
												</ice:column>
												<ice:column>
													<f:facet name="header">
														<ice:commandSortHeader id="namesort" columnName="sp.name">
															<ice:outputText value="#{bundle['c_admin_usermanager.supp.name']}"></ice:outputText>
														</ice:commandSortHeader>
													</f:facet>
													<ice:outputText id="idname"
														value="#{adminSupplierBean.name}" />
												</ice:column>
												<ice:column groupOn="#{adminSupplierBean.countryDesc}"  style="background-color:#F7F4F5;">
													<f:facet name="header">
														<ice:commandSortHeader id="countrysort" columnName="countryDesc">
															<ice:outputText value="#{bundle['c_admin_usermanager.supp.country']}" ></ice:outputText>
														</ice:commandSortHeader>
													</f:facet>
													<ice:outputText id="countrydesc" style="font-weight:bold;text-align:center;"
														value="#{adminSupplierBean.countryDesc}" />
												</ice:column>
												<ice:column groupOn="#{adminSupplierBean.stateDesc}" style="background-color:#F3F4F8;">
													<f:facet name="header">
														<ice:commandSortHeader id="statesort" columnName="stateDesc">
															<ice:outputText value="#{bundle['c_admin_usermanager.supp.state']}"></ice:outputText>
														</ice:commandSortHeader>
													</f:facet>
													<ice:outputText id="statedesc"
														value="#{adminSupplierBean.stateDesc}" />
												</ice:column>
												<ice:column groupOn="#{adminSupplierBean.cityDesc}" style="background-color:#F4F7F5;">
													<f:facet name="header">
														<ice:commandSortHeader id="citysort" columnName="cityDesc">
															<ice:outputText value="#{bundle['c_admin_usermanager.supp.city']}"></ice:outputText>
														</ice:commandSortHeader>
													</f:facet>
													<ice:outputText id="citydesc"
														value="#{adminSupplierBean.cityDesc}" />
												</ice:column>
												<ice:column>
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['c_admin_usermanager.supp.phone']}"></ice:outputText>
													</f:facet>
													<ice:outputText id="idPhone"
														value="#{adminSupplierBean.phone}" />
												</ice:column>
												<ice:column>
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['c_admin_usermanager.supp.website']}"></ice:outputText>
													</f:facet>
													<ice:outputText id="idwebSite"
														value="#{adminSupplierBean.webSite}" />
												</ice:column>
												<ice:column style="background-color:white;">
													<f:facet name="header" >
														<span style="color:#F9FAF8;font-size:9px;text-align: center">&amp;nbsp</span>
													</f:facet>
													<ice:graphicImage style="border:none;" styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_down_profile.png"
														onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_profile.png'"
														onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_profile.png'"
													
													/>
												</ice:column>
											</ice:dataTable>
											<ice:panelGroup styleClass="clearer" />


											<!-- PAGINATOR-->
											<ice:panelGroup style="float:left;width:420px;">
												<center>
													<ice:dataPaginator id="dataScroll_1"
														rendered="#{c_SupplierProfileGridBean.selectedDataScrollModes[c_SupplierProfileGridBean.selectedDataScrollMode].pagingEnabled}"
														for="tablesupgrid" vertical="false" fastStep="3" paginator="true"
														paginatorMaxPages="10">
														<f:facet name="first">
															<ice:graphicImage id="firstpage_1"
																url="./css/rime/css-images/arrow-first.gif"
																style="border:none;" title="first" />
														</f:facet>
														<f:facet name="last">
															<ice:graphicImage id="lastpage_1"
																url="./css/rime/css-images/arrow-last.gif"
																style="border:none;" title="last" />
														</f:facet>
														<f:facet name="previous">
															<ice:graphicImage id="previouspage_1"
																url="./css/rime/css-images/arrow-previous.gif"
																style="border:none;" title="previous" />
														</f:facet>
														<f:facet name="next">
															<ice:graphicImage id="nextpage_1"
																url="./css/rime/css-images/arrow-next.gif"
																style="border:none;" title="next" />
														</f:facet>
														<f:facet name="fastforward">
															<ice:graphicImage id="fastforward_1"
																url="./css/rime/css-images/arrow-ff.gif"
																style="border:none;" title="ff" />
														</f:facet>
														<f:facet name="fastrewind">
															<ice:graphicImage id="fastrewind_1"
																url="./css/rime/css-images/arrow-fr.gif"
																style="border:none;" title="fr" />
														</f:facet>
													</ice:dataPaginator>
												</center>
											</ice:panelGroup>

										</ice:panelGroup>

									</ice:panelGroup>

							</ice:panelGroup>

						</h:form>

						<ice:form>
							<ice:panelPopup  modal="true" visible="#{viewlogsPopUpBean.visible}" style="margin-top:-90px;width:485px;" styleClass="icePanelPopupBody icePanelPopup">
					                <f:facet name="header">
					                   <ice:panelGrid width="485" cellpadding="0" cellspacing="1" columns="2" styleClass="trHeader" >
					                        <ice:outputText style="color: white;" value="#{bundle['rz_log']}"/>
					                        <ice:commandButton image="./css/images/icons/close.png" action="#{viewlogsPopUpBean.closePopup}" title="Close this draggable popup"/>
					                    </ice:panelGrid>
					                </f:facet>
					                <f:facet name="body">
					                	<ice:panelGrid width="100%">
					                		<table style="border:none;margin-top:-10px;float:left;">
					                			<tr>
					                				<td rowspan="2" valign="top"><ice:graphicImage styleClass="noborder" url="./css/images/general/log#{logger.stType}.png"/></td>
					                				<td style="color:#3A4358;font-weight:bold;">&amp;nbsp&amp;nbsp#{logger.stType}</td>
					                			</tr>
					                			<tr>
					                				<td >
						                				 <ice:panelGrid width="100%" columns="1" cellpadding="0" border="1" style="background-color: #F4F4F4;border-color:black;" >
										                	<table align="center">
											                       	<tr>
												                       <td  width="410" colspan="3" class="tableflabelmaster" >
												                       		<div style="height:200px;overflow: auto;" >
												                       			#{logger.stLogger}
												                       		</div>
												                       </td>
												                    </tr>
												             </table>
									                 	</ice:panelGrid>
					                				</td>
					                			</tr>
					                			<tr>
					                				<td colspan="3" align="right">
						                				<ice:commandLink action ="#{viewlogsPopUpBean.closePopup}">
																	<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/general/logexit.png"/>
														</ice:commandLink>
													</td>
					                			</tr>
					                		</table>
										</ice:panelGrid>
					                </f:facet>
					            </ice:panelPopup> 
							</ice:form>


					</ui:define>


				</ui:composition>



			</body>
		</html>
	</f:view>
</jsp:root>
