																					<h:outputText id="d1supply"
																						styleClass="titleTextKml"
																						value="#{dGirnBean.nameciidSupplier}"></h:outputText>
																					<f:attribute name="idSelectedTicketIncidents"
																					value="#{dGirnBean.ciidcustomerTicketIncidents}" />																						
														</ice:commandLink>
													
													&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp	
												</ice:column>
												<ice:column styleClass="fontticket#{dGirnBean.statuscolor}">
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['c_admin_ticket.alerts.site']}"></ice:outputText>
													</f:facet>
													<h:outputText id="d1Sitex"
