																url="./css/rime/css-images/arrow-first.gif"
																style="border:none;" title="first" />
														</f:facet>
														<f:facet name="last">
															<ice:graphicImage id="lastpage_1"
																url="./css/rime/css-images/arrow-last.gif"
																style="border:none;" title="last" />
														</f:facet>
														<f:facet name="previous">
															<ice:graphicImage id="previouspage_1"
																url="./css/rime/css-images/arrow-previous.gif"
																style="border:none;" title="previous" />
														</f:facet>
														<f:facet name="next">
															<ice:graphicImage id="nextpage_1"
																url="./css/rime/css-images/arrow-next.gif"
																style="border:none;" title="next" />
														</f:facet>
														<f:facet name="fastforward">
															<ice:graphicImage id="fastforward_1"
																url="./css/rime/css-images/arrow-ff.gif"
																style="border:none;" title="ff" />
														</f:facet>
														<f:facet name="fastrewind">
															<ice:graphicImage id="fastrewind_1"
																url="./css/rime/css-images/arrow-fr.gif"
																style="border:none;" title="fr" />
														</f:facet>
													</ice:dataPaginator>
												</center>
											</ice:panelGroup>

										</ice:panelGroup>

									</ice:panelGroup>

							</ice:panelGroup>
							
						</ice:panelTab>
			
						</ice:panelTabSet>
					  </ice:panelGroup>
									

					</ice:form>
					
					<ice:form>
							
										<ice:panelPopup  autoPosition="200,100" autoCentre="true" modal="true" visible="#{viewTicketVendorPopUpBean.visible}" style="width:700px;" styleClass="icePanelPopupBody icePanelPopup">
							                <f:facet name="header">
							                   <ice:panelGrid width="100%" cellpadding="0" cellspacing="0" columns="2" styleClass="trHeader" >
							                        <ice:outputText style="color: white;" value="#{bundle['c_dh.hazardousincidents']}"/>
							                        <ice:commandButton image="./css/images/icons/close.png" action="#{viewTicketVendorPopUpBean.closePopup}" title="Close this draggable popup"/>
							                    </ice:panelGrid>
							                </f:facet>
							                
							                <f:facet name="body">
							                    <ice:panelGrid width="100%" columns="2" cellpadding="0"  style="background-color: #FFFFFF">

							              			<table style='text-align: left;  height: 240px;' width="100%" border='1' border-color='gray' border-style='solid' cellpadding='2' cellspacing='2'>
													<tr style='font-weight: bold;'>
														<td style='height: 78px; width: 184px;' ><span style='font-weight: normal;'> <img src='#{c_TicketViewVendor_GridBean.imageUrl}' height="80" width="80"/></span></td>
														<td colspan='3' rowspan='1' style='height: 78px; width: 291px;font-size: 15px;font-variant: small-caps;' >#{bundle['rz_popup.map_incident']}: #{c_TicketViewVendor_GridBean.rntype} <br/><br/>#{bundle['rz_popup.map_locate']}: #{c_TicketViewVendor_GridBean.rncity}</td>
													</tr>
													<tr>
														<td style='height: 0px; width: 184px; text-align: left;' valign='undefined'><span style='font-weight: bold;'>#{bundle['rz_popup.map_incidentsummary']}</span></td>
													<td colspan='3' rowspan='1' style='height: 0px; width: 291px;' >#{c_TicketViewVendor_GridBean.rntitle}</td>
													</tr>	
													<tr>	
													<td style='width: 184px; height: 26px; font-weight: bold;' >#{bundle['rz_popup.map_country']}</td>
													<td style='width: 292px; height: 26px;' >#{c_TicketViewVendor_GridBean.rncountry}</td>
													<td style='height: 26px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_severity']}</td>
													<td style='height: 26px; width: 291px;' >#{c_TicketViewVendor_GridBean.rnriskLevel}</td>
													</tr>	
													<tr>	
													<td style='width: 184px; height: 30px; font-weight: bold;' >#{bundle['rz_popup.map_state']}</td>
													<td style='width: 292px; height: 30px;' >#{c_TicketViewVendor_GridBean.rnstate}</td>
													<td style='height: 30px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_incidenttype']}</td>
													<td style='height: 30px; width: 291px;' >#{c_TicketViewVendor_GridBean.rntype}</td>
													</tr>
													<tr>
													<td style='width: 184px; height: 24px; font-weight: bold;' >#{bundle['rz_popup.map_city']}</td>
													<td style='width: 292px; height: 24px;' >#{c_TicketViewVendor_GridBean.rncity}</td>
													<td style='height: 24px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_date']}</td>
													<td style='height: 24px; width: 291px;' >#{c_TicketViewVendor_GridBean.rnnumberkilled}</td>
													</tr>
													<tr>
													<td style='width: 184px; height: 26px; font-weight: bold;' >#{bundle['rz_popup.map_deaths']}</td>
													<td style='width: 292px; height: 26px;' >#{c_TicketViewVendor_GridBean.rnnumberkilled}</td>
													<td style='height: 26px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_url']}</td>
													<td style='height: 26px; width: 80px; font-weight: bold;' >&amp;nbsp&amp;nbsp<a href="#{c_TicketViewVendor_GridBean.rnurl}"  target="_blank" style="color: #8C2635; font-variant: small-caps;font-size: 15px;">#{bundle['rz_popup.map_link']}</a></td>
													</tr>
													<tr>
													<td style='overflow:hidden; width:80px; height: 90px; font-weight: bold;' >#{bundle['rz_popup.map_description']}</td>
													<td colspan='3' rowspan='1' style='height: 90px; width: 291px;' ><TEXTAREA style="border:0; font-weight: normal; background-color: #FBFBFD; font-family:Times New Roman,Helvetica,sans-serif; font-size: 1.25em;" cols="90" rows="4" wrap="true" name="text" value="">#{c_TicketViewVendor_GridBean.rndescriptions}</TEXTAREA></td>
													</tr>
												</table>
							                 	</ice:panelGrid>
							                 	
							                </f:facet>
							                
							            </ice:panelPopup>   
							            
							       </ice:form>
							       
					<ice:form>
							
										
							            <ice:panelPopup  positionOnLoadOnly="true" draggable="true"  modal="true"  visible="#{viewTicketStepsPopUpBean.visible}" style="width:730px;" styleClass="icePanelPopupBody icePanelPopup">
							                <f:facet name="header">
							                   <ice:panelGrid width="730" cellpadding="0" cellspacing="0" columns="2" styleClass="trHeader" >
							                        <ice:outputText style="color: white;" value="#{bundle['c_admin_ticket.step']}"/>
							                        <ice:commandButton image="./css/images/icons/close.png" action="#{viewTicketStepsPopUpBean.closePopup}" title="Close this draggable popup"/>
							                    </ice:panelGrid>
							                </f:facet>
							                
							                <f:facet name="body">
							                
							                   <ice:panelGrid width="100%" cellpadding="0"  style="background-color: #F0F7FB">
            	
													
															     
													
													
													<ice:panelGroup>
														<ice:dataTable resizable="false" border="1" id="tableticketsteps"
															value="#{c_TicketsStepsBean.allCrudBeans}"
															var="ticketstepsBean"
															width="98%"
															rows="#{c_TicketsStepsBean.selectedDataScrollModes[c_TicketsStepsBean.selectedDataScrollMode].rows}"
															scrollable="#{c_TicketsStepsBean.selectedDataScrollModes[c_TicketsStepsBean.selectedDataScrollMode].scrollingEnabled}"
															scrollHeight="200px"
															style="float:center;font-color: #FFFFFF;"
															columnWidths="1%,29%,25%,40%,5%"
															columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft"
															rowClasses="rowOn,rowOff" cellpadding="0"
															sortColumn="#{c_TicketsStepsBean.columnNameOrder}"
															>
			
															<ice:column styleClass="fontticket#{ticketstepsBean.statuscolor}">
																<!--<ice:rowSelector id="selected"
																	value="#{c_TicketsStepsBean.itemSelected}" multiple="false"
																	selectionListener="#{c_TicketsStepsBean.rowSelectionListener}"
																	selectionAction="#{c_TicketsStepsBean.rowSelectionAction}" /> -->
																	>>		
															</ice:column>
															<ice:column styleClass="fontticket#{ticketstepsBean.statuscolor}">
																<f:facet name="header">
																	<ice:outputText value="">#{bundle['c_admin_ticket.step.status']}&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</ice:outputText>
																	
																</f:facet>
																<ice:outputText id="idestatus" value="#{ticketstepsBean.status}" />
															</ice:column>
															<ice:column styleClass="fontticket#{ticketstepsBean.statuscolor}">
																<f:facet name="header">
																	<ice:outputText value="#{bundle['c_admin_ticket.step.actionstep']}"></ice:outputText>
																</f:facet>
																<ice:inputTextarea id="descriptionideaction"
																								   cols="65"
																								   rows="4"
																		                           maxlength="480"
																		                           value="#{ticketstepsBean.actionStep}"
																		                           readonly="false"
																		                           styleClass="fieldsimple">
																</ice:inputTextarea>
															</ice:column>
															<ice:column styleClass="fontticket#{ticketstepsBean.statuscolor}">
																<f:facet name="header">
																		<ice:outputText value="">#{bundle['c_admin_ticket.step.datetime']}&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</ice:outputText>
																</f:facet>
																<ice:outputText id="eedt" style="font-weight:bold;"  value="#{ticketstepsBean.dtdateStep}" />
															</ice:column>
															<ice:column >
																<f:facet name="header">
																			<ice:outputText value=""></ice:outputText>
																</f:facet>
																<ice:commandLink action="#{c_TicketsStepsBean.updateAction}"   visible="#{c_TicketsStepsBean.isupdatestep}"
																		  		 actionListener="#{c_TicketsStepsBean.rowSelectionStepsListener}">
																						<ice:graphicImage style="border:none;"  styleClass="noborder"
																							url		="./css/images/#{folderBean.folder_menu}/icons/menu_up_update.png" 
																							onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_update.png'"
																							onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_update.png'"/>
																						<f:attribute name="idSelectedStepTicket"
																						value="#{ticketstepsBean.idStepTicket}" />																						
																</ice:commandLink>
															</ice:column>
															<!--<ice:column>
																<f:facet name="header"></f:facet>
																<ice:graphicImage style="border:none;" styleClass="noborder"
																	url="./css/images/icons/menu_down_new_select.png"
																	onmouseout="this.src='./css/images/icons/menu_down_new_select.png'"
																	onmouseover="this.src='./css/images/icons/menu_up_new_select.png'"
																/>
															</ice:column>-->
														</ice:dataTable>
														<ice:panelGroup styleClass="clearer" />
			
			
														<!-- PAGINATOR-->
														<ice:panelGroup style="float:left;width:420px;">
															<center>
																<ice:dataPaginator id="dataScroll_Ticketstepss"
																	rendered="#{c_TicketsStepsBean.selectedDataScrollModes[c_TicketsStepsBean.selectedDataScrollMode].pagingEnabled}"
																	for="tableticketsteps" vertical="false" fastStep="3" paginator="true"
																	paginatorMaxPages="10">
																	<f:facet name="first">
																		<ice:graphicImage id="firstpage_tkstp"
																			url="./css/rime/css-images/arrow-first.gif"
																			style="border:none;" title="first" />
																	</f:facet>
																	<f:facet name="last">
																		<ice:graphicImage id="lastpage_tkstp"
																			url="./css/rime/css-images/arrow-last.gif"
																			style="border:none;" title="last" />
																	</f:facet>
																	<f:facet name="previous">
																		<ice:graphicImage id="previouspage_tkstp"
																			url="./css/rime/css-images/arrow-previous.gif"
																			style="border:none;" title="previous" />
																	</f:facet>
																	<f:facet name="next">
																		<ice:graphicImage id="nextpage_tkstp"
																			url="./css/rime/css-images/arrow-next.gif"
																			style="border:none;" title="next" />
																	</f:facet>
																	<f:facet name="fastforward">
																		<ice:graphicImage id="fastforward_tkstp"
																			url="./css/rime/css-images/arrow-ff.gif"
																			style="border:none;" title="ff" />
																	</f:facet>
																	<f:facet name="fastrewind">
																		<ice:graphicImage id="fastrewind_tkstp"
																			url="./css/rime/css-images/arrow-fr.gif"
																			style="border:none;" title="fr" />
																	</f:facet>
																</ice:dataPaginator>
															</center>
														</ice:panelGroup>
													</ice:panelGroup>
													
													
													<ice:panelGroup visible="#{c_TicketsStepsBean.visible}">
													<span onClick="showTab('tabsnewsteps', this)" style=" cursor: pointer;font-size:12px;font-weight:bold;"><img src="./css/images/general/minus-glow.png" align="absmiddle"></img>
									                 	<h:outputLabel>
															&amp;nbsp<h:outputText styleClass="titleMenuClick" value="#{bundle['rz_info.newstep']}"></h:outputText>
														</h:outputLabel>
													</span>
														
									                <table id="tabsnewsteps" style="display:none;margin-top: -3px" width="100%">
									                	<tr>
									                		<td>	
									                			<br/>
									                			<ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;" > 
										                			<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
																				<tr>
																					<td width="20%"  class="tablelabeledit_disabled">&amp;nbsp&amp;nbsp 
																						<h:outputLabel>
																							<h:outputText value="#{bundle['c_admin_ticket.step.status']}"></h:outputText>&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																						</h:outputLabel>
																			
																					</td>
																					<td align="left" class="tablelabelfieldedit_disabled" width="80%">	
																						<ice:selectOneMenu id="selectedSteps" 
																							value="#{c_TicketsStepsBean.status}"
																							styleClass="selectedOneMenukeyBold"
																							valueChangeListener="#{c_TicketsStepsBean.processValueChange}"
																							partialSubmit="true" style="width: 235px;">
																							<f:selectItems value="#{c_TicketsStepsBean.list_Steps}" />
																					</ice:selectOneMenu>
																					 </td>
																				</tr>
																	</table>
																</ice:panelGroup>
			
																<br/>
																<ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;" > 
																	<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
																		<tr>
																					<td width="20%"  class="tablelabeledit_disabled">&amp;nbsp&amp;nbsp 
																						<h:outputLabel>
																							<h:outputText value="#{bundle['c_admin_ticket.step.actionstep']}"></h:outputText>&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																						</h:outputLabel>
																						&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																					</td>
																					<td align="left" class="tablelabelfieldedit_disabled" width="80%">	
																						<ice:inputTextarea id="descriptionideactionsteps"
																								   cols="99"
																								   rows="10"
																		                           maxlength="480"
																		                           value="#{c_TicketsStepsBean.actionStep}"
																		                           partialSubmit="true"
																		                           styleClass="fieldsimple">
																		                 </ice:inputTextarea>
																					 </td>
																		</tr>
																	</table>
																</ice:panelGroup>
																
																<br/>
																&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																<ice:commandLink action ="#{c_TicketsStepsBean.createNewAction}">
																	<ice:graphicImage style="border:none;" styleClass="noborder"
																	url="./css/images/#{folderBean.folder_menu}/icons/menu_up_new_step_action.png"
																	/>
																	
																</ice:commandLink>
																&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																<ice:commandLink action ="#{viewTicketStepsPopUpBean.closePopup}">
																	<ice:graphicImage style="border:none;" styleClass="noborder"
																	url="./css/images/#{folderBean.folder_menu}/icons/menu_up_cancel_action.png"
																	/>
																	
																</ice:commandLink>
															</td>
														</tr>
													</table>
													
													<br/>
													
													
												</ice:panelGroup>	
													
													
												
							                 	</ice:panelGrid>
							                 	
							                </f:facet>
							                
							            </ice:panelPopup>   
							            
							       </ice:form>
					
				</ui:define>
				

			</ui:composition>

	

       </body>
    </html>
   </f:view>
</jsp:root>
