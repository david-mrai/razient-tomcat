												style="float:left;margin-left:2px"
												columnWidths="4%,10%,10%,10%,10%,10%,8%,20%,8%,4%,4%,2%"
												columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter,columnLeft,columnLeft,columnLeft,columnLeft"
												rowClasses="rowOn,rowOff"
												cellpadding="0"
												sortColumn="#{c_TicketViewVendor_GridBean.columnNameOrder}"
												sortAscending="#{c_TicketViewVendor_GridBean.descending}">
												<ice:column styleClass="fontticket#{dGirnBean.statuscolor}">
													<f:facet name="header">
															<span style="color: #F9FAF8; font-size: 9px; text-align: center">&amp;nbsp#{bundle['c_admin_ticket.step']}
