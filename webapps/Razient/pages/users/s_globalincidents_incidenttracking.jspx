														value="#{dGirnBean.nameciidSiteSupplier}"></h:outputText>
												</ice:column>
												<ice:column  styleClass="fontticket#{dGirnBean.statuscolor}">
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['c_admin_ticket.alerts.name']}"></ice:outputText>
													</f:facet>
													<h:outputText id="dName"
														value="#{dGirnBean.ctnameTicket}"
														styleClass="titleTextKml"></h:outputText>
												</ice:column>
												
												<!--<ice:column styleClass="fontticket#{dGirnBean.statuscolor}">
													<f:facet name="header">
														<ice:outputText 
															value="#{bundle['c_admin_ticket.alerts.description']}"></ice:outputText>
													</f:facet>
													<ice:inputTextarea id="iddescriptions"
																		   cols="20" rows="2" maxlength="450"
												                           value="#{dGirnBean.ctdescriptionTicket}"
												                           readonly="false" styleClass="fieldtextareahighreadonly">
												                         </ice:inputTextarea>
												</ice:column>-->
												
												<ice:column  styleClass="fontticket#{dGirnBean.statuscolor}">
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['c_admin_ticket.alerts.distance']}"></ice:outputText>
													</f:facet>
													<h:outputText id="dDistances"
														styleClass="titleTextKml"
														value="#{dGirnBean.cidistance} #{bundle['c_admin_ticket.alerts.miles']}"></h:outputText>
												</ice:column>
												
												<ice:column styleClass="fontticket#{dGirnBean.statuscolor}">
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['c_admin_ticket.alerts.datetimeactivation']}"></ice:outputText>
													</f:facet>
													<h:outputText id="dDateAct"
														styleClass="titleTextKml"
														value="#{dGirnBean.csdatetimeStatus}"></h:outputText>
												</ice:column>
												
												<ice:column styleClass="fontticket#{dGirnBean.statuscolor}">
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['c_admin_ticket.alerts.datetimeclosed']}"></ice:outputText>
													</f:facet>
													<h:outputText id="dDateCloss"
														styleClass="titleTextKml"
														value="#{dGirnBean.csdatetimeClosed}"></h:outputText>
												</ice:column>
												
												<ice:column styleClass="fontticket#{dGirnBean.statuscolor}">
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['rz_admin_usermanager.globalincident.type']}"></ice:outputText>
													</f:facet>
													<h:outputText id="dType"
														styleClass="titleTextKml"
														value="#{dGirnBean.rntype}"></h:outputText>
												</ice:column>
												
												<ice:column styleClass="fontticket#{dGirnBean.statuscolor}">
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['rz_admin_usermanager.globalincident.title']}"></ice:outputText>
													</f:facet>
													<ice:inputTextarea id="idtitle"
																		   cols="40" rows="4" maxlength="450"
												                           value="#{dGirnBean.rntitle}"
												                           readonly="false" styleClass="fieldtextareahighreadonly">
												                         </ice:inputTextarea>
												</ice:column>
												
												<ice:column styleClass="fontticket#{dGirnBean.statuscolor}">
													<f:facet name="header">
														<ice:outputText
															value="">#{bundle['rz_admin_usermanager.globalincident.city']}&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</ice:outputText>
													</f:facet>
													<h:outputText id="d1City"
														styleClass="titleTextKml"
														value="#{dGirnBean.rncity}"></h:outputText>
												</ice:column>
											<!--  	<ice:column groupOn="#{dGirnBean.rnstate}" style="background-color:#F3F4F8;">
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['rz_admin_usermanager.globalincident.state']}"></ice:outputText>
													</f:facet>
													<h:outputText id="d1State"
														styleClass="titleTextKml"
														value="#{dGirnBean.rnstate}"></h:outputText>
												</ice:column>
												<ice:column groupOn="#{dGirnBean.rncountry}" style="background-color:#F7F4F5;">
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['rz_admin_usermanager.globalincident.country']}"></ice:outputText>
													</f:facet>
													<h:outputText id="d1Country"
														styleClass="titleTextKml"
														value="#{dGirnBean.rncountry}"></h:outputText>
												</ice:column>-->
												
												
												<ice:column styleClass="fontticket#{dGirnBean.statuscolor}">
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['c_dh.GIImg']}"></ice:outputText>
													</f:facet>																																								
														<ice:commandLink action="#{c_TicketViewVendor_GridBean.viewIncidentPopUpAction}" actionListener="#{c_TicketViewVendor_GridBean.rowSelectionListener}">
																					<ice:graphicImage style="border:none;"  styleClass="noborder"
																							url="#{dGirnBean.imagetype}" height="25" width="25"/>
																					<f:attribute name="idSelectedIncVendor"
																					value="#{dGirnBean.ciidrazienGlobalIncident}" />																						
														</ice:commandLink>	
																																
												</ice:column>
												
												<ice:column  styleClass="fontticket#{dGirnBean.statuscolor}">
																<f:facet name="header">
																	<ice:outputText value="#{bundle['c_admin_ticket.step.status']}"></ice:outputText>
																	
																</f:facet>
																<h:outputText id="d1Statusgi"
																	styleClass="titleTextKml"
																	value="#{dGirnBean.status}"></h:outputText>
												</ice:column>
												
												<ice:column  styleClass="fontticket#{dGirnBean.statuscolor}">
																<f:facet name="header">
																	<ice:outputText value="">#{bundle['c_admin_ticket.step.timetoclose']}&amp;nbsp&amp;nbsp&amp;nbsp</ice:outputText>
																	
																</f:facet>
																<h:outputText id="d1dtclosgi" styleClass="titleTextKml"
																	value="#{dGirnBean.dtdatetoclosed} #{bundle['c_admin_ticket.step.days']}"></h:outputText>
												</ice:column>
												
											</ice:dataTable>
											<ice:panelGroup styleClass="clearer" />


											<!-- PAGINATOR-->
											<ice:panelGroup style="float:left;width:420px;">
												<center>
													<ice:dataPaginator
														id="dataScroll_ticketviewvendor"
														rendered="#{c_TicketViewVendor_GridBean.selectedDataScrollModes[c_TicketViewVendor_GridBean.selectedDataScrollMode].pagingEnabled}"
														for="tableAvgb" vertical="false"
