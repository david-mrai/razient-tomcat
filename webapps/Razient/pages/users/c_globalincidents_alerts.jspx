													<td style='height: 30px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_incidenttype']}</td>
													<td style='height: 30px; width: 291px;' >#{c_AlertViewIncident_GridBean.rntype}</td>
													</tr>
