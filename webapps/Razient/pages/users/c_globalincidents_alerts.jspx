				<ui:define name="page-content-value">
				
				
				
				
				<ice:form>
				
				
					<ice:panelGrid width="100%" columns="1" cellpadding="0"  style="align:center;background-color: #F0F7FB; border-color: #294D80">
							<table cellspacing="0" cellpadding="0" style="margin-top: -7px;" width="100%">							
								<tr>
                                  <td bgcolor="#ffffff">
                                  <ice:panelGroup  >
	                                	<style type="text/css">
	                                		.dhGmpMapTd div.gmap {width:  #{utilServiceLocatorBean.widthPanelMapQueryGincidents-20}px; height: 500px}
											.dhGmpMapTd {visibility: block}
	                                 	</style>
	                                 	
	                                 	
	                                 	<ice:panelGroup visible="#{c_TabAlertViewBean.visibleMap_AB}">
									        <ice:gMap id="qrgimapA"  rendered="true" styleClass="dhGmpMapTd" latitude="#{c_AlertViewVendor_GridBean.latitude}" longitude="#{c_AlertViewVendor_GridBean.longitude}" zoomLevel="7">														        	
									      	 	<ice:gMapGeoXml  url="#{bundle['url_upload']}#{bundle['url_kml']}#{bundle['url_customer']}#{c_AlertViewVendor_GridBean.idCustomer}/#{c_AlertViewVendor_GridBean.nameKml}"/> 
									        	<ice:gMapControl id="largectrl" name="GLargeMapControl" rendered="#{c_AlertViewVendor_GridBean.showControls}"/>
