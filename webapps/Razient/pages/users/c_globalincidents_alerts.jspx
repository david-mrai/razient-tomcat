					<ice:panelGroup id="tabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer">

						<ice:panelTabSet tabChangeListener="#{c_TabAlertViewBean.processTabChange}" selectedIndex="#{c_TabAlertViewBean.ITab}">

							<ice:panelTab label="#{entityTypeBundle.entity_of} #{bundle['c_admin_configuration.alerts.tab1']}">
									

							<ice:panelGroup styleClass="customerProfileBox"
								style="height:#{utilServiceLocatorBean.heightPanelCustomerProfileGrid+150}px;width:97%;overflow:auto;">

									<!-- PAGINATOR-->
											<ice:panelGroup style="float:left;width:420px;">
												<center>
													<ice:dataPaginator
														id="dataScroll_alertviewvendor"
														rendered="#{c_AlertViewVendor_GridBean.selectedDataScrollModes[c_AlertViewVendor_GridBean.selectedDataScrollMode].pagingEnabled}"
														for="tableAvgb" vertical="false"
														fastStep="3" paginator="true"
														paginatorMaxPages="10">
														<f:facet name="first">
															<ice:graphicImage id="firstpage_2z"
																url="./css/rime/css-images/arrow-first.gif"
																style="border:none;" title="first" />
														</f:facet>
														<f:facet name="last">
															<ice:graphicImage id="lastpage_2z"
																url="./css/rime/css-images/arrow-last.gif"
																style="border:none;" title="last" />
														</f:facet>
														<f:facet name="previous">
															<ice:graphicImage id="previouspage_2z"
																url="./css/rime/css-images/arrow-previous.gif"
																style="border:none;" title="previous" />
														</f:facet>
														<f:facet name="next">
															<ice:graphicImage id="nextpage_2z"
																url="./css/rime/css-images/arrow-next.gif"
																style="border:none;" title="next" />
														</f:facet>
														<f:facet name="fastforward">
															<ice:graphicImage id="fastforward_2z"
																url="./css/rime/css-images/arrow-ff.gif"
																style="border:none;" title="ff" />
														</f:facet>
														<f:facet name="fastrewind">
															<ice:graphicImage id="fastrewind_2z"
																url="./css/rime/css-images/arrow-fr.gif"
																style="border:none;" title="fr" />
														</f:facet>
													</ice:dataPaginator>
												</center>
											</ice:panelGroup>
									
									<ice:panelGroup>
										<ice:panelGroup>
											<ice:dataTable resizable="false"
												border="1" id="tableAvgb"
												value="#{c_AlertViewVendor_GridBean.allCrudBeans}"
												var="dGirnBean" width="95%"
												rows="#{c_AlertViewVendor_GridBean.selectedDataScrollModes[c_AlertViewVendor_GridBean.selectedDataScrollMode].rows}"
												scrollable="#{c_AlertViewVendor_GridBean.selectedDataScrollModes[c_AlertViewVendor_GridBean.selectedDataScrollMode].scrollingEnabled}"
												style="float:left;margin-left:2px"
												columnWidths="4%,15%,12%,12%,10%,14%,10%,10%,7%,4%"
												columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft"
												rowClasses="rowOn,rowOff"
												cellpadding="0"
												sortColumn="#{c_AlertViewVendor_GridBean.columnNameOrder}"
												sortAscending="#{c_AlertViewVendor_GridBean.descending}">
												<ice:column groupOn="#{dGirnBean.ctnameAlert}">
													<f:facet name="header">
															<span style="color: #F9FAF8; font-size: 9px; text-align: center">&amp;nbsp#{bundle['c_dh.map']}
															</span>
													</f:facet>
													<!--<ice:rowSelector id="selected"
														value="#{query_GridBean.itemSelected}"
														multiple="false"
														selectionListener="#{query_GridBean.rowSelectionListener}"
														selectionAction="#{query_GridBean.rowSelectionAction}" />               
                      														<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/icons/menu_up_site_#{dGirnBean.siteType}.png"
															onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_site_#{dGirnBean.siteType}.png'"
															onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_site_#{dGirnBean.siteType}.png'"	
															/>-->
													<ice:commandLink
																				action="#{c_AlertViewVendor_GridBean.rowSelectionAction}"
																				visible="true" onclick="rld();"
