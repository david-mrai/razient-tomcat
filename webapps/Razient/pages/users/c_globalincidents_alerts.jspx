									            <ice:gMapControl id="typectrl" name="GMapTypeControl" rendered="#{c_AlertViewVendor_GridBean.showControls}"/>
											</ice:gMap>
										</ice:panelGroup>
										
										
										<ice:panelGroup visible="#{not c_TabAlertViewBean.visibleMap_AB}">
									        <ice:gMap id="qrgimapB"  rendered="true" styleClass="dhGmpMapTd" latitude="#{c_AlertViewIncident_GridBean.latitude}" longitude="#{c_AlertViewIncident_GridBean.longitude}" zoomLevel="7">														        	
									        	<ice:gMapGeoXml  url="#{bundle['url_upload']}#{bundle['url_kml']}#{bundle['url_customer']}#{c_AlertViewIncident_GridBean.idCustomer}/#{c_AlertViewIncident_GridBean.nameKml}"/> 
									        	<ice:gMapControl id="largectrl" name="GLargeMapControl" rendered="#{c_AlertViewIncident_GridBean.showControls}"/>
									            <ice:gMapControl id="scalectrl" name="GScaleControl" rendered="#{c_AlertViewIncident_GridBean.showControls}"/>
									            <ice:gMapControl id="typectrl" name="GMapTypeControl" rendered="#{c_AlertViewIncident_GridBean.showControls}"/>
