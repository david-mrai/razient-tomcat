													<td style='height: 24px; width: 291px;' >#{c_AlertViewIncident_GridBean.rnnumberkilled}</td>
													</tr>
													<tr>
													<td style='width: 184px; height: 26px; font-weight: bold;' >#{bundle['rz_popup.map_deaths']}</td>
													<td style='width: 292px; height: 26px;' >#{c_AlertViewIncident_GridBean.rnnumberkilled}</td>
													<td style='height: 26px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_url']}</td>
													<td style='height: 26px; width: 80px; font-weight: bold;' >&amp;nbsp&amp;nbsp<a href="#{c_AlertViewIncident_GridBean.rnurl}"  target="_blank" style="color: #8C2635; font-variant: small-caps;font-size: 15px;">#{bundle['rz_popup.map_link']}</a></td>
													</tr>
													<tr>
													<td style='overflow:hidden; width:80px; height: 90px; font-weight: bold;' >#{bundle['rz_popup.map_description']}</td>
													<td colspan='3' rowspan='1' style='height: 90px; width: 291px;' ><TEXTAREA style="border:0; font-weight: normal; background-color: #FBFBFD; font-family:Times New Roman,Helvetica,sans-serif; font-size: 1.25em;" cols="90" rows="4" wrap="true" name="text" value="">#{c_AlertViewIncident_GridBean.rndescriptions}</TEXTAREA></td>
													</tr>
												</table>
							                 	</ice:panelGrid>
							                 	
