					<ice:form>
							
										<ice:panelPopup  autoPosition="200,100" autoCentre="true" modal="true" visible="#{viewAlertVendorPopUpBean.visible}" style="width:700px;" styleClass="icePanelPopupBody icePanelPopup">
							                <f:facet name="header">
							                   <ice:panelGrid width="100%" cellpadding="0" cellspacing="0" columns="2" styleClass="trHeader" >
							                        <ice:outputText style="color: white;" value="#{bundle['c_dh.hazardousincidents']}"/>
							                        <ice:commandButton image="./css/images/icons/close.png" action="#{viewAlertVendorPopUpBean.closePopup}" title="Close this draggable popup"/>
							                    </ice:panelGrid>
							                </f:facet>
							                
							                <f:facet name="body">
							                    <ice:panelGrid width="100%" columns="2" cellpadding="0"  style="background-color: #FFFFFF">

							              			<table style='text-align: left;  height: 240px;' width="100%" border='1' border-color='gray' border-style='solid' cellpadding='2' cellspacing='2'>
													<tr style='font-weight: bold;'>
														<td style='height: 78px; width: 184px;' ><span style='font-weight: normal;'> <img src='#{c_AlertViewVendor_GridBean.imageUrl}' height="80" width="80"/></span></td>
														<td colspan='3' rowspan='1' style='height: 78px; width: 291px;font-size: 15px;font-variant: small-caps;' >#{bundle['rz_popup.map_incident']}: #{c_AlertViewVendor_GridBean.rntype} <br/><br/>#{bundle['rz_popup.map_locate']}: #{c_AlertViewVendor_GridBean.rncity}</td>
													</tr>
													<tr>
														<td style='height: 0px; width: 184px; text-align: left;' valign='undefined'><span style='font-weight: bold;'>#{bundle['rz_popup.map_incidentsummary']}</span></td>
													<td colspan='3' rowspan='1' style='height: 0px; width: 291px;' >#{c_AlertViewVendor_GridBean.rntitle}</td>
													</tr>	
													<tr>	
													<td style='width: 184px; height: 26px; font-weight: bold;' >#{bundle['rz_popup.map_country']}</td>
													<td style='width: 292px; height: 26px;' >#{c_AlertViewVendor_GridBean.rncountry}</td>
													<td style='height: 26px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_severity']}</td>
													<td style='height: 26px; width: 291px;' >#{c_AlertViewVendor_GridBean.rnriskLevel}</td>
													</tr>	
													<tr>	
													<td style='width: 184px; height: 30px; font-weight: bold;' >#{bundle['rz_popup.map_state']}</td>
													<td style='width: 292px; height: 30px;' >#{c_AlertViewVendor_GridBean.rnstate}</td>
													<td style='height: 30px; width: 184px; font-weight: bold;' >#{bundle['rz_popup.map_incidenttype']}</td>
													<td style='height: 30px; width: 291px;' >#{c_AlertViewVendor_GridBean.rntype}</td>
													</tr>
													<tr>
