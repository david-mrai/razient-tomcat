								<ice:panelGrid visible="#{c_CPSupplierBean.visibleGrid}">


									<ice:panelGroup>
										<ice:panelGroup>
											<ice:dataTable resizable="false" border="1" id="table"
												value="#{c_CPSupplierBean.allCrudBeans}"
												var="adminSupplierBean"
												width="#{utilServiceLocatorBean.widthTableGrid}"
												rows="#{c_CPSupplierBean.selectedDataScrollModes[c_CPSupplierBean.selectedDataScrollMode].rows}"
												scrollable="#{c_CPSupplierBean.selectedDataScrollModes[c_CPSupplierBean.selectedDataScrollMode].scrollingEnabled}"
												scrollHeight="200px"
												style="float:center;font-color: #FFFFFF;"
												columnWidths="1%,19%,20%,15%,30%,15%"
												columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
												rowClasses="rowOn,rowOff" cellpadding="0"
												sortColumn="#{c_CPSupplierBean.columnNameOrder}"
												sortAscending="#{c_CPSupplierBean.descending}"
												onclick="window.location.reload()">

												<ice:column>
													<ice:rowSelector id="selected"
														value="#{c_CPSupplierBean.itemSelected}" multiple="false"
														selectionListener="#{c_CPSupplierBean.rowSelectionListener}"
														selectionAction="#{c_CPSupplierBean.rowSelectionAction}" />               
									                                 >>		
																</ice:column>
												<ice:column>
