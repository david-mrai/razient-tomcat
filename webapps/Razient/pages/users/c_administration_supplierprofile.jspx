						</h:form>


						<h:form>
							<ice:panelGrid visible="#{c_CPSupplierBean.visibleCrud}">
							<span class="smallHeading"  onClick="showTab('tabssupp', this)" style="cursor: pointer;font-size:12px;font-weight:bold;"><img src="./css/images/general/minus-glow.png" align="absmiddle"></img>
                 				<h:outputLabel>
									<h:outputText styleClass="titleMiles" value="#{bundle['rz_info.additional']}"></h:outputText>
								</h:outputLabel>
							</span>
							</ice:panelGrid>
                 			<table id="tabssupp" style="display:block;"><tr><td>
						
						
							<ice:panelGroup id="tabSetTabSupplierProfile"
								styleClass="tabPanelBox panelTabSetSaleContainer"
								visible="#{c_CPSupplierBean.visibleCrud}">

								<ice:panelTabSet
									tabChangeListener="#{c_CPSupplierBean.processTabChange}"
									binding="#{c_CPSupplierBean.tabSet}">

									<ice:panelTab label="#{bundle['c_admin_supplierprofile.tab1']}">
										<div
											style="height:#{utilServiceLocatorBean.heightPanelDetailLow}px;overflow:auto;">
											<ice:panelGroup styleClass="customerProfileBox"
												style="height:#{utilServiceLocatorBean.heightSessionFind}px;width:#{utilServiceLocatorBean.widthSessionFind}px;overflow:auto;background-color:#FAFDFE;margin-top:3px;">

												<h:panelGrid width="100%" columns="1" rules="all"
													title="Question"
													style="border:1px;border-color:white;border-style:none;border-left-style:none;">
													<f:facet name="header">
														<u><h:outputLabel>
																<h:outputText styleClass="titleQuestionDetail"
																	value="#{bundle['rz_info.question']} : #{bundle['c_admin_supplierprofile.question1']}" />
															</h:outputLabel> </u>
													</f:facet>
													<table class="tableformscell" cellspacing="0"
														cellpadding="0">
														<tr>
															<td width="90">
																<br />
																&amp;nbsp
															</td>
															<td class="tableffield">
																<ice:selectOneRadio
																	value="#{c_CPSupplierBean.question1}"
																	id="radioQuestion1"
																	styleClass="selectedOneRadioMultiplekey"
																	valueChangeListener="#{c_CPSupplierBean.processValueChange}"
																	partialSubmit="true">
																	<f:selectItems
																		value="#{c_CPSupplierBean.list_Question1}" />
																</ice:selectOneRadio>

															</td>
														</tr>
													</table>
												</h:panelGrid>
											</ice:panelGroup>

											<ice:panelGroup styleClass="customerProfileBox"
												style="height:#{utilServiceLocatorBean.heightSessionFind}px;width:#{utilServiceLocatorBean.widthSessionFind}px;overflow:auto;background-color:#FAFDFE;margin-top:3px;">

												<h:panelGrid width="100%" columns="1" rules="all"
													title="Question"
													style="border:1px;border-color:white;border-style:none;border-left-style:none;">
													<f:facet name="header">
														<u><h:outputLabel>
																<h:outputText styleClass="titleQuestionDetail"
																	value="#{bundle['rz_info.question']} : #{bundle['c_admin_supplierprofile.question2']}" />
															</h:outputLabel> </u>
													</f:facet>
													<table class="tableformscell" cellspacing="0"
														cellpadding="0">
														<tr>
															<td width="90">
																<br />
																&amp;nbsp
															</td>
															<td class="tableffield">

																<ice:selectManyCheckbox id="radioQuestion2"
																	value="#{c_CPSupplierBean.question2Selected}"
																	styleClass="selectedOneRadioMultiplekey"
																	valueChangeListener="#{c_CPSupplierBean.processValueChange}"
																	partialSubmit="true">
																	<f:selectItems
																		value="#{c_CPSupplierBean.list_Question2}" />
																</ice:selectManyCheckbox>

															</td>
														</tr>
													</table>
												</h:panelGrid>


											</ice:panelGroup>
										</div>
									</ice:panelTab>

									<ice:panelTab label="#{bundle['c_admin_supplierprofile.tab2']}"
										disabled="#{c_CPSupplierBean.disabledAdditional}" >
										<div 
											style="height:#{utilServiceLocatorBean.heightPanelDetailLow}px;width:#{utilServiceLocatorBean.widthDivPosition}px;overflow:auto;">
											
											<ice:panelDivider id="icePnlDvr"
										                dividerPosition="60"
										                orientation="vertical"
										                style="width: 100%; height:150px;margin-top:5px;">
										
										            <f:facet name="first">
										                <ice:panelGroup style="padding: 5px;">
										                    
										                    
										                    <table class="tableformsmasterlow" style="margin-top: 0px;"
																cellspacing="0" cellpadding="0">
																<tr class="trHeader" align="center">
																	<td>
																		<h:outputLabel>
																			<h:outputText
																				value="#{bundle['c_admin_usermanager.supp.insuranceCertificateUpload']}"></h:outputText>
																		</h:outputLabel>
																	</td>
																</tr>
																<tr class="trrow1">
																	<td class="tableffield">
																		<br />
																		<ice:inputFile id="isInsurance" width="450"
																			uploadDirectory="./upload/Supplier/Awards/#{c_CPSupplierBean.idSupplier}/"
																			progressListener="#{if_ControllerBean.fileUploadProgressInsurance}"
																			actionListener="#{if_ControllerBean.uploadInsuranceFile}" 
																			submitOnUpload="preUpload"/>
																	</td>
																</tr>
																<tr class="trrow2">
																	<td colspan="2" align="center">
																		<br />
																		<ice:outputProgress
																			value="#{if_ControllerBean.fileProgressInsurance}"
																			styleClass="uploadProgressBar" />
																	</td>
																</tr>
																<tr class="trrow1">
																	<td class="tableffield">
																		<br />
																		<ice:outputText id="isNameInsurance"
																			value="#{if_ControllerBean.componentStatusInsurance}"
																			styleClass="fieldkeymaster" title="Text" />
																	</td>
																</tr>																
															</table>
										                </ice:panelGroup>
										            </f:facet>
										
										            <f:facet name="second">
										                <ice:panelGroup style="padding: 10px;">

															<table cellspacing="0" cellpadding="0" border="0" style="padding:3px;" align="center">
														        <tr style="vertical-align: top;">
														            <td rowspan="3"><ice:selectManyListbox value="#{c_CPSupplier_AwardBean.selectedItemsAwards}"
														                                      style="width:150px;" size="6">
														                <f:selectItems value="#{c_CPSupplier_AwardBean.listAwards}"/>
															            </ice:selectManyListbox></td>
														            <td>
														            	<ice:commandLink actionListener="#{c_CPSupplier_AwardBean.remove}">
																			<ice:graphicImage style="border:none;" styleClass="noborder"
																				url="./css/images/icons/menu_up_remove.png"
																				onmouseout="this.src='./css/images/icons/menu_up_remove.png'"
																				onmouseover="this.src='./css/images/icons/menu_up_remove.png'"
																				onmouseup="this.src='./css/images/icons/menu_up_remove.png'"
																				onmousedown="this.src='./css/images/icons/menu_up_remove.png'"
																				/>
																		</ice:commandLink>	
																		<br/><br/><br/>
														            </td>
														        </tr>
														    </table>
																
															</ice:panelGroup>
										              
										            </f:facet>
										    </ice:panelDivider>

										</div>
									</ice:panelTab>

									<ice:panelTab label="#{bundle['c_admin_supplierprofile.tab3']}"
										disabled="#{c_CPSupplierBean.disabledAdditional}">
										<div
											style="height:#{utilServiceLocatorBean.heightPanelDetailLow}px;width:#{utilServiceLocatorBean.widthDivPosition}px;overflow:auto;">
											
											<ice:panelDivider id="icePnlDvr"
										                dividerPosition="60"
										                orientation="vertical"
										                style="width: 100%; height:150px;margin-top:5px;">
										
										            <f:facet name="first">
										                <ice:panelGroup style="padding: 5px;">
										                    
										                    
										                    <table class="tableformsmasterlow" style="margin-top: 0px;"
																cellspacing="0" cellpadding="0">
																<tr class="trHeader" align="center">
																	<td>
																		<h:outputLabel>
																			<h:outputText
																				value="#{bundle['c_admin_usermanager.supp.certificationUploadProof']}"></h:outputText>
																		</h:outputLabel>
																	</td>
																</tr>
																<tr class="trrow1">
																	<td class="tableffield">
																		<br />
																		<ice:inputFile id="isProof" width="450"
																			uploadDirectory="./upload/Supplier/Proof/#{c_CPSupplierBean.idSupplier}/"
																			progressListener="#{if_ControllerBean.fileUploadProgressProof}"
																			actionListener="#{if_ControllerBean.uploadProofFile}" 
																			submitOnUpload="preUpload"/>
																	</td>
																</tr>
																<tr class="trrow2">
																	<td colspan="2" align="center">
																		<br />
																		<ice:outputProgress
																			value="#{if_ControllerBean.fileProgressProof}"
																			styleClass="uploadProgressBar" />
																	</td>
																</tr>
																<tr class="trrow1">
																	<td class="tableffield">
																		<br />
																		<ice:outputText id="isNameProof"
																			value="#{if_ControllerBean.componentStatusProof}"
																			styleClass="fieldkeymaster" title="Text" />
																	</td>
																</tr>																
															</table>
										                </ice:panelGroup>
										            </f:facet>
										
										            <f:facet name="second">
										                <ice:panelGroup style="padding: 10px;">

															<table cellspacing="0" cellpadding="0" border="0" style="padding:3px;" align="center">
														        <tr style="vertical-align: top;">
														            <td rowspan="3"><ice:selectManyListbox value="#{c_CPSupplier_CertificateBean.selectedItemsCertificates}"
														                                      style="width:150px;" size="6">
														                <f:selectItems value="#{c_CPSupplier_CertificateBean.listCertificates}"/>
															            </ice:selectManyListbox></td>
														            <td>
														            	<ice:commandLink actionListener="#{c_CPSupplier_CertificateBean.remove}">
																			<ice:graphicImage style="border:none;" styleClass="noborder"
																				url="./css/images/icons/menu_up_remove.png"
																				onmouseout="this.src='./css/images/icons/menu_up_remove.png'"
																				onmouseover="this.src='./css/images/icons/menu_up_remove.png'"
																				onmouseup="this.src='./css/images/icons/menu_up_remove.png'"
																				onmousedown="this.src='./css/images/icons/menu_up_remove.png'"
																				/>
																		</ice:commandLink>	
																		<br/><br/><br/>
														            </td>
														        </tr>
														    </table>
																
															</ice:panelGroup>
										              
										            </f:facet>
										    </ice:panelDivider>
											
										</div>
									</ice:panelTab>


									<ice:panelTab label="#{bundle['c_admin_supplierprofile.tab4']}"
										disabled="#{c_CPSupplierBean.disabledAdditional}">
										<div
											style="height:#{utilServiceLocatorBean.heightPanelDetailLow}px;overflow:auto; padding:1px;">
											<ice-cc:editableTable
												bean="#{c_CPSupplier_Contact_EditTableBean.editTableBean}"
												id="editableTableContact" idProperty="ipos">
												<ice-cc:column
													title="#{bundle['c_admin_supplierprofile.contact.login']}"
													value="#{row.login}"></ice-cc:column>
												<ice-cc:textColumn
													title="#{bundle['c_admin_supplierprofile.contact.firstname']}"
													property="firstName" width="80px"></ice-cc:textColumn>
												<ice-cc:textColumn
													title="#{bundle['c_admin_supplierprofile.contact.lastname']}"
													property="lastName" width="80px" />
												<ice-cc:textColumn
													title="#{bundle['c_admin_supplierprofile.contact.email']}"
													property="email" width="120px" />
												<ice-cc:textColumn
													title="#{bundle['c_admin_supplierprofile.contact.phone']}"
													property="phone" width="60px" />
												<ice-cc:textColumn
													title="#{bundle['c_admin_supplierprofile.contact.department']}"
													property="department" width="60px" />
												<ice-cc:textColumn
													title="#{bundle['c_admin_supplierprofile.contact.title']}"
													property="title" width="50px" />
												<ice-cc:selectOneMenuColumn
													title="#{bundle['c_admin_supplierprofile.contact.profile']}"
													property="profile"
													selectItems="#{c_CPSupplier_Contact_EditTableBean.list_Profile}"
													width="75px" />
												<ice-cc:selectOneMenuColumn
													title="#{bundle['c_admin_supplierprofile.contact.status']}"
													property="status"
													selectItems="#{c_CPSupplier_Contact_EditTableBean.list_Status}"
													width="75px" />
											</ice-cc:editableTable>


										</div>
									</ice:panelTab>

									<ice:panelTab label="#{bundle['c_admin_supplierprofile.tab5']}"
										disabled="#{c_CPSupplierBean.disabledAdditional}">
										<div
											style="height:#{utilServiceLocatorBean.heightPanelDetailLow}px;overflow:auto; padding:2px;">
											<table class="tableformsmasterlow" style="margin-top: 0px;"
												cellspacing="0" cellpadding="0">
												<tr>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td class="tableflabelmasterbold">
														<h:outputLabel>
															<h:outputText
																value="#{bundle['c_admin_supplierprofile.site.country']}"></h:outputText>
														</h:outputLabel>
														&amp;nbsp
													</td>
													<td class="tableffieldleft">
														<ice:selectOneMenu
															value="#{c_CPSupplier_Site_EditTableBean.country}"
															id="selectedCountrySite"
															styleClass="selectedOneMasterCountry"
															valueChangeListener="#{c_CPSupplier_Site_EditTableBean.processValueChange}"
															partialSubmit="true">
															<f:selectItem itemLabel="#{bundle['rz_select_country']}"
																itemValue="0" />
															<f:selectItems
																value="#{applicationBean.countrySelectedItems}"
																id="countrySite" />
														</ice:selectOneMenu>
													</td>
													<td class="tableflabelmasterbold">
														<h:outputLabel>
															<h:outputText
																value="#{bundle['c_admin_supplierprofile.site.state']}"></h:outputText>
														</h:outputLabel>
														&amp;nbsp
													</td>
													<td class="tableffieldleft">
														<ice:selectOneMenu
															value="#{c_CPSupplier_Site_EditTableBean.idState}"
															id="selectedStateSite"
															styleClass="selectedOneMasterState"
															valueChangeListener="#{c_CPSupplier_Site_EditTableBean.processValueChange}"
															partialSubmit="true">
															<f:selectItem itemLabel="#{bundle['rz_select_state']}"
																itemValue="0" />
															<f:selectItems
																value="#{c_CPSupplier_Site_EditTableBean.list_States}"
																id="stateSite" />
														</ice:selectOneMenu>
													</td>
													<td class="tableflabelmasterbold">
														<h:outputLabel>
															<h:outputText
																value="#{bundle['c_admin_supplierprofile.site.city']}"></h:outputText>
														</h:outputLabel>
														&amp;nbsp
													</td>													
													<td class="tableffieldleft">
														<ice:selectOneMenu
															value="#{c_CPSupplier_Site_EditTableBean.city}"
															id="selectedCitySite"
															styleClass="selectedOneMasterState"
															valueChangeListener="#{c_CPSupplier_Site_EditTableBean.processValueChange}"
															partialSubmit="true">
															<f:selectItem itemLabel="#{bundle['rz_select_city']}"
																itemValue="0" />
															<f:selectItems
																value="#{c_CPSupplier_Site_EditTableBean.list_City}"
																id="citySite" />
														</ice:selectOneMenu>
													</td>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
												</tr>
											</table>

											<ice-cc:editableTable
												bean="#{c_CPSupplier_Site_EditTableBean.editTableBean}"
												id="editableTableSite" idProperty="ipos">
												<ice-cc:textColumn
													title="#{bundle['c_admin_supplierprofile.site.name']}"
													property="name" width="80px"></ice-cc:textColumn>
												<ice-cc:textColumn
													title="#{bundle['c_admin_supplierprofile.site.address']}"
													property="address" width="80px"></ice-cc:textColumn>
												<!--													
												<ice-cc:selectOneMenuColumn
													title="#{bundle['c_admin_supplierprofile.site.country']}"
													property="country"
													selectItems="#{applicationBean.countrySelectedItems}"
													width="60px" />
												<ice-cc:selectOneMenuColumn
													title="#{bundle['c_admin_supplierprofile.site.state']}"
													property="state"
													selectItems="#{c_CPSupplier_Site_EditTableBean.list_States}"
													width="80px" />
												-->
												<ice-cc:column
													title="#{bundle['c_admin_supplierprofile.site.country']}"
													value="#{row.country}" width="80px" />
												<ice-cc:column
													title="#{bundle['c_admin_supplierprofile.site.state']}"
													value="#{row.state}" width="60px"></ice-cc:column>
												<ice-cc:column
													title="#{bundle['c_admin_supplierprofile.site.city']}"
													value="#{row.city}" width="80px"></ice-cc:column>
												<ice-cc:textColumn
													title="#{bundle['c_admin_supplierprofile.site.zipCode']}"
													property="zipCode" width="60px"></ice-cc:textColumn>
												<ice-cc:selectOneMenuColumn
													title="#{bundle['c_admin_supplierprofile.site.locationCriticality']}"
													property="locationCriticality"
													selectItems="#{c_CPSupplier_Site_EditTableBean.list_LocCriti}"
													width="120px" />
												<ice-cc:column
													title="#{bundle['c_admin_supplierprofile.site.latitude']}"
													value="#{row.latitude}" width="50px" />
												<ice-cc:column
													title="#{bundle['c_admin_supplierprofile.site.longitude']}"
													value="#{row.longitude}" width="50px" />
												<ice-cc:selectOneMenuColumn
													title="#{bundle['c_admin_supplierprofile.site.status']}"
													property="status"
													selectItems="#{c_CPSupplier_Site_EditTableBean.list_Status}"
													width="75px" />
											</ice-cc:editableTable>

										</div>
									</ice:panelTab>
								</ice:panelTabSet>
							</ice:panelGroup>
							
							</td></tr></table>
							
						</h:form>



					</ui:define>


				</ui:composition>



			</body>
		</html>
	</f:view>
</jsp:root>
