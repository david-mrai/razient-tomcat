						</h:form>
						
						
						<h:form>
							
							<ice:panelGroup id="tabSetTabCustomerProfile" styleClass="tabPanelBox panelTabSetSaleContainer">

								<ice:panelTabSet>

								<ice:panelTab label="#{bundle['c_admin_supplierprofile_awards.title']}">
									<div style="height:100%;">
										<br/>
										<ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;">
											<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
												<tr>
													<td width="14%"  class="tablelabeledit_#{c_AwardsCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['c_admin_supplierprofile.awards.site']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{c_AwardsCrudBean.stEdit_Global}" width="84%">
														<ice:selectOneMenu id="selectedSite" visible="#{not c_AwardsCrudBean.bEdit_Site}"
																value="#{c_AwardsCrudBean.idSiteSupplier}"
																styleClass="selectedOneMenukeyBold"
																valueChangeListener="#{c_AwardsCrudBean.processValueChange}"
																partialSubmit="true" style="width: 372px">
																<f:selectItems value="#{c_AwardsCrudBean.list_Site}" />
														</ice:selectOneMenu>
														<ice:inputText id="nameSite" size="40" maxlength="40" visible="#{c_AwardsCrudBean.bEdit_Site}"
																value="#{c_AwardsCrudBean.nameSite}" partialSubmit="true"
																readonly="true" styleClass="tablefieldedit_disabled">
														</ice:inputText>
													 </td>
												</tr>
			
											</table>
											
										</ice:panelGroup>
										
										<br/><br/>
										
										<ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;">
											<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
												<tr>
													<td width="10%" class="tablelabeledit_#{c_AwardsCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['c_admin_supplierprofile.awards.name']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{c_AwardsCrudBean.stEdit_Global}" width="60%">
														<ice:inputText id="name" size="70" maxlength="100"
																value="#{c_AwardsCrudBean.name}" partialSubmit="true"
																readonly="#{c_AwardsCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{c_AwardsCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
													
												</tr>
												<tr><td colspan="2" class="menusep_#{c_PartServicesCrudBean.stEdit_Global}"></td></tr>
												<tr>
													<td width="10%" class="tablelabeledit_#{c_AwardsCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['c_admin_supplierprofile.awards.description']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{c_AwardsCrudBean.stEdit_Global}" width="60%">
														<ice:inputTextarea id="idawardsdescription"
																		   cols="70" rows="4" maxlength="450"
												                           value="#{c_AwardsCrudBean.description}"
												                           readonly="false" styleClass="fieldtextareahigh">
												        </ice:inputTextarea>
													 </td>
													
												</tr>
												<tr><td colspan="2" class="menusep_#{c_PartServicesCrudBean.stEdit_Global}"></td></tr>
												<tr>
													<td width="10%" class="tablelabeledit_#{c_AwardsCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['c_admin_supplierprofile.awards.upload']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{c_AwardsCrudBean.stEdit_Global}" width="60%">
														<table class="tableformsupload" style="margin-top: 0px;"
																cellspacing="0" cellpadding="0">
																<tr class="trHeaderUpload" align="center">
																	<td>
																		<h:outputLabel>
																			<h:outputText
																				value=" #{bundle['c_admin_usermanager.supp.certificationUploadProof']}"></h:outputText>
																		</h:outputLabel>
																	</td>
																</tr>
																<tr class="trrow1">
																	<td align="left" >
																		<br />
																		<ice:inputFile id="isProof" width="620" buttonClass="iceInpFileBtnCus" inputTextClass="iceInpFileTxtCus"
																			uploadDirectory="./upload/supplier/#{c_AwardsCrudBean.idSupplier}/site/#{c_AwardsCrudBean.idSiteSupplier}/awards/temp/"
																			progressListener="#{c_AwardsCrudBean.fileUploadProgress}"
																			actionListener="#{c_AwardsCrudBean.uploadFile}" 
																			submitOnUpload="preUpload" height="45" label="#{bundle['rz_loadfile']}" inputTextSize="57" />
																			
																	</td>
																</tr>
																<tr >
																	<td colspan="2" align="left">
																		<ice:outputProgress
																			value="#{c_AwardsCrudBean.fileProgress}"
																			styleClass="uploadProgressBar" />
																	</td>
																</tr>
																<tr class="trrow1">
																	<td class="left">
																		<br />
																		&amp;nbsp&amp;nbsp<ice:outputText id="isNameProof"
																			value="#{c_AwardsCrudBean.componentStatus}"
																			styleClass="fieldkeymasterupload" title="Text" />
																	</td>
																</tr>																
															</table>
													 </td>
													
												</tr>
											</table>
											
										</ice:panelGroup>
										
										<br/>
										
									</div>
								</ice:panelTab>
								</ice:panelTabSet>

							</ice:panelGroup>
							
							
							<br/>
	
						</h:form>
						
						
						<ice:form>
							<ice:panelPopup  modal="true" visible="#{viewlogsPopUpBean.visible}" style="margin-top:-90px;width:485px;" styleClass="icePanelPopupBody icePanelPopup">
				                <f:facet name="header">
				                   <ice:panelGrid width="485" cellpadding="0" cellspacing="1" columns="2" styleClass="trHeader" >
				                        <ice:outputText style="color: white;" value="#{bundle['rz_log']}"/>
				                        <ice:commandButton image="./css/images/icons/close.png" action="#{viewlogsPopUpBean.closePopup}" title="Close this draggable popup"/>
				                    </ice:panelGrid>
				                </f:facet>
				                <f:facet name="body">
				                	<ice:panelGrid width="100%">
				                		<table style="border:none;margin-top:-10px;float:left;">
				                			<tr>
				                				<td rowspan="2" valign="top"><ice:graphicImage styleClass="noborder" url="./css/images/general/log#{logger.stType}.png"/></td>
				                				<td style="color:#3A4358;font-weight:bold;">&amp;nbsp&amp;nbsp#{logger.stType}</td>
				                			</tr>
				                			<tr>
				                				<td >
					                				 <ice:panelGrid width="100%" columns="1" cellpadding="0" border="1" style="background-color: #F4F4F4;border-color:black;" >
									                	<table align="center">
										                       	<tr>
											                       <td  width="410" colspan="3" class="tableflabelmaster" >
											                       		<div style="height:200px;overflow: auto;" >
											                       			#{logger.stLogger}
											                       		</div>
											                       </td>
											                    </tr>
											             </table>
								                 	</ice:panelGrid>
				                				</td>
				                			</tr>
				                			<tr>
				                				<td colspan="3" align="right">
					                				<ice:commandLink action ="#{viewlogsPopUpBean.closePopup}">
																<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/general/logexit.png"/>
													</ice:commandLink>
												</td>
				                			</tr>
				                		</table>
									</ice:panelGrid>
				                </f:facet>
				            </ice:panelPopup>   
				       </ice:form>
						

					</ui:define>


				</ui:composition>



			</body>
		</html>
	</f:view>
</jsp:root>
