				<ui:define name="page-content-value">
	                <ice:form>
	                	
	                	<ice:panelGroup id="tabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer">

								<ice:panelTabSet tabChangeListener="#{c_TabConfigurationBean.processTabChange}" selectedIndex="#{c_TabConfigurationBean.ITab}">

									<ice:panelTab label="#{bundle['c_admin_configuration.alerts.tab1']}">
									
										
										<ice:panelGroup id="tabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer">
						
						  						<ice:panelTabSet tabChangeListener="#{c_TabAlertsVendorManagerBean.processTabChange}"  selectedIndex="#{c_TabAlertsVendorManagerBean.ITab}">
						   
													<ice:panelTab   label="#{bundle['c_admin_configuration.alerts.tab11']}" >
																			
														<br/>
														<ice:panelGroup style="margin-top:-3px;width:97%;overflow:auto;">
		
															<ice:panelGroup>
																<ice:panelGroup>
																	<ice:dataTable resizable="false" border="1" id="tablealertvendorgrid"
																		value="#{c_AlertsVendorGridBean.allCrudBeans}"
																		var="alertsVendorBean"
																		width="98%"
																		rows="#{c_AlertsVendorGridBean.selectedDataScrollModes[c_AlertsVendorGridBean.selectedDataScrollMode].rows}"
																		scrollable="#{c_AlertsVendorGridBean.selectedDataScrollModes[c_AlertsVendorGridBean.selectedDataScrollMode].scrollingEnabled}"
																		scrollHeight="200px"
																		style="float:center;font-color: #FFFFFF;"
																		columnWidths="20%,1%,25%,25%,20%,9%"
																		columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
																		rowClasses="rowOn,rowOff" cellpadding="0"
																		sortColumn="#{c_AlertsVendorGridBean.columnNameOrder}"
																		sortAscending="#{c_AlertsVendorGridBean.descending}"
																		onclick="window.location.reload()">
						
																		
																		<ice:column groupOn="#{alertsVendorBean.nameSite}" style="background-color:#F7F4F5;">
																			<f:facet name="header">
																				<ice:commandSortHeader id="ecustomerSiteIdCustomerSitesort" columnName="customerSiteIdCustomerSite">
																					<ice:outputText	value="#{bundle['rz_admin_customerprofile.employee.site']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="idecustomerSiteIdCustomerSite"  style="font-weight:bold;text-align:center;"
																				value="#{alertsVendorBean.nameSite}" />
																		</ice:column>
																		<ice:column style="background-color:white;">
																			<ice:rowSelector id="selected"
																				value="#{c_AlertsVendorGridBean.itemSelected}" multiple="false"
																				selectionListener="#{c_AlertsVendorGridBean.rowSelectionListener}"
																				selectionAction="#{c_AlertsVendorGridBean.rowSelectionAction}" /> 
	
																				<!--<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/#{folderBean.folder_menu}/icons/menu_useractive.png"/>-->		
																		
																		</ice:column>
																		<ice:column style="background-color:#F4F7F5;">
																			<f:facet name="header">
																				<ice:commandSortHeader id="enamesort" columnName="name">
																					<ice:outputText value="#{bundle['c_admin_configuration.alerts.name']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="iname"
																					value="#{alertsVendorBean.name}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:outputText value="#{bundle['c_admin_configuration.alerts.frecuency']}"></ice:outputText>
																			</f:facet>
																			<ice:outputText id="ifrecuency"
																					value="#{alertsVendorBean.nameFrecuency}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:outputText value="#{bundle['c_admin_configuration.alerts.criticality']}"></ice:outputText>
																			</f:facet>
																			<ice:outputText id="icriticality"
																					value="#{alertsVendorBean.nameCriticality}" />
																		</ice:column>
																		
																		<ice:column style="background-color:white;">
																			<f:facet name="header">
																				
																			</f:facet>
																			<ice:graphicImage style="border:none;" styleClass="noborder"
																				url="./css/images/#{folderBean.folder_menu}/icons/menu_down_edit.png"
																				onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_edit.png'"
																				onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_edit.png'"
																			
																			/>
																		</ice:column>
																	</ice:dataTable>
																	
																	<ice:panelGroup styleClass="clearer" />
						
																	<!-- PAGINATOR-->
																	<ice:panelGroup style="float:left;width:420px;">
																		<center>
																			<ice:dataPaginator id="dataScroll_AlertsVendor"
																				rendered="#{c_AlertsVendorGridBean.selectedDataScrollModes[c_AlertsVendorGridBean.selectedDataScrollMode].pagingEnabled}"
																				for="tablealertvendorgrid" vertical="false" fastStep="3" paginator="true"
																				paginatorMaxPages="10">
																				<f:facet name="first">
																					<ice:graphicImage id="firstpage_employee"
																						url="./css/rime/css-images/arrow-first.gif"
																						style="border:none;" title="first" />
																				</f:facet>
																				<f:facet name="last">
																					<ice:graphicImage id="lastpage_employee"
																						url="./css/rime/css-images/arrow-last.gif"
																						style="border:none;" title="last" />
																				</f:facet>
																				<f:facet name="previous">
																					<ice:graphicImage id="previouspage_employee"
																						url="./css/rime/css-images/arrow-previous.gif"
																						style="border:none;" title="previous" />
																				</f:facet>
																				<f:facet name="next">
																					<ice:graphicImage id="nextpage_employee"
																						url="./css/rime/css-images/arrow-next.gif"
																						style="border:none;" title="next" />
																				</f:facet>
																				<f:facet name="fastforward">
																					<ice:graphicImage id="fastforward_employee"
																						url="./css/rime/css-images/arrow-ff.gif"
																						style="border:none;" title="ff" />
																				</f:facet>
																				<f:facet name="fastrewind">
																					<ice:graphicImage id="fastrewind_employee"
																						url="./css/rime/css-images/arrow-fr.gif"
																						style="border:none;" title="fr" />
																				</f:facet>
																			</ice:dataPaginator>
																		</center>
																	</ice:panelGroup>
																	<table style="width:99%;margin-top:-1px;">
																		<tr>
