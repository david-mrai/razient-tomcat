<?xml version="1.0" encoding="utf-8" ?>

<jsp:root version="1.2"
   xmlns:jsp="http://java.sun.com/JSP/Page"
   xmlns:f="http://java.sun.com/jsf/core"
   xmlns:h="http://java.sun.com/jsf/html"
   xmlns:ice="http://www.icesoft.com/icefaces/component"
   >

   <jsp:directive.page contentType="text/html;charset=ISO-8859-1" pageEncoding="ISO-8859-1" />
   <f:view>
   		<ice:outputDeclaration 
            doctypeRoot="html" 
            doctypePublic="-//W3C//DTD HTML 4.01 Transitional//EN" 
            doctypeSystem="http://www.w3.org/TR/html4/loose.dtd" /> 
             
    <html>
       <head>
         <title>Index (Razient)</title>
       </head>
       <body>
       
        	<!-- template="#{templateBean.templateContent}"-->
			<ui:composition
			        template="../../include/templates/pages/modeB_customer.jspx"
			        xmlns:h="http://java.sun.com/jsf/html"
			        xmlns:f="http://java.sun.com/jsf/core"
			        xmlns:c="http://java.sun.com/jstl/core"
			        xmlns:ice="http://www.icesoft.com/icefaces/component"
			        xmlns:ui="http://java.sun.com/jsf/facelets">
			
			  <!-- params for page titles-->
			 		 <!--<f:loadBundle basename="truckandi.view.bundle.Message" var="bundle"/>
			        <ui:param name="pageTitle" value="#{bundle['tai_login.title']}" />-->
					<ui:param name="pageTitle" value="Compliance" />
				
				<ui:define name="header_menu_value">
						<table cellspacing="0" cellpadding="0">
										<tr>
											<td>
											<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">
												<ice:graphicImage style="border:none;"  styleClass="noborder"
														url		="./css/images/#{folderBean.folder_menu}/risk_dash_1.png" 
													onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_1.png'"
													onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_2.png'"
													onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_1.png'"
													onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_2.png'" />
													<f:attribute name="optioonselected" value="dh"/>
											</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_C_Compliance}">
													<ice:graphicImage style="border:none;"  styleClass="noborder"
														url		="./css/images/#{folderBean.folder_menu}/risk_comp_1.png" 
													onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_1.png'"
													onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_2.png'"
													onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_1.png'"
													onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_2.png'" />
													<f:attribute name="optioonselected" value="cp_sm"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/#{folderBean.folder_menu}/risk_global_2.png" visible="#{users_MenuBarBean.visible_C_GlobalIncidents}"/>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_C_SuppliersView}">												
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_supp_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_supp_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_supp_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_supp_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_supp_2.png'" />
														<f:attribute name="optioonselected" value="sv_sp"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_C_Ratings}">																								
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_ratings_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_ratings_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_ratings_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_ratings_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_ratings_2.png'" />
														<f:attribute name="optioonselected" value="rt_vr"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_C_RequestForProposal}">																								
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_request_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_2.png'" />
														<f:attribute name="optioonselected" value="rp_ps"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_C_Contracts}">																								
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_contracts_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_contracts_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_contracts_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_contracts_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_contracts_2.png'" />
													<f:attribute name="optioonselected" value="ct_av"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_C_Reports}">																								
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_rep_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_2.png'" />
														<f:attribute name="optioonselected" value="rp_ct"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_C_Administration}">																								
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_admin_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_2.png'" />
														<f:attribute name="optioonselected" value="ad_um"/>
												</ice:commandLink>
											</td>
										</tr>
								</table>	
				</ui:define>
			    
			    <ui:define name="page-menu-value">
			    	 <ice:form>
			    	 
					 <ice:graphicImage visible="true" style="border:none;"
								styleClass="noborder"
								url="./css/images/#{folderBean.folder_menu}/risk_menu_down_alerts.png" />
					 <ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_query.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_query.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_query.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_query.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_query.png'" />
									
					
					 </ice:form> 	
			    </ui:define>
			    
				<ui:define name="page-content-value">
					<br/>
					<ice:form>
					<div xmlns:ft="http://www.mcmsoftware.com">
					 <c:forEach var="survey" items="#{componentRzSurveyManager.list_surveys}">
             			 <ft:survey value="#{survey}"/>
         			 </c:forEach>
					</div> 
					</ice:form>
					
					
					
					
					
					
					<div xmlns:ft="http://www.mcmsoftware.com">
					 <c:forEach var="inputField" items="#{inputFieldManager.fields}">
             			 <ft:inputField value="#{inputField}"/>
         			 </c:forEach>
					</div> 
					
					
					<div xmlns:ice="http://www.icesoft.com/icefaces/component"
					     xmlns:c="http://java.sun.com/jstl/core"
					     xmlns:ft="http://www.mcmsoftware.com">
					         <ice:form>
					             <ice:panelGrid columns="1">
					                 <ice:outputText>
					                     The following is a breif example on how a Custom Tag can be
					                     implmented in a Facelets application.  The following form 
					                     was implemented using just 3 lines of code instead of the 
					                     10+ lines that normally are needed.
					                 </ice:outputText>
					                 <br/>
					                 <ice:outputText>
					                     Creating custom tags can be beneficial, it can help
					                     eliminate duplication of code.  For our example we have combined a 
					                     label and an input text tag into one tag.
					                 </ice:outputText>
					                 <br/>
					                 <br/>
					                 <c:forEach var="inputField" items="#{inputFieldManager.fields}">
					                     <ft:inputField value="#{inputField}"/>
					                 </c:forEach>
					                 <br/>
					                 <ice:commandButton value="Register" type="submit"
					                                    action="#{inputFieldManager.register}"/>
					                 <ice:messages/>
					             </ice:panelGrid>
					         </ice:form>
					</div>
										
					
					
				</ui:define>
				

			</ui:composition>

	

       </body>
    </html>
   </f:view>
</jsp:root>
