							<ice:panelGroup>
							<div class="paneTableSectionBox"
											style="z-index: 10;margin-left:2px;margin-top:-9px;width:#{utilServiceLocatorBean.widthAllTree-6}px;float: left;position: absolute; ">
												
									<div class="pageHeading">#{bundle['s_survey_survey.question.sections.title']}</div>
									
									<br/>
									<!-- first column, for tree navigation -->
							    	
									
									<ice:panelGroup style="border: 0px solid gray; height: #{utilServiceLocatorBean.heightAllTree-76}px;">
										<!--
								                Fully styled Xp themed tree.
								            -->
										<ice:tree id="tree" value="#{s_SV_SV_TreeSurveyBean.model}"
											var="item" hideRootNode="false" hideNavigation="false"
											imageDir="./css/images/tree/" >
											<ice:treeNode >
												<f:facet name="icon">
													<ice:panelGroup style="display: inline;font-size:11px;">
														<h:graphicImage value="#{item.userObject.icon}" />
													</ice:panelGroup>
												</f:facet>
												<f:facet name="content" >
													<ice:panelGroup style="display: inline;font-size:11px;">
														<ice:commandLink target="_top"
															actionListener="#{s_SV_SV_TreeSurveyBean.actionlistener}"
															value="#{item.userObject.text}" onclick="javascript:window.location.reload();">
															<f:attribute name="sectionsId"
																value="#{item.userObject.section.idcustomerSectionSurveys}" />
														</ice:commandLink>
													</ice:panelGroup>
												</f:facet>
											</ice:treeNode>
										</ice:tree>
									</ice:panelGroup>

								</div>
							</ice:panelGroup>
							
							
							<ice:panelGrid columns="2" style="margin-top:-12px;margin-left:-4px;">
								
								<div class="paneTableBox" style="height:100%;margin-top:0px;overflow:auto;width:#{utilServiceLocatorBean.widthAllTree}px;">

								</div>
								<div class="paneBuiltSurveyBox"  style="margin-top:0px;width:100%;">

									<table class="tablebuiltsurvey" width="50" border="0">
										<tr>
											<td>&amp;nbsp
												<ice:graphicImage url="./css/images/icons/menu_sep.png"
													style="border:none;" />&amp;nbsp&amp;nbsp
											</td>
											<td align="left">
												<ice:inputText maxlength="6" size="6"
													value="#{statusSectionBean.counttotal_questions}"
													styleClass="fieldmenuamount" readonly="true"></ice:inputText>
											</td>
											<td align="left">
												<ice:graphicImage url="./css/images/icons/menu_up_of.png"
													style="border:none;" />
											</td>
											<td align="left">
												<ice:inputText maxlength="6" size="6"
													value="#{statusSectionBean.iresponsetotal_questions}"
													styleClass="fieldmenuindex" readonly="true"></ice:inputText>	
											</td>
											<td  align="right">
												<ice:graphicImage url="./css/images/icons/menu_sep.png"
													style="border:none;" />

											</td>
										</tr>
										<tr>
											<td align="center" colspan="5">
												<ice:outputText  styleClass="titleinfonumber"  value="#{bundle['s_survey_survey.inthesurvey']}"/>
											</td>
										</tr>
										<tr>
											<td align="left" colspan="5">
												<ice:graphicImage height="1px" width="170"
													url="./css/images/icons/menu_menu_line.png" />
											</td>
										</tr>
									</table>
									<table class="tablebuiltsurvey" width="50" border="0">
										<tr>
											<td>&amp;nbsp
												<ice:graphicImage url="./css/images/icons/menu_sep.png"
													style="border:none;" />&amp;nbsp&amp;nbsp
											</td>
											<td align="left">
												<ice:inputText maxlength="6" size="6"
													value="#{statusSectionBean.count_questions}"
													styleClass="fieldmenuamount" readonly="true"></ice:inputText>
											</td>
											<td align="left">
												<ice:graphicImage url="./css/images/icons/menu_up_of.png"
													style="border:none;" />
											</td>
											<td align="left">
												<ice:inputText maxlength="6" size="6"
													value="#{statusSectionBean.iresponse_questions}"
													styleClass="fieldmenuindex" readonly="true"></ice:inputText>
											</td>
											<td  align="right">
												<ice:graphicImage url="./css/images/icons/menu_sep.png"
													style="border:none;" />

											</td>
										</tr>
										<tr>
											<td align="center" colspan="5">
												<ice:outputText  styleClass="titleinfonumber"  value="#{bundle['s_survey_survey.inthesection']}"/>
											</td>
										</tr>
										<tr>
											<td align="left" colspan="5">
												<ice:graphicImage height="1px" width="170"
													url="./css/images/icons/menu_menu_line.png" />
											</td>
										</tr>
									</table>
									
									
									<div style="margin-top:0px;overflow:auto;width:100%;">
									
									<ice:panelGroup >
										<div xmlns:ft="http://www.mcmsoftware.com">
											<c:forEach var="builtsurvey"
												items="#{builtSurveyManager.list_surveys}">
												<ft:builtsurvey value="#{builtsurvey}" />
											</c:forEach>
										</div>
									</ice:panelGroup>
									</div>

								</div>

							</ice:panelGrid>
							
							<div class="paneTableBox" style="height:100;margin-top:1px;overflow:auto;width:100%;">


									<table  cellspacing="0" cellpadding="0" style="margin-top: 2px;" width="100%" >
										<tr>
											<td>&amp;nbsp</td>
											<td align="left">
												<ice:commandLink
													actionListener="#{statusSectionBean.saveQuestions}">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_savesurvey.png"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_savesurvey.png'"
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_savesurvey.png'"
														/>
												</ice:commandLink>
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												<ice:commandLink action="#{zoomSurveyQuestionsPopUpBean.openPopup}" rendered="#{not zoomSurveyQuestionsPopUpBean.visible}">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_zoomsurvey.png"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_zoomsurvey.png'"
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_zoomsurvey.png'"
														/>
												</ice:commandLink>
											</td>
											<td>
										&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
										
											</td>
											<td align="right">
												<ice:commandLink action="#{s_SV_SV_ListTableBean.toListSurvey}"
													actionListener="#{statusSectionBean.surveyToReview}"
													panelConfirmation="confirmsend"
													onclick="window.location.reload();">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_surveytoreview.png"
														onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_surveytoreview.png'"
														onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_surveytoreview.png'"
														/>
												</ice:commandLink>
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												<ice:commandLink
													action="#{s_SV_SV_ListTableBean.toListSurvey}"
													onclick="rld();">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_tolist.png"
														onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_tolist.png'"
														onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_tolist.png'"
														/>
												</ice:commandLink>
											</td>
											<td>
												&amp;nbsp&amp;nbsp&amp;nbsp
											</td>
										</tr>
									</table>
								</div>
							
							<ice:panelConfirmation id="confirmsend"  
									  acceptLabel="#{bundle['ice_confirmation.ok']}"  
									  cancelLabel="#{bundle['ice_confirmation.cancel']}"  
									  message="#{bundle['ice_confirmation.sendreview.message']}"  
									  title="#{bundle['ice_confirmation.sendsurvey.title']}"  
									  draggable="false"  
							/>

						</ice:form>

						<ice:form>
							<ice:panelPopup modal="true"  visible="#{zoomSurveyQuestionsPopUpBean.visible}" style="width:#{utilServiceLocatorBean.widthSurveyBuiltTable+350}px;" styleClass="icePanelPopupBody icePanelPopup" autoCentre="true">
						                <f:facet name="header">
						                   <ice:panelGrid width="#{utilServiceLocatorBean.widthSurveyBuiltTable+350}px;" cellpadding="0" cellspacing="1" columns="4" styleClass="trHeader" >
						                        <ice:outputText style="color: white;font-size:16px;font-variant:small-caps;" value="#{bundle['s_survey_survey.preview']}"/>
						                        
						                        <table>
						                        	<tr>
						                        		<td>
						                        			<ice:inputText maxlength="6" size="8" value="#{statusSectionBean.count_questions}"
																styleClass="fieldmenuzoomamount" readonly="true">
															</ice:inputText>
														</td>
						                        		<td>
						                        		<ice:graphicImage url="./css/images/icons/menu_up_of.png" style="border:none;" /></td>
						                        		<td>
						                        			<ice:inputText maxlength="6" size="8"
																value="#{statusSectionBean.iresponse_questions}" styleClass="fieldmenuzoomindex" readonly="true">
															</ice:inputText>
														</td>
						                        	</tr>
						                        </table>
												
												<ice:commandLink actionListener="#{statusSectionBean.saveQuestions}">
													<ice:graphicImage style="border:none;" styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_zoomsave.png"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_zoomsave.png'"
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_zoomsave.png'"
														
														/>
												</ice:commandLink>
						                        <ice:commandButton image="./css/images/icons/close.png" action="#{zoomSurveyQuestionsPopUpBean.closePopup}" title="Close this draggable popup"/>
						                    </ice:panelGrid>
						                </f:facet>
						                
						                <f:facet name="body">
						                
								           <div style="height:#{utilServiceLocatorBean.heightAllTree+150}px;margin-top:0px;overflow:auto;width:#{utilServiceLocatorBean.widthSurveyBuiltTable+330}px;">
									
												<ice:panelGroup>
													<div xmlns:ft="http://www.mcmsoftware.com">
														<c:forEach var="builtsurvey"
															items="#{builtSurveyManager.list_surveys}">
															<ft:builtsurvey value="#{builtsurvey}" />
														</c:forEach>
													</div>
												</ice:panelGroup>
											</div>
						                    
						                </f:facet>
					         </ice:panelPopup>
						</ice:form>

					</ui:define>


				</ui:composition>



			</body>
		</html>
	</f:view>
</jsp:root>
