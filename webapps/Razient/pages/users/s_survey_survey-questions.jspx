					<ui:define name="page-content-value">

						<ice:form>
							
								<div class="paneTableBox"
									style="height:100;margin-top:1px;overflow:auto;width:100%;">


									<table  cellspacing="0" cellpadding="0" style="margin-top: 2px;" width="100%" >
										<tr>
											<td>&amp;nbsp</td>
											<td align="left">
												<ice:commandLink
													actionListener="#{statusSectionBean.saveQuestions}">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_savesurvey.png"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_savesurvey.png'"
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_savesurvey.png'"
														/>
												</ice:commandLink>
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
												<ice:commandLink action="#{zoomSurveyQuestionsPopUpBean.openPopup}" rendered="#{not zoomSurveyQuestionsPopUpBean.visible}">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_zoomsurvey.png"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_zoomsurvey.png'"
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_zoomsurvey.png'"
														/>
												</ice:commandLink>
											</td>
											<td>
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
											</td>
											<td align="left">
												<ice:commandLink
													action="#{s_SV_SV_TreeSurveyBean.buildSection_unansweredAction}">
													<ice:graphicImage style="border:none;"
														styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_up_findunanswered.png"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_findunanswered.png'"
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_findunanswered.png'"
														/>
												</ice:commandLink>
												&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
											</td>
											<td align="right">
												<ice:commandLink action="#{s_SV_SV_ListTableBean.toListSurvey}"
													actionListener="#{statusSectionBean.surveyToReview}"
													panelConfirmation="confirmsend"
													onclick="window.location.reload();">
													<ice:graphicImage style="border:none;"
