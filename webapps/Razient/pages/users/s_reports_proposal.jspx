<?xml version="1.0" encoding="utf-8" ?>
<jsp:root version="1.2"
   xmlns:jsp="http://java.sun.com/JSP/Page"
   xmlns:f="http://java.sun.com/jsf/core"
   xmlns:h="http://java.sun.com/jsf/html"
   xmlns:ice="http://www.icesoft.com/icefaces/component">
   <jsp:directive.page contentType="text/html;charset=ISO-8859-1" pageEncoding="ISO-8859-1" />
   <f:view>
   		<ice:outputDeclaration 
            doctypeRoot="html" 
            doctypePublic="-//W3C//DTD HTML 4.01 Transitional//EN" 
            doctypeSystem="http://www.w3.org/TR/html4/loose.dtd" /> 
    <html>
       <head>
         <title>Index (Razient)</title>
       </head>
       <body>
       
        	<!-- template="#{templateBean.templateContent}"-->
			<ui:composition
			        template="../../include/templates/pages/modeB_supplier.jspx"
			        xmlns:h="http://java.sun.com/jsf/html"
			        xmlns:f="http://java.sun.com/jsf/core"
			        xmlns:c="http://java.sun.com/jstl/core"
			        xmlns:ice="http://www.icesoft.com/icefaces/component"
			        xmlns:ui="http://java.sun.com/jsf/facelets" >
			
			  <!-- params for page titles-->
			 		 <!--<f:loadBundle basename="truckandi.view.bundle.Message" var="bundle"/>
			        <ui:param name="pageTitle" value="#{bundle['tai_login.title']}" />-->
					<ui:param name="pageTitle" value="Request Proposal" />
				
				<ui:define name="header_menu_value">
						<table cellspacing="0" cellpadding="0">
										<tr>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">		
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/menu/risk_dash_1.png" 
														onmouseout	="this.src='./css/images/menu/risk_dash_1.png'"
														onmouseover	="this.src='./css/images/menu/risk_dash_2.png'"
														onmouseup	="this.src='./css/images/menu/risk_dash_1.png'"
														onmousedown	="this.src='./css/images/menu/risk_dash_2.png'" />
														<f:attribute name="optioonselected" value="dh"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_Survey}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/menu/risk_survey_1.png" 
														onmouseout	="this.src='./css/images/menu/risk_survey_1.png'"
														onmouseover	="this.src='./css/images/menu/risk_survey_2.png'"
														onmouseup	="this.src='./css/images/menu/risk_survey_1.png'"
														onmousedown	="this.src='./css/images/menu/risk_survey_2.png'" />
													<f:attribute name="optioonselected" value="sv_sv"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_GlobalIncidents}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/menu/risk_global_1.png" 
														onmouseout	="this.src='./css/images/menu/risk_global_1.png'"
														onmouseover	="this.src='./css/images/menu/risk_global_2.png'"
														onmouseup	="this.src='./css/images/menu/risk_global_1.png'"
														onmousedown	="this.src='./css/images/menu/risk_global_2.png'" />
													<f:attribute name="optioonselected" value="gi_al"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_RequestForProposal}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/menu/risk_request_1.png" 
														onmouseout	="this.src='./css/images/menu/risk_request_1.png'"
														onmouseover	="this.src='./css/images/menu/risk_request_2.png'"
														onmouseup	="this.src='./css/images/menu/risk_request_1.png'"
														onmousedown	="this.src='./css/images/menu/risk_request_2.png'" />
													<f:attribute name="optioonselected" value="rp_op"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>																																		
												<ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/menu/risk_rep_2.png"  visible="#{users_MenuBarBean.visible_S_Reports}"/>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_Administration}">																								
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_2.png'" />
														<f:attribute name="optioonselected" value="ad_um"/>
												</ice:commandLink>
											</td>
										</tr>
									</table>			
				</ui:define>
			    
			    <ui:define name="page-menu-value">
			    	 <ice:form>
					 
					<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
					 	<ice:graphicImage visible="true"  styleClass="menuPosA"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_survey.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_survey.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_survey.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_survey.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_survey.png'" />
						<f:attribute name="optioonselected" value="rp_sv"/>
					</ice:commandLink>	
					<ice:graphicImage visible="true"  styleClass="menuPosB"
										url		="./css/images/menu/risk_menu_down_proposal.png"/>
					<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
					 	<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_globalincidents.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_globalincidents.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_globalincidents.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_globalincidents.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_globalincidents.png'" />
						<f:attribute name="optioonselected" value="rp_gi"/>
					</ice:commandLink>
					
					<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_one.png"/>
					 </ice:form> 	
			    </ui:define>
			    
				<ui:define name="page-content-value">
					<table border="1" cellspacing="0" cellpadding="5" class="tabularView" style="border: 1px #C3DFF4 solid;">
                  <tr align="left" bgcolor="#3C7FB1" style="color:#FFFFFF">
                    <th width="100">Company</th>
                    <th>RFP ID</th>
                    <th width="200">RFP Name</th>
                    <th width="400">RFP Brief    Description</th>
                    <th width="100">Rfp Due Date</th>
                    <th width="100">Select For Review</th>
                  </tr>
                  <tr bgcolor="#FFFFFF">
                    <td>Cisco</td>
                    <td align="right">112233</td>
                    <td>Build    New Router</td>
                    <td>New    manufacturing company will build new router to specs.</td>
                    <td align="right">7/30/2010</td>
                    <td><img src="./css/images/general/select.png" width="27" height="27"/></td>
                  </tr>
                  <tr class="odd" bgcolor="#EFF2FF">
                    <td>IBM</td>
                    <td align="right">223333</td>
                    <td>Build    a Data center</td>
                    <td>Build    a new data center in Shanghai China</td>
                    <td align="right">8/30/2010</td>
                    <td><img src="./css/images/general/select.png" width="27" height="27"/></td>
                  </tr>
                  <tr bgcolor="#FFFFFF">
                    <td>Nike</td>
                    <td align="right">444444</td>
                    <td>Design    new Shoe</td>
                    <td>Design    a new shoe for LeBron James</td>
                    <td align="right">9/30/2010</td>
                    <td><img src="./css/images/general/select.png" width="27" height="27"/></td>
                  </tr>
                </table>
                <br/>
                <table border="1" cellspacing="0" cellpadding="5" class="tabularView" style="border: 1px #C3DFF4 solid;">
                  <tr align="left">
                    <th width="170"  bgcolor="#3C7FB1" style="color:#FFFFFF">Company</th>
                    <td width="700" bgcolor="#FFFFFF">Cisco</td>
                  </tr>
                  <tr align="left">
                    <th bgcolor="#3C7FB1" style="color:#FFFFFF">Propsal ID</th>
                    <td bgcolor="#FFFFFF">112233</td>
                  </tr>
                  <tr align="left">
                    <th bgcolor="#3C7FB1" style="color:#FFFFFF">Proposal Name</th>
                    <td bgcolor="#FFFFFF">Build    New Router</td>
                  </tr>
                  <tr align="left">
                    <th bgcolor="#3C7FB1" style="color:#FFFFFF">Propsal Date</th>
                    <td bgcolor="#FFFFFF">7/30/2010</td>
                  </tr>
                  <tr align="left">
                    <th bgcolor="#3C7FB1" style="color:#FFFFFF">Proposal Description</th>
                    <td bgcolor="#FFFFFF">New    manufacturing company will build new router to specs.</td>
                  </tr>
                  <tr align="left">
                    <th bgcolor="#3C7FB1" style="color:#FFFFFF">Bidder Requirements</th>
                    <td bgcolor="#FFFFFF">Rquirements    of companies bidding on proposal</td>
                  </tr>
                </table>
                <br/>
                <table border="1" cellspacing="0" cellpadding="5" class="tabularView" style="border: 1px #C3DFF4 solid;">
                  <tr align="left" bgcolor="#3C7FB1" style="color:#FFFFFF">
                    <th width="18%">Proposal    Questions</th>
                    <th width="44%">Question    Description</th>
                    <th width="38%">Answer The    Question</th>
                  </tr>
                  <tr bgcolor="#FFFFFF">
                    <td>Question 1: History</td>
                    <td>Provide    a history or projects in the industry and the skill required to deliver the    projects</td>
                    <td>We    have worked on many projects for high tech companies</td>
                  </tr>
                  <tr class="odd" bgcolor="#EFF2FF">
                    <td>Question 2: References</td>
                    <td>Provide    a list of 5 references that can be contacted.</td>
                    <td>Here    is our list of references. John Doe, Bob Smith, James Maddison</td>
                  </tr>
                  <tr bgcolor="#FFFFFF">
                    <td>Question 3: Certifications</td>
                    <td>Provide    a list of certification in the industry including ISO 9001 certification.</td>
                    <td>We    are certified with ISO9001 and PCI</td>
                  </tr>
                  <tr class="odd" bgcolor="#EFF2FF">
                    <td>Question 4: Skillset</td>
                    <td>Provide    a list of capabilities in this industry.</td>
                    <td>We    can manufacture all electronics.</td>
                  </tr>
                  <tr bgcolor="#FFFFFF">
                    <td>Question 5: Pricing</td>
                    <td>Provide    pricing and schedule for delivery</td>
                    <td>We    will price each unit at $50 and have a delivery time of 6 months.</td>
                  </tr>
                  <tr bgcolor="#FFFFFF">
                    <td colspan="3" style="padding:10px;"><div align="center"><img src="./css/images/general/print.png" width="21" height="21"/><img src="./css/images/general/pdf.png" width="21" height="21"/></div></td>
                    </tr>
                </table>
				</ui:define>
				

			</ui:composition>

	

       </body>
    </html>
   </f:view>
</jsp:root>
