					                				<ice:commandLink action ="#{viewlogsPopUpBean.closePopup}">
																<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/general/logexit.png"/>
													</ice:commandLink>
												</td>
				                			</tr>
				                		</table>
									</ice:panelGrid>
				                </f:facet>
				            </ice:panelPopup>   
				            
				            
				            <ice:panelPopup modal="true" visible="#{listEmployeeCustomerToUserPopUpBean.visible}" style="margin-left:0px;margin-top:-55px;position:absolute; width:650px;" styleClass="icePanelPopupBody">
