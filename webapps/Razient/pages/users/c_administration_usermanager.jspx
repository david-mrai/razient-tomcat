					<ui:define name="page-content-value">


						<!-- Static Tab Set -->
						<ice:form>
							<ice:panelGroup id="tabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer">

								<ice:panelTabSet
									tabChangeListener="#{c_UserManagerBean.processTabChange}" selectedIndex="#{c_UserManagerBean.ITab}">

									<ice:panelTab label="#{bundle['c_admin_usermanager.tab1']}">
									
										
											
											<ice:panelGroup id="tabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer">
						
						  						<ice:panelTabSet tabChangeListener="#{c_UserRegisterManagerBean.processTabChange}"  selectedIndex="#{c_UserRegisterManagerBean.ITab}">
						   
													<ice:panelTab   label="#{bundle['c_admin_usermanager.tab11']}" >
																			
														<br/>
														<ice:panelGroup style="margin-top:-3px;width:97%;overflow:auto;">
		
															<ice:panelGroup>
																<ice:panelGroup>
																	<ice:dataTable resizable="false" border="1" id="tableuseremployeecustgrid"
																		value="#{c_UserEmployeeCustGridBean.allCrudBeans}"
																		var="adminUserEmployeeCustBean"
																		width="98%"
																		rows="#{c_UserEmployeeCustGridBean.selectedDataScrollModes[c_UserEmployeeCustGridBean.selectedDataScrollMode].rows}"
																		scrollable="#{c_UserEmployeeCustGridBean.selectedDataScrollModes[c_UserEmployeeCustGridBean.selectedDataScrollMode].scrollingEnabled}"
																		scrollHeight="200px"
																		style="float:center;font-color: #FFFFFF;"
																		columnWidths="20%,1%,25%,25%,20%,9%"
																		columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
																		rowClasses="rowOn,rowOff" cellpadding="0"
																		sortColumn="#{c_UserEmployeeCustGridBean.columnNameOrder}"
																		sortAscending="#{c_UserEmployeeCustGridBean.descending}"
																		onclick="window.location.reload()">
						
																		
																		<ice:column groupOn="#{adminUserEmployeeCustBean.nameSite}" style="background-color:#F7F4F5;">
																			<f:facet name="header">
																				<ice:commandSortHeader id="ecustomerSiteIdCustomerSitesort" columnName="customerSiteIdCustomerSite">
																					<ice:outputText	value="#{bundle['rz_admin_customerprofile.employee.site']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="idecustomerSiteIdCustomerSite"  style="font-weight:bold;text-align:center;"
																				value="#{adminUserEmployeeCustBean.nameSite}" />
																		</ice:column>
																		<ice:column style="background-color:white;">
																			<ice:rowSelector id="selected"
																				value="#{c_UserEmployeeCustGridBean.itemSelected}" multiple="false"
																				selectionListener="#{c_UserEmployeeCustGridBean.rowSelectionListener}"
																				selectionAction="#{c_UserEmployeeCustGridBean.rowSelectionAction}" /> 
	
																				<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/#{folderBean.folder_menu}/icons/menu_useractive.png"/>		
																		
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="eemailssort" columnName="email">
																					<ice:outputText value="#{bundle['rz_admin_usermanager.user.login']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="eemaildesc"
																				value="#{adminUserEmployeeCustBean.email}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="efirstnamesort" columnName="firstName">
																					<ice:outputText value="#{bundle['rz_admin_usermanager.user.firstname']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="idefirstname"
																					value="#{adminUserEmployeeCustBean.firstName}" />
																		</ice:column>
																		<ice:column>
