															                        <ice:outputText style="color: white;" value="#{bundle['rz_filedocument.download']}"/>
															                        <ice:commandLink  action="#{filedocumentPopUpBean.closePopup}" >
																							<ice:graphicImage style="border:none;" styleClass="noborder"
																								url="./css/images/icons/close.png" />
																							
																					</ice:commandLink>
															                    </ice:panelGrid>
												</f:facet>
															                
									<f:facet name="body">
									<ice:panelGrid width="100%" columns="1" cellpadding="0"  style="background-color: white">
            	
            									<table cellpadding="0" cellspacing="0" width="100%" style="margin-top:0px;background-color:white;">
									  	 			<tr>
									  	 												  	 					
															<td>
																&amp;nbsp
															</td>
									  	 					<td style="text-align:center"><br/>
																	<ice:panelGroup visible="#{filedocumentBean.visible}">
																			<a href="#{filedocumentBean.urlfile}" target="_blank">
																				<ice:graphicImage id="imagesurlfile"
																									url="./css/images/icons/type_#{filedocumentBean.imagetype}.png"
																									style="border:none;" title="next" />	
																			</a>   				
																		</ice:panelGroup>	
																		<ice:panelGroup visible="#{not filedocumentBean.visible}">
																			<ice:graphicImage id="imagesnot"
																									url="./css/images/icons/type_#{filedocumentBean.imagetype}.png"
																									style="border:none;" title="next" />	
																		</ice:panelGroup>	    
															</td>
															<td>
																&amp;nbsp
																
															</td>
									  	 			</tr>
									  	 			<tr>
									  	 												  	 					
															<td>
																&amp;nbsp
															</td>
									  	 					<td style="text-align:center"><br/>
									  	 							<h:outputText styleClass="titleFileDocuments"
																	value="#{filedocumentBean.pathname}" />
																	<hr/> 
															</td>
															<td>
																&amp;nbsp
															</td>
									  	 			</tr>					  	 		
									  	 		</table>
												            	
											</ice:panelGrid>
										</f:facet>		                
								</ice:panelPopup>
								
				       </ice:form>
					
					
					

					</ui:define>


				</ui:composition>



			</body>
		</html>
	</f:view>
</jsp:root>
