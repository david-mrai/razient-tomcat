													</ice:commandLink>
												</td>
				                			</tr>
				                		</table>
									</ice:panelGrid>
				                </f:facet>
				            </ice:panelPopup>   
				            
				            
				            <ice:panelPopup modal="true" visible="#{listEmployeeCustomerPrimaryPopUpBean.visible}" style="margin-left:0px;margin-top:-55px;position:absolute; width:550px;" styleClass="icePanelPopupBody">
