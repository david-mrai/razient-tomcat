							<ice:panelGroup id="tabSetTabCustomerProfile" styleClass="tabPanelBox panelTabSetSaleContainer"	visible="#{c_MyProfileCrudBean.visibleTabs}">
								
								<ice:panelTabSet tabChangeListener="#{c_MyProfileCrudBean.processTabChange}" selectedIndex="#{c_MyProfileCrudBean.ITab}">

									<ice:panelTab label="#{bundle['rz_admin_customerprofile.tab1']}">
										<div style="height:540px;overflow:auto;">
										
										<br/>
							
										<ice:panelGroup styleClass="customerProfileBox" style="margin-top:-3px;height:500px;width:97%;overflow:auto;">

											<ice:panelGroup>
												<ice:panelGroup>
													<ice:dataTable resizable="false" border="1" id="tablesitegrid"
														value="#{rz_SiteGridBean.allCrudBeans}"
														var="adminSiteBean"
														width="98%"
														rows="#{rz_SiteGridBean.selectedDataScrollModes[rz_SiteGridBean.selectedDataScrollMode].rows}"
														scrollable="#{rz_SiteGridBean.selectedDataScrollModes[rz_SiteGridBean.selectedDataScrollMode].scrollingEnabled}"
														scrollHeight="200px"
														style="float:center;font-color: #FFFFFF;"
														columnWidths="1%,19%,20%,15%,15%,10%,15%,5%"
														columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
														rowClasses="rowOn,rowOff" cellpadding="0"
														sortColumn="#{rz_SiteGridBean.columnNameOrder}"
														sortAscending="#{rz_SiteGridBean.descending}"
														onclick="window.location.reload()">
		
														<ice:column>
															<ice:rowSelector id="selected"
																value="#{rz_SiteGridBean.itemSelected}" multiple="false"
																selectionListener="#{rz_SiteGridBean.rowSelectionListener}"
																selectionAction="#{rz_SiteGridBean.rowSelectionAction}" >
																<f:attribute name="typeSelected" value="ofCustomer"/> 
															</ice:rowSelector>	              
											                   <ice:outputText id="idname" style="font-weight:bold;color:#8F5662;font-size:20px;" value="#{adminSiteBean.indexkey}" />
																		
														</ice:column>
														<ice:column>
															<f:facet name="header">
																<ice:commandSortHeader id="namesort" columnName="name">
																	<ice:outputText value="#{bundle['rz_admin_customerprofile.site.name']}"></ice:outputText>
																</ice:commandSortHeader>
															</f:facet>
															<ice:outputText id="idname" style="font-weight:bold;"
																	value="#{adminSiteBean.name}" />
														</ice:column>
														<ice:column>
															<f:facet name="header">
																<ice:commandSortHeader id="addresssort" columnName="address">
																	<ice:outputText value="#{bundle['rz_admin_customerprofile.site.address']}"></ice:outputText>
																</ice:commandSortHeader>
															</f:facet>
															<ice:outputText id="idname"
																value="#{adminSiteBean.address}" />
														</ice:column>
														<ice:column groupOn="#{adminSiteBean.countryDesc}" style="background-color:#F7F4F5;">
															<f:facet name="header">
																<ice:commandSortHeader id="countrysort" columnName="countryDesc">
																	<ice:outputText value="#{bundle['rz_admin_customerprofile.site.country']}"></ice:outputText>
																</ice:commandSortHeader>
															</f:facet>
															<ice:outputText id="countrydesc"  style="font-weight:bold;text-align:center;"
																value="#{adminSiteBean.countryDesc}" />
														</ice:column>
														<ice:column groupOn="#{adminSiteBean.stateDesc}"  style="background-color:#F3F4F8;">
															<f:facet name="header">
																<ice:commandSortHeader id="statesort" columnName="stateDesc">
																	<ice:outputText value="#{bundle['c_admin_supplierprofile.site.state']}"></ice:outputText>
																</ice:commandSortHeader>
															</f:facet>
															<ice:outputText id="statedesc"
																value="#{adminSiteBean.stateDesc}" />
														</ice:column>
														<ice:column groupOn="#{adminSiteBean.cityDesc}"  style="background-color:#F4F7F5;">
															<f:facet name="header">
																<ice:commandSortHeader id="citysort" columnName="cityDesc">
																	<ice:outputText value="#{bundle['rz_admin_customerprofile.site.city']}"></ice:outputText>
																</ice:commandSortHeader>
															</f:facet>
															<ice:outputText id="citydesc"
																value="#{adminSiteBean.cityDesc}" />
														</ice:column>
														<ice:column>
															<f:facet name="header">
																<ice:outputText
																	value="#{bundle['rz_admin_customerprofile.site.locationCriticality']}"></ice:outputText>
															</f:facet>
															<ice:outputText id="idlocation"
																value="#{adminSiteBean.locationCriticality}" />
														</ice:column>
														<ice:column style="background-color:white;">
															<f:facet name="header">
																<span style="color:#F9FAF8;font-size:9px;text-align: center">&amp;nbsp</span>
															</f:facet>
															<ice:graphicImage style="border:none;" styleClass="noborder"
																url="./css/images/#{folderBean.folder_menu}/icons/menu_down_edit.png"
																onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_edit.png'"
																onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_edit.png'"
															
															/>
														</ice:column>
													</ice:dataTable>
													<ice:panelGroup styleClass="clearer" />
		
		
													<!-- PAGINATOR-->
													<ice:panelGroup style="float:left;width:420px;">
														<center>
															<ice:dataPaginator id="dataScroll_Site"
																rendered="#{rz_SiteGridBean.selectedDataScrollModes[rz_SiteGridBean.selectedDataScrollMode].pagingEnabled}"
																for="tablesitegrid" vertical="false" fastStep="3" paginator="true"
																paginatorMaxPages="10">
																<f:facet name="first">
																	<ice:graphicImage id="firstpage_1"
																		url="./css/rime/css-images/arrow-first.gif"
																		style="border:none;" title="first" />
																</f:facet>
																<f:facet name="last">
																	<ice:graphicImage id="lastpage_1"
																		url="./css/rime/css-images/arrow-last.gif"
																		style="border:none;" title="last" />
																</f:facet>
																<f:facet name="previous">
																	<ice:graphicImage id="previouspage_1"
																		url="./css/rime/css-images/arrow-previous.gif"
																		style="border:none;" title="previous" />
																</f:facet>
																<f:facet name="next">
																	<ice:graphicImage id="nextpage_1"
																		url="./css/rime/css-images/arrow-next.gif"
																		style="border:none;" title="next" />
																</f:facet>
																<f:facet name="fastforward">
																	<ice:graphicImage id="fastforward_1"
																		url="./css/rime/css-images/arrow-ff.gif"
																		style="border:none;" title="ff" />
																</f:facet>
																<f:facet name="fastrewind">
																	<ice:graphicImage id="fastrewind_1"
																		url="./css/rime/css-images/arrow-fr.gif"
																		style="border:none;" title="fr" />
																</f:facet>
															</ice:dataPaginator>
														</center>
													</ice:panelGroup>
		
												</ice:panelGroup>
												
												<table width="98%"  >
													<tr><td align="left">
													<ice:commandLink actionListener="#{rz_SiteGridBean.selectionListener}" action="#{rz_SiteGridBean.createNewSiteAction}"  onclick="rld();">
														<ice:graphicImage style="border:none;" styleClass="noborder"
															url="./css/images/#{folderBean.folder_menu}/icons/menu_up_createnewsite.png"
