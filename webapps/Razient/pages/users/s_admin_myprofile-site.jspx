						<h:form>
							
							<ice:panelGroup id="tabSetTabCustomerProfile" styleClass="tabPanelBox panelTabSetSaleContainer">

								<ice:panelTabSet>

								<ice:panelTab label="#{bundle['c_admin_supplierprofile_site.title']}">
									<div style="height:100%;">
										
										<br/>
										<ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;">
											<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
												<tr>
													<td width="20%"  class="tablelabeledit_#{c_SiteCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['c_admin_supplierprofile.site.name']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{c_SiteCrudBean.stEdit_Global}" width="30%">
														<ice:inputText id="name" size="30" maxlength="30"
																value="#{c_SiteCrudBean.name}" partialSubmit="true"
																readonly="#{c_SiteCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{c_SiteCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
													<td  width="20%" class="tablelabeledit_#{c_SiteCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['c_admin_supplierprofile.site.address']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{c_SiteCrudBean.stEdit_Global}" width="30%">
														<ice:inputText id="addr" size="60" maxlength="60"
																value="#{c_SiteCrudBean.address}" partialSubmit="true"
																readonly="#{c_SiteCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{c_SiteCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
												</tr>
												<tr><td colspan="4" class="menusep_#{c_SiteCrudBean.stEdit_Global}"></td></tr>
												<tr>
													<td width="20%"  class="tablelabeledit_#{c_SiteCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['c_admin_supplierprofile.site.country']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{c_SiteCrudBean.stEdit_Global}" width="30%">
														<ice:selectOneMenu value="#{c_SiteCrudBean.country}" visible="#{not c_SiteCrudBean.bEdit_Global}"
																id="selectedCountry" styleClass="selectedOneMasterCountry"
																valueChangeListener="#{c_SiteCrudBean.processValueChange}"
																partialSubmit="true">
																<f:selectItem itemLabel="#{bundle['rz_select_country']}"
																	itemValue="0" />
																<f:selectItems
																	value="#{applicationBean.countrySelectedItems}"
																	id="country" />
														</ice:selectOneMenu>	
														<ice:inputText id="countrydesc" size="30" maxlength="30" visible="#{c_SiteCrudBean.bEdit_Global}"
																value="#{c_SiteCrudBean.countryDesc}" partialSubmit="true"
																readonly="#{c_SiteCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{c_SiteCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
													<td  width="20%" class="tablelabeledit_#{c_SiteCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['c_admin_supplierprofile.site.zipCode']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{c_SiteCrudBean.stEdit_Global}" width="30%">
														<ice:inputText id="zipcode" size="30" maxlength="30"
																value="#{c_SiteCrudBean.zipCode}" partialSubmit="true"
																readonly="#{c_SiteCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{c_SiteCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
												</tr>
												<tr><td colspan="4" class="menusep_#{c_SiteCrudBean.stEdit_Global}"></td></tr>
												<tr>
													<td width="20%"  class="tablelabeledit_#{c_SiteCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['c_admin_supplierprofile.site.state']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{c_SiteCrudBean.stEdit_Global}" width="30%">
														<ice:selectOneMenu value="#{c_SiteCrudBean.state}" visible="#{not c_SiteCrudBean.bEdit_Global}"
																		id="selectedState" styleClass="selectedOneMasterState"
																		valueChangeListener="#{c_SiteCrudBean.processValueChange}"
																		partialSubmit="true">
																		<f:selectItem itemLabel="#{bundle['rz_select_state']}" itemValue="0" />
																		<f:selectItems value="#{c_SiteCrudBean.list_State}" id="state" />
														</ice:selectOneMenu>
														<ice:inputText id="statedesc" size="30" maxlength="30" visible="#{c_SiteCrudBean.bEdit_Global}"
																value="#{c_SiteCrudBean.stateDesc}" partialSubmit="true"
																readonly="#{c_SiteCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{c_SiteCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
													<td  width="20%" class="tablelabeledit_#{c_SiteCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['c_admin_supplierprofile.site.locationCriticality']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{c_SiteCrudBean.stEdit_Global}" width="30%">
														<ice:selectOneMenu id="selectedcritical" visible="#{not c_SiteCrudBean.bEdit_Global}"
																value="#{c_SiteCrudBean.locationCriticality}"
																styleClass="selectedOneMenukeyBold"
																valueChangeListener="#{c_SiteCrudBean.processValueChange}"
																partialSubmit="true">
																<f:selectItems value="#{c_SiteCrudBean.list_LocCriti}" />
														</ice:selectOneMenu>
														<ice:inputText id="statusDesc" size="30" maxlength="30" visible="#{c_SiteCrudBean.bEdit_Global}"
																value="#{c_SiteCrudBean.locationCriticalityDesc}" partialSubmit="true"
																readonly="#{c_SiteCrudBean.bEdit_Global}" styleClass="tablefieldedit_#{c_SiteCrudBean.stEdit_Global}">
														</ice:inputText>
													 </td>
												</tr>
												<tr><td colspan="4" class="menusep_#{c_SiteCrudBean.stEdit_Global}"></td></tr>
												<tr>
													<td width="20%"  class="tablelabeledit_#{c_SiteCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
															<h:outputLabel>
																<h:outputText value="#{bundle['c_admin_supplierprofile.site.city']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td align="left" class="tablelabelfieldedit_#{c_SiteCrudBean.stEdit_Global}" width="30%">
														<ice:selectOneMenu value="#{c_SiteCrudBean.city}"  visible="#{not c_SiteCrudBean.bEdit_Global}"
																id="selectedCity" styleClass="selectedOneMasterState"
																valueChangeListener="#{c_SiteCrudBean.processValueChange}"
																partialSubmit="true">
																<f:selectItem itemLabel="#{bundle['rz_select_city']}"
																	itemValue="0" />
																<f:selectItems value="#{c_SiteCrudBean.list_City}"
																	id="city" />
														</ice:selectOneMenu>
