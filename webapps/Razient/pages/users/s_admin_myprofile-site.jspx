						</h:form>
						
						<ice:form>
						<ice:panelPopup  modal="true" visible="#{viewlogsPopUpBean.visible}" style="margin-top:-90px; width:485px;" styleClass="icePanelPopupBody icePanelPopup">
				                <f:facet name="header">
				                   <ice:panelGrid width="485" cellpadding="0" cellspacing="1" columns="2" styleClass="trHeader" >
				                        <ice:outputText style="color: white;" value="#{bundle['rz_log']}"/>
				                        <ice:commandButton image="./css/images/icons/close.png" action="#{viewlogsPopUpBean.closePopup}" title="Close this draggable popup"/>
				                    </ice:panelGrid>
				                </f:facet>
				                <f:facet name="body">
				                	<ice:panelGrid width="100%">
				                		<table style="border:none;margin-top:-10px;float:left;">
				                			<tr>
				                				<td rowspan="2" valign="top"><ice:graphicImage styleClass="noborder" url="./css/images/general/log#{logger.stType}.png"/></td>
				                				<td style="color:#3A4358;font-weight:bold;">&amp;nbsp&amp;nbsp#{logger.stType}</td>
				                			</tr>
				                			<tr>
				                				<td >
					                				 <ice:panelGrid width="100%" columns="1" cellpadding="0" border="1" style="background-color: #F4F4F4;border-color:black;" >
									                	<table align="center">
										                       	<tr>
											                       <td  width="410" colspan="3" class="tableflabelmaster" >
											                       		<div style="height:200px;overflow: auto;" >
											                       			#{logger.stLogger}
											                       		</div>
											                       </td>
											                    </tr>
											             </table>
								                 	</ice:panelGrid>
				                				</td>
				                			</tr>
				                			<tr>
				                				<td colspan="3" align="right">
					                				<ice:commandLink action ="#{viewlogsPopUpBean.closePopup}">
																<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/general/logexit.png"/>
													</ice:commandLink>
												</td>
				                			</tr>
				                		</table>
									</ice:panelGrid>
				                </f:facet>
				            </ice:panelPopup>  
				            
				            <ice:panelPopup modal="true" visible="#{listEmployeeSupplierPrimaryPopUpBean.visible}" style="margin-left:0px;margin-top:-55px;position:absolute; width:550px;" styleClass="icePanelPopupBody">
												 <f:facet name="header">
															                    <ice:panelGrid width="550" cellpadding="0" cellspacing="1" columns="2" styleClass="trHeader" >
															                        <ice:outputText style="color: white;" value="#{bundle['c_admin_supplierprofile_site.employees']}"/>
															                        <ice:commandLink  action="#{listEmployeeSupplierPrimaryPopUpBean.closePopup}" >
																							<ice:graphicImage style="border:none;" styleClass="noborder"
																								url="./css/images/icons/close.png" />
																							
																					</ice:commandLink>
															                    </ice:panelGrid>
												</f:facet>
															                
									<f:facet name="body">
									<ice:panelGrid width="100%" columns="1" cellpadding="0"  style="background-color: #F0F7FB">
            	
												<ice:panelGroup>
													<ice:panelGroup>
														<ice:dataTable resizable="false" border="1" id="tablesiteemployeegrid"
															value="#{c_SiteEmployeeGridBean.allCrudBeans}"
															var="adminSiteEmployeeBean"
															width="98%"
															rows="#{c_SiteEmployeeGridBean.selectedDataScrollModes[c_SiteEmployeeGridBean.selectedDataScrollMode].rows}"
															scrollable="#{c_SiteEmployeeGridBean.selectedDataScrollModes[c_SiteEmployeeGridBean.selectedDataScrollMode].scrollingEnabled}"
															scrollHeight="200px"
															style="float:center;font-color: #FFFFFF;"
															columnWidths="1%,29%,25%,40%,5%"
															columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
															rowClasses="rowOn,rowOff" cellpadding="0"
															sortColumn="#{c_SiteEmployeeGridBean.columnNameOrder}"
															sortAscending="#{c_SiteEmployeeGridBean.descending}"
															>
			
															<ice:column>
																<ice:rowSelector id="selected"
																	value="#{c_SiteEmployeeGridBean.itemSelected}" multiple="false"
																	selectionListener="#{c_SiteEmployeeGridBean.rowSelectionListener}"
																	selectionAction="#{c_SiteEmployeeGridBean.rowSelectionAction}" /> 
																	>>		
															</ice:column>
															<ice:column>
																<f:facet name="header">
																	<ice:commandSortHeader id="efirstnamesort" columnName="firstName">
																		<ice:outputText value="#{bundle['c_admin_supplierprofile.employee.firstname']}"></ice:outputText>
																	</ice:commandSortHeader>
																</f:facet>
																<ice:outputText id="idefirstname" value="#{adminSiteEmployeeBean.firstName}" />
															</ice:column>
															<ice:column>
																<f:facet name="header">
																	<ice:commandSortHeader id="elastNamesort" columnName="lastName">
																		<ice:outputText value="#{bundle['c_admin_supplierprofile.employee.lastname']}"></ice:outputText>
																	</ice:commandSortHeader>
																</f:facet>
																<ice:outputText id="idelastname" value="#{adminSiteEmployeeBean.lastName}" />
															</ice:column>
															<ice:column>
																<f:facet name="header">
																		<ice:outputText value="#{bundle['c_admin_supplierprofile.employee.email']}"></ice:outputText>
																</f:facet>
																<ice:outputText id="eemaildesc" style="font-weight:bold;"  value="#{adminSiteEmployeeBean.email}" />
															</ice:column>
															<ice:column>
																<f:facet name="header"></f:facet>
																<ice:graphicImage style="border:none;" styleClass="noborder"
																	url="./css/images/icons/menu_down_new_select.png"
																	onmouseout="this.src='./css/images/icons/menu_down_new_select.png'"
																	onmouseover="this.src='./css/images/icons/menu_up_new_select.png'"
																/>
															</ice:column>
														</ice:dataTable>
														<ice:panelGroup styleClass="clearer" />
			
			
														<!-- PAGINATOR-->
														<ice:panelGroup style="float:left;width:420px;">
															<center>
																<ice:dataPaginator id="dataScroll_Employee"
																	rendered="#{c_SiteEmployeeGridBean.selectedDataScrollModes[c_SiteEmployeeGridBean.selectedDataScrollMode].pagingEnabled}"
																	for="tablesiteemployeegrid" vertical="false" fastStep="3" paginator="true"
																	paginatorMaxPages="10">
																	<f:facet name="first">
																		<ice:graphicImage id="firstpage_employee1"
																			url="./css/rime/css-images/arrow-first.gif"
																			style="border:none;" title="first" />
																	</f:facet>
																	<f:facet name="last">
																		<ice:graphicImage id="lastpage_employee1"
																			url="./css/rime/css-images/arrow-last.gif"
																			style="border:none;" title="last" />
																	</f:facet>
																	<f:facet name="previous">
																		<ice:graphicImage id="previouspage_employee1"
																			url="./css/rime/css-images/arrow-previous.gif"
																			style="border:none;" title="previous" />
																	</f:facet>
																	<f:facet name="next">
																		<ice:graphicImage id="nextpage_employee1"
																			url="./css/rime/css-images/arrow-next.gif"
																			style="border:none;" title="next" />
																	</f:facet>
																	<f:facet name="fastforward">
																		<ice:graphicImage id="fastforward_employee1"
																			url="./css/rime/css-images/arrow-ff.gif"
																			style="border:none;" title="ff" />
																	</f:facet>
																	<f:facet name="fastrewind">
																		<ice:graphicImage id="fastrewind_employee1"
																			url="./css/rime/css-images/arrow-fr.gif"
																			style="border:none;" title="fr" />
																	</f:facet>
																</ice:dataPaginator>
															</center>
														</ice:panelGroup>
													</ice:panelGroup>
												</ice:panelGroup>			                	
											</ice:panelGrid>
										</f:facet>		                
								</ice:panelPopup>   
								
								
								<ice:panelPopup modal="true" visible="#{listEmployeeSupplierSecondPopUpBean.visible}" style="margin-left:0px;margin-top:-55px;position:absolute; width:550px;" styleClass="icePanelPopupBody">
												 <f:facet name="header">
															                    <ice:panelGrid width="550" cellpadding="0" cellspacing="1" columns="2" styleClass="trHeader" >
															                        <ice:outputText style="color: white;" value="#{bundle['c_admin_supplierprofile_site.employees']}"/>
															                        <ice:commandLink  action="#{listEmployeeSupplierSecondPopUpBean.closePopup}" >
																							<ice:graphicImage style="border:none;" styleClass="noborder"
																								url="./css/images/icons/close.png" />
																							
																					</ice:commandLink>
															                    </ice:panelGrid>
												</f:facet>
															                
									<f:facet name="body">
									<ice:panelGrid width="100%" columns="1" cellpadding="0"  style="background-color: #F0F7FB">
            	
												<ice:panelGroup>
													<ice:panelGroup>
														<ice:dataTable resizable="false" border="1" id="tablesiteemployeesecondgrid"
															value="#{c_SiteEmployeeGridBean.allCrudBeans}"
															var="adminSiteEmployeeSecondBean"
															width="98%"
															rows="#{c_SiteEmployeeGridBean.selectedDataScrollModes[c_SiteEmployeeGridBean.selectedDataScrollMode].rows}"
															scrollable="#{c_SiteEmployeeGridBean.selectedDataScrollModes[c_SiteEmployeeGridBean.selectedDataScrollMode].scrollingEnabled}"
															scrollHeight="200px"
															style="float:center;font-color: #FFFFFF;"
															columnWidths="1%,29%,25%,40%,5%"
															columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
															rowClasses="rowOn,rowOff" cellpadding="0"
															sortColumn="#{c_SiteEmployeeGridBean.columnNameOrder}"
															sortAscending="#{c_SiteEmployeeGridBean.descending}"
															>
			
															<ice:column>
																<ice:rowSelector id="selected"
																	value="#{c_SiteEmployeeGridBean.itemSelected}" multiple="false"
																	selectionListener="#{c_SiteEmployeeGridBean.rowSelectionListener}"
																	selectionAction="#{c_SiteEmployeeGridBean.rowSelectionAction}" /> 
																	>>		
															</ice:column>
															<ice:column>
																<f:facet name="header">
																	<ice:commandSortHeader id="e2firstnamesort" columnName="firstName">
																		<ice:outputText value="#{bundle['c_admin_supplierprofile.employee.firstname']}"></ice:outputText>
																	</ice:commandSortHeader>
																</f:facet>
																<ice:outputText id="id2efirstname" value="#{adminSiteEmployeeSecondBean.firstName}" />
															</ice:column>
															<ice:column>
																<f:facet name="header">
																	<ice:commandSortHeader id="e2lastNamesort" columnName="lastName">
																		<ice:outputText value="#{bundle['c_admin_supplierprofile.employee.lastname']}"></ice:outputText>
																	</ice:commandSortHeader>
																</f:facet>
																<ice:outputText id="id2elastname" value="#{adminSiteEmployeeSecondBean.lastName}" />
															</ice:column>
															<ice:column>
																<f:facet name="header">
																		<ice:outputText value="#{bundle['c_admin_supplierprofile.employee.email']}"></ice:outputText>
																</f:facet>
																<ice:outputText id="e2emaildesc" style="font-weight:bold;"  value="#{adminSiteEmployeeSecondBean.email}" />
															</ice:column>
															<ice:column>
																<f:facet name="header"></f:facet>
																<ice:graphicImage style="border:none;" styleClass="noborder"
																	url="./css/images/icons/menu_down_new_select.png"
																	onmouseout="this.src='./css/images/icons/menu_down_new_select.png'"
																	onmouseover="this.src='./css/images/icons/menu_up_new_select.png'"
																/>
															</ice:column>
														</ice:dataTable>
														<ice:panelGroup styleClass="clearer" />
			
			
														<!-- PAGINATOR-->
														<ice:panelGroup style="float:left;width:420px;">
															<center>
																<ice:dataPaginator id="dataScroll_Employee"
																	rendered="#{c_SiteEmployeeGridBean.selectedDataScrollModes[c_SiteEmployeeGridBean.selectedDataScrollMode].pagingEnabled}"
																	for="tablesiteemployeesecondgrid" vertical="false" fastStep="3" paginator="true"
																	paginatorMaxPages="10">
																	<f:facet name="first">
																		<ice:graphicImage id="firstpage_employee2"
																			url="./css/rime/css-images/arrow-first.gif"
																			style="border:none;" title="first" />
																	</f:facet>
																	<f:facet name="last">
																		<ice:graphicImage id="lastpage_employee2"
																			url="./css/rime/css-images/arrow-last.gif"
																			style="border:none;" title="last" />
																	</f:facet>
																	<f:facet name="previous">
																		<ice:graphicImage id="previouspage_employee2"
																			url="./css/rime/css-images/arrow-previous.gif"
																			style="border:none;" title="previous" />
																	</f:facet>
																	<f:facet name="next">
																		<ice:graphicImage id="nextpage_employee2"
																			url="./css/rime/css-images/arrow-next.gif"
																			style="border:none;" title="next" />
																	</f:facet>
																	<f:facet name="fastforward">
																		<ice:graphicImage id="fastforward_employee2"
																			url="./css/rime/css-images/arrow-ff.gif"
																			style="border:none;" title="ff" />
																	</f:facet>
																	<f:facet name="fastrewind">
																		<ice:graphicImage id="fastrewind_employee2"
																			url="./css/rime/css-images/arrow-fr.gif"
																			style="border:none;" title="fr" />
																	</f:facet>
																</ice:dataPaginator>
															</center>
														</ice:panelGroup>
													</ice:panelGroup>
												</ice:panelGroup>			                	
											</ice:panelGrid>
										</f:facet>		                
								</ice:panelPopup>   
								
				            </ice:form>

			     </ui:define>

			</ui:composition>

	

       </body>
    </html>
   </f:view>
</jsp:root>
