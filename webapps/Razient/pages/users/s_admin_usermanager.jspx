																							readonly="true" styleClass="tablefieldedit_disabled">
																					</ice:inputText>
																				 </td>
																			</tr>
										
																		</table>
																		
																	</ice:panelGroup>
																	
																	<br/><br/>
																	
																	<ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;">
															<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
																<tr>
																	<td width="20%"  class="tablelabeledit_#{s_UserEmployeeSupCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
																		<ice:panelGroup visible="#{s_UserEmployeeSupCrudBean.bEdit_Site}"  style="margin-top:-9px;margin-left:9px;">
																			<h:outputLabel>
																				<h:outputText value="#{bundle['c_admin_usermanager.user.login']}"></h:outputText>&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																			</h:outputLabel>
																		</ice:panelGroup>
																		<ice:panelGroup visible="#{not s_UserEmployeeSupCrudBean.bEdit_Site}" style="margin-top:-9px;margin-left:9px;">
																			<h:outputLabel>
																				<h:outputText value="#{bundle['c_admin_usermanager.user.employee']}"></h:outputText>
																			</h:outputLabel>
																		</ice:panelGroup>
																	</td>
																	<td align="left" class="tablelabelfieldedit_enabled" width="30%">
																		
																		<table>
																		<tr>
																			<td>
																				<ice:inputText id="email" size="30" maxlength="30" 
																					style="font-weight: bold;" value="#{s_UserEmployeeSupCrudBean.email}" 
																					partialSubmit="true" readonly="true" 
																					styleClass="tablefieldedit_createnotedit_disabled" >
																				</ice:inputText>
