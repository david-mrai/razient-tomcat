																				<f:facet name="fastforward">
																					<ice:graphicImage id="fastforward_employee"
																						url="./css/rime/css-images/arrow-ff.gif"
																						style="border:none;" title="ff" />
																				</f:facet>
																				<f:facet name="fastrewind">
																					<ice:graphicImage id="fastrewind_employee"
																						url="./css/rime/css-images/arrow-fr.gif"
																						style="border:none;" title="fr" />
																				</f:facet>
																			</ice:dataPaginator>
																		</center>
																	</ice:panelGroup>
																	<table style="width:99%;margin-top:-1px;">
																		<tr>
																			<td align="right">
																				<ice:commandLink action="#{s_UserEmployeeSupGridBean.createNewAction}" onclick="rld();">
																								<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																									url="./css/images/#{folderBean.folder_menu}/icons/menu_up_add_user.png"
																									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_add_user.png'"
																									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_add_user.png'"
																									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_add_user.png'"
																									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_add_user.png'" />
																				</ice:commandLink>
																			</td>
																		</tr>
																	</table>
																</ice:panelGroup>
						
															</ice:panelGroup>
						
														</ice:panelGroup>
														
														<br/><br/>

													</ice:panelTab>
													
													<ice:panelTab   label="#{bundle['s_admin_usermanager.tab12']}" disabled="#{s_Tab_UserRegisterManagerBean.disabledAddUser}" >
										             <div style="height:#{utilServiceLocatorBean.heightPanel}px;" >

																	<br/>
																	<table cellspacing="0" cellpadding="0" style="margin-top: -7px;" width="100%" >
																		<tr  class="menubuttons">
																			<td align="left">
																				&amp;nbsp&amp;nbsp
																				<ice:commandLink action="#{s_UserEmployeeSupCrudBean.addAction}"  onclick="rld();"  visible="#{s_UserEmployeeSupCrudBean.bTypeCreate}">
																					<ice:graphicImage style="border:none;" styleClass="noborder"
																						url="./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png"
																						onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png'"
																						onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_save.png'"
																						
																						/>
																				</ice:commandLink>
																				&amp;nbsp&amp;nbsp
																				<ice:commandLink action="#{s_UserEmployeeSupCrudBean.updateAction}"  onclick="rld();"  visible="#{s_UserEmployeeSupCrudBean.bTypeQuery}">
																					<ice:graphicImage style="border:none;" styleClass="noborder"
																						url="./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png"
																						onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png'"
																						onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_save.png'"
																						
																						/>
