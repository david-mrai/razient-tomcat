				<ui:define name="page-content-value">
			    
			    
			    
			    	<!-- Static Tab Set -->
						<ice:form>
							<ice:panelGroup id="tabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer">

								<ice:panelTabSet tabChangeListener="#{s_TabUserManagerBean.processTabChange}" selectedIndex="#{s_TabUserManagerBean.ITab}">

									<ice:panelTab label="#{bundle['s_admin_usermanager.tab1']}">
									
										
											
											<ice:panelGroup id="tabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer">
						
						  						<ice:panelTabSet tabChangeListener="#{s_Tab_UserRegisterManagerBean.processTabChange}"  selectedIndex="#{s_Tab_UserRegisterManagerBean.ITab}">
						   
													<ice:panelTab   label="#{bundle['s_admin_usermanager.tab11']}" >
																			
														<br/>
														<ice:panelGroup style="margin-top:-3px;width:97%;overflow:auto;">
		
															<ice:panelGroup>
																<ice:panelGroup>
																	<ice:dataTable resizable="false" border="1" id="tableuseremployeesupgrid"
																		value="#{s_UserEmployeeSupGridBean.allCrudBeans}"
																		var="adminUserEmployeeSupBean"
																		width="98%"
																		rows="#{s_UserEmployeeSupGridBean.selectedDataScrollModes[s_UserEmployeeSupGridBean.selectedDataScrollMode].rows}"
																		scrollable="#{s_UserEmployeeSupGridBean.selectedDataScrollModes[s_UserEmployeeSupGridBean.selectedDataScrollMode].scrollingEnabled}"
																		scrollHeight="200px"
																		style="float:center;font-color: #FFFFFF;"
																		columnWidths="20%,1%,25%,25%,20%,9%"
																		columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
																		rowClasses="rowOn,rowOff" cellpadding="0"
																		sortColumn="#{s_UserEmployeeSupGridBean.columnNameOrder}"
																		sortAscending="#{s_UserEmployeeSupGridBean.descending}"
																		onclick="window.location.reload()">
						
																		
																		<ice:column groupOn="#{adminUserEmployeeSupBean.nameSite}" style="background-color:#F7F4F5;">
																			<f:facet name="header">
																				<ice:commandSortHeader id="ecustomerSiteIdCustomerSitesort" columnName="customerSiteIdCustomerSite">
																					<ice:outputText	value="#{bundle['rz_admin_customerprofile.employee.site']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="idecustomerSiteIdCustomerSite"  style="font-weight:bold;text-align:center;"
																				value="#{adminUserEmployeeSupBean.nameSite}" />
																		</ice:column>
																		<ice:column style="background-color:white;">
																			<ice:rowSelector id="selected"
																				value="#{s_UserEmployeeSupGridBean.itemSelected}" multiple="false"
																				selectionListener="#{s_UserEmployeeSupGridBean.rowSelectionListener}"
																				selectionAction="#{s_UserEmployeeSupGridBean.rowSelectionAction}" /> 
	
																				<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/#{folderBean.folder_menu}/icons/menu_useractive.png"/>		
																		
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="eemailssort" columnName="email">
																					<ice:outputText value="#{bundle['rz_admin_usermanager.user.login']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="eemaildesc"
																				value="#{adminUserEmployeeSupBean.email}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="efirstnamesort" columnName="firstName">
																					<ice:outputText value="#{bundle['rz_admin_usermanager.user.firstname']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="idefirstname"
																					value="#{adminUserEmployeeSupBean.firstName}" />
																		</ice:column>
																		<ice:column>
																			<f:facet name="header">
																				<ice:commandSortHeader id="elastnamesort" columnName="lastName">
																					<ice:outputText value="#{bundle['rz_admin_customerprofile.employee.lastname']}"></ice:outputText>
																				</ice:commandSortHeader>
																			</f:facet>
																			<ice:outputText id="elastnamedesc"
																				value="#{adminUserEmployeeSupBean.lastName}" />
																		</ice:column>
																		<ice:column style="background-color:white;">
																			<f:facet name="header">
																				
																			</f:facet>
																			<ice:graphicImage style="border:none;" styleClass="noborder"
																				url="./css/images/#{folderBean.folder_menu}/icons/menu_down_edit.png"
																				onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_edit.png'"
																				onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_edit.png'"
																			
																			/>
																		</ice:column>
																	</ice:dataTable>
																	
																	<ice:panelGroup styleClass="clearer" />
						
																	<!-- PAGINATOR-->
																	<ice:panelGroup style="float:left;width:420px;">
																		<center>
																			<ice:dataPaginator id="dataScroll_Employee"
																				rendered="#{s_UserEmployeeSupGridBean.selectedDataScrollModes[s_UserEmployeeSupGridBean.selectedDataScrollMode].pagingEnabled}"
																				for="tableuseremployeesupgrid" vertical="false" fastStep="3" paginator="true"
																				paginatorMaxPages="10">
																				<f:facet name="first">
																					<ice:graphicImage id="firstpage_employee"
																						url="./css/rime/css-images/arrow-first.gif"
																						style="border:none;" title="first" />
																				</f:facet>
																				<f:facet name="last">
																					<ice:graphicImage id="lastpage_employee"
																						url="./css/rime/css-images/arrow-last.gif"
																						style="border:none;" title="last" />
																				</f:facet>
																				<f:facet name="previous">
																					<ice:graphicImage id="previouspage_employee"
																						url="./css/rime/css-images/arrow-previous.gif"
																						style="border:none;" title="previous" />
																				</f:facet>
																				<f:facet name="next">
																					<ice:graphicImage id="nextpage_employee"
																						url="./css/rime/css-images/arrow-next.gif"
																						style="border:none;" title="next" />
