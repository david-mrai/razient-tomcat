				<ui:define name="page-content-value">
					<table border="" cellspacing="0" cellpadding="5" class="tabularView" style="border: 1px #C3DFF4 solid;font-size:12px;">
                    <tr>
                      <th style="color:#FFFFFF" width="200" bgcolor="#3C7FB1"><div align="left"><strong>Company:</strong></div></th>
                      <td bgcolor="#FFFFFF" width="700">Cisco</td>
                    </tr>
                    <tr>
                      <th style="color:#FFFFFF" bgcolor="#3C7FB1"><div align="left"><strong>Proposal ID</strong></div></th>
                      <td bgcolor="#FFFFFF">112233</td>
                    </tr>
                    <tr>
                      <th style="color:#FFFFFF" bgcolor="#3C7FB1"><div align="left"><strong>Proposal Date</strong></div></th>
                      <td bgcolor="#FFFFFF">01/12/2010</td>
                    </tr>
                    <tr>
                      <th style="color:#FFFFFF" bgcolor="#3C7FB1"><div align="left"><strong>Proposal Description</strong></div></th>
                      <td bgcolor="#FFFFFF">Description of proposal and all background information</td>
                    </tr>
                    <tr>
                      <th style="color:#FFFFFF" bgcolor="#3C7FB1"><div align="left"><strong>Bidder Requirements</strong></div></th>
                      <td bgcolor="#FFFFFF">Requirements of companies bidding on proposal</td>
                    </tr>
                    <tr>
                      <th rowspan="3" bgcolor="#3C7FB1"></th>
                      <td bgcolor="#FFFFFF">Upload Insurance Certificate <img src="./css/images/general/save.png" width="22" height="20" align="absmiddle"/></td>
                    </tr>
                    <tr>
                      <td bgcolor="#FFFFFF">Provide References</td>
                    </tr>
                    <tr>
                      <td bgcolor="#FFFFFF">Upload Certification <img src="./css/images/general/save.png" width="22" height="20" align="absmiddle"/></td>
                    </tr>
                  </table>
                  <br/>
                   <table border="" cellspacing="0" cellpadding="5" class="tabularView" style="border: 1px #C3DFF4 solid;">
                    <tr>
                      <th bgcolor="#3C7FB1" style="color:#FFFFFF" width="150" align="left">Proposal  Questions</th>
                      <th width="700" align="left" bgcolor="#3C7FB1" style="color:#FFFFFF">Question Description</th>
                      <th width="100" align="left" bgcolor="#3C7FB1" style="color:#FFFFFF">Maximum Points</th>
                    </tr>
                    <tr>
                      <td bgcolor="#FFFFFF">Question 1: History</td>
                      <td bgcolor="#FFFFFF">Provide a history or projects in the industry and the skill required to deliver the projects</td>
                      <td align="right" bgcolor="#FFFFFF">10</td>
                    </tr>
                    <tr class="odd" bgcolor="#EFF2FF">
                      <td>Question 2: References</td>
                      <td>Provide a list of 5 references that can be contacted.</td>
                      <td align="right">20</td>
                    </tr>
                    <tr bgcolor="#FFFFFF">
                      <td>Question 3: Certifications</td>
                      <td>Provide a list of certification in the industry including ISO 9001 certification.</td>
                      <td align="right">20</td>
                    </tr>
                    <tr class="odd" bgcolor="#EFF2FF">
                      <td>Question 4: Skill set</td>
                      <td>Provide a list of capabilities in this industry.</td>
                      <td align="right">20</td>
                    </tr>
                    <tr bgcolor="#FFFFFF">
                      <td>Question 5: Pricing</td>
                      <td>Provide pricing and schedule for delivery</td>
                      <td align="right">30</td>
                    </tr>
                    <tr class="odd">
                      <th align="left" bgcolor="#3C7FB1" style="color:#FFFFFF">Vendor</th>
                    <td bgcolor="#EFF2FF"><select name="select" id="select">
                        <option selected="selected">Matsui LTD</option>
                        <option>Sharp Electronics</option>
                        <option>FoxConn Inc</option>
                        <option>Gartner Inc</option>
                        <option>Sachi Inc</option>
                      </select></td>
                      <td bgcolor="#EFF2FF"></td>
                    </tr>
                    <tr bgcolor="#FFFFFF">
                      <td>Specific Vendor Selection</td>
                      <td>(select from list of vendor sorted by type, region,
                        physical threats in the region, etc) </td>
                      <td></td>
                    </tr>
                    <tr bgcolor="#EFF2FF" class="odd">
                      <td>All vendors</td>
                      <td><input type="checkbox" name="checkbox" value="checkbox"/></td>
                      <td></td>
                    </tr>
                    <tr>
                      <td Colspan="3" bgcolor="#FFFFFF"><div align="center"><img src="./css/images/general/submitReq.png" border="0"/><img src="./css/images/general/cancel.png"/></div>
                      </td>
                    </tr>
                  </table>
				</ui:define>
				

			</ui:composition>

	

