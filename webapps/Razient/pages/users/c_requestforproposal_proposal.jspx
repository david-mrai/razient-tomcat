			    <ui:define name="page-menu-value">
			    	 <ice:form>
			    	 
					 <ice:graphicImage visible="true" style="border:none;"
								styleClass="noborder"
								url="./css/images/#{folderBean.folder_menu}/risk_menu_down_proposal.png" />
					<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
					 <ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_bidreview.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_bidreview.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_bidreview.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_bidreview.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_bidreview.png'" />
									<f:attribute name="optioonselected" value="rp_br"/>
					</ice:commandLink>			
					  	
					    
					 </ice:form> 	
