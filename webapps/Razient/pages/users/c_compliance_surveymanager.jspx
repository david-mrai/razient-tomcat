																							               	scrollHeight="200px"
																							               	style="float:center;font-color: #FFFFFF;margin-top:2px;"
																							               	columnWidths="1%,39%,20%,20%,20%"
																							               	columnClasses="columnCenter,columnLeft,columnLeft,columnCenter,columnCenter"
																							                rowClasses="rowOn,rowOff"
																							               	cellpadding="0" onclick="rld();"
																											sortColumn="#{cs_ComplianceSurveyGridBean.columnNameOrder}" sortAscending="#{cs_ComplianceSurveyGridBean.descending}">
																									
																									<ice:column >
																										<ice:rowSelector id="selected"
																		                                 value="#{cs_ComplianceSurveyGridBean.itemSelected}"
																		                                 multiple="false"         
																		                                 selectionListener="#{cs_ComplianceSurveyGridBean.rowSelectionListener}"
																		                                 selectionAction="#{cs_ComplianceSurveyGridBean.rowSelectionAction}"/>               
																		                                 >>		
																									</ice:column>
																										<ice:column>
																										<f:facet name="header">
																											<ice:commandSortHeader id="nameId" columnName="name"  >
																		                        				<ice:outputText  value="#{bundle['c_compliance_surveymanager.survey.name']}"></ice:outputText>
																		                    				</ice:commandSortHeader>
																										</f:facet>
																										<ice:outputText id="idname" value="#{surveyBean.name}"/>
																									</ice:column>
																									<ice:column style="background-color:#F7F4F5;text-align: center;">
																										<f:facet name="header">
																											<ice:outputText value="#{bundle['c_compliance_surveymanager.survey.status']}"></ice:outputText>
																										</f:facet>
																										<ice:outputText id="statussv" value="#{surveyBean.status}"/>
																									</ice:column>
																									<ice:column>
																										<f:facet name="header">
																											<ice:commandSortHeader id="distributiondateId" columnName="distributionDate" >
																		                        				<ice:outputText value="#{bundle['c_compliance_surveymanager.survey.distribudate']}"></ice:outputText>
																		                    				</ice:commandSortHeader>
																										</f:facet>
																										<ice:outputText id="iddistributionDate" value="#{surveyBean.distributionDate}"/>
																									</ice:column>
																									<ice:column>
																										<f:facet name="header">
																											<ice:commandSortHeader id="closedateId" columnName="closeDate" >
																		                        				<ice:outputText value="#{bundle['c_compliance_surveymanager.survey.expirationdate']}"></ice:outputText>
																		                    				</ice:commandSortHeader>
																										</f:facet>
																										<ice:outputText id="idcloseDate" value="#{surveyBean.closeDate}"/>
																									</ice:column>
																									</ice:dataTable>
																					
																									<ice:panelGroup styleClass="clearer"/>
																									  
																			        				
																									<!-- Set up the buttons and links for browsing through the table
																							             fastStep means No. of pages to fast forward or rewind: 3
																							             paginatorMaxPages means No. of direct links to pages: 4 -->
																							        <ice:panelGroup style="float:left;width:420px;">
																						            <center>
																						            <ice:dataPaginator id="dataScroll_surveymanager"
																						                   rendered="#{cs_ComplianceSurveyGridBean.selectedDataScrollModes[cs_ComplianceSurveyGridBean.selectedDataScrollMode].pagingEnabled}"
																						                   for="csvtable"
																						                   vertical="false" fastStep="3" paginator="true" paginatorMaxPages="10">
																						                <f:facet name="first">
																						                    <ice:graphicImage id="firstpage_1" url="./css/rime/css-images/arrow-first.gif" style="border:none;" title="first"/>
																						                </f:facet>
																						                <f:facet name="last">
																						                    <ice:graphicImage id="lastpage_1" url="./css/rime/css-images/arrow-last.gif" style="border:none;" title="last"/>
																						                </f:facet>
																						                <f:facet name="previous">
																						                    <ice:graphicImage id="previouspage_1" url="./css/rime/css-images/arrow-previous.gif" style="border:none;" title="previous"/>
																						                </f:facet>
																						                <f:facet name="next">
																						                    <ice:graphicImage id="nextpage_1" url="./css/rime/css-images/arrow-next.gif" style="border:none;" title="next"/>
																						                </f:facet>
																						                <f:facet name="fastforward">
																						                    <ice:graphicImage id="fastforward_1" url="./css/rime/css-images/arrow-ff.gif" style="border:none;" title="ff"/>
																						                </f:facet>
																						                <f:facet name="fastrewind">
																						                    <ice:graphicImage id="fastrewind_1" url="./css/rime/css-images/arrow-fr.gif" style="border:none;" title="fr"/>
																						                </f:facet>
																						            </ice:dataPaginator>
																						            </center>
																						        </ice:panelGroup>
																								
																								
																							</ice:panelGroup>
																							
																						</ice:panelGroup>
																						</td>
																						<td>&amp;nbsp</td>
																					</tr>
																				</table>
												 		
														    <br/>
																				
										          							 </div>
												
						                                                </td>
						                                                </tr>
						                                                
					                                          		</tbody>
					                                          		</table>
					                                          	</td>
					                                          		
					                                    	 </tr>
					                                    	 
					                                    	
					                                    	 
	                                      					</tbody>
	                                    				</table>
                                    			</ice:form>
			                                    
