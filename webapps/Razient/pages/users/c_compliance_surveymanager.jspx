																						</table>
																						
																						
																						</td>
																						<td>&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</td>
																						<td>
																							<ice:panelGroup>
																							<ice:panelGroup>
																								
																								<ice:dataTable resizable="false" border="1" id="csvtable" value="#{cs_ComplianceSurveyGridBean.CSurveysBean}" var="surveyBean"  
																											width="98%" 
																											rows="#{cs_ComplianceSurveyGridBean.selectedDataScrollModes[cs_ComplianceSurveyGridBean.selectedDataScrollMode].rows}"
