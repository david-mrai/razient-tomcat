<?xml version="1.0" encoding="utf-8" ?>
<jsp:root version="1.2"
   xmlns:jsp="http://java.sun.com/JSP/Page"
   xmlns:f="http://java.sun.com/jsf/core"
   xmlns:h="http://java.sun.com/jsf/html"
   xmlns:ice="http://www.icesoft.com/icefaces/component">
   <jsp:directive.page contentType="text/html;charset=ISO-8859-1" pageEncoding="ISO-8859-1" />
   <f:view>
   		<ice:outputDeclaration 
            doctypeRoot="html" 
            doctypePublic="-//W3C//DTD HTML 4.01 Transitional//EN" 
            doctypeSystem="http://www.w3.org/TR/html4/loose.dtd" /> 
    <html>
       <head>
         <title>Index (Razient)</title>
       </head>
       <body>
       
        	<!-- template="#{templateBean.templateContent}"-->
			<ui:composition
			        template="../../include/templates/pages/modeB_supplier.jspx"
			        xmlns:h="http://java.sun.com/jsf/html"
			        xmlns:f="http://java.sun.com/jsf/core"
			        xmlns:c="http://java.sun.com/jstl/core"
			        xmlns:ice="http://www.icesoft.com/icefaces/component"
			        xmlns:ui="http://java.sun.com/jsf/facelets" >
			
			  <!-- params for page titles-->
			 		 <!--<f:loadBundle basename="truckandi.view.bundle.Message" var="bundle"/>
			        <ui:param name="pageTitle" value="#{bundle['tai_login.title']}" />-->
					<ui:param name="pageTitle" value="Survey Manager" />
				
				<ui:define name="header_menu_value">
						<table cellspacing="0" cellpadding="0">
										<tr>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">		
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_dash_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_dash_2.png'" />
														<f:attribute name="optioonselected" value="dh"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/#{folderBean.folder_menu}/risk_survey_2.png" visible="#{users_MenuBarBean.visible_S_Survey}"/>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_GlobalIncidents}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_global_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_global_2.png'" />
													<f:attribute name="optioonselected" value="gi_al"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_RequestForProposal}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_request_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_request_2.png'" />
													<f:attribute name="optioonselected" value="rp_op"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_Reports}">																																				
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_rep_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_rep_2.png'" />
													<f:attribute name="optioonselected" value="rp_sv"/>
												</ice:commandLink>
											</td>
											<td><ice:graphicImage style="border:none;"  styleClass="noborder" url		="./css/images/risk_black_low.png"/> </td>
											<td>
												<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}" visible="#{users_MenuBarBean.visible_S_Administration}">																								
													<ice:graphicImage style="border:none;"  styleClass="noborder"
															url		="./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png" 
														onmouseout	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png'"
														onmouseover	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_2.png'"
														onmouseup	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_1.png'"
														onmousedown	="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_supp_2.png'" />
														<f:attribute name="optioonselected" value="ad_um"/>
												</ice:commandLink>
											</td>
										</tr>
									</table>			
				</ui:define>
			    
			    <ui:define name="page-menu-value">
			    	 <ice:form>
					 
					 
					<ice:commandLink action="#{users_MenuBarBean.actionLink}"  onclick="rld();" actionListener="#{users_MenuBarBean.actionlistener}">				
					 	<ice:graphicImage visible="true"  styleClass="menuPosA"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_survey.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_survey.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_survey.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_survey.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_survey.png'" />
						<f:attribute name="optioonselected" value="sv_sv"/>
					</ice:commandLink>
					<ice:graphicImage visible="true" styleClass="menuPosB"
								url="./css/images/#{folderBean.folder_menu}/risk_menu_down_surveymanager.png" />
					
					 <ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_one.png"/>
									
					 </ice:form> 	
			    </ui:define>
			    
				<ui:define name="page-content-value">
					<table border="1" cellpadding="5" cellspacing="0" class="tabularView"  style="border: 1px #C3DFF4 solid;">
  					<tr bgcolor="#3C7FB1" style="color:#FFF">
                  <th class="bdrLeft"><input type="checkbox" name="main" id="main" onClick="sel(this.checked, 7)"></input></th>
                  <th>Survey Name <img src="./css/images/general/sortDown.png" width="11" height="7" /></th>
                  <th>Survey Desc <img src="./css/images/general/sortDown.png" width="11" height="7" /></th>
                  <th>Survey Status </th>
                  <th class="bdrRight">Survey Close Date <img src="./css/images/general/sortDown.png" width="11" height="7" /></th>
                  <th class="bdrRight">No of Suppliers <img src="./css/images/general/sortDown.png" width="11" height="7" /></th>
                  <th class="bdrRight">Email Respondents </th>
                </tr>
                <tr bgcolor="#FFFFFF">
                  <td align="left" class="bdrLeft"><input type="checkbox" name="checkbox1" id="checkbox1" onClick="document.getElementById('main').checked = false;"></input></td>
                  <td>HIPAA Security Assessment</td>
                  <td>Survey to identify weaknesses in all suppliers that handle HIPAA data</td>
                  <td><select name="select7">
                    <option>In-Progress</option>
                    <option>Completed</option>
                    <option>On Hold</option>
                    <option>Draft</option>
                  </select></td>
                  <td>05/01/2011</td>
                  <td>220</td>
                  <td><img src="./css/images/general/mail.png" width="27" height="27"/></td>
                </tr>
                <tr class="odd" bgcolor="#EFF2FF">
                  <td align="left" class="bdrLeft"><input type="checkbox" name="checkbox2" id="checkbox2" onClick="document.getElementById('main').checked = false;"></input></td>
                  <td>PCI Security Assessment </td>
                  <td>Survey to Identify gaps in Pci requirements in all vendors that process credit card information</td>
                  <td><select name="select2">
                    <option>In-Progress</option>
					<option>Completed</option>
					<option>On Hold</option>
                    <option>Draft</option>
                  </select></td>
                  <td>06/29/2011</td>
                  <td>2000</td>
                  <td><img src="./css/images/general/mail.png" width="27" height="27"/></td>
                </tr>
                <tr bgcolor="#FFFFFF">
                  <td align="left" class="bdrLeft"><input type="checkbox" name="checkbox3" id="checkbox3" onClick="document.getElementById('main').checked = false;"/></td>
                  <td>FFIEC </td>
                  <td>Regulatory requirements survey for all vendors under FFICE requirements </td>
                  <td><select name="select8">
                    <option>In-Progress</option>
					<option>Completed</option>
					<option>On Hold</option>
                    <option>Draft</option>
                  </select></td>
                  <td>06/24/2011</td>
                  <td>5000</td>
                  <td><img src="./css/images/general/mail.png" width="27" height="27"/></td>
                </tr>
                <tr class="odd" bgcolor="#EFF2FF">
                  <td align="left" class="bdrLeft"><input type="checkbox" name="checkbox4" id="checkbox4" onClick="document.getElementById('main').checked = false;"/></td>
                  <td>ISO9001:2008</td>
                  <td>Survey for all manufacturers certified for ISO 9001</td>
                  <td><select name="select9">
                    <option>In-Progress</option>
					<option>Completed</option>
					<option>On Hold</option>
                    <option>Draft</option>
                  </select></td>
                  <td>02/24/2011</td>
                  <td>200</td>
                  <td><img src="./css/images/general/mail.png" width="27" height="27"/></td>
                </tr>
                <tr bgcolor="#FFFFFF">
                  <td align="left" class="bdrLeft"><input type="checkbox" name="checkbox5" id="checkbox5" onClick="document.getElementById('main').checked = false;"/></td>
                  <td>SOX</td>
                  <td>Survey for all publicly traded vendors</td>
                  <td><select name="select10">
                    <option>In-Progress</option>
					<option>Completed</option>
					<option>On Hold</option>
                    <option>Draft</option>
                  </select></td>
                  <td>05/27/2011</td>
                  <td>175</td>
                  <td><img src="./css/images/general/mail.png" width="27" height="27"/></td>
                </tr>
                <tr class="odd" bgcolor="#EFF2FF">
                  <td align="left" class="bdrLeft"><input type="checkbox" name="checkbox6" id="checkbox6" onClick="document.getElementById('main').checked = false;"/></td>
                  <td>Business Continuity</td>
                  <td>Survey to indentify all Business Continuity requirements for vendors</td>
                  <td><select name="select11">
                    <option>In-Progress</option>
                  </select></td>
                  <td><select name="select6">
                      <option selected="selected">Days</option>
                      <option>Hours</option>
                      <option>Secs</option>
                    </select></td>
                  <td>3000</td>
                  <td><img src="./css/images/general/mail.png" width="27" height="27"/></td>
                </tr>
                <tr class="odd" bgcolor="#FFFFFF">
				   <td align="left" class="bdrLeft"><input type="checkbox" name="checkbox6" id="checkbox6" onClick="document.getElementById('main').checked = false;"/></td>
				   <td>Quarterly Insurance Certification Survey</td>
				   <td>Survey to update insurance requirements for all vendors </td>
							  <td><select name="select11">
								<option>In-Progress</option>
							  </select></td>
							  <td><select name="select6">
								  <option selected="selected">Days</option>
								  <option>Hours</option>
								  <option>Secs</option>
								</select></td>
							  <td>6000</td>
							  <td><img src="./css/images/general/mail.png" width="27" height="27"/></td>
                </tr>
                <tr class="odd" bgcolor="#EFF2FF">
				                  <td align="left" class="bdrLeft"><input type="checkbox" name="checkbox6" id="checkbox6" onClick="document.getElementById('main').checked = false;"/></td>
				                  <td>Status Update Survey</td>
				                  <td>Survey to refresh data on each vendor.</td>
				                  <td><select name="select11">
				                    <option>In-Progress</option>
				                  </select></td>
				                  <td><select name="select6">
				                      <option selected="selected">Days</option>
				                      <option>Hours</option>
				                      <option>Secs</option>
				                    </select></td>
				                  <td>30000</td>
				                  <td><img src="./css/images/general/mail.png" width="27" height="27"/></td>
                </tr>
                <tr bgcolor="#FFFFFF">
                  <td style="padding:20px;" colspan="7" class="bdrLeft"><div align="center"><img src="./css/images/general/newSurvey.png" /><img src="./css/images/general/delete.png" /></div></td>
                </tr>
              </table>
				</ui:define>
				

			</ui:composition>

	

       </body>
    </html>
   </f:view>
</jsp:root>
