<?xml version="1.0" encoding="utf-8" ?>
<jsp:root version="1.2" xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:ice="http://www.icesoft.com/icefaces/component"
	xmlns:ice-cc="http://www.icesoft.com/icefaces-composite-comps">
	<jsp:directive.page contentType="text/html;charset=ISO-8859-1"
		pageEncoding="ISO-8859-1" />
	<f:view>
		<ice:outputDeclaration doctypeRoot="html"
			doctypePublic="-//W3C//DTD HTML 4.01 Transitional//EN"
			doctypeSystem="http://www.w3.org/TR/html4/loose.dtd" />
		<html>
			<head>
				<title>Index (Razient)</title>
			</head>
			<body>

				<!-- template="#{templateBean.templateContent}"-->
				<ui:composition
					template="../../include/templates/pages/modeA_rz.jspx"
					xmlns:h="http://java.sun.com/jsf/html"
					xmlns:f="http://java.sun.com/jsf/core"
					xmlns:c="http://java.sun.com/jstl/core"
					xmlns:ice="http://www.icesoft.com/icefaces/component"
					xmlns:ui="http://java.sun.com/jsf/facelets">

					<ui:param name="pageTitle"
						value="#{bundle['rz_admin_customerprofile_grid.title']}" />

					<ui:define name="header-menu-value">
						<table cellspacing="0" cellpadding="0">
							<tr>
								<td>


									<ice:graphicImage style="border:none;" styleClass="noborder"
										url="./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.valueIconAdmin}.png"
										onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.enabledAdmin}.png'"
										onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.disabledAdmin}.png'"
										onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.enabledAdmin}.png'"
										onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.disabledAdmin}.png'" />

								</td>
								<td>
									<ice:graphicImage style="border:none;" styleClass="noborder"
										url="./css/images/risk_black_low.png" />
								</td>
								<td>
									<ice:commandLink action="#{rz_MenuBarBean.getIconCompliance}"
										onclick="rld();"
										actionListener="#{rz_MenuBarBean.actionlistener}">
										<ice:graphicImage style="border:none;" styleClass="noborder"
											url="./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.valueIconCompliance}.png"
											onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.enabledCompliance}.png'"
											onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.disabledCompliance}.png'"
											onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.enabledCompliance}.png'"
											onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.disabledCompliance}.png'" />
										<f:attribute name="optioonselected"
											value="admin_customerprofile_grid" />
									</ice:commandLink>
								</td>

							</tr>
						</table>

					</ui:define>
					<ui:define name="hide-show-value">
						<ice:form>
					    	<div style="margin-top:3px;float: left;position: absolute;">
						    	<ice:commandLink action="#{showhideBean.action_showhide}" onclick="rld();">
									<ice:graphicImage style="border:none;" 
										styleClass="noborder" url="./css/images/icons/menu_#{showhideBean.url_icon}.png"/>
								</ice:commandLink>
							</div>
						</ice:form>
					</ui:define>
					<ui:define name="page-menu-value">
						<ice:form>
							<ice:commandLink
								action="#{nav_CustomerProfileGridBean.actionMenu_UserManager}"
								onclick="rld();">
								<ice:graphicImage visible="true" styleClass="menuPosA"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_usermanager.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_usermanager.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_usermanager.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_usermanager.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_usermanager.png'" />
							</ice:commandLink>
							<ice:graphicImage visible="true" styleClass="menuPosB"
								url="./css/images/#{folderBean.folder_menu}/risk_menu_down_customerprofile.png" />
							<ice:commandLink
								action="#{nav_CustomerProfileGridBean.actionMenu_Template}"
								onclick="rld();">
								<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_template.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_template.png'" />
							</ice:commandLink>
							<ice:commandLink
								action="#{nav_CustomerProfileGridBean.actionMenu_DataUpload}"
								onclick="rld();">
								<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_dataupload.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_dataupload.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_dataupload.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_dataupload.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_dataupload.png'" />
							</ice:commandLink>
							<ice:commandLink
								action="#{nav_CustomerProfileGridBean.actionMenu_AuditLog}"
								onclick="rld();">
								<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_auditlog.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_auditlog.png'" />
							</ice:commandLink>
							
							<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_one.png"/>
						</ice:form>
					</ui:define>

					<ui:define name="page-content-value">
						<h:form>
						
						<table cellspacing="0" cellpadding="0" style="margin-top: -7px;" width="100%">
								<tr class="menubuttons">
									<td align="left">
										&amp;nbsp&amp;nbsp
										<ice:commandLink action="#{rz_CustomerProfileGridBean.createNewCustomerAction}"  onclick="rld();">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_createnewcustomer.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_createnewcustomer.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_createnewcustomer.png'"
												
												/>
										</ice:commandLink>
									</td>
									<td>
										&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
										&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
									</td>
							</tr>
							<tr>
								<td colspan="2" class="menuline">
								</td>
							</tr>
						</table>
						
						<ice:panelGroup id="tabSetTabGrid" styleClass="tabPanelBox panelTabSetSaleContainer">
						  	 <ice:panelTabSet id="tabsetcpgrid" tabChangeListener="#{rz_CustomerProfileGridBean.processTabChange}" selectedIndex="#{rz_CustomerProfileGridBean.ITab}">
						  	 	<ice:panelTab  id="tabsearch" label="#{bundle['rz_search.basic']}" >
						  	 		<div style="height:75px;" >
						  	 			<br/>
							  	 		<table cellpadding="0" cellspacing="0" style="margin-top:0px;">
							  	 			<tr>
							  	 					<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td>
								  	 					<ice:commandLink action="#{rz_CustomerProfileGridBean.find_All_Action}"  onclick="rld();">
															<ice:graphicImage style="border:none;" styleClass="noborder"
																url="./css/images/#{folderBean.folder_menu}/icons/menu_up_all.png"
																onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_all.png'"
																onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_all.png'"
																
																/>
														</ice:commandLink>
													</td>							  	 					
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
							  	 					<td class="tableflabelbuttons">
															<h:outputLabel>
																	<h:outputText value="#{bundle['rz_admin_usermanager.cust.autofind']}"></h:outputText>
															</h:outputLabel>
													</td>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td>
														<ice:selectInputText style="margin-top:-10px;" rows="7" width="250" valueChangeListener="#{rz_CustomerProfileGridBean.updateParamsList}" >
															<f:selectItems value="#{rz_CustomerProfileGridBean.list}"/>
														</ice:selectInputText>
													</td>
							  	 					<td></td>
							  	 			</tr>			  	 		
							  	 		</table>
						  	 		</div>
						  	 	</ice:panelTab>
					        
					        	<ice:panelTab  id="tabtableadvanceds" label="#{bundle['rz_search.advanced']}" >
					        		<div style="height:75px;" >
						  	 			<br/>
							  	 		<table cellpadding="0" cellspacing="0" style="margin-top:0px;">
							  	 			<tr>
							  	 					<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
							  	 					<td class="tableflabelmasterbold">
														<h:outputLabel>
															<h:outputText
																value="#{bundle['rz_admin_usermanager.cust.country']}"></h:outputText>
														</h:outputLabel>&amp;nbsp&amp;nbsp
													</td>
													<td class="tableffieldleft" colspan="3">
														<ice:selectOneMenu value="#{rz_CustomerProfileGridBean.country}"
															id="selectedCountry" styleClass="selectedOneMasterCountry"
															valueChangeListener="#{rz_CustomerProfileGridBean.processValueChange}"
															partialSubmit="true">
															<f:selectItem itemLabel="#{bundle['rz_select_country']}"
																itemValue="0" />
															<f:selectItems
																value="#{applicationBean.countrySelectedItems}"
																id="country" />
														</ice:selectOneMenu>
													</td>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td class="tableflabelmasterbold">
														<h:outputLabel>
															<h:outputText
																value="#{bundle['rz_admin_usermanager.cust.state']}"></h:outputText>
														</h:outputLabel>&amp;nbsp&amp;nbsp
													</td>
													<td class="tableffieldleft">
														<ice:selectOneMenu value="#{rz_CustomerProfileGridBean.state}"
															id="selectedState" styleClass="selectedOneMasterState"
															valueChangeListener="#{rz_CustomerProfileGridBean.processValueChange}"
															partialSubmit="true">
															<f:selectItem itemLabel="#{bundle['rz_select_state']}" itemValue="0" />
															<f:selectItems value="#{rz_CustomerProfileGridBean.list_State}" id="state" />
														</ice:selectOneMenu>
													</td>
													<td>
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td class="tableflabelmasterbold">
														<h:outputLabel>
															<h:outputText
																value="#{bundle['rz_admin_usermanager.cust.city']}"></h:outputText>
														</h:outputLabel>&amp;nbsp&amp;nbsp
													</td>
													<td class="tableffieldleft">
														<ice:selectOneMenu value="#{rz_CustomerProfileGridBean.city}"
															id="selectedCity" styleClass="selectedOneMasterState"
															valueChangeListener="#{rz_CustomerProfileGridBean.processValueChange}"
															partialSubmit="true">
															<f:selectItem itemLabel="#{bundle['rz_select_city']}"
																itemValue="0" />
															<f:selectItems value="#{rz_CustomerProfileGridBean.list_City}"
																id="city" />
														</ice:selectOneMenu>
													</td>
													<td>
													&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
								  	 				<td>
								  	 					
								  	 					<ice:commandLink action="#{rz_CustomerProfileGridBean.find_x_Items_Action}"  onclick="rld();">
															<ice:graphicImage style="border:none;" styleClass="noborder"
																url="./css/images/#{folderBean.folder_menu}/icons/menu_up_search.png"
																onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_search.png'"
																onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_search.png'"
																
																/>
														</ice:commandLink>
													</td>
								  	 				<td>&amp;nbsp</td>
							  	 			</tr>
							  	 			</table>
							  	 			<br/>
							  	 			<table cellpadding="0" cellspacing="0" style="margin-top:0px;">
							  	 			<tr>
							  	 				
							  	 			</tr>						  	 		
							  	 			</table>
						  	 		</div>
						    	</ice:panelTab>
							</ice:panelTabSet>  
						</ice:panelGroup>

						</h:form>
						<h:form>
							<br/><br/><br/><br/><br/><br/><br/><br/>

							<ice:panelGroup styleClass="customerProfileBox"
								style="height:#{utilServiceLocatorBean.heightPanelCustomerProfileGrid}px;width:97%;overflow:auto;">

									<!-- PAGINATOR-->
									<ice:panelGroup style="float:left;width:420px;">
												<center>
													<ice:dataPaginator id="dataScroll_2"
														rendered="#{rz_CustomerProfileGridBean.selectedDataScrollModes[rz_CustomerProfileGridBean.selectedDataScrollMode].pagingEnabled}"
														for="tablecustgrid" vertical="false" fastStep="3" paginator="true"
														paginatorMaxPages="10">
														<f:facet name="first">
															<ice:graphicImage id="firstpage_2"
																url="./css/rime/css-images/arrow-first.gif"
																style="border:none;" title="first" />
														</f:facet>
														<f:facet name="last">
															<ice:graphicImage id="lastpage_2"
																url="./css/rime/css-images/arrow-last.gif"
																style="border:none;" title="last" />
														</f:facet>
														<f:facet name="previous">
															<ice:graphicImage id="previouspage_2"
																url="./css/rime/css-images/arrow-previous.gif"
																style="border:none;" title="previous" />
														</f:facet>
														<f:facet name="next">
															<ice:graphicImage id="nextpage_2"
																url="./css/rime/css-images/arrow-next.gif"
																style="border:none;" title="next" />
														</f:facet>
														<f:facet name="fastforward">
															<ice:graphicImage id="fastforward_2"
																url="./css/rime/css-images/arrow-ff.gif"
																style="border:none;" title="ff" />
														</f:facet>
														<f:facet name="fastrewind">
															<ice:graphicImage id="fastrewind_2"
																url="./css/rime/css-images/arrow-fr.gif"
																style="border:none;" title="fr" />
														</f:facet>
													</ice:dataPaginator>
												</center>
									</ice:panelGroup>

									<ice:panelGroup>
										<ice:panelGroup>
											<ice:dataTable resizable="false" border="1" id="tablecustgrid"
												value="#{rz_CustomerProfileGridBean.allCrudBeans}"
												var="adminCustomerBean"
												width="98%"
												rows="#{rz_CustomerProfileGridBean.selectedDataScrollModes[rz_CustomerProfileGridBean.selectedDataScrollMode].rows}"
												scrollable="#{rz_CustomerProfileGridBean.selectedDataScrollModes[rz_CustomerProfileGridBean.selectedDataScrollMode].scrollingEnabled}"
												scrollHeight="200px"
												style="float:center;font-color: #FFFFFF;"
												columnWidths="1%,29%,15%,15%,15%,10%,10%,5%"
												columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
												rowClasses="rowOn,rowOff" cellpadding="0"
												sortColumn="#{rz_CustomerProfileGridBean.columnNameOrder}"
												sortAscending="#{rz_CustomerProfileGridBean.descending}"
												onclick="window.location.reload()">

												<ice:column>
													<ice:rowSelector id="selected"
														value="#{rz_CustomerProfileGridBean.itemSelected}" multiple="false"
														selectionListener="#{rz_CustomerProfileGridBean.rowSelectionListener}"
														selectionAction="#{rz_CustomerProfileGridBean.rowSelectionAction}" />               
									                                 
									                  <f:facet name="header">
														<ice:commandSortHeader id="typeentsort" columnName="typeEntity">
															<ice:outputText value="#{bundle['rz_typeentity']}"></ice:outputText>
														</ice:commandSortHeader>
													     </f:facet>
														<ice:outputText id="identity" value="#{adminCustomerBean.typeEntityDesc}" />
												</ice:column>
												<ice:column>
													<f:facet name="header">
														<ice:commandSortHeader id="namesort" columnName="name">
															<ice:outputText value="#{bundle['rz_admin_usermanager.cust.name']}"></ice:outputText>
														</ice:commandSortHeader>
													</f:facet>
													<ice:outputText id="idname"
														value="#{adminCustomerBean.name}" />
												</ice:column>
												<ice:column groupOn="#{adminCustomerBean.countryDesc}"  style="background-color:#F7F4F5;">
													<f:facet name="header">
														<ice:commandSortHeader id="countrysort" columnName="countryDesc">
															<ice:outputText value="#{bundle['rz_admin_usermanager.cust.country']}" ></ice:outputText>
														</ice:commandSortHeader>
													</f:facet>
													<ice:outputText id="countrydesc" style="font-weight:bold;text-align:center;"
														value="#{adminCustomerBean.countryDesc}" />
												</ice:column>
												<ice:column groupOn="#{adminCustomerBean.stateDesc}" style="background-color:#F3F4F8;">
													<f:facet name="header">
														<ice:commandSortHeader id="statesort" columnName="stateDesc">
															<ice:outputText value="#{bundle['rz_admin_usermanager.cust.state']}"></ice:outputText>
														</ice:commandSortHeader>
													</f:facet>
													<ice:outputText id="statedesc"
														value="#{adminCustomerBean.stateDesc}" />
												</ice:column>
												<ice:column groupOn="#{adminCustomerBean.cityDesc}" style="background-color:#F4F7F5;">
													<f:facet name="header">
														<ice:commandSortHeader id="citysort" columnName="cityDesc">
															<ice:outputText value="#{bundle['rz_admin_usermanager.cust.city']}"></ice:outputText>
														</ice:commandSortHeader>
													</f:facet>
													<ice:outputText id="citydesc"
														value="#{adminCustomerBean.cityDesc}" />
												</ice:column>
												<ice:column>
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['rz_admin_usermanager.cust.phone']}"></ice:outputText>
													</f:facet>
													<ice:outputText id="idPhone"
														value="#{adminCustomerBean.phone}" />
												</ice:column>
												<ice:column>
													<f:facet name="header">
														<ice:outputText
															value="#{bundle['rz_admin_usermanager.cust.website']}"></ice:outputText>
													</f:facet>
													<ice:outputText id="idwebSite"
														value="#{adminCustomerBean.webSite}" />
												</ice:column>
												<ice:column style="background-color:white;">
													<f:facet name="header">
														<span style="color:#F9FAF8;font-size:9px;text-align: center">&amp;nbsp</span>
													</f:facet>
													<ice:graphicImage style="border:none;text-align:center;" styleClass="noborder"
														url="./css/images/#{folderBean.folder_menu}/icons/menu_down_profile.png"
														onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_profile.png'"
														onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_profile.png'"
													
													/>
												</ice:column>
											</ice:dataTable>
											<ice:panelGroup styleClass="clearer" />


											<!-- PAGINATOR-->
											<ice:panelGroup style="float:left;width:420px;">
												<center>
													<ice:dataPaginator id="dataScroll_1"
														rendered="#{rz_CustomerProfileGridBean.selectedDataScrollModes[rz_CustomerProfileGridBean.selectedDataScrollMode].pagingEnabled}"
														for="tablecustgrid" vertical="false" fastStep="3" paginator="true"
														paginatorMaxPages="10">
														<f:facet name="first">
															<ice:graphicImage id="firstpage_1"
																url="./css/rime/css-images/arrow-first.gif"
																style="border:none;" title="first" />
														</f:facet>
														<f:facet name="last">
															<ice:graphicImage id="lastpage_1"
																url="./css/rime/css-images/arrow-last.gif"
																style="border:none;" title="last" />
														</f:facet>
														<f:facet name="previous">
															<ice:graphicImage id="previouspage_1"
																url="./css/rime/css-images/arrow-previous.gif"
																style="border:none;" title="previous" />
														</f:facet>
														<f:facet name="next">
															<ice:graphicImage id="nextpage_1"
																url="./css/rime/css-images/arrow-next.gif"
																style="border:none;" title="next" />
														</f:facet>
														<f:facet name="fastforward">
															<ice:graphicImage id="fastforward_1"
																url="./css/rime/css-images/arrow-ff.gif"
																style="border:none;" title="ff" />
														</f:facet>
														<f:facet name="fastrewind">
															<ice:graphicImage id="fastrewind_1"
																url="./css/rime/css-images/arrow-fr.gif"
																style="border:none;" title="fr" />
														</f:facet>
													</ice:dataPaginator>
												</center>
											</ice:panelGroup>

										</ice:panelGroup>

									</ice:panelGroup>

							</ice:panelGroup>

						</h:form>


					</ui:define>


				</ui:composition>



			</body>
		</html>
	</f:view>
</jsp:root>
