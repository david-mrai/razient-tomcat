															</td>
															<td class="tableflabelmasterbold" align="center">
																<ice:panelGrid >
																	<h:outputLabel >
																		<h:outputText value="#{bundle['rz_admin_surveymanager.questions.levelimportance']}"/>
																	</h:outputLabel>
																</ice:panelGrid>
																
															</td>
															<td rowspan="2" align="center">
															&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
															</td>
															<td colspan="2" align="center">
																 <ice:checkbox for="CriteriaSelectManyCheckboxLevelImportance" index="0"/><div style="font-weight: bold;">#{bundle['rz_importance.high']}</div>
															</td>
															
															<td rowspan="2" align="center">&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</td>
															
															<td colspan="2" align="center">
																 <ice:checkbox for="CriteriaSelectManyCheckboxLevelImportance" index="1"/><div style="font-weight: bold;">#{bundle['rz_importance.medium']}</div>
															</td>
															<td rowspan="2" align="center">&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</td>
															<td colspan="2" align="center">
																 <ice:checkbox for="CriteriaSelectManyCheckboxLevelImportance" index="2"/><div style="font-weight: bold;">#{bundle['rz_importance.low']}</div>
															</td>
															
															<td rowspan="2" align="center">&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</td>
															<td colspan="2" align="center">
																 <ice:checkbox for="CriteriaSelectManyCheckboxLevelImportance" index="3"/><div style="font-weight: bold;">#{bundle['rz_importance.not']}</div>
															</td>
															
														</tr>
														
													</table>
												</ice:panelGrid>
											
											</td>
									</tr>
								</table>
										
										<br/>
										<ice:messages style="margin-top:-5px;color:#1D115E; font-size: 11px;" globalOnly="true" />
										</div>	
									</ice:panelGrid>
									
									<style type="text/css">
                                          .cnfQuestion {
											    width: 600px;
											}
									</style>
									
									<ice:panelConfirmation id="confirmupdateQuestion"   styleClass="cnfQuestion" 
									  acceptLabel="#{bundle['ice_confirmation.ok']}"  
									  cancelLabel="#{bundle['ice_confirmation.cancel']}"  
									  message="#{bundle['ice_confirmation.update.message']} [#{rz_Compliance_SM_QuestionsBean.nameRzSurveys}}] [#{rz_Compliance_SM_QuestionsBean.nameRzSections}] [#{rz_Compliance_SM_QuestionsBean.name}]"  
									  title="#{bundle['ice_confirmation.update.title']}"  
									  draggable="false"  
									 />
									 <ice:panelConfirmation id="confirmdeleteQuestion"   styleClass="cnfQuestion"
									  acceptLabel="#{bundle['ice_confirmation.ok']}"  
									  cancelLabel="#{bundle['ice_confirmation.cancel']}"  
									  message="#{bundle['ice_confirmation.delete.message']} [#{rz_Compliance_SM_QuestionsBean.nameRzSurveys}}] [#{rz_Compliance_SM_QuestionsBean.nameRzSections}] [#{rz_Compliance_SM_QuestionsBean.name}]"  
									  title="#{bundle['ice_confirmation.delete.title']}"  
									  draggable="false"  
									 />
						</ice:form>	
					  </td>
					  <td valign="top">
					  	<ice:form>
					  		<table width="125px" style="margin-left:0px;border:1px solid #C3DFF4;" cellspacing="0" cellpadding="0" border="0">
					  			<tr  class="trSubHeader"><td align="center">#{bundle['rz_admin_surveymanager.questions.title']}</td></tr>
					  			<tr>
					  				<td valign="top" align="center"  class="tdSubHeader">
												&amp;nbsp&amp;nbsp
												<ice:commandLink action="#{rz_Compliance_SM_Questions_ListTableBean.loadPositionAction}" onclick="rld();" visible="#{rz_Compliance_SM_ListTableBean.visibleCrudSection}">
														<ice:graphicImage style="border:none;" styleClass="noborder"
																					url="./css/images/icons/menu_up_save.png"
																					onmouseout="this.src='./css/images/icons/menu_up_save.png'"
																					onmouseover="this.src='./css/images/icons/menu_up_save.png'"
																					onmouseup="this.src='./css/images/icons/menu_up_save.png'"
																					onmousedown="this.src='./css/images/icons/menu_up_save.png'"
																					/>
												</ice:commandLink>
										
												
												<ice:outputLabel value="#{bundle['rz_admin_surveymanager.questions.posquestions']}" visible="#{rz_Compliance_SM_ListTableBean.visibleCrudSection}"></ice:outputLabel>																
									</td>
								</tr>
								<tr>
									<td  class="tdcolumninfo" valign="top"><br/>
												<ice:panelGroup style="float:left;margin-top:0px;margin-left:2px;">
										            <ice:panelPositioned id="positionq" var="questionpos"
										                                 value="#{rz_Compliance_SM_Questions_ListTableBean.positions}"
										                                 styleClass="positionPanelContainer"
										                                 listener="#{rz_Compliance_SM_Questions_ListTableBean.changed}"
										                                 constraint="vertical">
										                <ice:panelGroup style="cursor:move;" styleClass="container">
										                    <ice:panelGroup styleClass="moveLabel"
										                                    style="border: 4px red">
										                        <ice:outputText id="nameq"   style="color:#334F4E" value="#{questionpos.name}"/>
										                    </ice:panelGroup>
										                </ice:panelGroup>
										            </ice:panelPositioned>
										        </ice:panelGroup>
											</td>
										</tr>
								</table>
					  	
					  	</ice:form>
					  </td>
					  </tr>
					  </table>
						<ice:form>
							<ice:panelPopup  modal="true" visible="#{viewlogsPopUpBean.visible}" style="margin-top:-90px;width:485px;" styleClass="icePanelPopupBody icePanelPopup">
				                <f:facet name="header">
				                   <ice:panelGrid width="485" cellpadding="0" cellspacing="1" columns="2" styleClass="trHeader" >
				                        <ice:outputText style="color: white;" value="#{bundle['rz_log']}"/>
				                        <ice:commandButton image="./css/images/icons/close.png" action="#{viewlogsPopUpBean.closePopup}" title="Close this draggable popup"/>
				                    </ice:panelGrid>
				                </f:facet>
				                <f:facet name="body">
				                	<ice:panelGrid width="100%">
				                		<table style="border:none;margin-top:-10px;float:left;">
				                			<tr>
				                				<td rowspan="2" valign="top"><ice:graphicImage styleClass="noborder" url="./css/images/general/log#{logger.stType}.png"/></td>
				                				<td style="color:#3A4358;font-weight:bold;">&amp;nbsp&amp;nbsp#{logger.stType}</td>
				                			</tr>
				                			<tr>
				                				<td >
					                				 <ice:panelGrid width="100%" columns="1" cellpadding="0" border="1" style="background-color: #F4F4F4;border-color:black;" >
									                	<table align="center">
										                       	<tr>
											                       <td  width="410" colspan="3" class="tableflabelmaster" >
											                       		<div style="height:200px;overflow: auto;" >
											                       			#{logger.stLogger}
											                       		</div>
											                       </td>
											                    </tr>
											             </table>
								                 	</ice:panelGrid>
				                				</td>
				                			</tr>
				                			<tr>
				                				<td colspan="3" align="right">
					                				<ice:commandLink action ="#{viewlogsPopUpBean.closePopup}">
																<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/general/logexit.png"/>
													</ice:commandLink>
												</td>
				                			</tr>
				                		</table>
									</ice:panelGrid>
				                </f:facet>
				            </ice:panelPopup>   
				          </ice:form>
					</ui:define>
				</ui:composition>

			</body>
		</html>
	</f:view>
</jsp:root>
