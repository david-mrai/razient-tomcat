																																	<ice:messages style="margin-top:-5px;color:#1D115E; font-size: 11px;" globalOnly="true" />
																																</td>
																															</tr>
																														</table>
																														<br/>
																														<table>
																															<tr><td>
																											                	<ice:commandLink action="#{rz_ComplianceSectionManager.insertAction}">
																																		<ice:graphicImage 
																																			url="./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png"
																																			onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png'"
																																			onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_save.png'"
																																			onmouseup="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png'"
																																			onmousedown="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_save.png'"
																																			/>
																																		
																																</ice:commandLink>
																																</td>
																																<td>
																											                	<ice:commandLink action="#{rz_ComplianceSectionManager.insertContinueAction}" onclick="rld();">
																																		<ice:graphicImage 
																																			url="./css/images/#{folderBean.folder_menu}/icons/menu_up_savecontinue.png"
																																			onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_savecontinue.png'"
																																			onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_savecontinue.png'"
																																			onmouseup="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_savecontinue.png'"
																																			onmousedown="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_savecontinue.png'"
																																			/>
																																		
																																</ice:commandLink>
																																</td>
																														</tr>
																														</table>
																														
																														
																														</ice:panelGrid>
																						                			</f:facet>
																						                
																						            </ice:panelPopup>  
																						            
																				</td>
																				<td  rowspan="2">&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</td>
																				<td  rowspan="2" valign="top">
																					<ice:panelGroup>
																									<ice:panelGroup>
																										
																										<ice:dataTable resizable="false" border="1" id="tablesession" value="#{rz_ComplianceSurveyManager.rzSectionsBean}" var="sectionBean"  
																													width="92%" 
																													rows="#{rz_ComplianceSurveyManager.selectedDataScrollModes[rz_ComplianceSurveyManager.selectedDataScrollMode].rows}"
																									               	scrollable="#{rz_ComplianceSurveyManager.selectedDataScrollModes[rz_ComplianceSurveyManager.selectedDataScrollMode].scrollingEnabled}"
																									               	scrollHeight="200px"
																									               	style="float:center;font-color: #FFFFFF;margin-top:7px;"
																									               	columnWidths="1%,40%,50%,10%"
																									               	columnClasses="columnCenter,columnLeft,columnLeft,columnCenter"
																									                rowClasses="rowOn,rowOff"
																									               	cellpadding="0"  onclick="rld();"
																													sortColumn="#{rz_ComplianceSurveyManager.columnNameOrder}" sortAscending="#{rz_ComplianceSurveyManager.descending}">
																											
																											<ice:column >
																												<ice:rowSelector id="selected" 
																				                                 value="#{rz_ComplianceSurveyManager.itemSelected}"
																				                                 multiple="false"         
																				                                 selectionListener="#{rz_ComplianceSurveyManager.rowSelectionListener}"
																				                                 selectionAction="#{rz_ComplianceSurveyManager.rowSelectionAction}"/>               
																				                                 >>		
																											</ice:column>
																												<ice:column>
																												<f:facet name="header">
																				                        				<ice:outputText value="#{bundle['rz_admin_surveymanager.sections.name']}"></ice:outputText>
																												</f:facet>
																												<ice:outputText id="idnameSections" value="#{sectionBean.name}"/>
																											</ice:column>
																											<ice:column>
																												<f:facet name="header">
																													<ice:outputText value="#{bundle['rz_admin_surveymanager.sections.titles']}"></ice:outputText>
																												</f:facet>
																												<ice:inputTextarea id="idtitle"
																												   cols="45" rows="2" maxlength="300"
																						                           value="#{sectionBean.title}"
																						                           readonly="false" styleClass="fieldtextareareadonly">
																						                         </ice:inputTextarea>
																											</ice:column>
																											<ice:column>
																												<f:facet name="header">
																				                        				<ice:outputText value="#{bundle['rz_admin_surveymanager.sections.position']}"></ice:outputText>
																												</f:facet>
																												<ice:outputText id="idposition" value="#{sectionBean.position}"/>
																											</ice:column>
																											</ice:dataTable>
																							
																											<ice:panelGroup styleClass="clearer"/>
																											  
																					        				
																											<!-- Set up the buttons and links for browsing through the table
																									             fastStep means No. of pages to fast forward or rewind: 3
																									             paginatorMaxPages means No. of direct links to pages: 4 -->
																									        <ice:panelGroup style="float:left;width:420px;">
																								            <center>
																								            <ice:dataPaginator id="dataScroll_2"
																								                   rendered="#{rz_ComplianceSurveyManager.selectedDataScrollModes[rz_ComplianceSurveyManager.selectedDataScrollMode].pagingEnabled}"
																								                   for="tablesession"
																								                   vertical="false" fastStep="3" paginator="true" paginatorMaxPages="10">
																								                <f:facet name="first">
																								                    <ice:graphicImage id="firstpage_1" url="./css/rime/css-images/arrow-first.gif" style="border:none;" title="first"/>
																								                </f:facet>
																								                <f:facet name="last">
																								                    <ice:graphicImage id="lastpage_1" url="./css/rime/css-images/arrow-last.gif" style="border:none;" title="last"/>
																								                </f:facet>
																								                <f:facet name="previous">
																								                    <ice:graphicImage id="previouspage_1" url="./css/rime/css-images/arrow-previous.gif" style="border:none;" title="previous"/>
																								                </f:facet>
																								                <f:facet name="next">
																								                    <ice:graphicImage id="nextpage_1" url="./css/rime/css-images/arrow-next.gif" style="border:none;" title="next"/>
																								                </f:facet>
																								                <f:facet name="fastforward">
																								                    <ice:graphicImage id="fastforward_1" url="./css/rime/css-images/arrow-ff.gif" style="border:none;" title="ff"/>
																								                </f:facet>
																								                <f:facet name="fastrewind">
																								                    <ice:graphicImage id="fastrewind_1" url="./css/rime/css-images/arrow-fr.gif" style="border:none;" title="fr"/>
																								                </f:facet>
																								            </ice:dataPaginator>
																								            </center>
																								        </ice:panelGroup>
																										
																										
																									</ice:panelGroup>
																									
																								</ice:panelGroup>
																						</td >
																						<td  rowspan="2">&amp;nbsp</td>
																						<td valign="top" align="center"  class="tdSubHeader">
																							&amp;nbsp&amp;nbsp
																							<ice:commandLink action="#{rz_ComplianceSurveyManager.loadPositionAction}" onclick="rld();">
																									<ice:graphicImage style="border:none;" styleClass="noborder"
																																url="./css/images/icons/menu_up_save.png"
																																onmouseout="this.src='./css/images/icons/menu_up_save.png'"
																																onmouseover="this.src='./css/images/icons/menu_up_save.png'"
																																onmouseup="this.src='./css/images/icons/menu_up_save.png'"
																																onmousedown="this.src='./css/images/icons/menu_up_save.png'"
																																/>
																							</ice:commandLink>
																					
																							
																							<h:outputText value="#{bundle['rz_admin_surveymanager.sections.possections']}"></h:outputText>
																															
																						
																						</td>
																					</tr>
																					<tr>
																						<td class="tdcolumninfo" valign="top"><br/>
																							<ice:panelGroup style="float:left;margin-top:0px;margin-left:8px;">
																					            <ice:panelPositioned id="positions" var="sectionpos"
																					                                 value="#{rz_ComplianceSurveyManager.positions}"
																					                                 styleClass="positionPanelContainer"
																					                                 listener="#{rz_ComplianceSurveyManager.changed}"
																					                                 constraint="vertical">
																					                <ice:panelGroup style="cursor:move;" styleClass="container">
																					                    <ice:panelGroup styleClass="moveLabel"
																					                                    style="border: 4px red;">
																					                        <ice:outputText id="name"  style="color:#334F4E" value="#{sectionpos.name}"/>
																					                    </ice:panelGroup>
																					                </ice:panelGroup>
																					            </ice:panelPositioned>
																					        </ice:panelGroup>
																						</td>
																					</tr>
																					</table>
																					</div>
						                                                </td>
						                                                </tr>
						                                                
					                                          		</tbody>
					                                          		</table>
						                                          
						                                          
					                                          	</td>
					                                          		
					                                    	 </tr>
					                                    	 
					                                    	
					                                    	 
	                                      					</tbody>
	                                    				</table>
                                    			</ice:form>
			                                    
