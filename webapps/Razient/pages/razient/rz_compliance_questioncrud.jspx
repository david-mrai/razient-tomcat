																							onmouseout="this.src='./css/images/icons/menu_up_save.png'"
																							onmouseover="this.src='./css/images/icons/menu_up_save.png'"
																							onmouseup="this.src='./css/images/icons/menu_up_save.png'"
																							onmousedown="this.src='./css/images/icons/menu_up_save.png'"
																							/>
														</ice:commandLink>
												
														
														<ice:outputLabel value="#{bundle['rz_admin_surveymanager.questions.posquestions']}" ></ice:outputLabel>																
											</td>
										</tr>
										<tr>
											<td  class="tdcolumninfo" valign="top"><br/>
														<ice:panelGroup style="float:left;margin-top:0px;margin-left:2px;">
												            <ice:panelPositioned id="positionq" var="questionpos"
												                                 value="#{rz_ComplianceSectionManager.positions}"
												                                 styleClass="positionPanelContainer"
												                                 listener="#{rz_ComplianceSectionManager.changed}"
												                                 constraint="vertical">
												                <ice:panelGroup style="cursor:move;" styleClass="container">
												                    <ice:panelGroup styleClass="moveLabel"
												                                    style="border: 4px red">
												                        <ice:outputText id="nameq"   style="color:#334F4E" value="#{questionpos.name}"/>
												                    </ice:panelGroup>
												                </ice:panelGroup>
												            </ice:panelPositioned>
												        </ice:panelGroup>
													</td>
												</tr>
										</table>
							  	
							  	</ice:form>
							  </td>
	                  		
	                  		
	                		</tr>
	              		</tbody>
	            	</table>
	            	
	            	<ice:form>
							<ice:panelPopup modal="true"
								visible="#{viewlogsPopUpBean.visible}"
								style="margin-top:-90px;width:485px;"
								styleClass="icePanelPopupBody icePanelPopup">
								<f:facet name="header">
									<ice:panelGrid width="485" cellpadding="0" cellspacing="1"
										columns="2" styleClass="trHeader">
										<ice:outputText style="color: white;"
											value="#{bundle['rz_log']}" />
										<ice:commandButton image="./css/images/icons/close.png"
											action="#{viewlogsPopUpBean.closePopup}"
											title="Close this draggable popup" />
									</ice:panelGrid>
								</f:facet>
								<f:facet name="body">
									<ice:panelGrid width="100%">
										<table style="border: none; margin-top: -10px; float: left;">
											<tr>
												<td rowspan="2" valign="top">
													<ice:graphicImage styleClass="noborder"
														url="./css/images/general/log#{logger.stType}.png" />
												</td>
												<td style="color: #3A4358; font-weight: bold;">
													&amp;nbsp&amp;nbsp#{logger.stType}
												</td>
											</tr>
											<tr>
												<td>
													<ice:panelGrid width="100%" columns="1" cellpadding="0"
														border="1"
														style="background-color: #F4F4F4;border-color:black;">
														<table align="center">
															<tr>
																<td width="410" colspan="3" class="tableflabelmaster">
																	<div style="height: 200px; overflow: auto;">
																		#{logger.stLogger}
																	</div>
																</td>
															</tr>
														</table>
													</ice:panelGrid>
												</td>
											</tr>
											<tr>
												<td colspan="3" align="right">
													<ice:commandLink action="#{viewlogsPopUpBean.closePopup}">
														<ice:graphicImage style="border:none;"
															styleClass="noborder"
															url="./css/images/general/logexit.png" />
													</ice:commandLink>
												</td>
											</tr>
										</table>
									</ice:panelGrid>
								</f:facet>
							</ice:panelPopup>
	            	</ice:form>
					<p>
					</p>	
                                    

					</ui:define>


				</ui:composition>




			</body>
		</html>
	</f:view>
</jsp:root>
