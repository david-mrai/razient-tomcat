																															/>
																														
																								  </ice:commandLink>	
																								  <ice:commandLink action="#{rz_ComplianceQuestionManager.deleteAction}" panelConfirmation="confirmdeleteQuestion" onclick="rld();" visible="#{not rz_ComplianceQuestionManager.visibleCrud}">
