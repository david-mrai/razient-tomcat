																					</tr>
																					
																			</table>
																			
																			</div>
																		</td>
						                                                </tr>
						                                                <tr>
						                                                <td>
						                                                	<div class="paneTableBoxs"  style="height:#{utilServiceLocatorBean.heightAllTable}px;margin-top:1px;margin-left:-8px;overflow:auto;width:#{utilServiceLocatorBean.widthAllTable-220}px;">
																			
						                                                		<table  width="98%" style="margin-left:0px;border:1px solid #C3DFF4;" cellspacing="0" cellpadding="0" border="0">
																					<tr  class="trSubHeader"><td colspan="4" align="center">#{bundle['rz_admin_surveymanager.questions.title']}</td></tr>
																					<tr>
																					<td valign="top"  rowspan="2" class="tdcolumninfo">
																										
																										<table border="0" cellspacing="0" cellpadding="0" width="95%" >
																											<tr>
																												<td>&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</td>
																												
																											</tr>
																											<tr>
																												<td align="center">
																													<ice:commandLink action="#{rz_ComplianceSectionManager.toNewQuestion}" onclick="rld();">
																																			<ice:graphicImage style="border:none;" styleClass="noborder"
																																				url="./css/images/icons/menu_up_new.png"
																																				onmouseout="this.src='./css/images/icons/menu_up_new.png'"
																																				onmouseover="this.src='./css/images/icons/menu_up_new.png'"
																																				onmouseup="this.src='./css/images/icons/menu_up_new.png'"
																																				onmousedown="this.src='./css/images/icons/menu_up_new.png'"
																																				alt="#{bundle['rz_admin_surveymanager.questions.newquestions']}" />
																																			
																																	</ice:commandLink>	
																												</td>
																											</tr>
																											<tr>
																												<td align="center">
																													<ice:outputLabel>
																														<h:outputText styleClass="titleButtonsFixedHigh" value="#{bundle['rz_admin_surveymanager.questions.newquestions']}"></h:outputText>
																													</ice:outputLabel>
																												</td>
																											</tr>
																										</table>
																										
																										
																					</td>
																					<td  rowspan="2">&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp</td>
																					<td  rowspan="2" valign="top">
																						<ice:panelGroup>
																										<ice:panelGroup>
																											
																											<ice:dataTable resizable="false" border="1" id="tablequestion" value="#{rz_ComplianceSectionManager.rzQuestionsBean}" var="questionBean"  
																														width="97%" 
																														rows="#{rz_ComplianceSectionManager.selectedDataScrollModes[rz_ComplianceSectionManager.selectedDataScrollMode].rows}"
																										               	scrollable="#{rz_ComplianceSectionManager.selectedDataScrollModes[rz_ComplianceSectionManager.selectedDataScrollMode].scrollingEnabled}"
																										               	scrollHeight="200px"
																										               	style="float:center;font-color: #FFFFFF;margin-top:7px;"
																										               	columnWidths="1%,40%,50%,10%"
																										               	columnClasses="columnCenter,columnLeft,columnLeft,columnCenter"
																										                rowClasses="rowOn,rowOff"
																										               	cellpadding="0"  onclick="rld();"
																														sortColumn="#{rz_ComplianceSectionManager.columnNameOrder}" sortAscending="#{rz_ComplianceSectionManager.descending}">
																												
																												<ice:column >
																													<ice:rowSelector id="selected"
																					                                 value="#{rz_ComplianceSectionManager.itemSelected}"
																					                                 multiple="false"         
																					                                 selectionListener="#{rz_ComplianceSectionManager.rowSelectionListener}"
																					                                 selectionAction="#{rz_ComplianceSectionManager.rowSelectionAction}"/>               
																					                                 >>		
																												</ice:column>
																													<ice:column>
																													<f:facet name="header">
																					                        				<ice:outputText value="#{bundle['rz_admin_surveymanager.questions.name']}"></ice:outputText>
																													</f:facet>
																													<ice:outputText id="idnameQuestions" value="#{questionBean.name}"/>
																												</ice:column>
																												<ice:column>
																													<f:facet name="header">
																														<ice:outputText value="#{bundle['rz_admin_surveymanager.questions.label']}"></ice:outputText>
																													</f:facet>
																													<ice:inputTextarea id="idlabel"
																													   cols="45" rows="2" maxlength="300"
																							                           value="#{questionBean.label}"
																							                           readonly="false" styleClass="fieldtextareareadonly">
																							                         </ice:inputTextarea>
																												</ice:column>
																												<ice:column>
																													<f:facet name="header">
																					                        				<ice:outputText value="#{bundle['rz_admin_surveymanager.questions.position']}"></ice:outputText>
																													</f:facet>
																													<ice:outputText id="idposition" value="#{questionBean.position}"/>
																												</ice:column>
																												</ice:dataTable>
																								
																												<ice:panelGroup styleClass="clearer"/>
																												  
																						        				
																												<!-- Set up the buttons and links for browsing through the table
																										             fastStep means No. of pages to fast forward or rewind: 3
																										             paginatorMaxPages means No. of direct links to pages: 4 -->
																										        <ice:panelGroup style="float:left;width:420px;">
																									            <center>
																									            <ice:dataPaginator id="dataScroll_2"
																									                   rendered="#{rz_ComplianceSectionManager.selectedDataScrollModes[rz_ComplianceSectionManager.selectedDataScrollMode].pagingEnabled}"
																									                   for="tablequestion"
																									                   vertical="false" fastStep="3" paginator="true" paginatorMaxPages="10">
																									                <f:facet name="first">
																									                    <ice:graphicImage id="firstpage_1" url="./css/rime/css-images/arrow-first.gif" style="border:none;" title="first"/>
																									                </f:facet>
																									                <f:facet name="last">
																									                    <ice:graphicImage id="lastpage_1" url="./css/rime/css-images/arrow-last.gif" style="border:none;" title="last"/>
																									                </f:facet>
																									                <f:facet name="previous">
																									                    <ice:graphicImage id="previouspage_1" url="./css/rime/css-images/arrow-previous.gif" style="border:none;" title="previous"/>
																									                </f:facet>
																									                <f:facet name="next">
																									                    <ice:graphicImage id="nextpage_1" url="./css/rime/css-images/arrow-next.gif" style="border:none;" title="next"/>
																									                </f:facet>
