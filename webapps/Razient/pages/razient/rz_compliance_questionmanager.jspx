																															url="./css/images/#{folderBean.folder_menu}/icons/menu_up_delete_section.png"
																															onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_delete_section.png'"
																															onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_delete_section.png'"
																															onmouseup="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_delete_section.png'"
																															onmousedown="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_delete_section.png'"
																															/>
																														
																								  </ice:commandLink>
																								  <ice:panelConfirmation id="confirmdeleteSection"  styleClass="cnfSection" 
																									  acceptLabel="#{bundle['ice_confirmation.ok']}"  
																									  cancelLabel="#{bundle['ice_confirmation.cancel']}"  
																									  message="#{bundle['ice_confirmation.delete.message']} [#{rz_ComplianceSectionManager.nameRzSurveys}] [#{rz_ComplianceSectionManager.name}]"  
																									  title="#{bundle['ice_confirmation.delete.title']}"  
																									  draggable="false"  
																									 />
																								
																							</td>
