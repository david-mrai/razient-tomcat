								<tr>
									<td>
										
										<ice:commandLink action="#{rz_MenuBarBean.getIconAdmin}" actionListener="#{rz_MenuBarBean.actionlistener}"   onclick="rld();">
												<ice:graphicImage style="border:none;"
																	styleClass="noborder"
																	url="./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.valueIconAdmin}.png"
																	onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.enabledAdmin}.png'"
																	onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.disabledAdmin}.png'"
																	onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.enabledAdmin}.png'"
																	onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.disabledAdmin}.png'" />
												<f:attribute name="optioonselected" value="comp_questionmanager"/>
										</ice:commandLink>
									</td>
									<td>
												<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/risk_black_low.png" />
									</td>
									<td>
										<ice:graphicImage style="border:none;"
																	styleClass="noborder"
																	url="./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.valueIconCompliance}.png"
																	onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.enabledCompliance}.png'"
																	onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.disabledCompliance}.png'"
																	onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.enabledCompliance}.png'"
																	onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.disabledCompliance}.png'" />
												
									</td>
	
								</tr>
							</table>			

					</ui:define>
