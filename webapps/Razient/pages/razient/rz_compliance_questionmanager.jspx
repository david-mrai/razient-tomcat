																								value="#{rz_ComplianceSectionManager.position}" partialSubmit="true"
																								readonly="true" styleClass="fieldkeymasterbgwhite">
																							</ice:inputText>
																						</td>
																						<td>
																							&amp;nbsp
																						</td>
																						
																					</tr>
																															<tr class="trrow2">
																						<td>
																							&amp;nbsp
																						</td>
																						<td class="tableflabelmasterbold">
																							<h:outputLabel>
																								<h:outputText
																									value="#{bundle['rz_admin_surveymanager.sections.titles']}"></h:outputText>
																							</h:outputLabel>
																							&amp;nbsp
																						</td>
																						<td>
																							&amp;nbsp
																						</td>
