																							<h:outputLabel>
																								<h:outputText
																									value="#{bundle['rz_admin_surveymanager.sections.description']}"></h:outputText>
																							</h:outputLabel>
																							&amp;nbsp
																						</td>
																						<td>
																							&amp;nbsp
																						</td>
																						<td class="tableffieldleft" colspan="6" align="left">
																							<ice:inputTextarea id="descriptionsect"
																							   cols="85"
																							   rows="4"
																	                           maxlength="480"
																	                           value="#{rz_ComplianceSectionManager.description}"
																	                           partialSubmit="true"
																	                           styleClass="fieldsimple">
																	                         </ice:inputTextarea>
