																url="./css/images/icons/menu_up_insert.png"
																onmouseout="this.src='./css/images/icons/menu_up_insert.png'"
																onmouseover="this.src='./css/images/icons/menu_up_insert.png'"
																onmouseup="this.src='./css/images/icons/menu_up_insert.png'"
																onmousedown="this.src='./css/images/icons/menu_up_insert.png'"
																alt="#{bundle['rz_insert']}" />
															<ice:outputLabel>
																<h:outputText styleClass="titleButtonsCrud" value="#{bundle['rz_insert']}"></h:outputText>
															</ice:outputLabel>
														</ice:commandLink>
