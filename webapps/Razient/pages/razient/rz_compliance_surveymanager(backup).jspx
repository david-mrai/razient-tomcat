													<td>&amp;nbsp&amp;nbsp&amp;nbsp</td>
													<td><ice:graphicImage url="./css/images/icons/menu_sep.png" style="border:none;" /></td>
													<td>&amp;nbsp&amp;nbsp&amp;nbsp</td>
													<td>
														<ice:commandLink action="#{rz_Compliance_SMBean.updateAction}"
															onclick="if(!confirm('#{bundle['rz_areyousure']} #{bundle['rz_update']}?')) return false;">
															<ice:graphicImage style="border:none;" styleClass="noborder"
																url="./css/images/icons/menu_up_update.png"
																onmouseout="this.src='./css/images/icons/menu_up_update.png'"
																onmouseover="this.src='./css/images/icons/menu_up_update.png'"
																onmouseup="this.src='./css/images/icons/menu_up_update.png'"
																onmousedown="this.src='./css/images/icons/menu_up_update.png'"
																alt="#{bundle['rz_update']}" />
															<ice:outputLabel>
																<h:outputText styleClass="titleButtonsCrud"
																	value="#{bundle['rz_update']}"></h:outputText>
															</ice:outputLabel>
														</ice:commandLink>
													</td>
													<td>&amp;nbsp&amp;nbsp&amp;nbsp</td>
													<td><ice:graphicImage url="./css/images/icons/menu_sep.png" style="border:none;" /></td>
													<td>&amp;nbsp&amp;nbsp&amp;nbsp</td>
													<td>
														<ice:commandLink action="#{rz_Compliance_SMBean.deleteAction}"
															onclick="if(!confirm('#{bundle['rz_areyousure']} #{bundle['rz_delete']} ?')) return false;">
															<ice:graphicImage style="border:none;" styleClass="noborder"
