													<td>&amp;nbsp&amp;nbsp&amp;nbsp</td>
													<td>
														&amp;nbsp&amp;nbsp
													</td>
													<td>&amp;nbsp&amp;nbsp&amp;nbsp</td>
													<td><ice:graphicImage url="./css/images/icons/menu_sep.png" style="border:none;" /></td>
													<td>&amp;nbsp&amp;nbsp&amp;nbsp</td>
													<td>
														<ice:commandLink action="#{rz_Compliance_SMBean.insertAction}">
