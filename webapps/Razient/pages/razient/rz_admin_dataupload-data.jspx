<?xml version="1.0" encoding="utf-8" ?>
<jsp:root version="1.2" xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:ice="http://www.icesoft.com/icefaces/component"
	xmlns:ice-cc="http://www.icesoft.com/icefaces-composite-comps">
	<jsp:directive.page contentType="text/html;charset=ISO-8859-1"
		pageEncoding="ISO-8859-1" />
	<f:view>
		<ice:outputDeclaration doctypeRoot="html"
			doctypePublic="-//W3C//DTD HTML 4.01 Transitional//EN"
			doctypeSystem="http://www.w3.org/TR/html4/loose.dtd" />
		<html>
			<head>
				<title>Index (Razient)</title>
			</head>
			<body>

				<!-- template="#{templateBean.templateContent}"-->
				<ui:composition
					template="../../include/templates/pages/modeA_rz.jspx"
					xmlns:h="http://java.sun.com/jsf/html"
					xmlns:f="http://java.sun.com/jsf/core"
					xmlns:c="http://java.sun.com/jstl/core"
					xmlns:ice="http://www.icesoft.com/icefaces/component"
					xmlns:ui="http://java.sun.com/jsf/facelets">

					<ui:param name="pageTitle"
						value="#{bundle['rz_admin_usermanager.dataupload.data.title']}" />

					<ui:define name="header-menu-value">
						<table cellspacing="0" cellpadding="0">
							<tr>
								<td>


									<ice:graphicImage style="border:none;" styleClass="noborder"
										url="./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.valueIconAdmin}.png"
										onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.enabledAdmin}.png'"
										onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.disabledAdmin}.png'"
										onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.enabledAdmin}.png'"
										onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.disabledAdmin}.png'" />

								</td>
								<td>
									<ice:graphicImage style="border:none;" styleClass="noborder"
										url="./css/images/risk_black_low.png" />
								</td>
								<td>
									<ice:commandLink action="#{rz_MenuBarBean.getIconCompliance}"
										onclick="rld();"
										actionListener="#{rz_MenuBarBean.actionlistener}">
										<ice:graphicImage style="border:none;" styleClass="noborder"
											url="./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.valueIconCompliance}.png"
											onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.enabledCompliance}.png'"
											onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.disabledCompliance}.png'"
											onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.enabledCompliance}.png'"
											onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.disabledCompliance}.png'" />
										<f:attribute name="optioonselected" value="admin_dataupload_data" />
									</ice:commandLink>
								</td>

							</tr>
						</table>

					</ui:define>
					<ui:define name="hide-show-value">
						<ice:form>
					    	<div style="margin-top:3px;float: left;position: absolute;">
						    	<ice:commandLink action="#{showhideBean.action_showhide}" onclick="rld();">
									<ice:graphicImage style="border:none;" 
										styleClass="noborder" url="./css/images/icons/menu_#{showhideBean.url_icon}.png"/>
								</ice:commandLink>
							</div>
						</ice:form>
					</ui:define>
					<ui:define name="page-menu-value">
						<ice:form>
							<ice:commandLink
								action="#{nav_DataUploadDataBean.actionMenu_UserManager}"
								onclick="rld();">
								<ice:graphicImage visible="true"  styleClass="menuPosA"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_usermanager.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_usermanager.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_usermanager.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_usermanager.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_usermanager.png'" />
							</ice:commandLink>
							<ice:commandLink
								action="#{nav_DataUploadDataBean.actionMenu_CustomerProfileGrid}"
								onclick="rld();">
								<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_customerprofile.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_customerprofile.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_customerprofile.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_customerprofile.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_customerprofile.png'" />
							</ice:commandLink>
							<ice:commandLink
								action="#{nav_DataUploadDataBean.actionMenu_Template}"
								onclick="rld();">
								<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_template.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_template.png'" />
							</ice:commandLink>
							<ice:graphicImage visible="true" styleClass="menuPosB"
								url="./css/images/#{folderBean.folder_menu}/risk_menu_down_dataupload.png" />
							<ice:commandLink
								action="#{nav_DataUploadDataBean.actionMenu_AuditLog}"
								onclick="rld();">
								<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_auditlog.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_auditlog.png'" />
							</ice:commandLink>
							
							<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_one.png"/>
						</ice:form>
					</ui:define>

					<ui:define name="page-content-value">

						<h:form>
						
						<table cellspacing="0" cellpadding="0" style="margin-top: -7px;" width="100%" >
								<tr  class="menubuttons">
									<td align="left">
										&amp;nbsp&amp;nbsp
										<ice:commandLink action="#{nav_DataUploadDataBean.actionMenu_DataUploadData_to_DataUploadKml}"  onclick="rld();">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_down_loadkml.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_loadkml.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_loadkml.png'"
												/>
										</ice:commandLink>
										
										&amp;nbsp&amp;nbsp
										<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_loaddata.png"
										/>
										
										&amp;nbsp&amp;nbsp
										<ice:commandLink action="#{nav_DataUploadDataBean.actionMenu_DataUploadData_to_DataUploadSurveyData}"  onclick="rld();">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_down_loadsurvey.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_loadsurvey.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_loadsurvey.png'"
												/>
										</ice:commandLink>
									</td>
									<td>
										&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
										&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
										&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
									</td>
							</tr>
							<tr>
								<td colspan="2" class="menuline"></td>
							</tr>
						</table>
						</h:form>


						
						<ice:form>
						
						<ice:panelGroup id="tabSetTab"
								styleClass="tabPanelBox panelTabSetSaleContainer">

								<ice:panelTabSet tabChangeListener="#{nav_DataUploadDataBean.processTabChange}" selectedIndex="#{nav_DataUploadDataBean.ITab}">
									<ice:panelTab label="#{bundle['rz_admin_usermanager.dataupload.profile.tab1']}">
									
									
									<!-- INICIA EL RAZIENT DATA FILE -->

										<ice:panelGroup id="icePanelUpLoad"
											style="height:#{utilServiceLocatorBean.heightPanelDataupload}px;width:850px;">

											<div style="height:#{utilServiceLocatorBean.heightPanel}px;">

												<table class="tableformsdataupload" style="margin-top: 0px;"
													cellspacing="0" cellpadding="0">
													<tr class="trHeader" align="center">
														<td>
															<h:outputLabel>
																<h:outputText
																	value="#{bundle['rz_admin_usermanager.dataupload.DataFileRaz']}"></h:outputText>
															</h:outputLabel>
														</td>
													</tr>
													<tr class="trrow1">
														<td align="left" colspan="4">
															<br />
															<ice:inputFile id="isObjProgRaz" width="450"
																uploadDirectory="./upload/DataUploadBatch/#{loginSystemBean.userLogin}/filesXLS/"
																progressListener="#{if_ControllerBean.fileUploadProgressRazient}"
																actionListener="#{if_ControllerBean.uploadRazientFile}"
																fileNamePattern=".+\.xls" submitOnUpload="" />
														</td>
													</tr>
													<tr class="trrow2">
														<td colspan="2" align="center">
															<ice:outputProgress
																value="#{if_ControllerBean.fileProgressRazient}"
																styleClass="uploadProgressBar" />
														</td>
													</tr>
													<tr class="trrow1">
														<td class="tableffield">
															<ice:outputText id="isNameRazient"
																value="#{if_ControllerBean.componentStatusRazient}"
																styleClass="titledatauploadmessage" />
														</td>
													</tr>
												</table>

											</div>
										</ice:panelGroup>
									</ice:panelTab>
									
									
									<ice:panelTab label="#{bundle['rz_admin_usermanager.dataupload.profile.tab2']}">

										<!-- INICIA EL CUSTOMER DATA FILE -->
										<ice:panelGroup id="icePanelFindCustomer"
											style="height:30px;width:950px;">
											<div style="height: 18px;">

												<table class="tableformstot">
													<tr>
														<td>
															<table class="tableformscell" cellspacing="0"
																cellpadding="0">
																<tr>
																	<td class="tableflabel">
																		&amp;nbsp&amp;nbsp
																	</td>
																	<td class="tableflabel">
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																	</td>
																	<td class="tableflabelbuttons" align="right">
																		<h:outputLabel>
																			<h:outputText
																				value="#{bundle['rz_admin_usermanager.dataupload.profile.tab2.type']} :"></h:outputText>
																		</h:outputLabel>
																		&amp;nbsp
																	</td>
																	<td class="tableflabel">
																		<ice:selectOneMenu id="selectedTypeCustomer" partialSubmit="true" required="true"
																			valueChangeListener="#{rz_CPDU_FileUploadBean.processValueChange}"
																			value="#{rz_CPDU_FileUploadBean.selectedSubClass}"
																			styleClass="selectedOneMenukeyBold" >
																			<f:selectItems
																				value="#{rz_CPDU_FileUploadBean.list_SubClasses}" />
																		</ice:selectOneMenu>
																	</td>
																	<td>
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																	</td>
																	<td class="tableflabelbuttons" align="right"
																		width="120">
																		<h:outputLabel>
																			<h:outputText
																				value="#{bundle['rz_admin_usermanager.dataupload.profile.tab2.fCust']}"></h:outputText>
																		</h:outputLabel>
																		&amp;nbsp
																	</td>
																	<td>
																		<ice:selectInputText id="customerListCust" rows="7" width="250" immediate="true" rendered="true"
																			valueChangeListener="#{rz_CPDU_FileUploadBean.updateParamsList}" >
																			<f:selectItems value="#{rz_CPDU_FileUploadBean.list}" />
																		</ice:selectInputText>
																	</td>
																	<td>
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																	</td>
																	<td>
																		<ice:commandLink
																			action="#{rz_CPDU_FileUploadBean.find_x_Customer_SubClass}"
																			onclick="rld();">
																			<ice:graphicImage visible="true" style="border:none;"
																				styleClass="noborder"
																				url="./css/images/icons/menu_up_load.png"
																				onmouseout="this.src='./css/images/icons/menu_up_load.png'"
																				onmouseover="this.src='./css/images/icons/menu_up_load.png'"
																				onmouseup="this.src='./css/images/icons/menu_up_load.png'"
																				onmousedown="this.src='./css/images/icons/menu_up_load.png'" />
																		</ice:commandLink>
																	</td>
																</tr>
															</table>
														</td>
													</tr>
												</table>
											</div>
										</ice:panelGroup>
										<br />
										<ice:panelGroup id="icePanelUpLoadCustomer"
											style="height:#{utilServiceLocatorBean.heightPanelDataupload}px;width:850px;">

											<div style="height:#{utilServiceLocatorBean.heightPanel}px;">
												<table class="tableformsdataupload" style="margin-top: 0px;"
													cellspacing="0" cellpadding="0">
													<tr class="trHeader" align="center">
														<td>
															<h:outputLabel>
																<h:outputText
																	value="#{bundle['rz_admin_usermanager.dataupload.DataFileCus']}"></h:outputText>
															</h:outputLabel>
														</td>
													</tr>
													<tr class="trrow1">
														<td align="left" colspan="4">
															<br />
															<ice:inputFile id="isObjProgCus" width="450"
																uploadDirectory="./upload/DataUploadBatch/#{loginSystemBean.userLogin}/#{rz_CPDU_FileUploadBean.selectedClass}/#{rz_CPDU_FileUploadBean.intIdCustomer}/filesXLS/"
																progressListener="#{if_ControllerBean.fileUploadProgressCustomer}"
																actionListener="#{if_ControllerBean.uploadCustomerFile}"
																fileNamePattern=".+\.xls" submitOnUpload="" />
														</td>
													</tr>
													<tr class="trrow2">
														<td colspan="2" align="center">
															<ice:outputProgress
																value="#{if_ControllerBean.fileProgressCustomer}"
																styleClass="uploadProgressBar" />
														</td>
													</tr>
													<tr class="trrow1">
														<td class="tableffield">
															<ice:outputText id="isNameCustomer"
																value="#{if_ControllerBean.componentStatusCustomer}"
																styleClass="titledatauploadmessage" />
														</td>
													</tr>
												</table>
											</div>
										</ice:panelGroup>

									</ice:panelTab>
									
									
									<ice:panelTab label="#{bundle['rz_admin_usermanager.dataupload.profile.tab3']}">

										<!-- INICIA EL SUPPLIER DATA FILE -->
										<ice:panelGroup id="icePanelFindSupplier"
											style="height:30px;width:950px;">
											<div style="height: 18px;">

												<table class="tableformstot">
													<tr>
														<td>
															<table class="tableformscell" cellspacing="0"
																cellpadding="0" >
																<tr>
																	<td class="tableflabel">
																		&amp;nbsp&amp;nbsp
																	</td>
																	<td class="tableflabel">
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																	</td>
																	<td class="tableflabelbuttons" align="right">
																		<h:outputLabel style="vertical-align: middle">
																			<h:outputText
																				value="#{bundle['rz_admin_usermanager.dataupload.profile.tab3.type']} :"></h:outputText>
																		</h:outputLabel>
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																	</td>
																	<td class="tableflabel">
																		<ice:selectOneMenu id="selectedTypeSupplier" partialSubmit="true" required="true"
																			valueChangeListener="#{rz_CPDU_FileUploadBean.processValueChange}"
																			value="#{rz_CPDU_FileUploadBean.selectedSubClass}"
																			styleClass="selectedOneMenukeyBold" >
																			<f:selectItems
																				value="#{rz_CPDU_FileUploadBean.list_SubClasses}" />
																		</ice:selectOneMenu>
																	</td>
																	<td>
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																	</td>
																	<td class="tableflabelbuttons" align="right"
																		width="120" >
																		<h:outputLabel id="customer" style="vertical-align: top">
																			<h:outputText
																				value="#{bundle['rz_admin_usermanager.dataupload.profile.tab3.fCust']}"></h:outputText>
																		</h:outputLabel>
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																	</td>
																	<td>
																		<ice:selectInputText id="customerList" rows="7" width="230" partialSubmit="true" rendered="true"
																			valueChangeListener="#{rz_CPDU_FileUploadBean.updateParamsList}" >
																			<f:selectItems value="#{rz_CPDU_FileUploadBean.list}" />
																		</ice:selectInputText>
																	</td>
																	<td>
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																	</td>
																	<td class="tableflabelbuttons" align="right"
																		width="120">
																		<h:outputLabel id="supplier" style="vertical-align: middle">
																			<h:outputText
																				value="#{bundle['rz_admin_usermanager.dataupload.profile.tab3.fSupp']}"></h:outputText>
																		</h:outputLabel>
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																	</td>
																	<td>
																		<ice:selectInputText id="supplierList" rows="7" width="230" partialSubmit="true" rendered="true"
																			valueChangeListener="#{rz_CPDU_FileUploadBean.updateParamsListSupp}" >
																			<f:selectItems value="#{rz_CPDU_FileUploadBean.listSupp}" />
																		</ice:selectInputText>
																	</td>
																	<td>
																		&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																	</td>
																	<td>
																		<ice:commandLink
																			action="#{rz_CPDU_FileUploadBean.find_x_Supplier_SubClass}"
																			onclick="rld();">
																			<ice:graphicImage visible="true" style="border:none;"
																				styleClass="noborder"
																				url="./css/images/icons/menu_up_load.png"
																				onmouseout="this.src='./css/images/icons/menu_up_load.png'"
																				onmouseover="this.src='./css/images/icons/menu_up_load.png'"
																				onmouseup="this.src='./css/images/icons/menu_up_load.png'"
																				onmousedown="this.src='./css/images/icons/menu_up_load.png'" />
																		</ice:commandLink>
																	</td>																	
																</tr>
															</table>
														</td>
													</tr>
												</table>
											</div>
										</ice:panelGroup>
										<br />
										<ice:panelGroup id="icePanelUpLoadSupplier"
											style="height:#{utilServiceLocatorBean.heightPanelDataupload}px;width:850px;">

											<div style="height:#{utilServiceLocatorBean.heightPanel}px;">
												<table class="tableformsdataupload" style="margin-top: 0px;"
													cellspacing="0" cellpadding="0">
													<tr class="trHeader" align="center">
														<td>
															<h:outputLabel>
																<h:outputText
																	value="#{bundle['rz_admin_usermanager.dataupload.DataFileSup']}"></h:outputText>
															</h:outputLabel>
														</td>
													</tr>
													<tr class="trrow1">
														<td align="left" colspan="4">
															<br />
															<ice:inputFile id="isObjProgSupp" width="450"
																uploadDirectory="./upload/DataUploadBatch/#{loginSystemBean.userLogin}/#{rz_CPDU_FileUploadBean.selectedClass}/#{rz_CPDU_FileUploadBean.intIdCustomer}/#{rz_CPDU_FileUploadBean.intIdSupplier}/filesXLS/"
																progressListener="#{if_ControllerBean.fileUploadProgressSupplier}"
																actionListener="#{if_ControllerBean.uploadSupplierFile}"
																fileNamePattern=".+\.xls" submitOnUpload="" />
														</td>
													</tr>
													<tr class="trrow2">
														<td colspan="2" align="center">
															<ice:outputProgress
																value="#{if_ControllerBean.fileProgressSupplier}"
																styleClass="uploadProgressBar" />
														</td>
													</tr>
													<tr class="trrow1">
														<td class="tableffield">
															<ice:outputText id="isNameSupplier"
																value="#{if_ControllerBean.componentStatusSupplier}"
																styleClass="titledatauploadmessage" />
														</td>
													</tr>
												</table>
											</div>
										</ice:panelGroup>

									</ice:panelTab>
									
									
									
								</ice:panelTabSet>
						</ice:panelGroup>
						
						<br />
						<br />
						<ice:panelGroup styleClass="customerProfileBox"
								style="height:#{utilServiceLocatorBean.heightPanelKmlTbDataupload}px;width:95%;overflow:auto;">
								
								<div style="height:40px;">
								<ice:outputText
									value="#{bundle['rz_admin_usermanager.dataupload.label']}"
									styleClass="titledatauploadmessage" title="Text" />

								<ice:dataTable resizable="false" border="1" id="tablestdfu"
									value="#{rz_CPDU_FileUploadBean.allCrudBeans}" var="stdFUBean"
									width="95%"
									rows="#{rz_CPDU_FileUploadBean.selectedDataScrollModes[rz_CPDU_FileUploadBean.selectedDataScrollMode].rows}"
									scrollable="#{rz_CPDU_FileUploadBean.selectedDataScrollModes[rz_CPDU_FileUploadBean.selectedDataScrollMode].scrollingEnabled}"
									style="float:left;margin-left:2px"
									columnWidths="1%,4%,9%,9%,18%,21%,10%,9%,9%"
									columnClasses="columnCenter,columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
									rowClasses="rowOn,rowOff" cellpadding="0"
									
									sortColumn="#{rz_CPDU_FileUploadBean.columnNameOrder}"
									sortAscending="#{rz_CPDU_FileUploadBean.descending}">
									<ice:column>>></ice:column>
									<ice:column>
										<f:facet name="header">
											<ice:outputText id="idDU"
												value="#{bundle['rz_admin_usermanager.dataupload.idDU']}"></ice:outputText>
										</f:facet>
										<ice:outputLabel>
											<h:outputText styleClass="titleTextFileUpload"
												value="#{stdFUBean.idDataUpload}"></h:outputText>
										</ice:outputLabel>
									</ice:column>
									<ice:column>
										<f:facet name="header">
											<ice:commandSortHeader id="dutype" columnName="type">
												<ice:outputText
													value="#{bundle['rz_admin_usermanager.dataupload.filetype']}"></ice:outputText>
											</ice:commandSortHeader>
										</f:facet>
										<h:outputText id="dutypeDesc" styleClass="titleTextFileuUload"
											value="#{stdFUBean.filetype}"></h:outputText>
									</ice:column>
									<ice:column>
										<f:facet name="header">
											<ice:outputText
												value="#{bundle['rz_admin_usermanager.dataupload.fileclass']}"></ice:outputText>
										</f:facet>
										<h:outputText id="duFileClass"
											styleClass="titleTextFileUpload"
											value="#{stdFUBean.fileclass}"></h:outputText>
									</ice:column>
									<ice:column>
										<f:facet name="header">
											<ice:outputText
												value="#{bundle['rz_admin_usermanager.dataupload.filesubclass']}"></ice:outputText>
										</f:facet>
										<h:outputText id="duFileSubClass" styleClass="titleTextKml"
											value="#{stdFUBean.filesubclass}"></h:outputText>
									</ice:column>
									<ice:column>
										<f:facet name="header">
											<ice:outputText
												value="#{bundle['rz_admin_usermanager.dataupload.filename']}"></ice:outputText>
										</f:facet>
										<h:outputText id="duFileName" styleClass="titleTextKml"
											value="#{stdFUBean.filenamexls}"></h:outputText>
									</ice:column>
									<ice:column>
										<f:facet name="header">
											<ice:outputText
												value="#{bundle['rz_admin_usermanager.dataupload.dateupload']}"></ice:outputText>
										</f:facet>
										<h:outputText id="duDateUpload" styleClass="titleTextKml"
											value="#{stdFUBean.dateupload}"
											converter="javax.faces.DateTime"></h:outputText>
									</ice:column>
									<ice:column style="text-align:center;">
										<f:facet name="header">
											<ice:outputText
												value="#{bundle['rz_admin_usermanager.dataupload.dataerrors']}"></ice:outputText>
										</f:facet>
										<ice:outputResource label="descargar" 
														resource="#{stdFUBean.resource}"
														image="./css/images/icons/type_#{stdFUBean.imagetype}.png" mimeType="#{stdFUBean.mimetype}"
														fileName="#{stdFUBean.pathname}" attachment="true"
														shared="false" style="width:150px"/>
									</ice:column>
									<ice:column>
										<f:facet name="header">
											<span
												style="color: #F9FAF8; font-size: 9px; text-align: center">&amp;nbsp#{bundle['rz_info.quantity']}:
												#{rz_CPDU_FileUploadBean.amountAttb}</span>
										</f:facet>
										<ice:commandLink
											action="#{rz_CPDU_FileUploadBean.selectionAction}"
											visible="#{stdFUBean.bVisible}" onclick="rld();"
											actionListener="#{rz_CPDU_FileUploadBean.selectionListener}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_down_#{stdFUBean.filestatus}.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_#{stdFUBean.filestatus}.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_#{stdFUBean.filestatus}.png'" />
											<f:attribute name="idSelected"
												value="#{stdFUBean.idDataUpload}" />
											<f:attribute name="status" value="#{stdFUBean.filestatus}" />
										</ice:commandLink>
									</ice:column>
								</ice:dataTable>
								</div>
							</ice:panelGroup>
							<br />
							<br />
							<ice:panelGroup style="float:left;width:420px;">
								<center>
									<ice:dataPaginator id="dataScroll_std"
										rendered="#{rz_CPDU_FileUploadBean.selectedDataScrollModes[rz_CPDU_FileUploadBean.selectedDataScrollMode].pagingEnabled}"
										for="tablestdfu" vertical="false" fastStep="3"
										paginator="true" paginatorMaxPages="10">
										<f:facet name="first">
											<ice:graphicImage id="firstpage_1"
												url="./css/rime/css-images/arrow-first.gif"
												style="border:none;" title="first" />
										</f:facet>
										<f:facet name="last">
											<ice:graphicImage id="lastpage_1"
												url="./css/rime/css-images/arrow-last.gif"
												style="border:none;" title="last" />
										</f:facet>
										<f:facet name="previous">
											<ice:graphicImage id="previouspage_1"
												url="./css/rime/css-images/arrow-previous.gif"
												style="border:none;" title="previous" />
										</f:facet>
										<f:facet name="next">
											<ice:graphicImage id="nextpage_1"
												url="./css/rime/css-images/arrow-next.gif"
												style="border:none;" title="next" />
										</f:facet>
										<f:facet name="fastforward">
											<ice:graphicImage id="fastforward_1"
												url="./css/rime/css-images/arrow-ff.gif"
												style="border:none;" title="ff" />
										</f:facet>
										<f:facet name="fastrewind">
											<ice:graphicImage id="fastrewind_1"
												url="./css/rime/css-images/arrow-fr.gif"
												style="border:none;" title="fr" />
										</f:facet>
									</ice:dataPaginator>
								</center>
							</ice:panelGroup>
						
						
						</ice:form>
						
						
					</ui:define>
				</ui:composition>
			</body>
		</html>
	</f:view>
</jsp:root>
