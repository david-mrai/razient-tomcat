								<tr>
									<td colspan="3" class="menuline"></td>
								</tr>
							</table>
							<br />

							<ice:panelGroup styleClass="customerProfileBox"
								style="width:100%;margin-top:-5px;text-align:center;" >
								<table cellspacing="0" cellpadding="0" style="margin-top: 0px;"
									width="100%" align="center" >
									<tr>
										<td width="20%"
											class="tablelabeledit_#{dm_CustomerProfileDemoBean.stEdit_Global}">	
											<span style="color: red;">*</span>
											<h:outputLabel>
												<h:outputText
													value="#{bundle['rz_admin_usermanager.cust.name']}"></h:outputText>
											</h:outputLabel>
										</td>
										<td align="left"
											class="tablelabelfieldedit_#{dm_CustomerProfileDemoBean.stEdit_Contact}"
											width="80%">
											<ice:inputText id="name" size="45" maxlength="50"
												value="#{dm_CustomerProfileDemoBean.name}"
