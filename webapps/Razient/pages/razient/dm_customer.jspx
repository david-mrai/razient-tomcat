												readonly="#{dm_CustomerProfileDemoBean.bEdit_Contact}"
												styleClass="tablefieldedit_#{dm_CustomerProfileDemoBean.stEdit_Contact}">
											</ice:inputText>
										</td>
									</tr>
									<tr>
										<td colspan="2"
											class="menusep_#{dm_CustomerProfileDemoBean.stEdit_Global}"></td>
									</tr>
									<tr>
