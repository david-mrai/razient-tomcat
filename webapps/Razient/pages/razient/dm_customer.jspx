					xmlns:ui="http://java.sun.com/jsf/facelets">

					<ui:param name="pageTitle"
						value="#{dm_CustomerProfileDemoBean.titlePage} #{bundle['rz_admin_customerprofile.title']}" />

					<ui:define name="page-content-value">

						<h:form>
							<br/>
							<table cellspacing="0" cellpadding="0" style="width:50%;margin-top: -7px;margin-left: 9px;"
