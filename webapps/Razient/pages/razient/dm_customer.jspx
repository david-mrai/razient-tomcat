								<tr >
									<td align="left">
										&amp;nbsp&amp;nbsp
										<ice:commandLink
											action="#{dm_CustomerProfileDemoBean.addCustomerAction}"
											visible="#{dm_CustomerProfileDemoBean.bTypeCreate}" >
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_createmyaccount.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_createmyaccount.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_createmyaccount.png'" />
										</ice:commandLink>
										
