																	readonly="false" styleClass="fieldtextareahighreadonly">
																</ice:inputTextarea>
															</ice:column>
															<ice:column style="text-align:center;">
																<f:facet name="header">
																	<ice:outputText
																		value="#{bundle['rz_admin_customerprofile.documents.path']}"></ice:outputText>
																</f:facet>	
																<ice:commandLink   action="#{adminDocumentsBean.selectedFileDocument}" 
																	actionListener="#{adminDocumentsBean.selectionListener}"
																	>													
																	<ice:graphicImage style="border:none;" styleClass="noborder" 
																		url="./css/images/icons/type_#{adminDocumentsBean.imagetype}.png"/>
																		<f:attribute name="idSelected" value="#{adminDocumentsBean.idDocument}" />
																</ice:commandLink>
															</ice:column>
															<ice:column style="text-align:center;">
																<f:facet name="header">
																	<span
																		style="color: #F9FAF8; font-size: 9px; text-align: center">&amp;nbsp
																		</span>
																</f:facet>
