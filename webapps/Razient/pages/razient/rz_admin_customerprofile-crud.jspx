															<center>
																<ice:dataPaginator id="dataScroll_documents"
																	rendered="#{rz_DocumentsGridBean.selectedDataScrollModes[rz_DocumentsGridBean.selectedDataScrollMode].pagingEnabled}"
																	for="tabledocumentsgrid" vertical="false" fastStep="3"
																	paginator="true" paginatorMaxPages="10">
