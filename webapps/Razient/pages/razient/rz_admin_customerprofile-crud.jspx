																	onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_edit.png'"
																	onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_edit.png'" />
															</ice:column>
														</ice:dataTable>
														<ice:panelGroup styleClass="clearer" />


														<!-- PAGINATOR-->
														<ice:panelGroup style="float:left;width:420px;">
															<center>
																<ice:dataPaginator id="dataScroll_Site"
																	rendered="#{rz_SiteGridBean.selectedDataScrollModes[rz_SiteGridBean.selectedDataScrollMode].pagingEnabled}"
																	for="tablesitegrid" vertical="false" fastStep="3"
																	paginator="true" paginatorMaxPages="10">
																	<f:facet name="first">
																		<ice:graphicImage id="firstpage_1"
																			url="./css/rime/css-images/arrow-first.gif"
