<?xml version="1.0" encoding="utf-8" ?>
<jsp:root version="1.2" xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:ice="http://www.icesoft.com/icefaces/component"
	xmlns:ice-cc="http://www.icesoft.com/icefaces-composite-comps"
	xmlns:fmt="http://java.sun.com/jstl/fmt">
	<jsp:directive.page contentType="text/html;charset=ISO-8859-1"
		pageEncoding="ISO-8859-1" />
	<f:view>
		<ice:outputDeclaration doctypeRoot="html"
			doctypePublic="-//W3C//DTD HTML 4.01 Transitional//EN"
			doctypeSystem="http://www.w3.org/TR/html4/loose.dtd" />
		<html>
			<head>
				<title>Index (Razient)</title>
			</head>
			<body>

				<!-- template="#{templateBean.templateContent}"-->
				<ui:composition
					template="../../include/templates/pages/modeA_rz.jspx"
					xmlns:h="http://java.sun.com/jsf/html"
					xmlns:f="http://java.sun.com/jsf/core"
					xmlns:c="http://java.sun.com/jstl/core"
					xmlns:ice="http://www.icesoft.com/icefaces/component"
					xmlns:ui="http://java.sun.com/jsf/facelets">

					<ui:param name="pageTitle"
						value="#{rz_CustomerProfileCrudBean.titlePage} #{bundle['rz_admin_customerprofile.title']}" />

					<ui:define name="header-menu-value">
						<table cellspacing="0" cellpadding="0">
							<tr>
								<td>


									<ice:graphicImage style="border:none;" styleClass="noborder"
										url="./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.valueIconAdmin}.png"
										onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.enabledAdmin}.png'"
										onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.disabledAdmin}.png'"
										onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.enabledAdmin}.png'"
										onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.disabledAdmin}.png'" />

								</td>
								<td>
									<ice:graphicImage style="border:none;" styleClass="noborder"
										url="./css/images/risk_black_low.png" />
								</td>
								<td>
									<ice:commandLink action="#{rz_MenuBarBean.getIconCompliance}"
										onclick="rld();"
										actionListener="#{rz_MenuBarBean.actionlistener}">
										<ice:graphicImage style="border:none;" styleClass="noborder"
											url="./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.valueIconCompliance}.png"
											onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.enabledCompliance}.png'"
											onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.disabledCompliance}.png'"
											onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.enabledCompliance}.png'"
											onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.disabledCompliance}.png'" />
										<f:attribute name="optioonselected"
											value="admin_customerprofile_crud" />
									</ice:commandLink>
								</td>

							</tr>
						</table>

					</ui:define>
					<ui:define name="page-menu-value">
						<ice:form>
							<ice:commandLink
								action="#{nav_CustomerProfileCrudBean.actionMenu_UserManager}"
								onclick="rld();">
								<ice:graphicImage visible="true" styleClass="menuPosA"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_usermanager.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_usermanager.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_usermanager.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_usermanager.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_usermanager.png'" />
							</ice:commandLink>
							<ice:graphicImage visible="true"  styleClass="menuPosB"
								url="./css/images/#{folderBean.folder_menu}/risk_menu_down_customerprofile.png" />
							<ice:commandLink
								action="#{nav_CustomerProfileCrudBean.actionMenu_Template}"
								onclick="rld();">
								<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_template.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_template.png'" />
							</ice:commandLink>
							<ice:commandLink
								action="#{nav_CustomerProfileCrudBean.actionMenu_DataUpload}"
								onclick="rld();">
								<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_dataupload.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_dataupload.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_dataupload.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_dataupload.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_dataupload.png'" />
							</ice:commandLink>
							<ice:commandLink
								action="#{nav_CustomerProfileCrudBean.actionMenu_AuditLog}"
								onclick="rld();">
								<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_auditlog.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_auditlog.png'" />
							</ice:commandLink>
							<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_one.png"/>
									
						</ice:form>
					</ui:define>
					<ui:define name="hide-show-value">
						<ice:form>
							<div style="margin-top: 3px; float: left; position: absolute;">
								<ice:commandLink action="#{showhideBean.action_showhide}"
									onclick="rld();">
									<ice:graphicImage style="border:none;" styleClass="noborder"
										url="./css/images/icons/menu_#{showhideBean.url_icon}.png" />
								</ice:commandLink>
							</div>
						</ice:form>
					</ui:define>
					<ui:define name="page-content-value">
						<h:form>

							<table cellspacing="0" cellpadding="0" style="margin-top: -7px;"
								width="100%">
								<tr class="menubuttons">
									<td align="left">
										&amp;nbsp&amp;nbsp
										<ice:commandLink
											action="#{rz_CustomerProfileCrudBean.editableCustomerAction}"
											onclick="rld();"
											visible="#{rz_CustomerProfileCrudBean.bTypeQuery}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_editable.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_editable.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_editable.png'" />
										</ice:commandLink>
										&amp;nbsp&amp;nbsp
										<ice:commandLink
											action="#{rz_CustomerProfileCrudBean.addCustomerAction}"
											onclick="rld();"
											visible="#{rz_CustomerProfileCrudBean.bTypeCreate}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_save.png'" />
										</ice:commandLink>
										<ice:commandLink
											action="#{rz_CustomerProfileCrudBean.updateCustomerAction}"
											onclick="rld();"
											visible="#{rz_CustomerProfileCrudBean.bTypeEdit}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_save.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_save.png'" />
										</ice:commandLink>
										<!--<ice:commandLink action="#{rz_CPCustomerBean.clearFormAction}"  onclick="rld();" visible="#{rz_CustomerProfileCrudBean.bTypeEdit}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_delete.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_delete.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_delete.png'"
												
												/>
										</ice:commandLink>-->
										&amp;nbsp&amp;nbsp
										<ice:commandLink
											action="#{rz_CustomerProfileCrudBean.returnToListAction}"
											onclick="rld();"
											visible="#{not rz_CustomerProfileCrudBean.bTypeEdit}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_cancel.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_cancel.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_cancel.png'" />
										</ice:commandLink>
										<ice:commandLink
											action="#{rz_CustomerProfileCrudBean.cancelCustomerAction}"
											onclick="rld();"
											visible="#{rz_CustomerProfileCrudBean.bTypeEdit}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_cancel.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_cancel.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_cancel.png'" />
										</ice:commandLink>
										&amp;nbsp&amp;nbsp
										<ice:commandLink action="#{viewlogsPopUpBean.openPopup}"
											id="logCreate" onclick="rld();" visible="false">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_logs_#{rz_CustomerProfileCrudBean.stViewLog}.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_logs_#{rz_CustomerProfileCrudBean.stViewLog}.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_logs_#{rz_CustomerProfileCrudBean.stViewLog}.png'" />
										</ice:commandLink>
										<ice:commandLink action="#{viewlogsPopUpBean.openPopup}"
											id="logEdit" onclick="rld();" visible="false">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_logs_#{rz_CustomerProfileCrudBean.stViewLog}.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_logs_#{rz_CustomerProfileCrudBean.stViewLog}.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_logs_#{rz_CustomerProfileCrudBean.stViewLog}.png'" />
										</ice:commandLink>
									</td>
									<td>
										&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
										&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
										&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
									</td>
									<td align="right">
										<ice:commandLink
											action="#{rz_CustomerProfileCrudBean.createNewCustomerAction}"
											onclick="rld();"
											visible="#{rz_CustomerProfileCrudBean.bTypeQuery}">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_createnewcustomer.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_createnewcustomer.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_createnewcustomer.png'" />
										</ice:commandLink>
										&amp;nbsp&amp;nbsp
										<ice:commandLink
											action="#{rz_CustomerProfileCrudBean.returnToListAction}"
											onclick="rld();">
											<ice:graphicImage style="border:none;" styleClass="noborder"
												url="./css/images/#{folderBean.folder_menu}/icons/menu_up_tolist.png"
												onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_tolist.png'"
												onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_tolist.png'" />
										</ice:commandLink>
										&amp;nbsp&amp;nbsp
									</td>
								</tr>
								<tr>
									<td colspan="3" class="menuline"></td>
								</tr>
							</table>
						</h:form>
						<h:form>
							<br />

							<ice:panelGroup styleClass="customerProfileBox"
								style="width:96%;margin-top:-5px;">
								<table cellspacing="0" cellpadding="0" style="margin-top: 0px;"
									width="100%">
									<tr>
										<td width="15%"
											class="tablelabeledit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											&amp;nbsp&amp;nbsp
											<h:outputLabel>
												<h:outputText
													value="#{bundle['rz_admin_usermanager.cust.name']}"></h:outputText>
											</h:outputLabel>
										</td>
										<td align="left"
											class="tablelabelfieldedit_#{rz_CustomerProfileCrudBean.stEdit_Contact}"
											width="30%">
											<ice:inputText id="name" size="45" maxlength="50"
												value="#{rz_CustomerProfileCrudBean.name}"
												partialSubmit="true"
												readonly="#{rz_CustomerProfileCrudBean.bEdit_Contact}"
												styleClass="tablefieldedit_#{rz_CustomerProfileCrudBean.stEdit_Contact}">
											</ice:inputText>
										</td>
										<td width="20%"
											class="tablelabeledit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											&amp;nbsp&amp;nbsp
											<h:outputLabel>
												<h:outputText
													value="#{bundle['rz_admin_usermanager.cust.phone']}"></h:outputText>
											</h:outputLabel>
										</td>
										<td align="left"
											class="tablelabelfieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}"
											width="30%">
											<ice:inputText id="phone" size="42" maxlength="20"
												value="#{rz_CustomerProfileCrudBean.phone}"
												partialSubmit="true"
												readonly="#{rz_CustomerProfileCrudBean.bEdit_Global}"
												styleClass="tablefieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											</ice:inputText>
										</td>
									</tr>
									<tr>
										<td colspan="4"
											class="menusep_#{rz_CustomerProfileCrudBean.stEdit_Global}"></td>
									</tr>
									<tr>
										<td width="20%"
											class="tablelabeledit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											&amp;nbsp&amp;nbsp
											<h:outputLabel>
												<h:outputText
													value="#{bundle['rz_admin_usermanager.cust.address']}"></h:outputText>
											</h:outputLabel>
										</td>
										<td align="left"
											class="tablelabelfieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}"
											width="30%">
											<ice:inputText id="address" size="45" maxlength="60"
												value="#{rz_CustomerProfileCrudBean.address}"
												partialSubmit="true"
												readonly="#{rz_CustomerProfileCrudBean.bEdit_Global}"
												styleClass="tablefieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											</ice:inputText>
										</td>
										<td width="20%"
											class="tablelabeledit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											&amp;nbsp&amp;nbsp
											<h:outputLabel>
												<h:outputText
													value="#{bundle['rz_admin_usermanager.cust.phone2']}"></h:outputText>
											</h:outputLabel>
										</td>
										<td align="left"
											class="tablelabelfieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}"
											width="30%">
											<ice:inputText id="phone2" size="42" maxlength="20"
												value="#{rz_CustomerProfileCrudBean.phone2}"
												partialSubmit="true"
												readonly="#{rz_CustomerProfileCrudBean.bEdit_Global}"
												styleClass="tablefieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											</ice:inputText>
										</td>
									</tr>
									<tr>
										<td colspan="4"
											class="menusep_#{rz_CustomerProfileCrudBean.stEdit_Global}"></td>
									</tr>
									<tr>
										<td width="20%"
											class="tablelabeledit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											&amp;nbsp&amp;nbsp
											<h:outputLabel>
												<h:outputText
													value="#{bundle['rz_admin_usermanager.cust.country']}"></h:outputText>
											</h:outputLabel>
										</td>
										<td align="left"
											class="tablelabelfieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}"
											width="30%">
											<ice:selectOneMenu
												value="#{rz_CustomerProfileCrudBean.country}"
												visible="#{not rz_CustomerProfileCrudBean.bEdit_Global}"
												id="selectedCountry" styleClass="selectedOneMasterCountry"
												valueChangeListener="#{rz_CustomerProfileCrudBean.processValueChange}"
												partialSubmit="true" style="width: 250px;">
												<f:selectItem itemLabel="#{bundle['rz_select_country']}"
													itemValue="0" />
												<f:selectItems
													value="#{applicationBean.countrySelectedItems}"
													id="country" />
											</ice:selectOneMenu>
											<ice:inputText id="countrydesc" size="30" maxlength="30"
												visible="#{rz_CustomerProfileCrudBean.bEdit_Global}"
												value="#{rz_CustomerProfileCrudBean.countryDesc}"
												partialSubmit="true"
												readonly="#{rz_CustomerProfileCrudBean.bEdit_Global}"
												styleClass="tablefieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											</ice:inputText>
										</td>
										<td width="20%"
											class="tablelabeledit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											&amp;nbsp&amp;nbsp
											<h:outputLabel>
												<h:outputText
													value="#{bundle['rz_admin_usermanager.cust.fax']}"></h:outputText>
											</h:outputLabel>
										</td>
										<td align="left"
											class="tablelabelfieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}"
											width="30%">
											<ice:inputText id="fax" size="42" maxlength="20"
												value="#{rz_CustomerProfileCrudBean.fax}"
												partialSubmit="true"
												readonly="#{rz_CustomerProfileCrudBean.bEdit_Global}"
												styleClass="tablefieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											</ice:inputText>
										</td>
									</tr>
									<tr>
										<td colspan="4"
											class="menusep_#{rz_CustomerProfileCrudBean.stEdit_Global}"></td>
									</tr>
									<tr>
										<td width="20%"
											class="tablelabeledit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											&amp;nbsp&amp;nbsp
											<h:outputLabel>
												<h:outputText
													value="#{bundle['rz_admin_usermanager.cust.state']}"></h:outputText>
											</h:outputLabel>
										</td>
										<td align="left"
											class="tablelabelfieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}"
											width="30%">
											<ice:selectOneMenu
												value="#{rz_CustomerProfileCrudBean.state}"
												visible="#{not rz_CustomerProfileCrudBean.bEdit_Global}"
												id="selectedState" styleClass="selectedOneMasterState"
												valueChangeListener="#{rz_CustomerProfileCrudBean.processValueChange}"
												partialSubmit="true" style="width: 250px;">
												<f:selectItem itemLabel="#{bundle['rz_select_state']}"
													itemValue="0" />
												<f:selectItems
													value="#{rz_CustomerProfileCrudBean.list_State}" id="state" />
											</ice:selectOneMenu>
											<ice:inputText id="statedesc" size="30" maxlength="30"
												visible="#{rz_CustomerProfileCrudBean.bEdit_Global}"
												value="#{rz_CustomerProfileCrudBean.stateDesc}"
												partialSubmit="true"
												readonly="#{rz_CustomerProfileCrudBean.bEdit_Global}"
												styleClass="tablefieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											</ice:inputText>
										</td>
										<td width="20%"
											class="tablelabeledit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											&amp;nbsp&amp;nbsp
											<h:outputLabel>
												<h:outputText
													value="#{bundle['rz_admin_usermanager.cust.website']}"></h:outputText>
											</h:outputLabel>
										</td>
										<td align="left"
											class="tablelabelfieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}"
											width="30%">
											<ice:inputText id="website" size="42" maxlength="50"
												value="#{rz_CustomerProfileCrudBean.webSite}"
												partialSubmit="true"
												readonly="#{rz_CustomerProfileCrudBean.bEdit_Global}"
												styleClass="tablefieldedit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											</ice:inputText>
										</td>
									</tr>
									<tr>
										<td colspan="4"
											class="menusep_#{rz_CustomerProfileCrudBean.stEdit_Global}"></td>
									</tr>
									<tr>
										<td width="20%"
											class="tablelabeledit_#{rz_CustomerProfileCrudBean.stEdit_Global}">
											&amp;nbsp&amp;nbsp
											<h:outputLabel>
												<h:outputText
													value="#{bundle['rz_admin_usermanager.cust.city']}"></h:outputText>
											</h:outputLabel>
