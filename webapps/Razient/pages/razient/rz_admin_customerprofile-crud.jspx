															<ice:column>
																<f:facet name="header">
																	<ice:commandSortHeader id="awardsfirstnamesort"
																		columnName="name">
																		<ice:outputText
																			value="#{bundle['rz_admin_customerprofile.documents.name']}"></ice:outputText>
																	</ice:commandSortHeader>
																</f:facet>
