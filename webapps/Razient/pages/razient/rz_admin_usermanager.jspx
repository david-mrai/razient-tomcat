						<ice:panelPopup  modal="true" visible="#{viewlogsPopUpBean.visible}" style="margin-top:-90px;width:485px;" styleClass="icePanelPopupBody icePanelPopup">
				                <f:facet name="header">
				                   <ice:panelGrid width="485" cellpadding="0" cellspacing="1" columns="2" styleClass="trHeader" >
				                        <ice:outputText style="color: white;" value="#{bundle['rz_log']}"/>
				                        <ice:commandButton image="./css/images/icons/close.png" action="#{viewlogsPopUpBean.closePopup}" title="Close this draggable popup"/>
				                    </ice:panelGrid>
				                </f:facet>
				                <f:facet name="body">
				                	<ice:panelGrid width="100%">
				                		<table style="border:none;margin-top:-10px;float:left;">
				                			<tr>
				                				<td rowspan="2" valign="top"><ice:graphicImage styleClass="noborder" url="./css/images/general/log#{logger.stType}.png"/></td>
				                				<td style="color:#3A4358;font-weight:bold;">&amp;nbsp&amp;nbsp#{logger.stType}</td>
				                			</tr>
				                			<tr>
				                				<td >
					                				 <ice:panelGrid width="100%" columns="1" cellpadding="0" border="1" style="background-color: #F4F4F4;border-color:black;" >
									                	<table align="center">
										                       	<tr>
											                       <td  width="410" colspan="3" class="tableflabelmaster" >
											                       		<div style="height:200px;overflow: auto;" >
											                       			#{logger.stLogger}
											                       		</div>
											                       </td>
											                    </tr>
											             </table>
								                 	</ice:panelGrid>
				                				</td>
				                			</tr>
				                			<tr>
				                				<td colspan="3" align="right">
					                				<ice:commandLink action ="#{viewlogsPopUpBean.closePopup}">
																<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/general/logexit.png"/>
													</ice:commandLink>
												</td>
				                			</tr>
				                		</table>
									</ice:panelGrid>
				                </f:facet>
				            </ice:panelPopup>   
				            
				            
				            <ice:panelPopup modal="true" visible="#{listEmployeeCustomerToUserPopUpBean.visible}" style="margin-left:0px;margin-top:-55px;position:absolute; width:650px;" styleClass="icePanelPopupBody">
												 <f:facet name="header">
															                    <ice:panelGrid width="650" cellpadding="0" cellspacing="1" columns="2" styleClass="trHeader" >
															                        <ice:outputText style="color: white;" value="#{bundle['rz_admin_customerprofile_site.employees']}"/>
															                        <ice:commandLink  action="#{listEmployeeCustomerToUserPopUpBean.closeclearPopup_rz}" >
																							<ice:graphicImage style="border:none;" styleClass="noborder"
																								url="./css/images/icons/close.png" />
																							
																					</ice:commandLink>
															                    </ice:panelGrid>
												</f:facet>
															                
									<f:facet name="body">
									<ice:panelGrid width="100%" columns="1" cellpadding="0"  style="background-color: #F0F7FB">
            	
												<ice:panelGroup>
													<ice:panelGroup>
														<ice:dataTable resizable="false" border="1" id="tablelistemployeeusergrid"
															value="#{rz_ListEmployeeUserGridBean.allCrudBeans}"
															var="adminListEmployeeUserBean"
															width="98%"
															rows="#{rz_ListEmployeeUserGridBean.selectedDataScrollModes[rz_ListEmployeeUserGridBean.selectedDataScrollMode].rows}"
															scrollable="#{rz_ListEmployeeUserGridBean.selectedDataScrollModes[rz_ListEmployeeUserGridBean.selectedDataScrollMode].scrollingEnabled}"
															scrollHeight="200px"
															style="float:center;font-color: #FFFFFF;"
															columnWidths="1%,29%,25%,40%,5%"
															columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
															rowClasses="rowOn,rowOff" cellpadding="0"
															sortColumn="#{rz_ListEmployeeUserGridBean.columnNameOrder}"
															sortAscending="#{rz_ListEmployeeUserGridBean.descending}"
															>
			
															<ice:column>
																<ice:rowSelector id="selected"
																	value="#{rz_ListEmployeeUserGridBean.itemSelected}" multiple="false"
																	selectionListener="#{rz_ListEmployeeUserGridBean.rowSelectionListener}"
																	selectionAction="#{rz_ListEmployeeUserGridBean.rowSelectionAction}" /> 
																	>>		
															</ice:column>
															<ice:column>
																<f:facet name="header">
																	<ice:commandSortHeader id="efirstnamesort" columnName="firstName">
																		<ice:outputText value="#{bundle['rz_admin_customerprofile.employee.firstname']}"></ice:outputText>
																	</ice:commandSortHeader>
																</f:facet>
																<ice:outputText id="idefirstname" value="#{adminListEmployeeUserBean.firstName}" />
															</ice:column>
															<ice:column>
																<f:facet name="header">
																	<ice:commandSortHeader id="elastNamesort" columnName="lastName">
																		<ice:outputText value="#{bundle['rz_admin_customerprofile.employee.lastname']}"></ice:outputText>
																	</ice:commandSortHeader>
																</f:facet>
																<ice:outputText id="idelastname" value="#{adminListEmployeeUserBean.lastName}" />
															</ice:column>
															<ice:column>
																<f:facet name="header">
																		<ice:outputText value="#{bundle['rz_admin_customerprofile.employee.email']}"></ice:outputText>
																</f:facet>
																<ice:outputText id="eemaildesc" style="font-weight:bold;"  value="#{adminListEmployeeUserBean.email}" />
															</ice:column>
															<ice:column>
																<f:facet name="header"></f:facet>
																<ice:graphicImage style="border:none;" styleClass="noborder"
																	url="./css/images/icons/menu_down_new_select.png"
																	onmouseout="this.src='./css/images/icons/menu_down_new_select.png'"
																	onmouseover="this.src='./css/images/icons/menu_up_new_select.png'"
																/>
															</ice:column>
														</ice:dataTable>
														<ice:panelGroup styleClass="clearer" />
			
			
														<!-- PAGINATOR-->
														<ice:panelGroup style="float:left;width:420px;">
															<center>
																<ice:dataPaginator id="dataScroll_Employee"
																	rendered="#{rz_ListEmployeeUserGridBean.selectedDataScrollModes[rz_ListEmployeeUserGridBean.selectedDataScrollMode].pagingEnabled}"
																	for="tablelistemployeeusergrid" vertical="false" fastStep="3" paginator="true"
																	paginatorMaxPages="10">
																	<f:facet name="first">
																		<ice:graphicImage id="firstpage_employee1"
																			url="./css/rime/css-images/arrow-first.gif"
																			style="border:none;" title="first" />
																	</f:facet>
																	<f:facet name="last">
																		<ice:graphicImage id="lastpage_employee1"
																			url="./css/rime/css-images/arrow-last.gif"
																			style="border:none;" title="last" />
																	</f:facet>
																	<f:facet name="previous">
																		<ice:graphicImage id="previouspage_employee1"
																			url="./css/rime/css-images/arrow-previous.gif"
																			style="border:none;" title="previous" />
																	</f:facet>
																	<f:facet name="next">
																		<ice:graphicImage id="nextpage_employee1"
																			url="./css/rime/css-images/arrow-next.gif"
																			style="border:none;" title="next" />
																	</f:facet>
																	<f:facet name="fastforward">
																		<ice:graphicImage id="fastforward_employee1"
																			url="./css/rime/css-images/arrow-ff.gif"
																			style="border:none;" title="ff" />
																	</f:facet>
																	<f:facet name="fastrewind">
																		<ice:graphicImage id="fastrewind_employee1"
																			url="./css/rime/css-images/arrow-fr.gif"
																			style="border:none;" title="fr" />
																	</f:facet>
																</ice:dataPaginator>
															</center>
														</ice:panelGroup>
													</ice:panelGroup>
												</ice:panelGroup>		
												
												<ice:panelGroup>
													<span onClick="showTab('tabsnewemployee', this)" style=" cursor: pointer;font-size:12px;font-weight:bold;"><img src="./css/images/general/minus-glow.png" align="absmiddle"></img>
									                 	<h:outputLabel>
															&amp;nbsp<h:outputText styleClass="titleMenuClick" value="#{bundle['rz_info.newemployee']}"></h:outputText>
														</h:outputLabel>
													</span>
														
									                <table id="tabsnewemployee" style="display:none;margin-top: -3px" width="100%">
									                	<tr>
									                		<td>	
									                			<br/>
									                			<ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;" > 
										                			<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
																				<tr>
																					<td width="20%"  class="tablelabeledit_#{rz_UserEmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
																						<h:outputLabel>
																							<h:outputText value="#{bundle['rz_admin_usermanager.user.login']}"></h:outputText>&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																						</h:outputLabel>
																			
																					</td>
																					<td align="left" class="tablelabelfieldedit_#{rz_UserEmployeeCrudBean.stEdit_Global}" width="80%">	
																						<ice:inputText id="email" size="60" maxlength="50" 
																							style="font-weight: bold;" value="#{rz_UserEmployeeCrudBean.email}" 
																							partialSubmit="true" 
																							styleClass="tablefieldedit_enabled" >
																						</ice:inputText>
																					 </td>
																				</tr>
											
																	</table>
																</ice:panelGroup>
			
																<br/>
																<ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;" > 
																	<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
																		<tr>
																			<td width="20%"  class="tablelabeledit_disabled">&amp;nbsp&amp;nbsp
																					<h:outputLabel>
																						<h:outputText value="#{bundle['rz_admin_customerprofile.employee.firstname']}"></h:outputText>&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																					</h:outputLabel>
																			</td>
																			<td align="left" class="tablelabelfieldedit_disabled" width="30%">
																				<ice:inputText id="firtsnamequery" size="30" maxlength="30"
																						value="#{rz_UserEmployeeCrudBean.firstName}" partialSubmit="true"
																						styleClass="tablefieldedit_enabled" >
																				</ice:inputText>
																			 </td>
																			<td  width="20%" class="tablelabeledit_disabled">&amp;nbsp&amp;nbsp 
																					<h:outputLabel>
																						<h:outputText value="#{bundle['rz_admin_customerprofile.employee.lastname']}"></h:outputText>
																					</h:outputLabel>
																			</td>
																			<td align="left" class="tablelabelfieldedit_disabled" width="30%">
																				<ice:inputText id="lastnamequery" size="30" maxlength="30"
																						value="#{rz_UserEmployeeCrudBean.lastName}" partialSubmit="true"
																						styleClass="tablefieldedit_enabled" >
																				</ice:inputText>
																			 </td>
																		</tr>
																		<tr><td colspan="4" class="menusep_#{rz_UserEmployeeCrudBean.stEdit_Global}"></td></tr>
																		<tr>
																			 <td width="20%"  class="tablelabeledit_#{rz_UserEmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
																					<h:outputLabel>
																						<h:outputText value="#{bundle['rz_admin_customerprofile.employee.phone']}"></h:outputText>
																					</h:outputLabel>
																			</td>
																			<td align="left" class="tablelabelfieldedit_disabled" width="30%">
																				<ice:inputText id="phonequery" size="30" maxlength="30"
																						value="#{rz_UserEmployeeCrudBean.phone}" partialSubmit="true"
																						styleClass="tablefieldedit_enabled">
																				</ice:inputText>
																			 </td>
																			 <td width="20%"  class="tablelabeledit_#{rz_UserEmployeeCrudBean.stEdit_Global}">&amp;nbsp&amp;nbsp 
																					<h:outputLabel>
																						<h:outputText value="#{bundle['rz_admin_customerprofile.employee.mobile']}"></h:outputText>
																					</h:outputLabel>
																			</td>
																			<td align="left" class="tablelabelfieldedit_disabled" width="30%">
																				<ice:inputText id="mobilequery" size="30" maxlength="30"
																						value="#{rz_UserEmployeeCrudBean.mobile}" partialSubmit="true"
																						styleClass="tablefieldedit_enabled" >
																				</ice:inputText>
																			 </td>
																		</tr>
																	</table>
																</ice:panelGroup>
																
																<br/>
																&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																<ice:commandLink action ="#{rz_UserEmployeeCrudBean.selectedNewEmployee}">
																	<ice:graphicImage style="border:none;" styleClass="noborder"
																	url="./css/images/#{folderBean.folder_menu}/icons/menu_down_new_select_employee.png"
																	onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_new_select_employee.png'"
																	onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_new_select_employee.png'"
																	/>
																	
																</ice:commandLink>
																
															</td>
														</tr>
													</table>
													
													<br/>
													
													
												</ice:panelGroup>	                	
											</ice:panelGrid>
											
											
											
											
											
										</f:facet>		                
								</ice:panelPopup>   
							</ice:form>
							
							<ice:form>
				
							<ice:panelPopup  modal="true" visible="#{changepasswordPopUpBean.visible}" style="width:435px;" styleClass="icePanelPopupBody icePanelPopup">
						                <f:facet name="header">
						                   <ice:panelGrid width="435" cellpadding="0" cellspacing="1" columns="2" styleClass="trHeader" >
						                        <ice:outputText style="color: white;" value="Change Password"/>
						                        <ice:commandButton image="./css/images/icons/close.png" action="#{changepasswordPopUpBean.closePopup}" title="Close this draggable popup"/>
						                    </ice:panelGrid>
						                </f:facet>
						                
						                <f:facet name="body">
						                    <ice:panelGrid width="100%" columns="1" cellpadding="0"  style="background-color: #F0F7FB">
							                	<table align="center">
								                       	<tr>
									                       <td  width="200" class="tableflabelmasterbold" ><ice:outputText style="font-weight:bold;color:#3E4F53;"  value="#{bundle['rz_pwd.user']}"/></td>
									                       <td width="200" colspan="3">
									                       				<ice:inputText id="userlogin" size="40" maxlength="40"
																			value="#{rz_UserEmployeeCrudBean.email}"
																			readonly="true" styleClass="fieldkeymasterbgblue">
																		</ice:inputText>
															</td>
									                    </tr>
									                     <tr>
									                       <td width="200"  class="tableflabelmasterbold"><ice:outputText  style="font-weight:bold;color:#3E4F53;" value="#{bundle['rz_pwd.newpwd']}"/></td>
									                       <td width="200" colspan="3">
									                       				<ice:inputSecret id="newPwd" size="20" maxlength="30"
																			value="#{changeNewPwdBean.newPassword}"  styleClass="fieldkeymasterbgleft">
																		</ice:inputSecret>
															</td>
									                    </tr>
									                     <tr>
									                       <td width="200"  class="tableflabelmasterbold"><ice:outputText  style="font-weight:bold;color:#3E4F53;" value="#{bundle['rz_pwd.repwd']}"/></td>
									                       <td width="200" colspan="3"><ice:inputSecret styleClass="fieldkeymasterbgleft" size="20" value="#{changeNewPwdBean.rePassword}"/></td>
									                    </tr>
									                    <tr>
									                    <td></td>
									                    <td  colspan="2" width="350">
									                    	<ice:commandLink actionListener ="#{changeNewPwdBean.changePassword_UserCustomerOfRazient}">
																<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/icons/menu_up_changepwd.png"/>
															</ice:commandLink>
														</td>
														<td></td>
														</tr>
									                    <tr>
															<td colspan="4"><ice:messages style="margin-top:-5px;color:#1D115E; font-size: 11px;" globalOnly="false" /></td>	
									                    </tr>
									                    </table>
						                 	</ice:panelGrid>
						                </f:facet>
						                
						            </ice:panelPopup>   
						            
						       </ice:form>
						
					</ui:define>


				</ui:composition>




			</body>
		</html>
	</f:view>
</jsp:root>
