<?xml version="1.0" encoding="utf-8" ?>
<jsp:root version="1.2" xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:ice="http://www.icesoft.com/icefaces/component"
	xmlns:ice-cc="http://www.icesoft.com/icefaces-composite-comps">
	<jsp:directive.page contentType="text/html;charset=ISO-8859-1"
		pageEncoding="ISO-8859-1" />
	<f:view>
		<ice:outputDeclaration doctypeRoot="html"
			doctypePublic="-//W3C//DTD HTML 4.01 Transitional//EN"
			doctypeSystem="http://www.w3.org/TR/html4/loose.dtd" />
		<html>
			<head>
				<title>Index (Razient)</title>
			</head>
			<body>

				<!-- template="#{templateBean.templateContent}"-->
				<ui:composition
					template="../../include/templates/pages/modeA_rz.jspx"
					xmlns:h="http://java.sun.com/jsf/html"
					xmlns:f="http://java.sun.com/jsf/core"
					xmlns:c="http://java.sun.com/jstl/core"
					xmlns:ice="http://www.icesoft.com/icefaces/component"
					xmlns:ice-cc="http://www.icesoft.com/icefaces-composite-comps"
					xmlns:ui="http://java.sun.com/jsf/facelets">

					<!-- params for page titles-->
					<ui:param name="pageTitle"
						value="#{bundle['rz_admin_usermanager.title']}" />

					<ui:define name="header-menu-value">
						<table cellspacing="0" cellpadding="0">
								<tr>
									<td>
										
										
												<ice:graphicImage style="border:none;"
																	styleClass="noborder"
																	url="./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.valueIconAdmin}.png"
																	onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.enabledAdmin}.png'"
																	onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.disabledAdmin}.png'"
																	onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.enabledAdmin}.png'"
																	onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_admin_#{rz_MenuBarBean.disabledAdmin}.png'" />
										
									</td>
									<td>
												<ice:graphicImage style="border:none;" styleClass="noborder" url="./css/images/risk_black_low.png" />
									</td>
									<td>
										<ice:commandLink action="#{rz_MenuBarBean.getIconCompliance}"  onclick="rld();" actionListener="#{rz_MenuBarBean.actionlistener}">
												<ice:graphicImage style="border:none;"
																	styleClass="noborder"
																	url="./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.valueIconCompliance}.png"
																	onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.enabledCompliance}.png'"
																	onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.disabledCompliance}.png'"
																	onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.enabledCompliance}.png'"
																	onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_comp_#{rz_MenuBarBean.disabledCompliance}.png'" />
												<f:attribute name="optioonselected" value="admin_usermanager"/>
										</ice:commandLink>
									</td>
	
								</tr>
							</table>			

					</ui:define>
					<ui:define name="hide-show-value">
						<ice:form>
					    	<div style="margin-top:3px;float: left;position: absolute;">
						    	<ice:commandLink action="#{showhideBean.action_showhide}" onclick="rld();">
									<ice:graphicImage style="border:none;" 
										styleClass="noborder" url="./css/images/icons/menu_#{showhideBean.url_icon}.png"/>
								</ice:commandLink>
							</div>
						</ice:form>
					</ui:define>
					<ui:define name="page-menu-value">
						<ice:form>

							<ice:graphicImage visible="true"  styleClass="menuPosA"
								url="./css/images/#{folderBean.folder_menu}/risk_menu_down_usermanager.png" />
							<ice:commandLink action="#{rz_UserManagerBean.actionMenu_CustomerProfileGrid}" onclick="rld();">
								<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_customerprofile.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_customerprofile.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_customerprofile.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_customerprofile.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_customerprofile.png'" />
							</ice:commandLink>
							<ice:commandLink action="#{rz_UserManagerBean.actionMenu_Template}" onclick="rld();">
								<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_template.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_template.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_template.png'" />
							</ice:commandLink>
							<ice:commandLink action="#{rz_UserManagerBean.actionMenu_DataUpload}" onclick="rld();">
								<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_dataupload.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_dataupload.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_dataupload.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_dataupload.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_dataupload.png'" />
							</ice:commandLink>
							<ice:commandLink
								action="#{rz_UserManagerBean.actionMenu_AuditLog}"
								onclick="rld();">
								<ice:graphicImage visible="true"  styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png"
									onmouseout="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png'"
									onmouseover="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_over_auditlog.png'"
									onmouseup="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_up_auditlog.png'"
									onmousedown="this.src='./css/images/#{folderBean.folder_menu}/risk_menu_down_auditlog.png'" />
							</ice:commandLink>
							
							<ice:graphicImage visible="true" styleClass="menuPosB"
									url="./css/images/#{folderBean.folder_menu}/risk_menu_one.png"/>
						</ice:form>
					</ui:define>

					<ui:define name="page-content-value">

					<!-- Static Tab Set -->
					<ice:form>
					<ice:panelGroup id="tabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer">
					
					   <ice:panelTabSet tabChangeListener="#{rz_UserManagerBean.processTabChange}"  selectedIndex="#{rz_UserManagerBean.ITab}">
					   
							<ice:panelTab   label="#{bundle['rz_admin_usermanager.tab1']}" >
					           <div style="height:#{utilServiceLocatorBean.heightPanel}px;">
								<table class="tableformstot">
									<tr>
										<td>
											<table class="tableformscell" cellspacing="0" cellpadding="0">
												<tr>
													<td class="tableflabel">
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td class="tableflabel">
														<ice:commandLink action="#{rz_UMRazient_EditTableBean.findAllUser}">
															<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																url="./css/images/#{folderBean.folder_menu}/icons/menu_up_all.png"
																onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_all.png'"
																onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_all.png'"/>
														</ice:commandLink>
													</td>
													<td class="tableflabel">
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
														&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
													</td>
													<td class="tableflabelbuttons">
														<h:outputLabel>
														<h:outputText value="#{bundle['rz_admin_usermanager.rz.status']}"></h:outputText>
														</h:outputLabel>&amp;nbsp
													</td>
													<td class="tableflabel">
														<ice:selectOneMenu id="selectedStatusRz" value="#{rz_UMRazient_EditTableBean.selectedStatus}" styleClass="selectedOneMenukeyBold"  required="false">
															<f:selectItems value="#{rz_UMRazient_EditTableBean.list_Status}" />
													    </ice:selectOneMenu>
													</td>
													<td>
														<ice:commandLink action="#{rz_UMRazient_EditTableBean.find_x_Status}" onclick="rld();">
															<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																url="./css/images/icons/menu_up_load.png"/>
														</ice:commandLink>
													</td>
												</tr>
											</table>
										</td>
									</tr>
								</table>
									
					              <br/>
					              	<div class="paneTableBox" style="padding:2px;height:#{utilServiceLocatorBean.heightEditableTable-60}px;margin-left:20px;margin-top:-8px;overflow:auto;width:#{utilServiceLocatorBean.widthEditableTable}px;">
					                
									<ice-cc:editableTable bean="#{rz_UMRazient_EditTableBean.editTableBean}" id="editableTable" idProperty="ipos" >
										<ice-cc:textColumn title="#{bundle['rz_admin_usermanager.rz.login']}" property="login" width="120px"  >
										</ice-cc:textColumn>
										<ice-cc:textColumn title="#{bundle['rz_admin_usermanager.rz.pwd']}" property="password" width="40px" />
										<ice-cc:textColumn title="#{bundle['rz_admin_usermanager.rz.firstname']}" property="firstName" width="80px" />
										<ice-cc:textColumn title="#{bundle['rz_admin_usermanager.rz.lastname']}" property="lastName" width="80px" />
										<ice-cc:textColumn title="#{bundle['rz_admin_usermanager.rz.phone']}" property="phone" width="60px" />
										<ice-cc:textColumn title="#{bundle['rz_admin_usermanager.rz.email']}" property="email" width="120px" >
										 <!-- <f:validator validatorId="validateEmail" /> -->
										</ice-cc:textColumn>
										<ice-cc:selectOneMenuColumn title="#{bundle['rz_admin_usermanager.rz.status']}" property="status"
													selectItems="#{rz_UMRazient_EditTableBean.list_Status}" width="60px"/>
									</ice-cc:editableTable>
									</div>
							  </div>
					        </ice:panelTab>
					        
					        <ice:panelTab   label="#{bundle['rz_admin_usermanager.tab2']}" >
					             <div style="height:#{utilServiceLocatorBean.heightPanel}px;" >
					              
					              
							             <ice:panelGroup id="subTabSetTab" styleClass="tabPanelBox panelTabSetSaleContainer" >
							
											   <ice:panelTabSet tabChangeListener="#{rz_UMCustomerBean.processTabChange}" selectedIndex="#{rz_UMCustomerBean.ITab}">
											   

												<ice:panelTab   label="#{bundle['rz_admin_usermanager.tab21']}" >
												     
													<table class="tableformstot">
														<tr>
															<td>
																<table class="tableformscell" cellspacing="0" cellpadding="0">
																	<tr>
																		<td class="tableflabel">
																			&amp;nbsp&amp;nbsp
																		</td>
																		<td class="tableflabel">
																			<ice:commandLink action="#{rz_UMCustomer_User_ListTableBean.find_All_Action}" onclick="rld();">
																				<ice:graphicImage visible="true" style="border:none;" styleClass="noborder"
																					url="./css/images/#{folderBean.folder_menu}/icons/menu_up_all.png"
																					onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_all.png'"
																					onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_all.png'"/>
																			</ice:commandLink>
																		</td>
																		<td class="tableflabel">
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		</td>
																		<td class="tableflabelbuttons" align="right">
																			&amp;nbsp
																		</td>
																		<td class="tableflabel">
																			&amp;nbsp
																		</td>
																		<td>
																			&amp;nbsp
																		</td>
																		<td>
																			&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp&amp;nbsp
																		</td>
																		<td class="tableflabelbuttons" width="120">
																		<h:outputLabel >
																			<h:outputText value="#{bundle['rz_admin_usermanager.cust.autofind']}"></h:outputText>
																			</h:outputLabel>
																		</td>
																		<td>
																			<ice:selectInputText rows="7" width="250" valueChangeListener="#{rz_UMCustomer_User_ListTableBean.updateParamsList}">
															                    <f:selectItems value="#{rz_UMCustomer_User_ListTableBean.list}"/>
															                </ice:selectInputText>
																		</td>
																	</tr>
																</table>
															</td>
														</tr>
													</table>   
													    
													    
												<div class="paneTableBox"  style="height:#{utilServiceLocatorBean.heightEditableTable}px;margin-top:8px;overflow:auto;width:#{utilServiceLocatorBean.widthEditableTable}px;">
											 		<ice:panelGroup>
														<ice:panelGroup>
															<ice:dataTable resizable="false" border="1" id="table" value="#{rz_UMCustomer_User_ListTableBean.rzCustomerBean}" var="customerBean"  
																		width="95%" 
																		rows="#{rz_UMCustomer_User_ListTableBean.selectedDataScrollModes[rz_UMCustomer_User_ListTableBean.selectedDataScrollMode].rows}"
														               	scrollable="#{rz_UMCustomer_User_ListTableBean.selectedDataScrollModes[rz_UMCustomer_User_ListTableBean.selectedDataScrollMode].scrollingEnabled}"
														               	scrollHeight="200px"
														               	style="float:center;font-color: #FFFFFF;"
														               	columnWidths="1%,29%,29%,20%,20%,25%,5%"
														               	columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
														                rowClasses="rowOn,rowOff"
														               	cellpadding="0"
																		sortColumn="#{rz_UMCustomer_User_ListTableBean.columnNameOrder}" sortAscending="#{rz_UMCustomer_User_ListTableBean.descending}">
																
																<ice:column >
																	<ice:rowSelector id="selected"
									                                 value="#{rz_UMCustomer_User_ListTableBean.itemSelected}"
									                                 multiple="false"         
									                                 selectionListener="#{rz_UMCustomer_User_ListTableBean.rowSelectionListener}"
									                                 selectionAction="#{rz_UMCustomer_User_ListTableBean.rowSelectionAction}"/>               
									                                 >>		
																</ice:column>
																	<ice:column>
																	<f:facet name="header">
																		<ice:commandSortHeader id="nameId" columnName="name"  >
									                        				<ice:outputText value="#{bundle['rz_admin_usermanager.cust.name']}"></ice:outputText>
									                    				</ice:commandSortHeader>
																	</f:facet>
																	<ice:outputText id="idname" value="#{customerBean.name}"/>
																</ice:column>
																<ice:column groupOn="#{customerBean.countryDesc}"  style="background-color:#F7F4F5;">
																	<f:facet name="header">
																		<ice:commandSortHeader id="countrysort" columnName="countryDesc">
																			<ice:outputText value="#{bundle['rz_admin_usermanager.cust.country']}" ></ice:outputText>
																		</ice:commandSortHeader>
																	</f:facet>
																	<ice:outputText id="countrydesc" style="font-weight:bold;text-align:center;"
																		value="#{customerBean.countryDesc}" />
																</ice:column>
																<ice:column groupOn="#{customerBean.stateDesc}" style="background-color:#F3F4F8;">
																	<f:facet name="header">
																		<ice:commandSortHeader id="statesort" columnName="stateDesc">
																			<ice:outputText value="#{bundle['rz_admin_usermanager.cust.state']}"></ice:outputText>
																		</ice:commandSortHeader>
																	</f:facet>
																	<ice:outputText id="statedesc"
																		value="#{customerBean.stateDesc}" />
																</ice:column>
																<ice:column groupOn="#{customerBean.cityDesc}" style="background-color:#F4F7F5;">
																	<f:facet name="header">
																		<ice:commandSortHeader id="citysort" columnName="cityDesc">
																			<ice:outputText value="#{bundle['rz_admin_usermanager.cust.city']}"></ice:outputText>
																		</ice:commandSortHeader>
																	</f:facet>
																	<ice:outputText id="citydesc"
																		value="#{customerBean.cityDesc}" />
																</ice:column>
																<ice:column>
																	<f:facet name="header">
																		<ice:outputText value="#{bundle['rz_admin_usermanager.cust.website']}"></ice:outputText>
																	</f:facet>
																	<ice:outputText id="idwebSite" value="#{customerBean.webSite}"/>
																</ice:column>
																<ice:column style="background-color:white;">
																	<f:facet name="header">
																		<span style="color:#F9FAF8;font-size:9px;text-align: center">&amp;nbsp#{bundle['rz_info.quantity']}: #{rz_UMCustomer_User_ListTableBean.amount}</span>
																	</f:facet>
																	<ice:graphicImage style="border:none;text-align:center;" styleClass="noborder" 
																		url="./css/images/#{folderBean.folder_menu}/icons/menu_down_addtbusers.png"
																		onmouseout="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_down_addtbusers.png'"
																		onmouseover="this.src='./css/images/#{folderBean.folder_menu}/icons/menu_up_addtbusers.png'"
																	
																	/>
																</ice:column>

																</ice:dataTable>
												
																<ice:panelGroup styleClass="clearer"/>
																  
										        				
																<!-- Set up the buttons and links for browsing through the table
														             fastStep means No. of pages to fast forward or rewind: 3
														             paginatorMaxPages means No. of direct links to pages: 4 -->
														        <ice:panelGroup style="float:left;width:420px;">
													            <center>
													            <ice:dataPaginator id="dataScroll_1"
													                   rendered="#{rz_UMCustomer_User_ListTableBean.selectedDataScrollModes[rz_UMCustomer_User_ListTableBean.selectedDataScrollMode].pagingEnabled}"
													                   for="table"
													                   vertical="false" fastStep="3" paginator="true" paginatorMaxPages="10">
													                <f:facet name="first">
													                    <ice:graphicImage id="firstpage_1" url="./css/rime/css-images/arrow-first.gif" style="border:none;" title="first"/>
													                </f:facet>
													                <f:facet name="last">
													                    <ice:graphicImage id="lastpage_1" url="./css/rime/css-images/arrow-last.gif" style="border:none;" title="last"/>
													                </f:facet>
													                <f:facet name="previous">
													                    <ice:graphicImage id="previouspage_1" url="./css/rime/css-images/arrow-previous.gif" style="border:none;" title="previous"/>
													                </f:facet>
													                <f:facet name="next">
													                    <ice:graphicImage id="nextpage_1" url="./css/rime/css-images/arrow-next.gif" style="border:none;" title="next"/>
													                </f:facet>
													                <f:facet name="fastforward">
													                    <ice:graphicImage id="fastforward_1" url="./css/rime/css-images/arrow-ff.gif" style="border:none;" title="ff"/>
													                </f:facet>
													                <f:facet name="fastrewind">
													                    <ice:graphicImage id="fastrewind_1" url="./css/rime/css-images/arrow-fr.gif" style="border:none;" title="fr"/>
													                </f:facet>
													            </ice:dataPaginator>
													            </center>
													        </ice:panelGroup>
															
														</ice:panelGroup>
														
													</ice:panelGroup>

												</div> 

						              			</ice:panelTab>
						              			
						              			
						              			
						              			
						              			<ice:panelTab   label="#{bundle['rz_admin_usermanager.tab22']}" disabled="#{rz_UMCustomerBean.disabledUser}">
					
													<br/>
													     <ice:panelGroup styleClass="customerProfileBox" style="width:96%;margin-top:-5px;">
															<table cellspacing="0" cellpadding="0" style="margin-top: 0px;" width="100%" >
																<tr>
																	<td width="20%"  class="tablelabeledit_disabled">&amp;nbsp&amp;nbsp 
																			<h:outputLabel>
																				<h:outputText value="#{bundle['rz_admin_usermanager.user.customer']}"></h:outputText>
																			</h:outputLabel>
																	</td>
																	<td align="left" class="tablelabelfieldedit_disabled" width="30%">
																	
																		<h:outputLabel>
																				<h:outputText  value="#{rz_UserEmployeeGridBean.nameCustomer}" styleClass="tabletexttitleinformation"></h:outputText>
																		</h:outputLabel>
																	 </td>
																</tr>
							
															</table>
															
														</ice:panelGroup>
													<br/>
													<ice:panelGroup style="margin-top:-3px;width:97%;overflow:auto;">
	
														<ice:panelGroup>
															<ice:panelGroup>
																<ice:dataTable resizable="false" border="1" id="tableuseremployeegrid"
																	value="#{rz_UserEmployeeGridBean.allCrudBeans}"
																	var="adminUserEmployeeBean"
																	width="98%"
																	rows="#{rz_UserEmployeeGridBean.selectedDataScrollModes[rz_UserEmployeeGridBean.selectedDataScrollMode].rows}"
																	scrollable="#{rz_UserEmployeeGridBean.selectedDataScrollModes[rz_UserEmployeeGridBean.selectedDataScrollMode].scrollingEnabled}"
																	scrollHeight="200px"
																	style="float:center;font-color: #FFFFFF;"
																	columnWidths="20%,1%,25%,25%,20%,9%"
																	columnClasses="columnCenter,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnLeft,columnCenter"
																	rowClasses="rowOn,rowOff" cellpadding="0"
																	sortColumn="#{rz_UserEmployeeGridBean.columnNameOrder}"
																	sortAscending="#{rz_UserEmployeeGridBean.descending}"
																	onclick="window.location.reload()">
					
																	
																	<ice:column groupOn="#{adminUserEmployeeBean.nameSite}" style="background-color:#F7F4F5;">
																		<f:facet name="header">
																			<ice:commandSortHeader id="ecustomerSiteIdCustomerSitesort" columnName="customerSiteIdCustomerSite">
																				<ice:outputText	value="#{bundle['rz_admin_customerprofile.employee.site']}"></ice:outputText>
																			</ice:commandSortHeader>
																		</f:facet>
																		<ice:outputText id="idecustomerSiteIdCustomerSite"  style="font-weight:bold;text-align:center;"
																			value="#{adminUserEmployeeBean.nameSite}" />
																	</ice:column>
																	<ice:column style="background-color:white;">
