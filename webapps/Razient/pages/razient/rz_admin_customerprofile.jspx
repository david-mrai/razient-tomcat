													property="zipCode" width="60px" />
												<ice-cc:selectOneMenuColumn
													title="#{bundle['rz_admin_customerprofile.site.locationCriticality']}"
													property="locationCriticality" 
													selectItems="#{rz_CPCustomer_Site_EditTableBean.list_LocCriti}"
													width="120px" />
												<ice-cc:column 
													title="#{bundle['rz_admin_customerprofile.site.latitude']}"
													value="#{row.latitude}" width="50px" />
												<ice-cc:column
													title="#{bundle['rz_admin_customerprofile.site.longitude']}"
													value="#{row.longitude}" width="50px" />
												<ice-cc:selectOneMenuColumn
													title="#{bundle['rz_admin_customerprofile.site.status']}"
													property="status"
													selectItems="#{rz_CPCustomer_Site_EditTableBean.list_Status}"
													width="75px" />
											</ice-cc:editableTable>

										</div>
									</ice:panelTab>

								</ice:panelTabSet>

							</ice:panelGroup>
							
							</td></tr></table>
						</h:form>

					</ui:define>


				</ui:composition>



			</body>
		</html>
	</f:view>
</jsp:root>
