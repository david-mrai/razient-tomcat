													                </f:facet>
													                <f:facet name="next">
													                    <ice:graphicImage id="nextpage_1" url="./css/rime/css-images/arrow-next.gif" style="border:none;" title="next"/>
													                </f:facet>
													                <f:facet name="fastforward">
													                    <ice:graphicImage id="fastforward_1" url="./css/rime/css-images/arrow-ff.gif" style="border:none;" title="ff"/>
													                </f:facet>
													                <f:facet name="fastrewind">
													                    <ice:graphicImage id="fastrewind_1" url="./css/rime/css-images/arrow-fr.gif" style="border:none;" title="fr"/>
													                </f:facet>
													            </ice:dataPaginator>
													            </center>
													        </ice:panelGroup>
															
															
														</ice:panelGroup>
														
													</ice:panelGroup>
											</td >
											<td  rowspan="2">&amp;nbsp</td>
											<td valign="top" align="center"  class="tdSubHeader">
												&amp;nbsp&amp;nbsp
												<ice:commandLink action="#{rz_Compliance_SM_Sections_ListTableBean.loadPositionAction}" onclick="rld();">
														<ice:graphicImage style="border:none;" styleClass="noborder"
																					url="./css/images/icons/menu_up_save.png"
																					onmouseout="this.src='./css/images/icons/menu_up_save.png'"
																					onmouseover="this.src='./css/images/icons/menu_up_save.png'"
																					onmouseup="this.src='./css/images/icons/menu_up_save.png'"
																					onmousedown="this.src='./css/images/icons/menu_up_save.png'"
																					/>
												</ice:commandLink>
										
												
												<h:outputText value="#{bundle['rz_admin_surveymanager.sections.possections']}"></h:outputText>
																				
											bv
											</td>
										</tr>
										<tr>
											<td class="tdcolumninfo" valign="top"><br/>
												<ice:panelGroup style="float:left;margin-top:0px;margin-left:8px;">
										            <ice:panelPositioned id="positions" var="sectionpos"
										                                 value="#{rz_Compliance_SM_Sections_ListTableBean.positions}"
										                                 styleClass="positionPanelContainer"
										                                 listener="#{rz_Compliance_SM_Sections_ListTableBean.changed}"
										                                 constraint="vertical">
										                <ice:panelGroup style="cursor:move;" styleClass="container">
										                    <ice:panelGroup styleClass="moveLabel"
										                                    style="border: 4px red;">
										                        <ice:outputText id="name"  style="color:#334F4E" value="#{sectionpos.name}"/>
										                    </ice:panelGroup>
										                </ice:panelGroup>
										            </ice:panelPositioned>
										        </ice:panelGroup>
											</td>
										</tr>
										</table>
										<br/>
												
										<ice:messages style="margin-top:-5px;color:#1D115E; font-size: 11px;" globalOnly="true" />
										
										</div>	
									</ice:panelGrid>
									
									<style type="text/css">
                                          .cnfSurvey {
											    width: 500px;
											}
										</style>
										
									<ice:panelConfirmation id="confirmupdateSurvey"  styleClass="cnfSurvey"
									  acceptLabel="#{bundle['ice_confirmation.ok']}"  
									  cancelLabel="#{bundle['ice_confirmation.cancel']}"  
									  message="#{bundle['ice_confirmation.update.message']} [#{rz_Compliance_SMBean.name}]"  
									  title="#{bundle['ice_confirmation.update.title']}"  
									  draggable="false"  
									 />
									 <ice:panelConfirmation id="confirmdeleteSurvey"  styleClass="cnfSurvey"
									  acceptLabel="#{bundle['ice_confirmation.ok']}"  
									  cancelLabel="#{bundle['ice_confirmation.cancel']}"  
									  message="#{bundle['ice_confirmation.delete.message']} [#{rz_Compliance_SMBean.name}]"  
									  title="#{bundle['ice_confirmation.delete.title']}"  
									  draggable="false"  
									 />
						</ice:form>		
					</ui:define>


				</ui:composition>




			</body>
		</html>
	</f:view>
