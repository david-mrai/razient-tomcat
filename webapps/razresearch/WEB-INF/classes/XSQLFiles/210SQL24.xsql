<Data>
  <Name>210SQL24</Name>
  <Sentence>SELECT city.city,city.city FROM razient.city AS city,razient.reportnewsstates AS reportnewsstates WHERE (city.country=reportnewsstates.country) AND(city.state_abr=reportnewsstates.state_abbr) AND(reportnewsstates.printable_name LIKE @country) AND(reportnewsstates.state LIKE @state) ORDER BY city.city ASC</Sentence>
