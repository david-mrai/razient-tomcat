<Data>
  <Name>110SQL17</Name>
  <Sentence>SELECT country.printable_name,city.city,city.state FROM razient.city AS city,razient.country AS country WHERE (country.printable_name LIKE @country) 
 AND (country.iso=city.country) AND(city.city LIKE @city) ORDER BY country.printable_name ASC,city.city ASC,city.state ASC</Sentence>
