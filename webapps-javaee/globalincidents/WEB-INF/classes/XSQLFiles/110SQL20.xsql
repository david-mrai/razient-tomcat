  <Name>110SQL20</Name>
  <Sentence>SELECT reportnewsglobalincident.datePosted,reportnewsglobalincident.timePosted,reportnewsglobalincident.newssource,reportnewsglobalincident.title,reportnewsglobalincident.url,reportnewsglobalincident.description,reportnewsglobalincident.city,reportnewsglobalincident.address,reportnewsglobalincident.state,reportnewsglobalincident.country,reportnewsglobalincident.latitude,reportnewsglobalincident.longitude,reportnewsglobalincident.type,reportnewsglobalincident.riskLevel,reportnewsglobalincident.numberkilled FROM razient.reportnewsglobalincident AS reportnewsglobalincident WHERE (reportnewsglobalincident.idrazienGlobalIncident=@newsid)</Sentence>
