			</font>
			</div>
			</td>
			<td class = "row_par" ID="col_par" bgcolor="#FFFFFF" Align="Center">
			<div align="Left">			<font color="#000000"><xsl:value-of select="city.state" disable-output-escaping="no"/>&#xa0;
			</font>
			</div>
			</td>
		</xsl:if>
		<xsl:if test="($actual mod 2 = 1)">
			<td class = "row_impar" ID="col_par" bgcolor="#FFFFFF" Align="Center">
       		<div>&#xa0;</div>
			</td>
			<td class = "row_impar" ID="col_impar" bgcolor="#FFFFFF" Align="Center">
			<div align="Left">			<font color="#000000"><xsl:value-of select="city.city" disable-output-escaping="no"/>&#xa0;
			</font>
			</div>
			</td>
			<td class = "row_impar" ID="col_par" bgcolor="#FFFFFF" Align="Center">
			<div align="Left">			<font color="#000000"><xsl:value-of select="city.state" disable-output-escaping="no"/>&#xa0;
			</font>
			</div>
			</td>
		</xsl:if>
	</tr>
</xsl:template>

