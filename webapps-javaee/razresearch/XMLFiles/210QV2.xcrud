        <Data>
            <Name>210SQL3</Name>
            <Sentence>SELECT reportnewsglobalincident.idrazienGlobalIncident,reportnewsglobalincident.country,reportnewsglobalincident.state,reportnewsglobalincident.city,reportnewsglobalincident.dateNews,reportnewsglobalincident.type,COUNT(reportnewsglobalincident.type) FROM razient.reportnewsglobalincident AS reportnewsglobalincident WHERE (reportnewsglobalincident.country=@country) AND (reportnewsglobalincident.state=@state) AND (reportnewsglobalincident.city=@city) AND (reportnewsglobalincident.dateNews&gt;=@fromdate) AND (reportnewsglobalincident.dateNews&lt;=@todate) GROUP BY reportnewsglobalincident.dateNews,reportnewsglobalincident.type ORDER BY reportnewsglobalincident.dateNews ASC,reportnewsglobalincident.city ASC</Sentence>
