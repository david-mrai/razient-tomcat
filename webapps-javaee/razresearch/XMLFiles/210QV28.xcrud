        <Data>
            <Name>210SQL32</Name>
            <Sentence>SELECT reportnewsglobalincident.country,reportnewsglobalincident.state,reportnewsglobalincident.city,reportnewsglobalincident.type,reportnewsglobalincident.latitude + COUNT( reportnewsglobalincident.type) -  reportnewsglobalincident.latitude FROM razient.reportnewsglobalincident AS reportnewsglobalincident WHERE (reportnewsglobalincident.country=@country) AND (reportnewsglobalincident.state=@state) AND(reportnewsglobalincident.dateNews&gt;=@fromdate) AND(reportnewsglobalincident.dateNews&lt;=@todate) AND(reportnewsglobalincident.type=@type) GROUP BY reportnewsglobalincident.state,reportnewsglobalincident.city ORDER BY reportnewsglobalincident.state ASC,reportnewsglobalincident.city ASC</Sentence>
