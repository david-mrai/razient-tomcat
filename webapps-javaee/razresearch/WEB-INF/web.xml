<?xml version="1.0" encoding="ISO-8859-1" ?>
<web-app id="WebApp" version="2.4"
         xmlns="http://java.sun.com/xml/ns/j2ee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd"> 
      <display-name>razresearch</display-name> 
      <context-param>
             <description>Archivo de Configuracion del LogicServer</description>
             <param-name>configFile</param-name>
             <param-value>/usr/local/tomcat/conf</param-value>
      </context-param> 
	<servlet> 
		<servlet-name>LogicServerAppServlet</servlet-name> 
		<display-name>LogicServerAppServlet</display-name> 
		<servlet-class>com.mcmsoftware.project.LogicServerAppServlet</servlet-class> 
	</servlet>
	<servlet-mapping> 
		<servlet-name>LogicServerAppServlet</servlet-name> 
		<url-pattern>/LogicServerAppServlet</url-pattern>  
	</servlet-mapping> 
	<welcome-file-list> 
	      <welcome-file>index.html</welcome-file> 
	      <welcome-file>index.htm</welcome-file> 
	      <welcome-file>index.jsp</welcome-file> 
	      <welcome-file>default.html</welcome-file> 
	      <welcome-file>default.htm</welcome-file> 
	      <welcome-file>default.jsp</welcome-file> 
	</welcome-file-list> 
	<jsp-config> 
	<taglib> 
	      <taglib-uri>http://jakarta.apache.org/taglibs/datetime-1.0</taglib-uri> 
	      <taglib-location>/WEB-INF/taglibs/taglibs-datetime.tld</taglib-location> 
	</taglib> 
	</jsp-config> 
</web-app>