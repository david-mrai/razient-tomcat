<Data>
  <Name>210SQL15</Name>
  <Sentence>SELECT reportnewsglobalincident.country,reportnewsglobalincident.state,reportnewsglobalincident.city,reportnewsglobalincident.dateNews,reportnewsglobalincident.type,CASE risklevel 
WHEN &quot;1&quot; THEN &quot;Critical&quot;
WHEN &quot;2&quot; THEN &quot;High&quot;
WHEN &quot;3&quot; THEN &quot;Medium&quot;
WHEN &quot;4&quot; THEN &quot;low&quot; 
END AS &apos;Risk Level&apos;,reportnewsglobalincident.title,reportnewsglobalincident.description FROM razient.reportnewsglobalincident AS reportnewsglobalincident WHERE (reportnewsglobalincident.country=@country) AND(reportnewsglobalincident.state=@state) AND(reportnewsglobalincident.city=@city) AND(reportnewsglobalincident.type=@type) AND(reportnewsglobalincident.dateNews=@newsdate) ORDER BY reportnewsglobalincident.dateNews ASC</Sentence>
