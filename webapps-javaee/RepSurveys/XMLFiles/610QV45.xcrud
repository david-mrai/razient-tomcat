        </Connection>
        <Data>
            <Name>610SQL49</Name>
            <Sentence>SELECT vw_cussur_secque.idcustomerSurveys,vw_cussur_secque.customer_idCustomer,vw_cussur_secque.surveyname,vw_cussur_secque.sectionname,vw_cussur_secque.question,supplier.idSupplier,supplier.name,CASE WHEN (`suppliersurveyresponseanswers`.dateAnswered IS NULL) THEN &apos;Not Answered&apos; ELSE `suppliersurveyresponseanswers`.dateAnswered END AS dateAnswered,CASE WHEN (`suppliersurveyresponseanswers`.levelMarginal IS NULL) THEN 0 ELSE `suppliersurveyresponseanswers`.levelMarginal END AS levelMarginal FROM razient.vw_cussur_secque AS vw_cussur_secque,razient.customersurveyasignsupp AS customersurveyasignsupp,razient.supplier AS supplier,razient.suppliersurveyresponseanswers AS suppliersurveyresponseanswers WHERE (supplier.idSupplier=suppliersurveyresponseanswers.supplier_idSupplier) AND (vw_cussur_secque.customer_idCustomer=customersurveyasignsupp.idCustomer) AND (vw_cussur_secque.idcustomerSurveys=customersurveyasignsupp.idSurvey) AND (customersurveyasignsupp.idSupplier=supplier.idSupplier) AND(suppliersurveyresponseanswers.customerQuestionsSurveys_idcustomerQuestionSurveys *=  vw_cussur_secque.idcustomerQuestionSurveys) AND (vw_cussur_secque.idcustomerSurveys=@idSurvey) AND(vw_cussur_secque.customer_idCustomer=@cxRaz__razient__customersurveys__idcustomerSurveys)</Sentence>
            <Out_Fields>
