<Data>
  <Name>610SQL50</Name>
  <Sentence>SELECT supplier.idSupplier,supplier.name FROM razient.customersurveys AS customersurveys,razient.customersurveyasignsupp AS customersurveyasignsupp,razient.supplier AS supplier WHERE (customersurveys.customer_idCustomer=customersurveyasignsupp.idCustomer) AND (customersurveys.idcustomerSurveys=customersurveyasignsupp.idSurvey) AND (customersurveyasignsupp.idSupplier=supplier.idSupplier) AND (customersurveyasignsupp.idCustomer=@cxRaz__razient__customersurveys__idcustomerSurveys) AND (customersurveyasignsupp.idSurvey=@idSurvey) AND (customersurveys.razientSurveyStatus_idrazientSurveyStatus&gt;1) ORDER BY supplier.name ASC</Sentence>
