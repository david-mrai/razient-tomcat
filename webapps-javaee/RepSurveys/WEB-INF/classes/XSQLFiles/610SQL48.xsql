  <Name>610SQL48</Name>
  <Sentence>SELECT customersurveys.idcustomerSurveys,customersurveys.name FROM razient.customersurveys AS customersurveys WHERE (customersurveys.customer_idCustomer=@cxRaz__razient__customersurveys__idcustomerSurveys) AND (customersurveys.razientSurveyStatus_idrazientSurveyStatus&gt;1) ORDER BY customersurveys.name ASC</Sentence>
